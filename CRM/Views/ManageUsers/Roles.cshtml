@section Scripts {
    <script>
        /* ── UI Feedback Helper Engine ── */
        function validateSelect(selectEl) {
            var wrapper = selectEl.closest('.mb-2') || selectEl.closest('.mb-3');
            if (!wrapper) return true;
            var ok = selectEl.value !== '';
            selectEl.classList.toggle('is-valid', ok);
            selectEl.classList.toggle('is-invalid', !ok);
            wrapper.classList.toggle('show-valid', ok);
            wrapper.classList.toggle('show-invalid', !ok);
            return ok;
        }

        function resetSelect(selectEl) {
            var wrapper = selectEl.closest('.mb-2') || selectEl.closest('.mb-3');
            selectEl.classList.remove('is-valid', 'is-invalid');
            if (wrapper) wrapper.classList.remove('show-valid', 'show-invalid');
            selectEl.value = '';
        }

        /* Live events hook mapping */
        ['addRoleSelect', 'editRoleSelect'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener('change', function () { validateSelect(this); });
        });

        document.getElementById('addRoleModal').addEventListener('show.bs.modal', function () {
            resetSelect(document.getElementById('addRoleSelect'));
            $('#addCustomRoleSection').hide();
            $('#addModulesSection').hide();
            $('.add-module-cb').prop('checked', false);
        });

        /* ── Pagination Processing Core ── */
        var currentPage = 1;
        var pageSize = 10;
        var filteredRoles = [];

        function initializePagination() {
            filteredRoles = Array.from(document.querySelectorAll('.role-card'));
            if (filteredRoles.length > 0) {
                document.getElementById('paginationContainer').style.display = 'flex';
                updatePagination();
            }
        }

        function updatePagination() {
            var totalPages = Math.ceil(filteredRoles.length / pageSize);
            var startIndex = (currentPage - 1) * pageSize;
            var endIndex = Math.min(startIndex + pageSize, filteredRoles.length);

            document.querySelectorAll('.role-card').forEach(function (c) { c.style.display = 'none'; });
            for (var i = startIndex; i < endIndex; i++) {
                if (filteredRoles[i]) filteredRoles[i].style.display = 'block';
            }

            var start = filteredRoles.length > 0 ? startIndex + 1 : 0;
            document.getElementById('paginationInfo').textContent =
                'Showing ' + start + '–' + endIndex + ' of ' + filteredRoles.length + ' roles';

            updatePageNumbers(totalPages);
            document.getElementById('prevBtn').disabled = currentPage === 1;
            document.getElementById('nextBtn').disabled = currentPage === totalPages || totalPages === 0;
        }

        function updatePageNumbers(totalPages) {
            var pg = document.getElementById('pageNumbers');
            pg.innerHTML = '';
            if (totalPages <= 1) return;
            var max = 5;
            var sp = Math.max(1, currentPage - Math.floor(max / 2));
            var ep = Math.min(totalPages, sp + max - 1);
            if (ep - sp + 1 < max) sp = Math.max(1, ep - max + 1);
            for (var i = sp; i <= ep; i++) {
                (function (p) {
                    var btn = document.createElement('button');
                    btn.className = 'pagination-btn' + (p === currentPage ? ' active' : '');
                    btn.textContent = p;
                    btn.onclick = function () { goToPage(p); };
                    pg.appendChild(btn);
                })(i);
            }
        }

        function changePage(dir) {
            var tp = Math.ceil(filteredRoles.length / pageSize);
            var np = currentPage + dir;
            if (np >= 1 && np <= tp) { currentPage = np; updatePagination(); }
        }
        function goToPage(p) { currentPage = p; updatePagination(); }

        /* ── Execution Context Initialization ── */
        $(document).ready(function () {
            initializePagination();

            $('.role-card .dropdown').on('show.bs.dropdown', function () {
                $('.role-card').css('z-index', '1');
                $(this).closest('.role-card').css('z-index', '99999');
            });
            $('.role-card .dropdown').on('hide.bs.dropdown', function () {
                $(this).closest('.role-card').css('z-index', '1');
            });

            function applyFilters() {
                var search = $('#searchBox').val().toLowerCase();
                filteredRoles = [];
                $('.role-card').each(function () {
                    if (!search || $(this).text().toLowerCase().includes(search)) {
                        filteredRoles.push(this);
                    }
                });
                currentPage = 1;
                updatePagination();
            }
            $('#searchBox').on('input', applyFilters);
            $('#clearFilters').on('click', function () { $('#searchBox').val(''); applyFilters(); });

            /* Conditional Switch Toggles */
            $('#addRoleSelect').on('change', function() {
                if ($(this).val() === 'Other') {
                    $('#addCustomRoleSection').show();
                    $('#addModulesSection').show();
                } else {
                    $('#addCustomRoleSection').hide();
                    $('#addModulesSection').hide();
                }
            });

            $('#editRoleSelect').on('change', function() {
                if ($(this).val() === 'Other') {
                    $('#editCustomRoleSection').show();
                    $('#editModulesSection').show();
                } else {
                    $('#editCustomRoleSection').hide();
                    $('#editModulesSection').hide();
                }
            });

            /* Form Submissions Processing Engine */
            $('#addRoleForm').on('submit', function (e) {
                e.preventDefault();
                var sel = document.getElementById('addRoleSelect');
                if (!validateSelect(sel)) return;

                var selectVal = $('#addRoleSelect').val();
                if (selectVal === 'Other') {
                    var customName = $('#addCustomRoleName').val().trim();
                    if (!customName) { showToast('Please enter a custom role name', 'warning'); return; }

                    $('#addRoleSelect').append('<option value="' + customName + '" selected>' + customName + '</option>');
                    $('#addRoleSelect').val(customName);

                    var modules = [];
                    $('.add-module-cb:checked').each(function () { modules.push($(this).val()); });
                    $('#addAllowedModules').val(modules.join(','));
                }

                var btn = $('#addSubmitBtn');
                var orig = btn.html();
                btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Creating…');

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (r) {
                        if (r.success) { $('#addRoleModal').modal('hide'); location.reload(); }
                        else Swal.fire({ icon: 'error', title: 'Error', text: r.message || 'Error creating role' });
                    },
                    error: function (xhr) { Swal.fire({ icon: 'error', title: 'Error', text: xhr.responseText || 'Error creating role' }); },
                    complete: function () { btn.prop('disabled', false).html(orig); }
                });
            });

            /* Edit Data Fetcher Engine */
            $('.edit-role-btn').on('click', function () {
                var id = $(this).data('role-id');
                $.getJSON('/ManageUsers/GetRole?id=' + id, function (r) {
                    if (r.success) {
                        $('#editRoleId').val(r.id);
                        var roleName = r.roleName;
                        var standardRoles = ['Admin', 'Partner', 'Agent'];

                        $('.edit-module-cb').prop('checked', false);
                        $('#editAllowedModules').val('');

                        if (standardRoles.includes(roleName)) {
                            $('#editRoleSelect').val(roleName);
                            $('#editCustomRoleName').val('');
                            $('#editCustomRoleSection').hide();
                            $('#editModulesSection').hide();
                        } else {
                            $('#editRoleSelect').val('Other');
                            $('#editCustomRoleName').val(roleName);
                            $('#editCustomRoleSection').show();
                            $('#editModulesSection').show();

                            if (r.allowedModules) {
                                var mods = r.allowedModules.split(',');
                                mods.forEach(function (m) {
                                    $('.edit-module-cb[value="' + m.trim() + '"]').prop('checked', true);
                                });
                            }
                        }
                        validateSelect(document.getElementById('editRoleSelect'));
                        $('#editRoleModal').modal('show');
                    } else Swal.fire({ icon: 'error', title: 'Error', text: r.message || 'Role not found' });
                }).fail(function () { Swal.fire({ icon: 'error', title: 'Error', text: 'Error loading role data' }); });
            });

            $('#editRoleForm').on('submit', function (e) {
                e.preventDefault();
                var sel = document.getElementById('editRoleSelect');
                if (!validateSelect(sel)) return;

                var selectVal = $('#editRoleSelect').val();
                if (selectVal === 'Other') {
                    var customName = $('#editCustomRoleName').val().trim();
                    if (!customName) { showToast('Please enter a custom role name', 'warning'); return; }

                    $('#editRoleSelect').append('<option value="' + customName + '" selected>' + customName + '</option>');
                    $('#editRoleSelect').val(customName);

                    var modules = [];
                    $('.edit-module-cb:checked').each(function() { modules.push($(this).val()); });
                    $('#editAllowedModules').val(modules.join(','));
                } else {
                    $('#editAllowedModules').val('');
                }

                var btn = $('#editSubmitBtn');
                var orig = btn.html();
                btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Saving…');

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (r) {
                        if (r.success) { $('#editRoleModal').modal('hide'); location.reload(); }
                        else Swal.fire({ icon: 'error', title: 'Error', text: r.message || 'Error updating role' });
                    },
                    error: function (xhr) { Swal.fire({ icon: 'error', title: 'Error', text: 'Error updating role' }); },
                    complete: function () { btn.prop('disabled', false).html(orig); }
                });
            });
        });
    </script>
}