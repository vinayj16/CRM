@model IEnumerable<CRM.Models.RolePermission>
@inject CRM.MasterDb.MasterDbContext _mastercontext

@{
    ViewData["Title"] = "Roles & Permissions";
    var rolesList = Model?.ToList() ?? new List<CRM.Models.RolePermission>();
    var totalRoles = rolesList.Count;

    // Declared here so it's accessible by BOTH the Add and Edit modals lower down
    var systemModules = new[] {
        "Dashboard", "Leads & Properties", "Sales", "Finance",
        "Team Management", "Attendance", "Payouts", "User Management",
        "Settings", "Subscriptions", "Financial Settings", "Testimonials", "Integrations"
    };

    // Check if tenant's plan has Partner feature
    bool hasPartnerFeature = false;
    var tenantIdClaim = Context.User.FindFirst("TenantId")?.Value;
    if (!string.IsNullOrEmpty(tenantIdClaim) && int.TryParse(tenantIdClaim, out int tid))
    {
        var maxPartners = _mastercontext.TenantSubscriptions
            .Where(s => s.TenantId == tid && (s.Status == "Active" || s.Status == "Trial"))
            .OrderByDescending(s => s.StartDate)
            .Select(s => s.Plan != null ? s.Plan.MaxPartners : 0)
            .FirstOrDefault();

        hasPartnerFeature = maxPartners > 0;
    }
}

