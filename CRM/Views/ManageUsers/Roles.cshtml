    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editRoleForm" method="post" action="/ManageUsers/AddRoles" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editRoleId" />
                <input type="hidden" name="AllowedModules" id="editAllowedModules" />
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-pencil"></i>Edit System Tier
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2" id="editSelectWrapper">
                        <label class="form-label">Role Definition Tier <span style="color:#DC2626;">*</span></label>
                        <select name="RoleName" id="editRoleSelect" class="form-select" required>
                            <option value="">Choose role…</option>
                            <option value="Admin">Admin</option>
                            @if (hasPartnerFeature)
                            {
                                <option value="Partner">Partner</option>
                            }
                            <option value="Agent">Agent</option>
                            <option value="Other">Other (Custom Feature Tier)</option>
                        </select>
                        <div class="valid-feedback"><i class="fa-solid fa-check"></i> Tier loaded</div>
                        <div class="invalid-feedback"><i class="fa-solid fa-circle-exclamation"></i> Selection required</div>
                    </div>

                    <div class="mb-2" id="editCustomRoleSection" style="display:none;">
                        <label class="form-label">Custom Role Label <span style="color:#DC2626;">*</span></label>
                        <input type="text" class="form-control" id="editCustomRoleName" placeholder="Enter name">
                    </div>

                    <div class="mb-2" id="editModulesSection" style="display:none;">
                        <label class="form-label" style="color:#1A6FA8;">Module Access Configuration Matrix</label>
                        <div class="row g-1 style-matrix-box" style="background:#FFFFFF; padding:6px; border:1px dashed #E2E8F0; border-radius:6px;">
                            @for (int i = 0; i < systemModules.Length; i++)
                            {
                                <div class="col-6">
