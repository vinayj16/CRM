                    <div class="stats-number">@totalRoles</div>
                    <div class="stats-label">Total Roles</div>
                </div>
                <div class="stats-card">
                    <div class="stats-number">@rolesList.Count(r => r.RoleName == "Admin")</div>
                    <div class="stats-label">Admin Roles</div>
                </div>
                <div class="stats-card">
                    <div class="stats-number">@rolesList.Count(r => r.RoleName != "Admin" && r.RoleName != "Partner" && r.RoleName != "Agent")</div>
                    <div class="stats-label">Custom Roles</div>
                </div>
            </div>
        </div>
    </div>

    <div class="filter-section">
        <div class="filter-label">
            <i class="fa-solid fa-filter" style="font-size:9px;"></i> Filter &amp; Search
        </div>
        <div class="filter-row">
            <input type="text" class="form-control" id="searchBox" placeholder="Search by role name…">
            <button type="button" class="btn" id="clearFilters">
                <i class="fa-solid fa-rotate-right" style="font-size:8.5px;"></i> Clear
            </button>
        </div>
    </div>

    <div id="rolesContainer">
        @if (rolesList.Any())
        {
            <div class="section-label">All Roles</div>

            foreach (var role in rolesList)
            {
                var standardRolesList = new[] { "Admin", "Partner", "Agent" };
                var isCustomRole = !standardRolesList.Contains(role.RoleName);

                <div class="role-card paginated-item">
                    <div class="desktop-layout">
                        <div class="role-card-inner">
                            <div class="rc-name-col">
                                <div class="role-name">
                                    <i class="fa-solid fa-user-tag"></i>
                                    <span>@role.RoleName</span>
                                </div>
                                <div class="role-meta">
                                    <i class="fa-solid fa-calendar" style="font-size:9px;"></i>
                                    @role.CreatedAt.ToString("MMM dd, yyyy")
                                </div>
                            </div>

                            <div class="rc-perm-col">
                                @if (isCustomRole && !string.IsNullOrEmpty(role.AllowedModules))
                                {
                                    <div class="perm-label">
                                        <i class="fa-solid fa-cubes" style="font-size:9px;"></i>
                                        <span>Module-Based Access Matrix</span>
                                    </div>
                                    @foreach (var mod in role.AllowedModules.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="permission-badge">@mod.Trim()</span>
                                    }
                                }
                                else
                                {
                                    <div class="perm-label">
                                        <i class="fa-solid fa-key" style="font-size:9px;"></i>
                                        <span>Page-Specific Access Rules</span>
                                    </div>
                                    <span class="permission-badge">
                                        <i class="fa-solid fa-check" style="font-size:8.5px;"></i> Configured per page
                                    </span>
                                }
                            </div>

                            <div class="rc-action-col">
                                <div class="dropdown">
                                    <button class="dd-trigger btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fa-solid fa-ellipsis-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        @if (!isCustomRole)
                                        {
                                            <li>
                                                <a class="dropdown-item" href="/ManageUsers/RolePermissions?roleName=@role.RoleName">
                                                    <i class="fa-solid fa-shield-halved"></i>Manage Permissions
                                                </a>
                                            </li>
                                        }
                                        <li>
                                            <button class="dropdown-item edit-role-btn" type="button" data-role-id="@role.Id">
                                                <i class="fa-solid fa-pencil"></i>Edit Role
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-danger" href="/ManageUsers/DeleteRoles/@role.Id" onclick="return confirm('Delete this role?')">
                                                <i class="fa-solid fa-trash"></i>Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mobile-layout" style="padding: .5rem .75rem;">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                            <div>
                                <div class="role-name" style="font-size:12px; margin-bottom:2px;">
                                    <i class="fa-solid fa-user-tag"></i> <span>@role.RoleName</span>
                                </div>
                                <div class="role-meta" style="margin-bottom:4px;">
                                    <i class="fa-solid fa-calendar" style="font-size:9px;"></i> @role.CreatedAt.ToString("MMM dd, yyyy")
                                </div>
                                <div>
                                    @if (isCustomRole && !string.IsNullOrEmpty(role.AllowedModules))
                                    {
                                        <span class="permission-badge" style="background:rgba(22,163,74,.1); color:#16A34A;">Module-Based Access Matrix</span>
                                    }
                                    else
                                    {
                                        <span class="permission-badge">Page-Specific Rules</span>
                                    }
                                </div>
                            </div>
                            <div class="dropdown">
                                <button class="dd-trigger btn" type="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (!isCustomRole)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/ManageUsers/RolePermissions?roleName=@role.RoleName">
                                                <i class="fa-solid fa-shield-halved"></i>Manage Permissions
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <button class="dropdown-item edit-role-btn" type="button" data-role-id="@role.Id">
                                            <i class="fa-solid fa-pencil"></i>Edit Role
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="/ManageUsers/DeleteRoles/@role.Id" onclick="return confirm('Delete this role?')">
                                            <i class="fa-solid fa-trash"></i>Delete
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="rp-empty">
                <i class="fa-solid fa-shield-halved"></i>
                <h3>No Roles Found</h3>
                <p>Start by adding your first role above.</p>
            </div>
        }

        <div class="pagination-container" id="paginationContainer" style="display:none;">
            <div class="pagination-info">
                <span id="paginationInfo">Showing 1–10 of 0 roles</span>
            </div>
            <div class="pagination-controls">
                <button class="pagination-btn" id="prevBtn" onclick="changePage(-1)">
                    <i class="fa-solid fa-chevron-left"></i> Prev
                </button>
                <div id="pageNumbers" style="display:flex;gap:3px;"></div>
                <button class="pagination-btn" id="nextBtn" onclick="changePage(1)">
                    Next <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="addRoleForm" method="post" action="/ManageUsers/AddRoles" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="AllowedModules" id="addAllowedModules" />
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-plus"></i>Add New Role
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2" id="addSelectWrapper">
                        <label class="form-label">Role Definition Tier <span style="color:#DC2626;">*</span></label>
                        <select name="RoleName" class="form-select" id="addRoleSelect" required>
                            <option value="">Choose role…</option>
                            <option value="Admin">Admin</option>
                            @if (hasPartnerFeature)
                            {
                                <option value="Partner">Partner</option>
                            }
                            <option value="Agent">Agent</option>
                            <option value="Other">Other (Custom Feature Tier)</option>
                        </select>
                        <div class="valid-feedback"><i class="fa-solid fa-check"></i> Tier selected</div>
                        <div class="invalid-feedback"><i class="fa-solid fa-circle-exclamation"></i> Selection required</div>
                    </div>

                    <div class="mb-2" id="addCustomRoleSection" style="display:none;">
                        <label class="form-label">Custom Role Label <span style="color:#DC2626;">*</span></label>
                        <input type="text" class="form-control" id="addCustomRoleName" placeholder="E.g., Manager, Sales Agent">
                    </div>

                    <div class="mb-2" id="addModulesSection" style="display:none;">
                        <label class="form-label" style="color:#1A6FA8;">Module Access Configuration Matrix</label>
                        <div class="row g-1 style-matrix-box" style="background:#FFFFFF; padding:6px; border:1px dashed #E2E8F0; border-radius:6px;">
                            @for (int i = 0; i < systemModules.Length; i++)
                            {
                                <div class="col-6">
                                    <div class="form-check" style="min-height:auto; margin-bottom:2px;">
                                        <input class="form-check-input add-module-cb" type="checkbox" value="@systemModules[i]" id="addMod@i">
                                        <label class="form-check-label" for="addMod@i" style="font-size:11px; cursor:pointer;">@systemModules[i]</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-2">
                        <div class="alert alert-info">
                            <i class="fa-solid fa-circle-info" style="font-size:11px; flex-shrink:0; margin-top:1px;"></i>
                            <span>Custom security models bypass explicit row configuration grids automatically.</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="addSubmitBtn">Create Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

