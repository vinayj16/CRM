@* @model IEnumerable<CRM.Models.UserModel>
@{
    ViewData["Title"] = "User Impersonation";
    var usersList = Model.ToList();
}

<style>
    :root {
        --clr-gold: #D4A45A;
        --clr-gold-dark: #B8883E;
        --clr-gold-soft: rgba(212,164,90, 0.10);
        --clr-blue: #1A6FA8;
        --clr-blue-dark: #0F4C75;
        --clr-blue-soft: rgba(26,111,168, 0.10);
    }

    /* ── Header ─────────────────────────────────── */
    .impersonation-header {
        background: linear-gradient(135deg, var(--clr-blue) 0%, var(--clr-blue-dark) 100%);
        border-bottom: 3px solid var(--clr-gold);
        color: white;
        padding: 1.1rem 1.4rem;
        border-radius: 10px;
        margin-bottom: 1.25rem;
    }
    h1, .h1 {
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    margin-bottom: 0px !important;
}
    .impersonation-header h1 {
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0;
    }

    .impersonation-header p {
        font-size: 0.82rem;
        opacity: 0.88;
        margin: 0;
    }

    .impersonation-header .fa-user-secret {
        color: var(--clr-gold);
        font-size: 2rem !important;
    }

    /* ── Filter Section ─────────────────────────── */
    .filter-section {
        background: white;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.1rem;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        border: 1px solid #E2E8F0;
    }

    .filter-section .form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #2A3A4A;
        margin-bottom: 0.3rem;
    }

    .filter-section .form-control,
    .filter-section .form-select {
        font-size: 0.85rem;
        padding: 0.45rem 0.7rem;
        border-radius: 7px;
        border: 1px solid #E2E8F0;
        transition: border-color 0.2s;
    }

    .filter-section .form-control:focus,
    .filter-section .form-select:focus {
        border-color: var(--clr-blue);
        box-shadow: 0 0 0 0.15rem var(--clr-blue-soft);
    }

    /* ── Role Section ───────────────────────────── */
    .role-section {
        background: white;
        border-radius: 10px;
        padding: 0;
        margin-bottom: 0.85rem;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        border: 1px solid #E2E8F0;
        overflow: hidden;
    }

    .role-header {
        background: linear-gradient(135deg, var(--clr-blue) 0%, var(--clr-blue-dark) 100%);
        border-bottom: 3px solid var(--clr-gold);
        color: white;
        padding: 0.7rem 1rem;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        transition: background 0.2s;
    }

    .role-header:hover {
        background: linear-gradient(135deg, #2589C9 0%, #125082 100%);
    }

    .role-header i {
        color: var(--clr-gold);
        margin-right: 0.5rem;
    }

    .role-header::after {
        content: "\f078";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        margin-left: auto;
        transition: transform 0.2s;
        font-size: 0.75rem;
        opacity: 0.85;
    }

    .role-header.collapsed::after {
        transform: rotate(-90deg);
    }

    /* ── Users Grid ─────────────────────────────── */
    .users-body {
        padding: 0.65rem 0.85rem;
    }

    .users-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.45rem;
    }

    /* ── User Items ─────────────────────────────── */
    .user-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.45rem 0.65rem;
        border: 1px solid #E2E8F0;
        border-left: 3px solid var(--clr-gold);
        border-radius: 7px;
        transition: all 0.2s ease;
        background: #FFFFFF;
        gap: 0.5rem;
        min-width: 0;
    }

    .user-item:hover {
        background: var(--clr-blue-soft);
        border-color: var(--clr-blue);
        border-left-color: var(--clr-gold);
    }

    .user-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
    }

    .user-name {
        font-weight: 600;
        color: #2A3A4A;
        font-size: 0.82rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-email {
        font-size: 0.72rem;
        color: #6B7B8D;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Impersonate Button ─────────────────────── */
    .impersonate-btn {
        background: transparent;
        border: 1.5px solid var(--clr-blue);
        color: var(--clr-blue);
        padding: 0.28rem 0.65rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.75rem;
        transition: all 0.25s ease;
        outline: none;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .impersonate-btn:hover {
        background: linear-gradient(135deg, var(--clr-blue) 0%, var(--clr-blue-dark) 100%);
        color: #FFFFFF;
        border-color: var(--clr-blue);
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(26,111,168, 0.3);
    }

    .impersonate-btn:focus,
    .impersonate-btn:active,
    .impersonate-btn:visited {
        background: linear-gradient(135deg, var(--clr-blue) 0%, var(--clr-blue-dark) 100%);
        color: #FFFFFF;
        box-shadow: none;
        outline: none;
    }

    /* ── Header Expand/Collapse Buttons ─────────── */
    .impersonation-header .btn-outline-light {
        font-size: 0.78rem;
        padding: 0.28rem 0.7rem;
        border-radius: 5px;
        border-color: rgba(255,255,255,0.5);
        color: white;
        background: rgba(255,255,255,0.12);
        transition: background 0.2s;
    }

    .impersonation-header .btn-outline-light:hover {
        background: rgba(255,255,255,0.25);
        color: white;
    }

    /* ── Dark Mode ──────────────────────────────── */
    html.dark-mode .filter-section,
    html.dark-mode .role-section {
        background: #1A2332 !important;
        border-color: #2A3A4A !important;
    }

    html.dark-mode .users-body {
        background: #1A2332;
    }

    html.dark-mode .user-item {
        background: #1A2332 !important;
        border-color: #2A3A4A !important;
        border-left-color: var(--clr-gold) !important;
    }

    html.dark-mode .user-item:hover {
        background: #1E2A3A !important;
    }

    html.dark-mode .user-name {
        color: #E2E8F0 !important;
    }

    html.dark-mode .user-email {
        color: #8FA3B8 !important;
    }

    html.dark-mode .filter-section .form-label {
        color: #E2E8F0 !important;
    }

    html.dark-mode .filter-section .form-control,
    html.dark-mode .filter-section .form-select {
        background-color: #1E2A3A;
        border-color: #2A3A4A;
        color: #E2E8F0;
    }

    /* ── Responsive ─────────────────────────────── */
    @@media (max-width: 1200px) {
        .users-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .impersonation-header {
            padding: 0.9rem 1rem;
        }

        .impersonation-header h1 {
            font-size: 1.1rem;
        }

        .impersonation-header .d-flex.gap-2 {
            gap: 0.35rem !important;
        }

        .users-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .users-body {
            padding: 0.5rem 0.65rem;
        }
    }

    @@media (max-width: 576px) {
        .users-grid {
            grid-template-columns: 1fr;
        }

        .user-name {
            font-size: 0.82rem;
        }

        .user-email {
            font-size: 0.72rem;
        }

        .impersonation-header .fa-user-secret {
            font-size: 1.4rem !important;
        }
    }
</style>

<div class="content">
    <!-- Header -->
    <div class="impersonation-header">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="fa-solid fa-user-secret fa-3x"></i>
                <div>
                    <h1 class="mb-0">User Impersonation</h1>
                    <p class="mb-0">Login as any user to test their experience</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-light" id="expandAllBtn" onclick="expandAll()">
                    <i class="fa-solid fa-expand me-1"></i>View All
                </button>
                <button type="button" class="btn btn-sm btn-outline-light" id="collapseAllBtn" onclick="collapseAll()">
                    <i class="fa-solid fa-compress me-1"></i>Collapse
                </button>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="filter-section">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Filter by Role</label>
                <select id="roleFilter" class="form-select">
                    <option value="">All Roles</option>
                    @foreach (var role in ViewBag.Roles as List<string> ?? new List<string>())
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Search Users</label>
                <input type="text" id="searchBox" class="form-control" placeholder="Search by name or email...">
            </div>
        </div>
    </div>

    <!-- Users by Role -->
    <div id="usersContainer">
        @{
            var groupedUsers = usersList.GroupBy(u => u.Role).OrderBy(g => g.Key);
        }

        @foreach (var roleGroup in groupedUsers)
        {
            <div class="role-section" data-role="@roleGroup.Key">
                <div class="role-header">
                    <i class="fa-solid fa-users"></i>
                    @roleGroup.Key (@roleGroup.Count() users)
                </div>

                <div class="users-body">
                    <div class="users-grid">
                        @foreach (var user in roleGroup.OrderBy(u => u.Username))
                        {
                            <div class="user-item" data-username="@user.Username" data-email="@user.Email">
                                <div class="user-info">
                                    <div class="user-name" title="@user.Username">@user.Username</div>
                                    <div class="user-email" title="@user.Email">@user.Email</div>
                                </div>
                                <button class="btn impersonate-btn" onclick="impersonateUser(@user.UserId, '@user.Username')">
                                    <i class="fa-solid fa-sign-in-alt me-1"></i>Impersonate
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Filter functionality
    $('#roleFilter, #searchBox').on('input change', function() {
        var selectedRole = $('#roleFilter').val().toLowerCase();
        var searchTerm = $('#searchBox').val().toLowerCase();
        
        $('.role-section').each(function() {
            var $section = $(this);
            var sectionRole = $section.data('role').toLowerCase();
            var hasVisibleUsers = false;
            
            // Show/hide section based on role filter
            if (selectedRole === '' || sectionRole === selectedRole) {
                $section.find('.user-item').each(function() {
                    var $user = $(this);
                    var username = $user.data('username').toLowerCase();
                    var email = $user.data('email').toLowerCase();
                    
                    // Show/hide user based on search term
                    if (searchTerm === '' || username.includes(searchTerm) || email.includes(searchTerm)) {
                        $user.show();
                        hasVisibleUsers = true;
                    } else {
                        $user.hide();
                    }
                });
                
                // Show/hide entire section based on whether it has visible users
                if (hasVisibleUsers) {
                    $section.show();
                } else {
                    $section.hide();
                }
            } else {
                $section.hide();
            }
        });
    });

    // Impersonation function
    function impersonateUser(userId, username) {
        Swal.fire({
            title: 'Confirm Impersonation',
            text: `Are you sure you want to login as ${username}?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#1A6FA8',
            cancelButtonColor: '#6B7B8D',
            confirmButtonText: 'Yes, Impersonate',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/Account/StartImpersonation', { userId: userId })
                    .done(function(data) {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Impersonation Started',
                                text: data.message,
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = '/Profile/Index';
                            });
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    })
                    .fail(function() {
                        Swal.fire('Error', 'Failed to start impersonation', 'error');
                    });
            }
        });
    }

    function expandAll() {
        $(".users-body").slideDown(200);
        $(".role-header").removeClass("collapsed");
    }
    function collapseAll() {
        $(".users-body").slideUp(200);
        $(".role-header").addClass("collapsed");
    }

    // Click role header to toggle that section
    $(document).on("click", ".role-header", function() {
        $(this).toggleClass("collapsed");
        $(this).closest(".role-section").find(".users-body").slideToggle(200);
    });
</script>
} *@
