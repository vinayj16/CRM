@model List<CRM.Models.BankAccountModel>
@{
    ViewData["Title"] = "Bank Accounts";
}

<div class="container-fluid ba-wrapper">
    <div class="page-hd"><i class="fa-solid fa-building-columns"></i><h4>Bank Accounts</h4></div>
    <div class="row">
        <div class="col-12">
            <div class="card ba-card">
                <div class="card-header ba-header">
                    <h5 class="card-title mb-0"><i class="fa-solid fa-building-columns me-2"></i>Bank Account Settings</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @if (Model?.Any() == true)
                        {
                            @foreach (var account in Model)
                            {
                                <div class="col-12 col-sm-6 col-md-4 mb-3">
                                    <div class="card gateway-card">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="bank-icon"><i class="fa-solid fa-university"></i></span>
                                                    <h6 class="mb-0">@account.BankName</h6>
                                                </div>
                                                @if (account.IsActive)
                                                {
                                                    <span class="badge ba-badge-active">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge ba-badge-inactive">Inactive</span>
                                                }
                                            </div>
                                            <div class="small ba-details">
                                                <p class="mb-1"><strong>Account Holder Name:</strong> @account.AccountHolderName</p>
                                                <p class="mb-1"><strong>Account Number:</strong> ******@account.AccountNumber.Substring(Math.Max(0, account.AccountNumber.Length - 4))</p>
                                                <p class="mb-1"><strong>Bank Name:</strong> @account.BankName</p>
                                                <p class="mb-1"><strong>IFSC Code:</strong> @account.IFSCCode</p>
                                                @if (!string.IsNullOrEmpty(account.BranchName))
                                                {
                                                    <p class="mb-1"><strong>Branch Name:</strong> @account.BranchName</p>
                                                }
                                                @if (!string.IsNullOrEmpty(account.AccountType))
                                                {
                                                    <p class="mb-1"><strong>Account Type:</strong> @account.AccountType</p>
                                                }
                                            </div>
                                            <div class="d-flex justify-content-end gap-2 mt-3">
                                                <button class="btn ba-btn-edit btn-sm" onclick="editAccount(@account.Id)">
                                                    <i class="fa-solid fa-edit me-1"></i>Edit
                                                </button>
                                                @if (!account.IsActive)
                                                {
                                                    <button class="btn ba-btn-delete btn-sm" onclick="deleteAccount(@account.Id)">
                                                        <i class="fa-solid fa-trash me-1"></i>Delete
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <!-- Add New Account Card -->
                        <div class="col-12 col-sm-6 col-md-4 mb-3">
                            <div class="card gateway-card ba-add-card" onclick="openAccountModal()">
                                <div class="card-body text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 220px;">
                                    <i class="fa-solid fa-plus-circle fa-2x mb-3 ba-add-icon"></i>
                                    <h6>Add New Account</h6>
                                    <p class="text-muted small">Add a bank account for receiving payments</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bank Account Modal -->
<div class="modal fade" id="accountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered ba-modal-dialog">
        <div class="modal-content ba-modal-content">
            <div class="modal-header ba-header">
                <h5 class="modal-title" id="accountModalTitle">Add Bank Account</h5>
                <button type="button" class="btn-close ba-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="accountForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="accountId" name="Id" value="0">

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Account Holder Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control ba-input" name="AccountHolderName" id="accountHolderName" required>
                            <div class="valid-feedback">Looks good!</div>
                            <div class="invalid-feedback">Please enter account holder name</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Account Number <span class="text-danger">*</span></label>
                            <input type="text" class="form-control ba-input" name="AccountNumber" id="accountNumber" required inputmode="numeric" pattern="[0-9]+" maxlength="30">
                            <div class="valid-feedback">Looks good!</div>
                            <div class="invalid-feedback">Please enter a valid account number (digits only)</div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Bank Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control ba-input" name="BankName" id="bankName" required>
                            <div class="valid-feedback">Looks good!</div>
                            <div class="invalid-feedback">Please enter bank name</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">IFSC Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control text-uppercase ba-input" name="IFSCCode" id="ifscCode" required minlength="11" maxlength="11" pattern="[A-Za-z0-9]{11}">
                            <div class="valid-feedback">Looks good!</div>
                            <div class="invalid-feedback">Please enter IFSC code</div>
                            <small class="form-text text-muted d-block mt-1">Bank IFSC Codes</small>
                            <small class="form-text text-muted d-block">Length: Always 11 characters.</small>
                            <small class="form-text text-muted d-block">Type: Alpha-numeric (alphabets and numbers).</small>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Branch Name</label>
                            <input type="text" class="form-control ba-input" name="BranchName" id="branchName">
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Account Type</label>
                            <select class="form-select ba-input" name="AccountType" id="accountType">
                                <option value="">Select Type</option>
                                <option value="Savings">Savings</option>
                                <option value="Current">Current</option>
                                <option value="Business">Business</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-check ba-checkbox mt-3">
                        <input type="hidden" name="IsActive" value="false">
                        <input class="form-check-input" type="checkbox" name="IsActive" id="isActiveAccount" value="true">
                        <label class="form-check-label" for="isActiveAccount">
                            Set as active account
                        </label>
                        <small class="form-text text-muted d-block">Only one account can be active at a time</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn ba-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn ba-btn-save">Save Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const accounts = @Html.Raw(Json.Serialize(Model));

function clearValidationStates() {
    document.querySelectorAll('#accountForm .ba-input').forEach(function (el) {
        el.classList.remove('is-valid', 'is-invalid');
    });
    document.getElementById('accountForm').classList.remove('was-validated');
}

function openAccountModal() {
    document.getElementById('accountModalTitle').textContent = 'Add Bank Account';
    document.getElementById('accountForm').reset();
    document.getElementById('accountId').value = '0';
    clearValidationStates();
    new bootstrap.Modal(document.getElementById('accountModal')).show();
}

function editAccount(accountId) {
    const account = accounts.find(a => a.id === accountId);
    if (!account) return;

    document.getElementById('accountModalTitle').textContent = 'Edit Bank Account';
    document.getElementById('accountId').value = account.id;
    document.getElementById('accountHolderName').value = account.accountHolderName;
    document.getElementById('accountNumber').value = account.accountNumber;
    document.getElementById('bankName').value = account.bankName;
    document.getElementById('ifscCode').value = account.ifscCode;
    document.getElementById('branchName').value = account.branchName || '';
    document.getElementById('accountType').value = account.accountType || '';
    document.getElementById('isActiveAccount').checked = account.isActive;
    clearValidationStates();

    new bootstrap.Modal(document.getElementById('accountModal')).show();
}

function deleteAccount(accountId) {
    Swal.fire({
        title: 'Confirm Delete',
        text: 'Are you sure you want to delete this bank account?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#DC2626',
        confirmButtonText: 'Yes, delete!'
    }).then((result) => {
        if (!result.isConfirmed) return;
        fetch('/Financial/DeleteBankAccount', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + accountId
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) { Swal.fire('Deleted!', 'Bank account deleted successfully!', 'success').then(() => location.reload()); }
            else { Swal.fire('Error', 'Error: ' + data.message, 'error'); }
        })
        .catch(() => Swal.fire('Error', 'An error occurred while deleting the account', 'error'));
    });
}

function applyFieldValidationState(el) {
    if (!el.value) {
        // Empty + optional field => no color at all (not falsely "valid")
        // Empty + required field => invalid (red)
        el.classList.remove('is-valid', 'is-invalid');
        if (el.hasAttribute('required')) {
            el.classList.add('is-invalid');
        }
        return;
    }
    if (el.checkValidity()) {
        el.classList.remove('is-invalid');
        el.classList.add('is-valid');
    } else {
        el.classList.remove('is-valid');
        el.classList.add('is-invalid');
    }
}

document.getElementById('accountForm').addEventListener('submit', function(e) {
    e.preventDefault();

    var ifsc = document.getElementById('ifscCode');
    if (ifsc && ifsc.value) ifsc.value = ifsc.value.toUpperCase().trim();

    // Validate every field explicitly so optional+empty fields never show as valid
    document.querySelectorAll('#accountForm .ba-input').forEach(applyFieldValidationState);

    if (!this.checkValidity()) { return; }

    const formData = new FormData(this);
    formData.set('IsActive', document.getElementById('isActiveAccount').checked ? 'true' : 'false');

    fetch('/Financial/SaveBankAccount', { method: 'POST', body: formData })
    .then(r => r.json())
    .then(data => {
        if (data.success) { Swal.fire('Saved!', 'Bank account saved successfully!', 'success').then(() => location.reload()); }
        else { Swal.fire('Error', 'Error: ' + data.message, 'error'); }
    })
    .catch(() => Swal.fire('Error', 'An error occurred while saving the account', 'error'));
});

// Live validation feedback while typing/selecting
document.querySelectorAll('#accountForm .ba-input').forEach(function (el) {
    el.addEventListener('input', function () { applyFieldValidationState(el); });
    el.addEventListener('change', function () { applyFieldValidationState(el); });
});
</script>

<style>
:root {
    --ba-primary: #1A6FA8;
    --ba-accent: #D4A45A;
    --ba-primary-light: rgba(26,111,168, 0.08);
    --ba-accent-light: rgba(212,164,90, 0.12);
}
h5, .h5 {
    font-size: 1.1rem !important;
    font-weight: 600 !important;
    margin-bottom: 0px !important;
}
.ba-wrapper { padding-top: 0.5rem; }

.ba-card {
    border: none;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(26,111,168, 0.10);
}

.ba-header {
    background: linear-gradient(135deg, var(--ba-primary) 0%, #125082 100%);
    color: #FFFFFF;
    border-bottom: 3px solid var(--ba-accent);
    padding: 0.9rem 1.25rem;
}

.ba-header .card-title, .ba-header .modal-title { color: #2A3A4A !important; font-weight: 600; letter-spacing: 0.3px; }

.ba-close { filter: invert(1) grayscale(100) brightness(2); }

/* Account cards */
.gateway-card {
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    background: #FFFFFF;
}

.row>* {
margin-top:0px !important
}
.gateway-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(26,111,168, 0.15);
    border-color: var(--ba-primary);
}

.bank-icon {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--ba-primary-light);
    color: var(--ba-primary);
    font-size: 1rem;
}

.ba-details p strong { color: var(--ba-primary); font-weight: 600; }

.ba-badge-active {
    background-color: #16A34A;
    color: #FFFFFF;
    font-weight: 500;
    padding: 0.35em 0.7em;
    border-radius: 50px;
}
.ba-badge-inactive {
    background-color: #8FA3B8;
    color: #FFFFFF;
    font-weight: 500;
    padding: 0.35em 0.7em;
    border-radius: 50px;
}

.ba-btn-edit {
    background-color: var(--ba-primary);
    border: 1px solid var(--ba-primary);
    color: #FFFFFF;
}
.ba-btn-edit:hover { background-color: #125082; border-color: #125082; color: #FFFFFF; }

.ba-btn-delete {
    background-color: #FFFFFF;
    border: 1px solid #DC2626;
    color: #DC2626;
}
.ba-btn-delete:hover { background-color: #DC2626; color: #FFFFFF; }

/* Add new account card */
.ba-add-card {
    border: 2px dashed var(--ba-accent) !important;
    cursor: pointer;
    background: var(--ba-accent-light);
}
.ba-add-card:hover {
    background: rgba(212,164,90, 0.22);
    border-color: var(--ba-primary) !important;
}
.ba-add-icon { color: var(--ba-accent); }
.ba-add-card:hover .ba-add-icon { color: var(--ba-primary); }

/* Modal */
.ba-modal-dialog { width: 50%; max-width: 50%; }
.ba-modal-content {
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 12px;
    border: none;
}

.ba-input:focus {
    border-color: var(--ba-primary);
    box-shadow: 0 0 0 0.2rem var(--ba-primary-light);
}

.ba-checkbox {
    background: var(--ba-primary-light);
    border: 1px solid var(--ba-primary-light);
    border-radius: 8px;
    padding: 0.75rem 1rem;
}
.ba-checkbox .form-check-input:checked {
    background-color: var(--ba-primary);
    border-color: var(--ba-primary);
}

.ba-btn-cancel {
    background-color: #FFFFFF;
    border: 1px solid #B8C8D8;
    color: #2A3A4A;
}
.ba-btn-cancel:hover { background-color: #F0F4F8; }

.ba-btn-save {
    background-color: var(--ba-accent);
    border: 1px solid var(--ba-accent);
    color: #FFFFFF;
    font-weight: 600;
}
.ba-btn-save:hover { background-color: #B8883E; border-color: #B8883E; color: #FFFFFF; }

/* Validation styles - red/green (driven only by JS-applied is-valid/is-invalid classes,
   never by the native :valid/:invalid pseudo-class, so empty optional fields stay neutral) */
.invalid-feedback, .valid-feedback { display: none; font-size: 0.78rem; }

.form-control.is-invalid ~ .invalid-feedback,
.form-select.is-invalid ~ .invalid-feedback { display: block; }

.form-control.is-valid ~ .valid-feedback,
.form-select.is-valid ~ .valid-feedback { display: block; }

.form-control.is-invalid,
.form-select.is-invalid {
    border-color: #DC2626 !important;
    background-image: none;
}

.form-control.is-valid,
.form-select.is-valid {
    border-color: #16A34A !important;
    background-image: none;
}

.valid-feedback { color: #16A34A; }
.invalid-feedback { color: #DC2626; }

/* Compact form */
#accountForm .modal-body { padding: 1.1rem 1.4rem; }
#accountForm .form-label { margin-bottom: 0.3rem; font-size: 0.85rem; }
#accountForm .ba-input { padding: 0.45rem 0.7rem; font-size: 0.88rem; }
#accountForm .row.g-3 { --bs-gutter-y: 0.65rem; }
#accountForm .form-text { font-size: 0.72rem; margin-top: 0.1rem !important; }
#accountForm .ba-checkbox { padding: 0.55rem 0.8rem; margin-top: 0.6rem !important; }
#accountForm .ba-checkbox .form-check-label { font-size: 0.88rem; }
#accountForm .ba-checkbox small { font-size: 0.72rem; }
#accountForm .modal-footer { padding: 0.75rem 1.4rem; }

/* Responsive */
@@media (min-width: 992px) {
    #accountModal .modal-dialog { width: 50% !important; max-width: 50% !important; }
}

@@media (max-width: 991px) {
    #accountModal .modal-dialog { width: 95% !important; max-width: 95% !important; margin: 0.5rem !important; }
    #accountModal .modal-body { padding: 1rem !important; }
    #accountModal .modal-footer { flex-wrap: nowrap; }
    #accountModal .modal-footer .btn { flex: 1; }
}

@@media (max-width: 576px) {
    .ba-header { padding: 0.75rem 1rem; }
    .gateway-card .card-body { padding: 1rem; }
    .bank-icon { width: 32px; height: 32px; font-size: 0.9rem; }
}
</style>
