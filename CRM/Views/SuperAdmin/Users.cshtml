@using CRM.MasterDb.Models
@using CRM.Models
@model List<UserModel>
@{
    ViewData["Title"] = "User Management";
    var tenants = ViewBag.Tenants as List<TenantModel> ?? new List<TenantModel>();
    var currentTenant = ViewBag.CurrentTenant as TenantModel;
}

<style>
    .users-container { max-width: 100%; padding: 0 0.5rem; }
    /* Page header banner (consistent with other SA pages) */
    .users-hdr {
        background: linear-gradient(135deg, #1A6FA8 0%, #D4A45A 100%);
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #FFFFFF;
    }
    .users-hdr-icon {
        width: 32px; height: 32px;
        background: rgba(255,255,255,0.18);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; flex-shrink: 0;
    }
    .users-hdr h1 { font-size: 1rem !important; font-weight: 700 !important; color: #FFFFFF !important; margin: 0 !important; line-height: 1.2 !important; }
    .users-hdr p { font-size: 0.74rem !important; color: rgba(255,255,255,0.82) !important; margin: 0 !important; }
    .users-card { border-radius: 12px; border: 1px solid var(--border-color); background: var(--card-bg); overflow: hidden; }
    .users-card-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border-color);
        display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 0.75rem;
    }
    .users-card-header h5 { margin: 0; font-weight: 700; color: var(--text-primary); }
    .users-card-body { padding: 1rem 1.25rem; }
    .tenant-selector { min-width: 240px; max-width: 60%; flex: 0 1 auto; width: auto; }
    .user-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .user-table th {
        padding: 0.65rem 0.75rem; text-align: left; font-weight: 600;
        background: var(--body-bg); color: var(--text-primary);
        border-bottom: 2px solid var(--border-color); white-space: nowrap;
    }
    .user-table td { padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--border-color); vertical-align: middle; }
    .user-table tbody tr:hover { background: rgba(26,111,168,0.04); }
    .role-badge {
        display: inline-block; padding: 0.2rem 0.6rem; border-radius: 4px;
        font-size: 0.78rem; font-weight: 600;
    }
    .role-admin { background: #E8EDF2; color: #1A6FA8; }
    .role-agent { background: #DCFCE7; color: #2A3A4A; }
    .role-sales { background: #FEE2E2; color: #B45309; }
    .role-partner { background: #FEE2E2; color: #991B1B; }
    .status-badge {
        display: inline-block; padding: 0.2rem 0.55rem; border-radius: 4px;
        font-size: 0.75rem; font-weight: 600;
    }
    .status-active { background: #DCFCE7; color: #15803D; }
    .status-inactive { background: #FEE2E2; color: #991B1B; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: var(--text-muted); }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; opacity: 0.4; }
    .password-note { font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem; }
    .action-btn { padding: 0.25rem 0.5rem; font-size: 0.8rem; border-radius: 4px; }
    html.dark-mode .role-admin { background: rgba(232,237,242,0.12); color: #8FA3B8; }
    html.dark-mode .role-agent { background: rgba(220,252,231,0.12); color: #8FA3B8; }
    html.dark-mode .role-sales { background: rgba(254,226,226,0.12); color: #E8C27E; }
    html.dark-mode .role-partner { background: rgba(254,226,226,0.12); color: #E8C27E; }

    @@media (max-width: 767px) {
        .users-card-header { flex-direction: column; align-items: stretch !important; gap: 8px; }
        .users-card-header .d-flex { width: 100%; }
        .users-card-body { padding: 0.75rem; }
        .user-table { font-size: 0.8rem; }
        .user-table th, .user-table td { padding: 0.45rem 0.5rem; }
    }
</style>

<div class="users-container">
    <div class="page-hd"><i class="fa-solid fa-users"></i><h4>User Management</h4></div>
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" style="margin-bottom:10px;">
        <ol class="breadcrumb mb-0" style="font-size:.76rem;background:transparent;padding:0;">
            <li class="breadcrumb-item"><a href="/SuperAdmin/Dashboard" style="color:var(--blue);">Dashboard</a></li>
            <li class="breadcrumb-item active" style="color:var(--text-muted)">Users</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="users-hdr">
        <div class="users-hdr-icon"><i class="fa-solid fa-users"></i></div>
        <div>
            <h1>User Management</h1>
            <p>Manage team members across all tenant organizations</p>
        </div>
    </div>

    <div class="users-card">
        <div class="users-card-header">
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <select id="tenantSelect" class="form-select tenant-selector form-select-sm" onchange="loadTenantUsers()">
                    <option value="">-- Select a Tenant --</option>
                    @foreach (var t in tenants)
                    {
                        <option value="@t.TenantId" selected="@(currentTenant?.TenantId == t.TenantId ? true : null)">
                            @t.CompanyName (@t.Subdomain)
                        </option>
                    }
                </select>
                <button type="button" class="btn btn-primary btn-sm" onclick="showCreateUserModal()" id="addUserBtn" @(currentTenant == null ? "disabled" : null)">
                    <i class="fa-solid fa-plus me-1"></i>Add User
                </button>
            </div>
        </div>
        <div class="users-card-body">
            <div id="usersTableContainer">
                @if (currentTenant != null && Model.Any())
                {
                    <div class="mb-2">
                        <strong>@currentTenant.CompanyName</strong>
                        <span class="text-muted ms-2">- @Model.Count user(s)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="user-table">
                            <thead>
                                <tr>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model)
                                {
                                    <tr>
                                        <td><strong>@u.Username</strong></td>
                                        <td>@u.Email</td>
                                        <td>@u.Phone</td>
                                        <td><span class="role-badge role-@u.Role?.ToLower()">@u.Role</span></td>
                                        <td><span class="status-badge status-@(u.IsActive ? "active" : "inactive")">@(u.IsActive ? "Active" : "Inactive")</span></td>
                                        <td style="font-size:0.8rem;color:var(--text-muted);">@u.CreatedDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-outline-primary action-btn" onclick="editUser(@u.UserId, '@u.Username', '@u.Email', '@u.Phone', '@u.Role', @(u.IsActive ? "true" : "false"))" title="Edit">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <button class="btn btn-outline-danger action-btn" onclick="deleteUser(@u.UserId, '@u.Username')" title="Deactivate">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-users-slash"></i>
                        <h6>Select a tenant to view users</h6>
                        <p class="mb-0">Choose a company from the dropdown above to manage its team members.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-user-plus me-2" style="color:var(--blue);"></i>Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createUserForm">
                    <input type="hidden" id="cu_tenantId" value="@(currentTenant?.TenantId ?? 0)" />
                    <div class="mb-3">
                        <label class="form-label">Tenant</label>
                        <input type="text" class="form-control" id="cu_tenantName" value="@(currentTenant?.CompanyName ?? "")" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Username <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="cu_username" required placeholder="e.g. john_doe" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="cu_email" required placeholder="user@company.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" class="form-control" id="cu_phone" placeholder="+91-9876543210" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role <span class="text-danger">*</span></label>
                        <select class="form-select" id="cu_role">
                            <option value="Admin">Admin</option>
                            <option value="Sales">Sales</option>
                            <option value="Agent" selected>Agent</option>
                            <option value="Partner">Partner</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="text" class="form-control" id="cu_password" placeholder="Leave blank for default: Test@123" />
                        <div class="password-note">Default password: <strong>Test@123</strong></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createUser(event)"><i class="fa-solid fa-check me-1"></i>Create User</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-user-pen me-2" style="color:var(--blue);"></i>Edit User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm">
                    <input type="hidden" id="eu_userId" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input type="text" class="form-control" id="eu_username" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="eu_email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" class="form-control" id="eu_phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select class="form-select" id="eu_role">
                            <option value="Admin">Admin</option>
                            <option value="Sales">Sales</option>
                            <option value="Agent">Agent</option>
                            <option value="Partner">Partner</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="eu_isActive">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Password (leave blank to keep current)</label>
                        <input type="text" class="form-control" id="eu_password" placeholder="Enter new password" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateUser(event)"><i class="fa-solid fa-save me-1"></i>Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enable Add User button on page load if tenant is pre-selected
        document.addEventListener('DOMContentLoaded', function() {
            var sel = document.getElementById('tenantSelect');
            var btn = document.getElementById('addUserBtn');
            if (sel && sel.value) {
                btn.disabled = false;
            }
        });

        // Load users when tenant is selected
        function loadTenantUsers() {
            var tenantId = document.getElementById('tenantSelect').value;
            if (!tenantId) {
                document.getElementById('usersTableContainer').innerHTML = `
                    <div class="empty-state">
                        <i class="fa-solid fa-users-slash"></i>
                        <h6>Select a tenant to view users</h6>
                        <p class="mb-0">Choose a company from the dropdown above to manage its team members.</p>
                    </div>`;
                document.getElementById('addUserBtn').disabled = true;
                return;
            }
            document.getElementById('addUserBtn').disabled = false;
            window.location.href = '/SuperAdmin/Users?tenantId=' + tenantId;
        }

        // Show create user modal
        function showCreateUserModal() {
            var tenantId = document.getElementById('tenantSelect').value;
            if (!tenantId) { alert('Please select a tenant first'); return; }
            document.getElementById('cu_tenantId').value = tenantId;
            var tenantName = document.getElementById('tenantSelect').options[document.getElementById('tenantSelect').selectedIndex].text;
            document.getElementById('cu_tenantName').value = tenantName;
            document.getElementById('cu_username').value = '';
            document.getElementById('cu_email').value = '';
            document.getElementById('cu_phone').value = '';
            document.getElementById('cu_role').value = 'Agent';
            document.getElementById('cu_password').value = '';
            var modal = new bootstrap.Modal(document.getElementById('createUserModal'));
            modal.show();
        }

        // Create user
        function createUser(evt) {
            var tenantId = document.getElementById('cu_tenantId').value;
            var username = document.getElementById('cu_username').value.trim();
            var email = document.getElementById('cu_email').value.trim();
            var phone = document.getElementById('cu_phone').value.trim();
            var role = document.getElementById('cu_role').value;
            var password = document.getElementById('cu_password').value.trim();

            if (!username) { alert('Username is required'); return; }
            if (!email) { alert('Email is required'); return; }

            var btn = evt.target;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Creating...';

            fetch('/SuperAdmin/CreateTenantUser', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: 'tenantId=' + encodeURIComponent(tenantId) +
                      '&username=' + encodeURIComponent(username) +
                      '&email=' + encodeURIComponent(email) +
                      '&phone=' + encodeURIComponent(phone) +
                      '&role=' + encodeURIComponent(role) +
                      '&password=' + encodeURIComponent(password)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    var modal = bootstrap.Modal.getInstance(document.getElementById('createUserModal'));
                    modal.hide();
                    loadTenantUsers();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => alert('Error: ' + err.message))
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Create User';
            });
        }

        // Edit user - populate modal
        function editUser(id, username, email, phone, role, isActive) {
            document.getElementById('eu_userId').value = id;
            document.getElementById('eu_username').value = username;
            document.getElementById('eu_email').value = email;
            document.getElementById('eu_phone').value = phone;
            document.getElementById('eu_role').value = role;
            document.getElementById('eu_isActive').value = isActive ? 'true' : 'false';
            document.getElementById('eu_password').value = '';
            var modal = new bootstrap.Modal(document.getElementById('editUserModal'));
            modal.show();
        }

        // Update user
        function updateUser(evt) {
            var userId = document.getElementById('eu_userId').value;
            var username = document.getElementById('eu_username').value.trim();
            var email = document.getElementById('eu_email').value.trim();
            var phone = document.getElementById('eu_phone').value.trim();
            var role = document.getElementById('eu_role').value;
            var isActive = document.getElementById('eu_isActive').value === 'true';
            var password = document.getElementById('eu_password').value.trim();

            if (!username || !email) { alert('Username and Email are required'); return; }

            var btn = evt.target;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Saving...';

            fetch('/SuperAdmin/UpdateTenantUser', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: 'userId=' + encodeURIComponent(userId) +
                      '&username=' + encodeURIComponent(username) +
                      '&email=' + encodeURIComponent(email) +
                      '&phone=' + encodeURIComponent(phone) +
                      '&role=' + encodeURIComponent(role) +
                      '&isActive=' + isActive +
                      '&password=' + encodeURIComponent(password)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    var modal = bootstrap.Modal.getInstance(document.getElementById('editUserModal'));
                    modal.hide();
                    loadTenantUsers();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => alert('Error: ' + err.message))
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-save me-1"></i>Save Changes';
            });
        }

        // Delete user
        function deleteUser(userId, username) {
            if (!confirm('Are you sure you want to deactivate user "' + username + '"?')) return;

            fetch('/SuperAdmin/DeleteTenantUser', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: 'userId=' + encodeURIComponent(userId)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    loadTenantUsers();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => alert('Error: ' + err.message));
        }
    </script>
}
