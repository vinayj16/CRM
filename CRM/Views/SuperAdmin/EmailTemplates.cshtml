@model List<CRM.Models.EmailTemplateModel>
@{
    ViewData["Title"] = "Email Templates - Super Admin";
}
<style>
    .et-container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .et-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .et-header h2 { margin: 0; font-size: 1.5rem; font-weight: 600; color: var(--text-primary); }
    .et-grid { display: grid; gap: 16px; }
    .et-card { border: 1px solid var(--border-color); border-radius: 10px; padding: 16px; background: var(--card-bg); }
    .et-card h4 { margin: 0 0 4px 0; font-size: 1rem; color: var(--text-primary); }
    .et-card .subject { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 8px; }
    .et-card .preview { font-size: 0.8rem; color: var(--text-muted); max-height: 60px; overflow: hidden; }
    .et-card .actions { display: flex; gap: 8px; margin-top: 10px; }
    .et-badge { font-size: 0.7rem; padding: 2px 8px; border-radius: 4px; font-weight: 600; }
    .et-badge-active { background: var(--blue-light); color: var(--blue-dark); }
    .et-badge-inactive { background: #FEE2E2; color: #DC2626; }
    html.dark-mode .et-badge-active { background: rgba(26,111,168,0.25); color: #8FA3B8; }
    html.dark-mode .et-badge-inactive { background: rgba(220,38,38,0.2); color: #E8C27E; }
    .et-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); z-index: 1000; }
    .et-modal.open { display: flex; align-items: center; justify-content: center; }
    .et-modal-content { background: var(--card-bg); border-radius: 12px; padding: 24px; max-width: 700px; width: 90%; max-height: 85vh; overflow-y: auto; }
    .et-modal-content h3 { margin: 0 0 16px 0; }
    .et-form-group { margin-bottom: 14px; }
    .et-form-group label { display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--text-primary); }
    .et-form-group input, .et-form-group textarea, .et-form-group select { width: 100%; padding: 8px 10px; border: 1px solid var(--border-color); border-radius: 6px; background: var(--body-bg); color: var(--text-primary); font-size: 0.9rem; }
    .et-form-group input:focus, .et-form-group select:focus, .et-form-group textarea:focus {
        border-color: var(--blue); outline: none; box-shadow: 0 0 0 3px rgba(26,111,168,0.12);
    }
    .et-form-group textarea { min-height: 200px; font-family: monospace; }
    .et-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .et-btn { padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 500; transition: all 0.2s; }
    .et-btn-primary { background: linear-gradient(135deg, var(--blue), var(--blue-light)); color: #FFFFFF; }
    .et-btn-primary:hover { background: linear-gradient(135deg, var(--blue-dark), var(--blue)); }
    .et-btn-secondary { background: var(--border-color); color: var(--text-primary); }
    .et-btn-secondary:hover { background: #B8C8D8; }
    html.dark-mode .et-btn-secondary { background: #2A3A4A; color: #E2E8F0; }
    html.dark-mode .et-btn-secondary:hover { background: #2A3A4A; }
    .et-btn-danger { background: #DC2626; color: #FFFFFF; }
    .et-btn-danger:hover { background: #991B1B; }
    .et-btn-sm { padding: 4px 10px; font-size: 0.8rem; }

    @@media (max-width: 767px) {
        .et-container { padding: 12px; }
        .et-form-row { grid-template-columns: 1fr; }
        .et-card { padding: 12px; }
    }
</style>

<div class="et-container">
    <nav class="mb-3" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/SuperAdmin/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active">Email Templates</li>
        </ol>
    </nav>

    <div class="et-header">
        <h2><i class="fa-solid fa-envelope-open-text" style="color:var(--blue);"></i> Email Templates</h2>
        <button class="et-btn et-btn-primary" onclick="openModal(null)">+ Create Template</button>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:60px 20px;color:var(--text-muted);">
            <i class="fa-solid fa-envelope" style="font-size:48px;margin-bottom:16px;opacity:0.3;color:var(--gold);"></i>
            <p>No email templates yet. Create your first template to start sending branded emails.</p>
        </div>
    }
    else
    {
        <div class="et-grid">
            @foreach (var t in Model)
            {
                var tJson = System.Text.Json.JsonSerializer.Serialize(t, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
                var tJsonAttr = tJson.Replace("'", "&#39;");
                <div class="et-card" data-template-id="@t.TemplateId" data-template='@Html.Raw(tJsonAttr)'>
                    <div style="display:flex;justify-content:space-between;align-items:start;">
                        <div>
                            <h4>@t.TemplateName</h4>
                            <div class="subject">Subject: @t.Subject</div>
                        </div>
                        <span class="et-badge @(t.IsActive ? "et-badge-active" : "et-badge-inactive")">
                            @(t.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(t.Variables))
                    {
                        <div style="font-size:0.75rem;color:var(--text-muted);margin-top:6px;">
                            Variables: @t.Variables
                        </div>
                    }
                    <div class="actions">
                        <button class="et-btn et-btn-sm et-btn-primary" onclick="openModal(@t.TemplateId)">Edit</button>
                        <button class="et-btn et-btn-sm et-btn-secondary" onclick="previewTemplate(@t.TemplateId)">Preview</button>
                        <button class="et-btn et-btn-sm et-btn-danger" onclick="deleteTemplate(@t.TemplateId)">Delete</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="et-modal" id="templateModal">
    <div class="et-modal-content">
        <h3 id="modalTitle">Create Template</h3>
        <form id="templateForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="templateId" name="templateId" value="0" />
            <div class="et-form-group">
                <label>Template Name *</label>
                <input type="text" id="templateName" name="templateName" required maxlength="100" />
            </div>
            <div class="et-form-group">
                <label>Subject *</label>
                <input type="text" id="subject" name="subject" required maxlength="200" />
            </div>
            <div class="et-form-group">
                <label>Body HTML *</label>
                <textarea id="bodyHtml" name="bodyHtml" required></textarea>
                <div style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;">
                    Use variables like {Name}, {Email}, {Link}, {CompanyName} in the body. These get replaced dynamically.
                </div>
            </div>
            <div class="et-form-row">
                <div class="et-form-group">
                    <label>Variables (comma-separated)</label>
                    <input type="text" id="variables" name="variables" placeholder="e.g. {Name}, {Link}, {CompanyName}" />
                </div>
                <div class="et-form-group">
                    <label>Status</label>
                    <select id="isActive" name="isActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>
            <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
                <button type="button" class="et-btn et-btn-secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="et-btn et-btn-primary">Save Template</button>
            </div>
        </form>
    </div>
</div>

<script>
function openModal(id) {
        document.getElementById('templateModal').classList.add('open');
        if (id) {
            var card = document.querySelector('[data-template-id="' + id + '"]');
            if (card && card.dataset.template) {
                try {
                    var t = JSON.parse(card.dataset.template.replace(/&#39;/g, "'"));
                    document.getElementById('modalTitle').textContent = 'Edit Template';
                    document.getElementById('templateId').value = t.templateId || t.TemplateId;
                    document.getElementById('templateName').value = t.templateName || t.TemplateName;
                    document.getElementById('subject').value = t.subject || t.Subject;
                    document.getElementById('bodyHtml').value = t.bodyHtml || t.BodyHtml || '';
                    document.getElementById('variables').value = t.variables || t.Variables || '';
                    document.getElementById('isActive').value = (t.isActive !== undefined ? t.isActive : (t.IsActive || false)) ? 'true' : 'false';
                } catch (e) {
                    console.error('Error parsing template data:', e);
                    showToast('Failed to load template data', 'error');
                }
            }
        } else {
            document.getElementById('modalTitle').textContent = 'Create Template';
            document.getElementById('templateForm').reset();
            document.getElementById('templateId').value = '0';
        }
    }

    function previewTemplate(id) {
        var card = document.querySelector('[data-template-id="' + id + '"]');
        if (card && card.dataset.template) {
            try {
                var t = JSON.parse(card.dataset.template.replace(/&#39;/g, "'"));
                var preview = (t.bodyHtml || '').replace(/\{(\w+)\}/g, '[$1]');
                var w = window.open('', '_blank', 'width=700,height=500');
                w.document.write('<html><head><title>Preview: ' + (t.templateName || '') + '</title></head><body>' + preview + '</body></html>');
                w.document.close();
            } catch (e) {
                console.error('Error parsing template data:', e);
                showToast('Failed to load template data', 'error');
            }
        }
    }

    function closeModal() {
        document.getElementById('templateModal').classList.remove('open');
    }

    document.getElementById('templateForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        var id = document.getElementById('templateId').value;
        var data = {
            templateId: parseInt(id) || 0,
            templateName: document.getElementById('templateName').value,
            subject: document.getElementById('subject').value,
            bodyHtml: document.getElementById('bodyHtml').value,
            variables: document.getElementById('variables').value,
            isActive: document.getElementById('isActive').value === 'true'
        };
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        var headers = { 'Content-Type': 'application/json' };
        if (token) headers['RequestVerificationToken'] = token.value;
        var url = id > 0 ? '/superadmin/updatetemplate' : '/superadmin/createtemplate';
        try {
            var resp = await fetch(url, { method: 'POST', headers: headers, body: JSON.stringify(data) });
            var result = await resp.json();
            if (result.success) {
                if (typeof Swal !== 'undefined') {
                    await Swal.fire({ icon: 'success', title: 'Saved', text: 'Template saved successfully', timer: 1500, showConfirmButton: false });
                }
                location.reload();
            } else {
                if (typeof Swal !== 'undefined') {
                    await Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Operation failed' });
                } else { showToast(result.message || 'Operation failed', 'error'); }
            }
        } catch (err) {
            showToast('Failed to save template', 'error');
        }
    });

    async function deleteTemplate(id) {
        var confirmed = false;
        if (typeof Swal !== 'undefined') {
            var result = await Swal.fire({
                title: 'Delete Template?',
                text: 'Are you sure you want to delete this template?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#DC2626',
                confirmButtonText: 'Yes, delete',
                cancelButtonText: 'Cancel'
            });
            if (!result.isConfirmed) return;
        } else {
            if (!confirm('Delete this template?')) return;
        }
        try {
            var resp = await fetch('/superadmin/deletetemplate', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'templateId=' + id });
            var result = await resp.json();
            if (result.success) {
                if (typeof Swal !== 'undefined') {
                    await Swal.fire({ icon: 'success', title: 'Deleted', text: 'Template deleted', timer: 1500, showConfirmButton: false });
                }
                location.reload();
            } else {
                if (typeof Swal !== 'undefined') {
                    await Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Operation failed' });
                } else { showToast(result.message || 'Operation failed', 'error'); }
            }
        } catch (err) {
            showToast('Failed to delete template', 'error');
        }
    }


</script>
