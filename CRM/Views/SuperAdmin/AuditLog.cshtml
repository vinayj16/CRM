@model List<CRM.Models.AuditLogModel>
@{
    ViewData["Title"] = "Audit Log";
}

<style>
    .al-container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .al-header { margin-bottom: 20px; }
    .al-header h2 { margin: 0; font-size: 1.5rem; font-weight: 600; color: var(--text-primary); }
    .al-stats { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
    .al-stat-card { flex: 1; min-width: 120px; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 10px; padding: 6px 10px; display: flex; align-items: center; gap: 8px; transition: transform .18s; }
    .al-stat-card:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(26,111,168,0.10); }
    .al-stat-icon { width: 26px; height: 26px; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 12px; color: #FFFFFF; }
    .al-stat-icon.blue { background: linear-gradient(135deg, #1A6FA8, #2589C9); }
    .al-stat-icon.green { background: linear-gradient(135deg, #16A34A, #2589C9); }
    .al-stat-icon.purple { background: linear-gradient(135deg, #6B7B8D, #B8C8D8); }
    .al-stat-icon.amber { background: linear-gradient(135deg, #F59E0B, #F59E0B); }
    .al-stat-icon.red { background: linear-gradient(135deg, #DC2626, #D4A45A); }
    .al-stat-num { font-size: 1.05rem; font-weight: 700; color: var(--text-primary); line-height: 1.1; }
    .al-stat-lbl { font-size: 0.62rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.4px; }
    html.dark-mode .al-stat-card:hover { box-shadow: 0 4px 14px rgba(26,111,168,0.20); }

    .al-filter-bar { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 9px; padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
    .al-filter-bar .form-label { font-size: 0.68rem; font-weight: 700; color: var(--blue); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px; display: block; }
    .al-filter-bar .form-select, .al-filter-bar .form-control { font-size: 0.8rem; padding: 0.27rem 0.6rem; border: 1.5px solid var(--border-color); border-radius: 6px; color: var(--text-primary); background-color: var(--body-bg); height: 30px; outline: none; min-width: 140px; }
    .al-filter-bar .form-select:focus, .al-filter-bar .form-control:focus { border-color: var(--blue); box-shadow: 0 0 0 2px rgba(26,111,168,0.1); }
    .al-btn { height: 30px; padding: 0 0.85rem; border-radius: 6px; font-size: 0.78rem; font-weight: 600; border: none; cursor: pointer; background: var(--blue); color: #FFFFFF; display: inline-flex; align-items: center; gap: 5px; transition: opacity .18s; text-decoration: none; }
    .al-btn:hover { opacity: 0.88; color: #FFFFFF; text-decoration: none; }
    .al-btn-clear { height: 30px; padding: 0 0.8rem; border-radius: 6px; font-size: 0.78rem; font-weight: 500; border: 1.5px solid var(--gold); cursor: pointer; background: var(--card-bg); color: var(--gold-dark); display: inline-flex; align-items: center; gap: 5px; text-decoration: none; transition: all .18s; }
    .al-btn-clear:hover { background: var(--body-bg); color: var(--gold-dark); text-decoration: none; }

    .al-card { background: var(--card-bg); border-radius: 10px; border: 1px solid var(--border-color); box-shadow: 0 2px 10px rgba(26,111,168,0.07); overflow: hidden; }
    .al-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .al-table thead tr { background: var(--body-bg); border-bottom: 2px solid var(--gold); }
    .al-table thead th { padding: 0.5rem 0.8rem; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.55px; color: var(--blue); white-space: nowrap; }
    .al-table tbody tr { border-bottom: 1px solid var(--border-color); transition: background .12s; }
    .al-table tbody tr:last-child { border-bottom: none; }
    .al-table tbody tr:hover { background: var(--body-bg); }
    .al-table td { padding: 0.4rem 0.8rem; vertical-align: middle; }
    .al-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 20px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.3px; }
    .al-badge-login { background: rgba(26,111,168,0.12); color: #1A6FA8; }
    .al-badge-create { background: rgba(22,163,74,0.12); color: #15803D; }
    .al-badge-update { background: rgba(212,164,90,0.12); color: #B45309; }
    .al-badge-delete { background: rgba(220,38,38,0.12); color: #DC2626; }
    .al-badge-view { background: rgba(107,123,141,0.12); color: #6B7B8D; }
    html.dark-mode .al-badge-login { background: rgba(26,111,168,0.25); color: #8FA3B8; }
    html.dark-mode .al-badge-create { background: rgba(22,163,74,0.18); color: #8FA3B8; }
    html.dark-mode .al-badge-update { background: rgba(212,164,90,0.18); color: #E8C27E; }
    html.dark-mode .al-badge-delete { background: rgba(220,38,38,0.20); color: #E8C27E; }
    html.dark-mode .al-badge-view { background: rgba(107,123,141,0.20); color: #8FA3B8; }

    .al-empty { text-align: center; padding: 60px 20px; color: var(--text-muted); }
    .al-empty i { font-size: 48px; margin-bottom: 16px; color: var(--gold); opacity: 0.3; }

    /* Pagination */
    .al-pagination { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-top: 1px solid var(--border-color); flex-wrap: wrap; gap: 8px; }
    .al-page-info { font-size: 0.8rem; color: var(--text-muted); }
    .al-page-links { display: flex; gap: 4px; }
    .al-page-link { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; height: 32px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-primary); text-decoration: none; transition: all .15s; }
    .al-page-link:hover { background: var(--body-bg); border-color: var(--blue); color: var(--blue); text-decoration: none; }
    .al-page-link.active { background: var(--blue); border-color: var(--blue); color: #FFFFFF; }
    html.dark-mode .al-page-link { border-color: var(--border-color); }
    html.dark-mode .al-page-link.active { background: var(--blue); border-color: var(--blue); color: #FFFFFF; }

    .al-user { font-weight: 600; font-size: 0.8rem; color: var(--text-primary); }
    .al-entity { font-size: 0.72rem; color: var(--text-muted); }
    .al-ts { font-size: 0.72rem; color: var(--text-muted); white-space: nowrap; }
    .al-ip { font-size: 0.7rem; color: var(--text-muted); font-family: monospace; }
    .al-row-clickable { cursor: pointer; }
    .al-row-clickable:hover td:first-child { border-left: 3px solid var(--blue); }

    /* Detail Modal */
    .al-detail-modal { display: none; position: fixed; z-index: 9999; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; }
    .al-detail-modal.open { display: flex; }
    .al-detail-content { background: var(--card-bg); border-radius: 12px; max-width: 600px; width: 90%; max-height: 80vh; overflow-y: auto; padding: 24px; box-shadow: 0 16px 48px rgba(0,0,0,0.2); border: 1px solid var(--border-color); }
    .al-detail-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color); }
    .al-detail-header h3 { margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--text-primary); }
    .al-detail-close { width: 32px; height: 32px; border-radius: 8px; border: none; background: var(--body-bg); color: var(--text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 16px; transition: all .15s; }
    .al-detail-close:hover { background: var(--border-color); color: var(--text-primary); }
    .al-detail-grid { display: grid; grid-template-columns: 110px 1fr; gap: 8px 12px; font-size: 0.82rem; }
    .al-detail-label { color: var(--text-muted); font-weight: 600; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.4px; padding-top: 2px; }
    .al-detail-value { color: var(--text-primary); word-break: break-word; }
    .al-detail-divider { grid-column: 1 / -1; height: 1px; background: var(--border-color); margin: 4px 0; }
    .al-detail-json { background: var(--body-bg); border-radius: 6px; padding: 10px 14px; font-family: monospace; font-size: 0.78rem; color: var(--text-primary); white-space: pre-wrap; word-break: break-word; max-height: 200px; overflow-y: auto; border: 1px solid var(--border-color); margin: 0; }
    html.dark-mode .al-detail-content { border-color: var(--border-color); }

    @@media (max-width: 767px) {
        .al-container { padding: 12px; }
        .al-stats { gap: 8px; }
        .al-stat-card { min-width: calc(50% - 4px); padding: 6px 10px; gap: 8px; }
        .al-filter-bar { padding: 10px 12px; gap: 8px; }
        .al-filter-bar form { gap: 8px; }
        .al-table { font-size: 0.75rem; }
        .al-table thead th { padding: 0.4rem 0.5rem; }
        .al-table td { padding: 0.35rem 0.5rem; }
    }
    @@media (max-width: 480px) {
        .al-stats { display: grid; grid-template-columns: repeat(2, 1fr); }
        .al-stat-card { min-width: 0; }
        .al-stat-card:last-child { grid-column: span 2; }
        .al-filter-bar .form-select, .al-filter-bar .form-control { min-width: 100%; }
        .al-filter-bar .form-label { font-size: 0.62rem; }
    }
</style>

<div class="al-container">
    <nav class="mb-3" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/SuperAdmin/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active">Audit Log</li>
        </ol>
    </nav>

    <div class="al-header">
        <h2><i class="fa-solid fa-clipboard-list" style="color:var(--blue);"></i> Audit Log</h2>
        <p style="color:var(--text-muted);font-size:0.85rem;">Track all user actions across the system</p>
    </div>

    <!-- Stats Cards -->
    <div class="al-stats">
        <div class="al-stat-card">
            <div class="al-stat-icon blue"><i class="fa-solid fa-list"></i></div>
            <div>
                <div class="al-stat-num">@ViewBag.TotalCount</div>
                <div class="al-stat-lbl">Total Actions</div>
            </div>
        </div>
        <div class="al-stat-card">
            <div class="al-stat-icon green"><i class="fa-solid fa-right-to-bracket"></i></div>
            <div>
                <div class="al-stat-num">@ViewBag.TotalLogins</div>
                <div class="al-stat-lbl">Logins</div>
            </div>
        </div>
        <div class="al-stat-card">
            <div class="al-stat-icon purple"><i class="fa-solid fa-plus"></i></div>
            <div>
                <div class="al-stat-num">@ViewBag.TotalCreations</div>
                <div class="al-stat-lbl">Creations</div>
            </div>
        </div>
        <div class="al-stat-card">
            <div class="al-stat-icon amber"><i class="fa-solid fa-pen"></i></div>
            <div>
                <div class="al-stat-num">@ViewBag.TotalUpdates</div>
                <div class="al-stat-lbl">Updates</div>
            </div>
        </div>
        <div class="al-stat-card">
            <div class="al-stat-icon red"><i class="fa-solid fa-trash"></i></div>
            <div>
                <div class="al-stat-num">@ViewBag.TotalDeletions</div>
                <div class="al-stat-lbl">Deletions</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="al-filter-bar">
        <form method="get" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;width:100%">
            <div>
                <label class="form-label">Action</label>
                <select name="actionFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Actions</option>
                    @foreach (var act in (ViewBag.AllActions as IEnumerable<string>) ?? new List<string>())
                    {
                        <option value="@act" selected="@(ViewBag.ActionFilter == act)">@act</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Entity Type</label>
                <select name="entityType" class="form-select" onchange="this.form.submit()">
                    <option value="">All Entities</option>
                    @foreach (var entity in (ViewBag.AllEntityTypes as IEnumerable<string>) ?? new List<string>())
                    {
                        <option value="@entity" selected="@(ViewBag.EntityType == entity)">@entity</option>
                    }
                </select>
            </div>
            <a href="/SuperAdmin/AuditLog" class="al-btn-clear"><i class="fa-solid fa-xmark"></i> Clear</a>
        </form>
    </div>

    <!-- Audit Log Table -->
    <div class="al-card">
        @if (!Model.Any())
        {
            <div class="al-empty">
                <i class="fa-solid fa-clipboard-list"></i>
                <p>No audit log entries found. Actions are recorded when users log in, create, update, or delete records.</p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="al-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Entity ID</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 0;
                        }
                        @foreach (var log in Model)
                        {
                            var badgeClass = log.Action switch
                            {
                                "Login" => "al-badge-login",
                                "Create" => "al-badge-create",
                                "Update" => "al-badge-update",
                                "Delete" => "al-badge-delete",
                                _ => "al-badge-view"
                            };

                            <tr class="al-row-clickable" onclick="showDetail(@index)" title="Click for details">
                                <td>
                                    <div class="al-ts">@log.Timestamp.ToString("MMM dd, HH:mm")</div>
                                </td>
                                <td>
                                    <div class="al-user">@(log.User?.Username ?? $"User #{log.UserId}")</div>
                                </td>
                                <td>
                                    <span class="al-badge @badgeClass">
                                        <i class="fa-solid fa-@(log.Action?.ToLower() == "login" ? "right-to-bracket" :
                                            log.Action?.ToLower() == "create" ? "plus" :
                                            log.Action?.ToLower() == "update" ? "pen" :
                                            log.Action?.ToLower() == "delete" ? "trash" : "eye")"></i>
                                        @log.Action
                                    </span>
                                </td>
                                <td>
                                    <div class="al-entity">@(log.EntityType ?? "-")</div>
                                </td>
                                <td>
                                    <div class="al-entity">@(log.EntityId?.ToString() ?? "-")</div>
                                </td>
                                <td>
                                    <div class="al-ip">@(log.IpAddress ?? "-")</div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="al-pagination">
                <div class="al-page-info">
                    Page @ViewBag.CurrentPage of @ViewBag.TotalPages
                    (@ViewBag.TotalCount total entries)
                </div>
                <div class="al-page-links">
                    @if ((int)ViewBag.CurrentPage > 1)
                    {
                        <a class="al-page-link" href="?page=@(ViewBag.CurrentPage - 1)&action=@ViewBag.Action&entityType=@ViewBag.EntityType">&laquo;</a>
                    }
                    @for (int p = Math.Max(1, (int)ViewBag.CurrentPage - 2); p <= Math.Min((int)ViewBag.TotalPages, (int)ViewBag.CurrentPage + 2); p++)
                    {
                        <a class="al-page-link @(p == (int)ViewBag.CurrentPage ? "active" : "")" href="?page=@p&action=@ViewBag.Action&entityType=@ViewBag.EntityType">@p</a>
                    }
                    @if ((int)ViewBag.CurrentPage < (int)ViewBag.TotalPages)
                    {
                        <a class="al-page-link" href="?page=@(ViewBag.CurrentPage + 1)&action=@ViewBag.Action&entityType=@ViewBag.EntityType">&raquo;</a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Detail Modal -->
<div class="al-detail-modal" id="alDetailModal" onclick="if(event.target==this)closeDetail()">
    <div class="al-detail-content">
        <div class="al-detail-header">
            <h3><i class="fa-solid fa-receipt" style="color:var(--blue);margin-right:8px;"></i>Audit Entry Details</h3>
            <button class="al-detail-close" onclick="closeDetail()">&times;</button>
        </div>
        <div class="al-detail-grid" id="alDetailGrid">
            <div class="al-detail-label">Timestamp</div>
            <div class="al-detail-value" id="alDetTimestamp">-</div>
            <div class="al-detail-label">User</div>
            <div class="al-detail-value" id="alDetUser">-</div>
            <div class="al-detail-label">User ID</div>
            <div class="al-detail-value" id="alDetUserId">-</div>
            <div class="al-detail-divider"></div>
            <div class="al-detail-label">Action</div>
            <div class="al-detail-value" id="alDetAction">-</div>
            <div class="al-detail-label">Entity Type</div>
            <div class="al-detail-value" id="alDetEntityType">-</div>
            <div class="al-detail-label">Entity ID</div>
            <div class="al-detail-value" id="alDetEntityId">-</div>
            <div class="al-detail-divider"></div>
            <div class="al-detail-label">IP Address</div>
            <div class="al-detail-value" id="alDetIp">-</div>
            <div class="al-detail-label">User Agent</div>
            <div class="al-detail-value" id="alDetAgent" style="font-size:0.72rem;color:var(--text-muted);word-break:break-all;">-</div>
            <div class="al-detail-divider"></div>
            <div class="al-detail-label" style="align-self:start;padding-top:4px;">Details</div>
            <div class="al-detail-value">
                <pre class="al-detail-json" id="alDetDesc">-</pre>
            </div>
        </div>
    </div>
</div>

<script>
    var auditData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
        ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles
    }));

    function showDetail(index) {
        var entry = auditData[index];
        if (!entry) return;

        document.getElementById('alDetTimestamp').textContent = entry.timestamp || '-';
        document.getElementById('alDetUser').textContent = entry.user ? entry.user.username : ('User #' + entry.userId);
        document.getElementById('alDetUserId').textContent = entry.userId != null ? entry.userId.toString() : '-';
        document.getElementById('alDetAction').textContent = entry.action || '-';
        document.getElementById('alDetEntityType').textContent = entry.entityType || '-';
        document.getElementById('alDetEntityId').textContent = entry.entityId != null ? entry.entityId.toString() : '-';
        document.getElementById('alDetIp').textContent = entry.ipAddress || '-';
        document.getElementById('alDetAgent').textContent = entry.userAgent || '-';

        // Parse NewValues JSON to extract description
        var descEl = document.getElementById('alDetDesc');
        if (entry.newValues) {
            try {
                var parsed = typeof entry.newValues === 'string' ? JSON.parse(entry.newValues) : entry.newValues;
                descEl.textContent = parsed.description || JSON.stringify(parsed, null, 2);
            } catch(e) {
                descEl.textContent = entry.newValues.toString();
            }
        } else if (entry.oldValues) {
            try {
                var parsed = typeof entry.oldValues === 'string' ? JSON.parse(entry.oldValues) : entry.oldValues;
                descEl.textContent = JSON.stringify(parsed, null, 2);
            } catch(e) {
                descEl.textContent = entry.oldValues.toString();
            }
        } else {
            descEl.textContent = 'No additional details';
        }

        document.getElementById('alDetailModal').classList.add('open');
    }

    function closeDetail() {
        document.getElementById('alDetailModal').classList.remove('open');
    }

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDetail();
    });
</script>
