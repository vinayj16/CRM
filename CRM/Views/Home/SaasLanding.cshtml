
@{
    ViewData["Title"] = "CRM Platform";
    Layout = "_LandingLayout";

    var copyrightText = Context.RequestServices.GetService<CRM.MasterDb.MasterDbContext>()?.SaasSetting.FirstOrDefault(s => s.SettingKey == "CopyrightText")?.SettingValue ?? "";
    var footerEmail = Context.RequestServices.GetService<CRM.MasterDb.MasterDbContext>()?.SaasSetting.FirstOrDefault(s => s.SettingKey == "CompanyEmail")?.SettingValue ?? "";
    var footerCompanyName = Context.RequestServices.GetService<CRM.MasterDb.MasterDbContext>()?.SaasSetting.FirstOrDefault(s => s.SettingKey == "CompanyName")?.SettingValue ?? "PropTech CRM";
    var footerMapUrl = Context.RequestServices.GetService<CRM.MasterDb.MasterDbContext>()?.SaasSetting.FirstOrDefault(s => s.SettingKey == "CompanyMapUrl")?.SettingValue;
    var footerPhone = Context.RequestServices.GetService<CRM.MasterDb.MasterDbContext>()?.SaasSetting.FirstOrDefault(s => s.SettingKey == "CompanyPhone")?.SettingValue ?? "";
    var footerAddress = Context.RequestServices.GetService<CRM.MasterDb.MasterDbContext>()?.SaasSetting.FirstOrDefault(s => s.SettingKey == "CompanyAddress")?.SettingValue ?? "";
}

<style>
    /* -- CSS Variables -- */
    :root {
        --saas-primary: #D4A45A;
        --saas-primary-hover: #B8883E;
        --saas-dark: #162436;
        --saas-muted-blue: #125082;
        --saas-gray: #6B7B8D;
        --lp-grad-mix: linear-gradient(90deg, #162436 0%, #125082 35%, #E8C27E 70%, #B8883E 100%);
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
        font-size: 90%;
        -webkit-text-size-adjust: 100%;
    }

    html, body {
        overflow-x: hidden !important;
        max-width: 100%;
    }

    body {
        padding-top: 60px !important;
    }

    /* -- NAVBAR -- */
    .saas-navbar {
        background: #FFFFFF;
        box-shadow: 0 2px 10px rgba(22,36,54, 0.08);
        padding: 3px 0;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        max-width: 100%;
        z-index: 1040;
        overflow-x: hidden;
    }

        .saas-navbar .container,
        .saas-navbar .container-fluid {
            padding-left: 12px;
            padding-right: 12px;
        }

        .saas-navbar .navbar-brand img {
            height: 40px;
            width: auto;
            object-fit: contain;
        }

        .saas-navbar .nav-link {
            color: #2A3A4A;
            font-weight: 600;
            padding: 7px 10px !important;
            transition: 0.25s;
            font-size: 0.94rem;
            white-space: nowrap;
            text-decoration: none;
        }

            .saas-navbar .nav-link:hover {
                color: var(--saas-primary-hover);
            }

        /* Hamburger button */
        .saas-navbar .mob-toggler {
            display: none;
            background: transparent;
            border: 2px solid var(--saas-primary);
            border-radius: 6px;
            padding: 5px 9px;
            cursor: pointer;
            flex-direction: column;
            gap: 4px;
            margin-left: 8px;
        }

            .saas-navbar .mob-toggler span {
                display: block;
                width: 20px;
                height: 2px;
                background: var(--saas-primary);
                border-radius: 2px;
                transition: 0.3s;
            }

    /* Mobile drawer */
    .mob-nav-drawer {
        display: none;
        position: fixed;
        top: 60px;
        left: 0;
        right: 0;
        background: #FFFFFF;
        border-top: 2px solid var(--saas-primary);
        box-shadow: 0 8px 24px rgba(22,36,54,0.13);
        padding: 14px 16px;
        z-index: 1039;
        animation: drawerIn 0.2s ease;
    }

        .mob-nav-drawer.open {
            display: block;
        }

        .mob-nav-drawer a {
            display: block;
            padding: 10px 12px;
            color: #2A3A4A;
            font-weight: 600;
            text-decoration: none;
            border-radius: 6px;
            font-size: 0.97rem;
            transition: 0.2s;
        }

            .mob-nav-drawer a:hover {
                background: rgba(212,164,90,0.1);
                color: var(--saas-primary-hover);
            }

        .mob-nav-drawer .btn-login {
            display: block;
            width: 100%;
            text-align: center;
            margin-top: 10px;
            border-radius: 6px;
        }

    @@keyframes drawerIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Login button */
    .btn-login {
        background: linear-gradient(135deg, #D4A45A 0%, #125082 100%);
        color: #FFFFFF;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 700;
        border: none;
        transition: 0.25s;
        box-shadow: 0 6px 18px rgba(22,36,54, 0.18);
        white-space: nowrap;
        text-decoration: none;
    }

        .btn-login:hover {
            background: linear-gradient(135deg, #B8883E 0%, #162436 100%);
            color: #FFFFFF;
            transform: translateY(-1px);
        }

    .btn-signup {
        background: linear-gradient(135deg, #D4A45A 0%, #125082 100%);
        color: #FFFFFF !important;
        padding: 8px 22px;
        border-radius: 6px;
        font-weight: 700;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: 0.25s;
        box-shadow: 0 6px 18px rgba(22,36,54, 0.18);
    }

        .btn-signup:hover {
            background: linear-gradient(135deg, #B8883E 0%, #162436 100%);
            color: #FFFFFF !important;
            transform: translateY(-1px);
        }

    /* -- TICKER -- */
    .lp-ticker {
        background: var(--saas-dark);
        border-bottom: 2px solid var(--saas-primary);
        overflow: hidden;
        height: 32px;
        display: flex;
        align-items: center;
    }

    .lp-ticker__track {
        display: flex;
        gap: 52px;
        white-space: nowrap;
        animation: ticker-scroll 28s linear infinite;
        will-change: transform;
    }

    .lp-ticker__item {
        font-size: 12px;
        font-weight: 600;
        color: #E8C27E;
        letter-spacing: 0.3px;
    }

    @@keyframes ticker-scroll {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    /* -- HERO -- */
    .saas-hero {
        background: linear-gradient(135deg, rgba(22,36,54,0.9) 0%, rgba(42,58,74,0.84) 50%, rgba(184,136,62,0.25) 100%), url('/superadmin/caurosal1.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: scroll;
        padding: 76px 0 68px;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .text-primary {
        color: #2589C9;
    }
    /* blue */
    .text-success {
        color: #16A34A;
    }
    /* green */
    .text-danger {
        color: #DC2626;
    }
    /* red */
    .text-warning {
        color: #F59E0B;
    }
    /* orange */
    .text-info {
        color: #2589C9;
    }
    /* cyan */
    .text-secondary {
        color: #6B7B8D;
    }
    /* gray */

        .saas-hero::before {
            content: '';
            position: absolute;
            top: -180px;
            right: -180px;
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(232,194,126,0.15) 0%, transparent 70%);
            border-radius: 50%;
        }

        .saas-hero h1 {
            font-size: 2.75rem;
            font-weight: 800;
            margin-bottom: 18px;
            line-height: 1.2;
            position: relative;
            z-index: 1;
        }

            .saas-hero h1 span {
                color: var(--saas-primary);
            }

        .saas-hero p {
            font-size: 1.08rem;
            opacity: 0.92;
            margin-bottom: 22px;
            max-width: 640px;
            position: relative;
            z-index: 1;
        }

    /* -- BUTTONS -- */
    .btn-saas {
        background: var(--saas-primary);
        color: white;
        padding: 10px 30px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1rem;
        border: none;
        transition: all 0.25s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-saas:hover {
            background: var(--saas-primary-hover);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(212,164,90,0.3);
        }

    .btn-saas-outline {
        border: 2px solid var(--saas-primary);
        color: var(--saas-primary);
        padding: 9px 28px;
        border-radius: 8px;
        font-weight: 700;
        background: transparent;
        transition: all 0.25s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-saas-outline:hover {
            background: var(--saas-primary);
            color: white;
        }

    /* -- STATS BAR -- */
    .stats-bar {
        background: #FFFFFF;
        border-radius: 12px;
        padding: 22px;
        margin-top: -34px;
        position: relative;
        z-index: 10;
        box-shadow: 0 8px 28px rgba(22,36,54,0.1);
    }

    .stat-item h3 {
        font-size: 2rem;
        font-weight: 800;
        color: var(--saas-primary-hover);
        margin-bottom: 2px;
    }

    .stat-item p {
        color: #6B7B8D;
        margin: 0;
        font-weight: 500;
    }

    /* -- SECTIONS -- */
    .features-section,
    .pricing-section,
    .lp-about,
    .cta-section {
        padding: 56px 0;
    }

    .pricing-section {
        margin-bottom: 40px;
    }

    .cta-section {
        margin-top: 20px;
    }

    .features-section {
        background: #F0F4F8;
    }

    .section-title {
        font-weight: 800;
        color: var(--saas-dark);
    }

    /* -- FEATURE CARDS -- */
    .feature-card {
        background: white;
        border-radius: 10px;
        padding: 26px 20px;
        text-align: center;
        border: 1px solid #E8EDF2;
        transition: all 0.25s;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 26px rgba(22,36,54,0.1);
            border-color: var(--saas-primary);
        }

        .feature-card i {
            font-size: 2.2rem;
            color: var(--saas-primary-hover);
            margin-bottom: 14px;
        }

        .feature-card h5 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .feature-card p {
            color: #6B7B8D;
            font-size: 0.94rem;
            margin: 0;
            flex: 1;
        }

    /* -- ABOUT -- */
    .lp-about {
        background: #FFFFFF;
    }

    .lp-about__img-wrap {
        position: relative;
        padding-right: 22px;
        padding-bottom: 22px;
    }

    .lp-about__img {
        border-radius: 12px;
        box-shadow: 0 14px 30px rgba(22,36,54,0.13);
        width: 100%;
        object-fit: cover;
        height: 410px;
    }

    .lp-about__badge {
        position: absolute;
        bottom: 0;
        right: 0;
        background: linear-gradient(135deg, var(--saas-dark) 0%, var(--saas-primary-hover) 100%);
        color: white;
        padding: 20px 28px;
        border-radius: 10px;
        box-shadow: 0 8px 22px rgba(22,36,54,0.25);
        text-align: center;
        z-index: 2;
    }

    .lp-about__badge-num {
        display: block;
        font-size: 2rem;
        font-weight: 800;
        color: var(--saas-primary);
        line-height: 1.1;
    }

    .lp-about__badge-txt {
        font-size: 0.86rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.9;
    }

    .lp-eyebrow {
        color: var(--saas-primary-hover);
        text-transform: uppercase;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 1.3px;
        display: inline-block;
    }

    .lp-about__title {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--saas-dark);
    }

    .lp-about__text {
        color: #6B7B8D;
        font-size: 1rem;
        line-height: 1.65;
        margin-bottom: 12px;
    }

    .lp-about__features {
        list-style: none;
    }

        .lp-about__features li {
            font-size: 1rem;
            font-weight: 600;
            color: var(--saas-dark);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }

            .lp-about__features li i {
                color: var(--saas-primary);
                font-size: 1.16rem;
            }

    /* -- PRICING -- */
    .billing-toggle {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 34px;
        font-weight: 600;
        flex-wrap: wrap;
        justify-content: center;
    }

        .billing-toggle .form-check-input {
            width: 48px;
            height: 24px;
            cursor: pointer;
        }

            .billing-toggle .form-check-input:checked {
                background-color: var(--saas-primary);
                border-color: var(--saas-primary);
            }

    .save-badge {
        background: #DCFCE7;
        color: #15803D;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .plan-card {
        background: white;
        border-radius: 12px;
        padding: 32px 24px 24px;
        border: 2px solid #E8EDF2;
        transition: all 0.25s;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
    }

        .plan-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 28px rgba(22,36,54,0.1);
            border-color: var(--saas-primary);
        }

        .plan-card.popular {
            border-color: var(--saas-primary);
            transform: scale(1.02);
        }

    .badge-popular {
        position: absolute;
        top: -13px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--saas-primary);
        color: white;
        padding: 6px 18px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .plan-card h4 {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .plan-card .price {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--saas-dark);
        margin: 20px 0;
    }

        .plan-card .price small {
            font-size: 0.95rem;
            font-weight: 500;
            color: #6B7B8D;
        }

    .plan-card ul {
        list-style: none;
        padding: 0;
        margin: 0 0 32px 0;
        flex: 1;
    }

        .plan-card ul li {
            margin-bottom: 10px;
            color: #2A3A4A;
            font-size: 0.95rem;
        }

            .plan-card ul li i {
                width: 20px;
                margin-right: 8px;
                color: var(--saas-primary-hover);
            }

                .plan-card ul li i.fa-times {
                    color: #DC2626;
                }

        .plan-card .get-started-btn {
            margin-top: 8px;
        }

    /* -- MID BANNER -- */
    .lp-mid-banner {
        line-height: 0;
        background: #F0F4F8;
        width: 100%;
        overflow: hidden;
    }

        .lp-mid-banner img {
            width: 100%;
            height: 400px;
            display: block;
            object-fit: contain;
            object-position: center;
            background: #F0F4F8;
        }

    /* -- CTA -- */
    .cta-section {
        background: linear-gradient(135deg, #0D1724 0%, #0F4C75 100%);
        color: white;
    }

        .cta-section h2 {
            font-weight: 800;
            margin-bottom: 12px;
        }

        .cta-section p {
            opacity: 0.86;
            font-size: 1.02rem;
        }

    .cta-card {
        border-radius: 12px;
    }

    /* -- FOOTER -- */
    .saas-footer {
        background: var(--saas-dark);
        color: #B8C8D8;
        padding: 34px 0 34px;
    }

        .saas-footer h5 {
            color: #FFFFFF;
            font-weight: 700;
            margin-bottom: 16px;
        }

        .saas-footer p {
            color: #8FA3B8;
            font-size: 0.94rem;
            line-height: 1.6;
        }

        .saas-footer a {
            color: #8FA3B8;
            text-decoration: none;
            transition: 0.25s;
        }

            .saas-footer a:hover {
                color: var(--saas-primary);
            }

        .saas-footer .footer-links {
            list-style: none;
            padding: 0;
        }

            .saas-footer .footer-links li {
                margin-bottom: 8px;
                word-break: break-word;
            }

        .saas-footer .social-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border: 1px solid #2A3A4A;
            border-radius: 50%;
            margin-right: 8px;
            color: #8FA3B8;
            transition: 0.25s;
        }

            .saas-footer .social-links a:hover {
                border-color: var(--saas-primary);
                color: var(--saas-primary);
            }

        .saas-footer .copyright {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding: 18px 0;
            margin-top: 24px;
            text-align: center;
            color: #6B7B8D;
            font-size: 0.88rem;
        }

    /* -- FORM VALIDATION -- */
    .form-control.is-invalid {
        border-color: #DC2626;
    }

    .invalid-feedback {
        display: none;
        color: #DC2626;
        font-size: 14px;
        margin-top: 5px;
    }

    .form-control.is-invalid + .invalid-feedback {
        display: block;
    }

    /* ----------------------------------------
           RESPONSIVE BREAKPOINTS
           ---------------------------------------- */

    /* Tablet landscape & below (= 991px) */
    @@media (max-width: 991px) {
        body {
            padding-top: 56px !important;
        }
        /* Show hamburger, hide desktop nav links */
        .saas-navbar .mob-toggler {
            display: flex;
        }

        .saas-navbar .d-none.d-md-inline {
            display: none !important;
        }
        /* Hero */
        .saas-hero {
            padding: 56px 0 48px;
        }

            .saas-hero h1 {
                font-size: 2.1rem;
            }

            .saas-hero p {
                font-size: 1rem;
                max-width: 100%;
            }
        /* Stats */
        .stats-bar {
            margin-top: -20px;
            padding: 16px 12px;
        }

        .stat-item h3 {
            font-size: 1.65rem;
        }
        /* About */
        .lp-about__img {
            height: 320px;
        }
        /* Mid banner */
        .lp-mid-banner img {
            height: 200px;
        }
    }

    /* Tablet portrait (= 767px) */
    @@media (max-width: 767px) {
        body {
            padding-top: 54px !important;
        }
        /* Navbar */
        .saas-navbar {
            padding: 2px 0;
        }
        /* Hero */
        .saas-hero {
            padding: 44px 0 36px;
        }

            .saas-hero h1 {
                font-size: 1.75rem;
                line-height: 1.25;
            }

            .saas-hero p {
                font-size: 0.97rem;
            }

            .saas-hero .d-flex.flex-wrap {
                gap: 10px !important;
            }

        .btn-saas, .btn-saas-outline {
            width: 100%;
            text-align: center;
        }
        /* Stats */
        .stats-bar {
            margin-top: -16px;
            padding: 14px 10px;
            border-radius: 10px;
        }

        .stat-item h3 {
            font-size: 1.4rem;
        }

        .stat-item p {
            font-size: 0.85rem;
        }
        /* Sections */
        .features-section,
        .pricing-section,
        .lp-about,
        .cta-section {
            padding: 36px 0;
        }
            /* Feature cards */
            .features-section .row {
                --bs-gutter-x: 12px;
                --bs-gutter-y: 12px;
            }

        .feature-card {
            padding: 20px 14px;
        }

            .feature-card i {
                font-size: 1.8rem;
            }
        /* About */
        .lp-about__img-wrap {
            padding-right: 12px;
            padding-bottom: 12px;
        }

        .lp-about__img {
            height: 260px;
        }

        .lp-about__badge {
            padding: 12px 16px;
        }

        .lp-about__badge-num {
            font-size: 1.4rem;
        }

        .lp-about__title {
            font-size: 1.7rem;
        }

        .lp-about__text {
            font-size: 0.95rem;
        }
        /* Pricing */
        .plan-card.popular {
            transform: scale(1);
        }

        .plan-card {
            margin-bottom: 24px;
            padding: 28px 20px 20px;
        }

            .plan-card .price {
                font-size: 1.9rem;
                margin: 14px 0;
            }

            .plan-card .get-started-btn {
                margin-top: 12px;
                padding: 12px 20px;
                font-size: 0.95rem;
            }
        /* CTA form */
        .cta-section .card-body {
            padding: 20px 16px;
        }
        /* Footer */
        .saas-footer {
            padding: 28px 0 28px;
        }

            .saas-footer .row {
                --bs-gutter-y: 20px;
            }

            .saas-footer h5 {
                font-size: 1rem;
                margin-bottom: 10px;
            }
        /* Mid banner */
        .lp-mid-banner img {
            height: 160px;
        }
    }

    /* Mobile small (= 480px) */
    @@media (max-width: 480px) {
        html {
            font-size: 87%;
        }

        .saas-hero h1 {
            font-size: 1.55rem;
        }
        /* Stats 2�2 */
        .stats-bar .col-6 {
            flex: 0 0 50%;
            max-width: 50%;
        }
        /* Feature cards single col */
        .features-section .col-sm-6 {
            flex: 0 0 100%;
            max-width: 100%;
        }
        /* Pricing single col */
        #plansContainer > div {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .plan-card {
            margin-bottom: 20px;
            padding: 24px 18px 18px;
        }

            .plan-card .price {
                font-size: 1.7rem;
                margin: 12px 0;
            }

            .plan-card .get-started-btn {
                margin-top: 10px;
                padding: 10px 16px;
                font-size: 0.9rem;
            }
        /* Ticker */
        .lp-ticker__item {
            font-size: 11px;
        }

        .lp-ticker {
            height: 28px;
