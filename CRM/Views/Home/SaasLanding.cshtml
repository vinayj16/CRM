                    <a href="https://www.linkedin.com/company/proptechit/" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                    <a href="https://www.instagram.com/proptech_it" target="_blank"><i class="fab fa-instagram"></i></a>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="col-lg-2 col-md-6">
                <h5 class="footer-title">Quick Links</h5>
                <ul class="footer-links">
                    <li><a href="#home">Home</a></li>
                    <li><a href="#features">Features</a></li>
                    <li><a href="#about">About</a></li>
                    <li><a href="#pricing">Pricing</a></li>
                    <li><a href="#inquiry">Contact Us</a></li>
                    <li><a href="/Account/Login">Login</a></li>
                    <li><a href="/Account/Sign up">Sign up</a></li>

                </ul>
            </div>

            <!-- Contact Info -->
            <div class="col-lg-3 col-md-6">
                <h5 class="footer-title">Contact Info</h5>
                <ul class="footer-links">
                    @if (!string.IsNullOrEmpty(footerAddress))
                    {
                        <li>
                            <i class="fas fa-map-marker-alt me-2"></i>
                            @if (!string.IsNullOrEmpty(footerMapUrl))
                            {
                                <a href="@footerMapUrl" target="_blank">@footerAddress</a>
                            }
                            else
                            {
                                <span>@footerAddress</span>
                            }
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(footerPhone))
                    {
                        <li><i class="fas fa-phone-alt me-2"></i><span>@footerPhone</span></li>
                    }
                    @if (!string.IsNullOrEmpty(footerEmail))
                    {
                        <li>
                            <i class="fas fa-envelope me-2"></i>
                            <a href="https://mail.google.com/mail/?view=cm&to=@footerEmail" target="_blank">@footerEmail</a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Legal -->
            <div class="col-lg-3 col-md-6">
                <h5 class="footer-title">Legal</h5>
                <ul class="footer-links">
                    <li><a href="/superadmin/Privacy">Privacy Policy</a></li>
                    <li><a href="/superadmin/Terms">Terms of Service</a></li>
                    <li><a href="/superadmin/RefundPolicy">Refund Policy</a></li>
                </ul>
            </div>
        </div>

        <!-- Copyright -->
        <div class="copyright mt-4 pt-3">
            @{
                var currentYear2 = DateTime.Now.Year;
                var copyrightText2 =
                Context.RequestServices
                .GetService<CRM.MasterDb.MasterDbContext>()?
                .SaasSetting
                .FirstOrDefault(s => s.SettingKey == "CopyrightText")
                ?.SettingValue;
            }
            <p class="mb-0 text-center">
                &copy; 2015 - @currentYear2
                @* <a href="/Home/Landing">
                    @(!string.IsNullOrEmpty(copyrightText2)
                                        ? Html.Raw(copyrightText2)
                                        : footerCompanyName.Trim())
                </a>. *@
                <a href="/Home/Landing">
                    @(!string.IsNullOrEmpty(copyrightText2)
                                        ? Html.Raw(copyrightText2.Trim())
                                        : footerCompanyName.Trim())
                </a>.
                All Rights Reserved |
                Powered by
                <a href="https://proptechit.com/" target="_blank">PropTech Solutions Private Limited</a>
            </p>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // -- Mobile nav --
        const mobToggler  = document.getElementById('mobToggler');
        const mobNavDrawer = document.getElementById('mobNavDrawer');

        mobToggler?.addEventListener('click', function () {
            mobNavDrawer.classList.toggle('open');
        });

        function closeMobNav() {
            mobNavDrawer?.classList.remove('open');
        }

        document.addEventListener('click', function (e) {
            if (mobNavDrawer?.classList.contains('open') &&
                !mobNavDrawer.contains(e.target) &&
                !mobToggler.contains(e.target)) {
                mobNavDrawer.classList.remove('open');
            }
        });

        // -- Plans --
        let plansData = [];
        let showYearly = false;

        document.addEventListener('DOMContentLoaded', function () {
            loadPlans();

            document.getElementById('billingToggle')?.addEventListener('change', function () {
                showYearly = this.checked;
                renderPlans();
            });

            document.getElementById('inquiryForm')?.addEventListener('submit', submitInquiry);
        });

        function loadPlans() {
            fetch('/SuperAdmin/GetSaasPlans')
                .then(r => r.json())
                .then(data => {
                    plansData = data.plans || data || [];
                    if (plansData.length >= 4) {
                        renderPlans();
                    } else {
                        console.log('API returned', plansData.length, 'plans, keeping static fallback');
                        plansData = [
                            { planId: 1, planName: 'Free' },
                            { planId: 2, planName: 'Basic Plan' },
                            { planId: 3, planName: 'Standard Plan' },
                            { planId: 4, planName: 'Premium Plan' }
                        ];
                        populatePlanDropdown();
                    }
                })
                .catch(() => {
                    console.log('API not available, using static plans');
                    plansData = [
                        { planId: 1, planName: 'Free' },
                        { planId: 2, planName: 'Basic Plan' },
                        { planId: 3, planName: 'Standard Plan' },
                        { planId: 4, planName: 'Premium Plan' }
                    ];
                    populatePlanDropdown();
                });
        }

        function populatePlanDropdown() {
            const planSelect = document.getElementById('inquiryPlanSelect');
            if (planSelect) {
                planSelect.innerHTML = '<option value="">Choose a plan...</option>';
                plansData.forEach(plan => {
                    const option = document.createElement('option');
                    option.value = plan.planId;
                    option.textContent = plan.planName;
                    option.dataset.planName = plan.planName;
                    planSelect.appendChild(option);
                });
            }

            // Add click handlers to Get Started buttons
            document.querySelectorAll('.get-started-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const planId = this.dataset.planId;
                    const planSelect = document.getElementById('inquiryPlanSelect');
                    if (planSelect && planId) {
                        planSelect.value = planId;
                    }
                    const inquirySection = document.getElementById('inquiry');
                    if (inquirySection) {
                        inquirySection.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            });
        }

        function renderPlans() {
            const container = document.getElementById('plansContainer');
            if (!container) return;

            if (!plansData.length) {
                container.innerHTML = '<div class="col-12 text-center py-4"><p class="text-muted mb-0">Plans will be available soon. Please submit an inquiry below.</p></div>';
                return;
            }

            const colSize = plansData.length <= 3 ? 'col-lg-4' : 'col-lg-3';
            let html = '';
            console.log(plansData);
            plansData.forEach((plan, idx) => {
                const isPopular = idx === 1 || plan.planType === 'Standard';
                const price = showYearly ? plan.yearlyPrice : plan.monthlyPrice;
                const period = showYearly ? '/Year' : '/Month';
                const description = plan.description || '';
                const support = (plan.supportLevel || '').toLowerCase();
                const maxAgents   = plan.maxAgents === -1          ? 'Unlimited' : plan.maxAgents;
                const maxPartners = plan.maxPartners === -1        ? 'Unlimited' : plan.maxPartners;
                const maxLeads    = plan.maxLeadsPerMonth === -1   ? 'Unlimited' : Number(plan.maxLeadsPerMonth || 0).toLocaleString('en-IN');
                const maxPartnersVal = Number(plan.maxPartners ?? 0);
                const monthlySavings  = (plan.monthlyPrice * 12) - plan.yearlyPrice;
                const savingsPercent  = plan.monthlyPrice > 0 ? Math.round((monthlySavings / (plan.monthlyPrice * 12)) * 100) : 0;
                let savingsBadge = '';
                if (showYearly && monthlySavings > 0 && plan.monthlyPrice > 0) {
                    savingsBadge = `<div style="display:inline-block;background:#16A34A;color:#FFFFFF;font-size:12px;padding:4px 8px;border-radius:6px;margin-top:6px;font-weight:600;">Save ${savingsPercent}%</div>`;
                }

                html += `
                    <div class="${colSize} col-md-6">
                        <div class="plan-card ${isPopular ? 'popular' : ''}" data-plan-id="${plan.planId}" data-plan-name="${plan.planName.replace(/"/g, '&quot;')}">
                            ${isPopular ? '<span class="badge-popular">Most Popular</span>' : ''}
                            <h4>${plan.planName || ''}</h4>
                            <p class="text-muted mb-0" style="font-size:0.9rem;">${description}</p>
                            <div class="price">
                                Rs.${Number(price || 0).toLocaleString('en-IN')}<small>${period}</small>
                                ${savingsBadge}
                            </div>



                <ul>

        <!-- Limits -->
        <li><i class="fas fa-users text-primary"></i>${maxAgents} Agents</li>
        <li><i class="fas fa-bullseye text-info"></i>${maxLeads} Leads/Month</li>

        <!-- Core features -->
        <li><i class="fas fa-home text-success"></i>Leads & Properties</li>
        <li><i class="fas fa-chart-line text-success"></i>Sales Management</li>
        <li><i class="fas fa-user-friends text-success"></i>Team Management</li>
        <li><i class="fas fa-clock text-warning"></i>Attendance Tracking</li>
        <li><i class="fas fa-wallet text-success"></i>Finance Module</li>
        <li><i class="fas fa-money-bill-wave text-success"></i>Payouts Management</li>
        <li><i class="fas fa-user-cog text-success"></i>User Management</li>
        <li><i class="fas fa-cogs text-secondary"></i>Financial Settings</li>
        <li><i class="fas fa-star text-warning"></i>Testimonials Management</li>

        <!-- Self Subscription -->
        <li><i class="fas fa-sync-alt text-primary"></i>Self-Subscription</li>

        <!-- API -->
        <li>
            <i class="fas ${plan.hasCustomAPIAccess ? 'fa-plug text-success' : 'fa-times text-danger'}"></i>
            Social media leads Integrations
        </li>

        <!-- Channel Partner -->
        <li>
            <i class="fas ${(maxPartnersVal === -1 || maxPartnersVal > 0) ? 'fa-handshake text-success' : 'fa-times text-danger'}"></i>
            Channel Partner System
        </li>

        <!-- Dashboards -->
        <li>
            <i class="fas ${plan.hasAdvancedReports ? 'fa-chart-pie text-success' : 'fa-times text-danger'}"></i>
            Advanced Dashboards
        </li>

        <!-- Branding -->
        <li>
            <i class="fas ${plan.hasCustomBranding ? 'fa-paint-brush text-success' : 'fa-times text-danger'}"></i>
            Custom Branding
        </li>

        <!-- Impersonation -->
        <li>
            <i class="fas ${plan.hasImpersonation ? 'fa-user-secret text-success' : 'fa-times text-danger'}"></i>
            Impersonation Feature
        </li>

        <!-- Support -->
             <li>
            <i class="fas ${
                support.includes('dedicated') ? 'fa-user-tie text-success' :
                support.includes('chat')      ? 'fa-comments text-primary' :
                support.includes('email')     ? 'fa-envelope text-warning' :
                'fa-times text-danger'
            }"></i>
            ${plan.supportLevel} Support
        </li>

        </ul>
                            <a href="#inquiry" class="btn ${isPopular ? 'btn-saas' : 'btn-saas-outline'} w-100 get-started-btn" data-plan-id="${plan.planId}" data-plan-name="${plan.planName.replace(/"/g, '&quot;')}">Get Started</a>
                        </div>
                    </div>`;
            });

            container.innerHTML = html;

            // Populate plan dropdown
            const planSelect = document.getElementById('inquiryPlanSelect');
            if (planSelect) {
                planSelect.innerHTML = '<option value="">Choose a plan...</option>';
                plansData.forEach(plan => {
                    const option = document.createElement('option');
                    option.value = plan.planId;
                    option.textContent = plan.planName;
                    option.dataset.planName = plan.planName;
                    planSelect.appendChild(option);
                });
            }

            // Add click handlers to Get Started buttons
            document.querySelectorAll('.get-started-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const planId = this.dataset.planId;
                    const planName = this.dataset.planName;
                    const planSelect = document.getElementById('inquiryPlanSelect');
                    if (planSelect && planId) {
                        planSelect.value = planId;
                    }
                    const inquirySection = document.getElementById('inquiry');
                    if (inquirySection) {
                        inquirySection.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            });
        }

        function submitInquiry(e) {
            e.preventDefault();
            const form = e.currentTarget;

            form.querySelectorAll('.form-control').forEach(field => {
                field.classList.remove('is-invalid');
                field.addEventListener('input', function () {
                    if (this.checkValidity()) this.classList.remove('is-invalid');
                });
            });

            let isValid = true;

            form.querySelectorAll('[required]').forEach(field => {
                if (!field.value.trim()) {
                    field.classList.add('is-invalid');
                    isValid = false;
                }
                if (field.type === 'email' && field.value.trim()) {
                    const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    if (!emailPattern.test(field.value.trim())) {
                        field.classList.add('is-invalid');
                        isValid = false;
                    }
                }
            });

            const phoneField = form.querySelector('[name="phone"]');
            if (phoneField.value.trim() && !/^[0-9]{10}$/.test(phoneField.value.trim())) {
                phoneField.classList.add('is-invalid');
                isValid = false;
            }

            if (!isValid) return;

            const btn = form.querySelector('button[type="submit"]');
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';

            const data = {
                companyName:   form.querySelector('[name="companyName"]').value,
                contactPerson: form.querySelector('[name="contactPerson"]').value,
                email:         form.querySelector('[name="email"]').value,
                phone:         form.querySelector('[name="phone"]').value,
                message:       form.querySelector('[name=message]').value,
                referralCode:  form.querySelector('[name=referralCode]').value,
                selectedPlan:  form.querySelector('[name="selectedPlan"]').value
            };

            // Add plan name if a plan is selected
            const planSelect = form.querySelector('[name="selectedPlan"]');
            if (planSelect && planSelect.value) {
                const selectedOption = planSelect.options[planSelect.selectedIndex];
                data.selectedPlanName = selectedOption.dataset.planName || planSelect.options[planSelect.selectedIndex].text;
                data.selectedPlanId = parseInt(planSelect.value);
            }

            fetch('/Home/SubmitInquiry', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(res => {
                btn.disabled = false;
                btn.innerHTML = original;
                if (res.success) {
                    form.reset();
                    Swal.fire({ icon: 'success', title: 'Thank You!', text: res.message, confirmButtonColor: '#D4A45A' });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'Unable to submit inquiry.' });
                }
            })
            .catch(() => {
                btn.disabled = false;
                btn.innerHTML = original;
                Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong. Please try again.' });
            });
        }
    </script>
}
