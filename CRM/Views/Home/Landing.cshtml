			pointer-events: none;
			opacity: 0;
			transition: opacity .2s;
		}

		.lp-field.is-valid .lp-field__icon {
			opacity: 1;
			color: var(--lp-green);
		}

		.lp-field.is-valid .lp-field__icon::after {
			content: '\f00c';
			font-family: 'Font Awesome 6 Free';
			font-weight: 900;
		}

		.lp-field.has-error .lp-field__icon {
			opacity: 1;
			color: var(--lp-red-err);
		}

			.lp-field.has-error .lp-field__icon::after {
				content: '\f00d';
				font-family: 'Font Awesome 6 Free';
				font-weight: 900;
			}

		.lp-field.has-error input, .lp-field.has-error select {
			border-color: var(--lp-red-err);
