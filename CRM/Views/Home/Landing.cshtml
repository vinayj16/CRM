		/* ═══════════════════════════════════════════════
		   PROJECTS — AUTO-SCROLL TICKER  ← CHANGED ONLY HERE
		═══════════════════════════════════════════════ */
		.lp-projects {
			padding: 46px 0 36px;
			background: var(--lp-bg);
		}

		/* The clip window — full viewport width, no side padding */
		.lp-projects__slider {
			overflow: hidden;
			padding: 10px 0 18px;
			/* Fade edges for a polished look */
			-webkit-mask-image: linear-gradient(to right, transparent 0%, #000000 5%, #000000 95%, transparent 100%);
			mask-image: linear-gradient(to right, transparent 0%, #000000 5%, #000000 95%, transparent 100%);
		}

		/* The moving track */
		.lp-projects__grid {
			display: flex;
			flex-wrap: nowrap;
			gap: 16px;
			width: max-content;
			padding: 4px 24px; /* small vertical breathing room */
			animation: proj-scroll 35s linear infinite;
			will-change: transform;
		}
			/* Pause on hover so users can interact */
			.lp-projects__grid:hover {
				animation-play-state: paused;
			}

		@@keyframes proj-scroll {
			from {
				transform: translateX(0);
			}

			to {
				transform: translateX(var(--proj-shift, -50%));
			}
		}

		/* ── Property card ── */
		.lp-prop-card {
			flex: 0 0 230px;
			width: 230px;
			background: #FFFFFF;
			border-radius: var(--lp-radius);
			overflow: hidden;
			border: 1.5px solid var(--lp-border);
			cursor: pointer;
			transition: transform .28s, box-shadow .28s, border-color .28s;
			box-shadow: var(--lp-shadow);
			user-select: none;
		}

			.lp-prop-card:hover {
				transform: translateY(-5px);
				box-shadow: var(--lp-shadow-md);
				border-color: rgba(26,111,168,.25);
