<!-- Progressive Logo Loading Overlay -->
<div id="spinner" class="show position-fixed w-100 vh-100 top-0 start-0 d-flex align-items-center justify-content-center" style="background: white; z-index: 99999;">
	<div style="text-align: center; position: relative;">
		<div id="logoContainer" style="position: relative; width: 200px; height: 200px; margin: 0 auto 20px;">
			<img id="logoImage" src="~/icons/PropTech_Logo_Color.png" alt="PropTech CRM" style="width: 100%; height: 100%; object-fit: contain; opacity: 0.2; transition: opacity 0.3s ease;">
		</div>
		<div style="width: 300px; height: 4px; background: #E8EDF2; border-radius: 2px; overflow: hidden; margin: 0 auto 10px;">
			<div id="loadingBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #1A6FA8, #DC2626); transition: width 0.3s ease;"></div>
		</div>
		<div id="progressText" style="color: #6B7B8D; font-size: 14px; font-weight: 500;">0%</div>
	</div>
</div>

