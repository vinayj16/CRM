@{
	ViewData["Title"] = "Home";
	Layout = "_LandingLayout";
}
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject CRM.AppDbContext _context
@inject CRM.MasterDb.MasterDbContext _mastercontext
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@{
	var branding = ViewBag.Branding as CRM.Models.BrandingModel;
	var hasCompanyLogo = !string.IsNullOrEmpty(branding?.CompanyLogo);
	var logoStyle = branding?.LogoDisplayStyle ?? "LogoOnly";
	var companyName = Model.ContainsKey("CompanyName") && !string.IsNullOrEmpty(Model["CompanyName"]) ? Model["CompanyName"] : "PropTech CRM";

	// Check plan-based branding: only show custom brand if plan has HasCustomBranding
	bool hasCustomBranding = false;
	var tidClaim = Context.User.FindFirst("TenantId")?.Value;
	if (!string.IsNullOrEmpty(tidClaim) && int.TryParse(tidClaim, out int tid))
	{
		var activeSub = _mastercontext.TenantSubscriptions
			.Where(s => s.TenantId == tid && (s.Status == "Active" || s.Status == "Trial"))
			.OrderByDescending(s => s.StartDate)
			.FirstOrDefault();
		if (activeSub != null)
		{
			var activePlan = _mastercontext.SaasPlans.FirstOrDefault(p => p.PlanId == activeSub.PlanId);
			hasCustomBranding = activePlan?.HasCustomBranding ?? false;
		}
	}
	// For public (not authenticated) subdomain visitors, show PropTech logo by default
	// Only show custom branding if the plan explicitly allows it
	bool usePropTechLogo = !hasCustomBranding || User.Identity?.IsAuthenticated != true;
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

@{
var token = HttpContextAccessor.HttpContext?.Request.Cookies["jwtToken"];
var emails = HttpContextAccessor.HttpContext?.Session.GetString("Email")
?? HttpContextAccessor.HttpContext?.Request.Cookies["Email"];
string role = "";
string username = "";
string email = "";
byte[] profileImageBytes = null;
if (!string.IsNullOrEmpty(token))
{
try
{
var handler = new JwtSecurityTokenHandler();
var jwt = handler.ReadJwtToken(token);
role = jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role || c.Type == "role")?.Value ?? "";
username = jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name || c.Type == "name")?.Value ?? "";
email = jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email || c.Type == "email")?.Value ?? emails ?? "";
}
catch { role = ""; username = ""; email = ""; }
}

	if (!string.IsNullOrEmpty(username) && role != "SuperAdmin")
	{
		// Get UserId from claims instead of username lookup
		var userIdClaim = Context.User.FindFirst("UserId")?.Value;
		if (!string.IsNullOrEmpty(userIdClaim) && int.TryParse(userIdClaim, out int userId))
		{
			var userProfile = _context.UserProfiles.FirstOrDefault(u => u.UserId == userId);
			profileImageBytes = userProfile?.ProfileImage;
		}
	}
	string profileImageSrc = profileImageBytes != null
	? $"data:image/png;base64,{Convert.ToBase64String(profileImageBytes)}"
	: "";
	int? subdomainPartnerId = Context.Items["subdomainPartnerId"] as int?;
	string subdomainPartnerName = Context.Items["subdomainPartnerName"] as string;
	// Get company logo from branding settings
	int? userChannelPartnerId = subdomainPartnerId;
	bool isPartnerAgent = false;
	if (!string.IsNullOrEmpty(username) && role != "SuperAdmin")
	{
		var userRecord = _context.Users.FirstOrDefault(u => u.Username == username);
		userChannelPartnerId = userRecord?.ChannelPartnerId;
		isPartnerAgent = userRecord?.ChannelPartnerId != null && (role == "Sales" || role == "Agent");
	}

}


