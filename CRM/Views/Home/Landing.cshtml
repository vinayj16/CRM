<!-- ═══════════════════════════════════════════════
	 ABOUT
═══════════════════════════════════════════════ -->
<section class="lp-about" id="about">
	<div class="lp-container">
		<div class="lp-about__grid">
			<div class="lp-about__img-wrap" id="aboutImgWrap">
				@if (!string.IsNullOrEmpty(branding?.AboutUsImage))
				{
					<img src="@branding.AboutUsImage" alt="About Us" class="lp-about__img" />
				}
				else
				{
					<img src="~/uploads/Construction.jpg" alt="About Us" class="lp-about__img" />
				}
				<div class="lp-about__badge">
					<span class="lp-about__badge-num">15+</span>
					<span class="lp-about__badge-txt">Years<br>Experience</span>
				</div>
			</div>
			<div class="lp-about__content">
				<h3><span class="lp-eyebrow demo-text slideInRight">About Us</span></h3>
				<h2 class="lp-about__title">Welcome to @(Model.ContainsKey("CompanyName") ? Model["CompanyName"] : "Our Company")</h2>
				@if (!string.IsNullOrEmpty(branding?.AboutUsText))
				{
					<div class="lp-about__text">@Html.Raw(branding.AboutUsText.Replace("\n", "<br/>"))</div>
				}
				else
				{
					<p class="lp-about__text">We are a leading real estate company dedicated to providing exceptional property solutions. With years of experience, we help clients find their dream homes and make smart investment decisions.</p>
					<p class="lp-about__text">Our experienced professionals ensure every transaction is smooth, transparent, and beneficial. We pride ourselves on our commitment to excellence and customer satisfaction.</p>
