			right: -8px;
			width: 60px;
			height: 60px;
			border-bottom: 4px solid var(--lp-blue);
			border-right: 4px solid var(--lp-blue);
			border-radius: 0 0 3px 0;
			z-index: 1;
		}

		.lp-about__badge {
			position: absolute;
			bottom: -14px;
			right: -14px;
