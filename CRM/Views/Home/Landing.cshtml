		.lp-field.has-error .lp-field__err {
			display: block;
		}

		.lp-field__ok {
			display: none;
			font-size: 10.5px;
			color: var(--lp-green);
			margin-top: 3px;
			font-weight: 600;
		}

		.lp-field.is-valid .lp-field__ok {
			display: block;
		}

		.lp-fields-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 8px;
		}

		@@media (max-width: 420px) {
			.lp-fields-row {
				grid-template-columns: 1fr;
			}
		}

		/* Compact modal overrides */
		.lp-modal__body {
			padding: 10px 14px 6px;
		}

		.lp-modal__header {
			padding: 10px 14px;
		}

		.lp-modal__footer {
			padding: 8px 14px;
		}

		.lp-field label {
			font-size: 10.5px;
			margin-bottom: 2px;
		}

		.lp-field input, .lp-field select {
			height: 32px;
			font-size: 12px;
			padding: 4px 28px 4px 8px;
		}

		.lp-fields-row + .lp-fields-row {
			margin-top: 6px;
		}


		.hero-action-center {
			text-align: center;
			margin-top: 20px;
		}

		/* Button styled like navbar CTA */
		.cta-register-btn {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			background: linear-gradient(135deg, #DC2626, #DC2626); /* bright red gradient */
			color: #FFFFFF;
			padding: 12px 28px;
			font-size: 15px;
			font-weight: 600;
			border-radius: 8px;
			text-decoration: none;
			box-shadow: 0 4px 14px rgba(220,38,38, 0.3);
			transition: all 0.3s ease;
		}

			/* Arrow animation */
			.cta-register-btn i {
				transition: transform 0.3s ease;
			}

			/* Hover effect like login CTA */
			.cta-register-btn:hover {
				background: linear-gradient(135deg, #DC2626, #DC2626);
				box-shadow: 0 6px 18px rgba(220,38,38, 0.4);
				transform: translateY(-2px);
				color: #FFFFFF;
			}

				.cta-register-btn:hover i {
					transform: translateX(5px);
				}

		/* Tagline */
		.tagline-text {
			margin-top: 8px;
			color: #F59E0B;
			font-size: 20px;
			font-weight: 600;
		}

		.navbar-profile-link {
			display: flex;
			align-items: center;
			gap: 8px;
			text-decoration: none;
		}

			.navbar-profile-link img,
			.navbar-profile-link div {
				flex-shrink: 0;
			}

		.dropdown-menu {
			top: 100% !important;
			bottom: auto !important;
			margin-top: 8px;
		}
	</style>
}

<script>
	document.addEventListener('DOMContentLoaded', function () {

		/* ── NAV HEIGHT SYNC ── */
		var nav = document.getElementById('mainNav');
		function syncNavHeight() {
			var h = nav.querySelector('.lp-nav__inner').getBoundingClientRect().height;
			document.documentElement.style.setProperty('--lp-nav-h', h + 'px');
		}
		syncNavHeight();
		window.addEventListener('resize', syncNavHeight);

		// ── SPINNER ──
		// var spinner    = document.getElementById('spinner');
		// var logoImage  = document.getElementById('logoImage');
		// var logoText   = document.getElementById('logoText');
		// var loadingBar = document.getElementById('loadingBar');
		// var progressEl = document.getElementById('progressText');
		// var progress   = 0;
		// var tick = setInterval(function () {
		//     progress += 1.67;
		//     if (progress >= 100) { progress = 100; clearInterval(tick); }
		//     if (loadingBar)  loadingBar.style.width = progress + '%';
		//     if (progressEl)  progressEl.textContent = Math.round(progress) + '%';
		//     var op = 0.2 + (progress / 100) * 0.8;
		//     if (logoImage) logoImage.style.opacity = op;
		//     if (logoText)  logoText.style.opacity  = op;
		//     if (progress === 100) {
		//         setTimeout(function () {
		//             spinner.classList.add('hidden');
		//             setTimeout(function () { spinner.style.display = 'none'; }, 600);
		//         }, 300);
		//     }
		// }, 50);
						// Progressive Logo Loading Effect
					const overlay = document.getElementById('spinner');
					const logoImage = document.getElementById('logoImage');
					const logoText = document.getElementById('logoText');
					const loadingBar = document.getElementById('loadingBar');

					const navbar = document.querySelector('.navbar.sticky-top') || document.querySelector('.navbar');

					// Keep first section aligned under the fixed navbar on all breakpoints.
					function syncLandingNavbarOffset() {
						if (!navbar) return;

						const navHeight = Math.ceil(navbar.getBoundingClientRect().height);
						if (navHeight > 0) {
							document.documentElement.style.setProperty('--landing-navbar-height', navHeight + 'px');
						}
					}

					syncLandingNavbarOffset();
					window.addEventListener('resize', syncLandingNavbarOffset);

					// Navbar can shrink/expand while scrolling; keep offset in sync to avoid top gap.
					let isOffsetSyncScheduled = false;
					function scheduleNavbarOffsetSync() {
						if (isOffsetSyncScheduled) return;
						isOffsetSyncScheduled = true;

						requestAnimationFrame(() => {
							syncLandingNavbarOffset();
							isOffsetSyncScheduled = false;
						});
					}

					window.addEventListener('scroll', scheduleNavbarOffsetSync, { passive: true });
					if (navbar) {
						navbar.addEventListener('transitionend', scheduleNavbarOffsetSync);
					}

					if (!overlay) return;

					let progress = 0;
					const duration = 3000; // 3 seconds
					const interval = 50; // Update every 50ms
					const increment = (100 / (duration / interval));
					const progressText = document.getElementById('progressText');

					const progressInterval = setInterval(() => {
						progress += increment;

						if (progress >= 100) {
							progress = 100;
							clearInterval(progressInterval);

							// Hide overlay after completion
							setTimeout(() => {
								overlay.classList.remove('show');
								overlay.style.opacity = '0';
								setTimeout(() => {
									overlay.style.display = 'none';
								}, 500);
							}, 300);
						}

						// Update progress bar
						if (loadingBar) {
							loadingBar.style.width = progress + '%';
						}

						// Update progress text
						if (progressText) {
							progressText.textContent = Math.round(progress) + '%';
						}

						// Update logo opacity (low to high visibility)
						const opacity = 0.2 + (progress / 100) * 0.8; // From 0.2 to 1.0
						if (logoImage) {
							logoImage.style.opacity = opacity;
						}
						if (logoText) {
							logoText.style.opacity = opacity;
						}
					}, interval);


		/* ── OFFCANVAS HAMBURGER ── */
		var toggle         = document.getElementById('navToggle');
		var offcanvas      = document.getElementById('navOffcanvas');
		var offcanvasClose = document.getElementById('offcanvasClose');
		var backdrop       = document.getElementById('offcanvasBackdrop');

		function openOffcanvas() {
			if (!offcanvas) return;
			offcanvas.classList.add('open');
			backdrop.classList.add('show');
			document.body.style.overflow = 'hidden';
			toggle.classList.add('open');
			toggle.setAttribute('aria-expanded', 'true');
		}
		function closeOffcanvas() {
			if (!offcanvas) return;
			offcanvas.classList.remove('open');
			backdrop.classList.remove('show');
			document.body.style.overflow = '';
			toggle.classList.remove('open');
			toggle.setAttribute('aria-expanded', 'false');
		}
		if (toggle)         toggle.addEventListener('click', openOffcanvas);
		if (offcanvasClose) offcanvasClose.addEventListener('click', closeOffcanvas);
		if (backdrop)       backdrop.addEventListener('click', closeOffcanvas);
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape') closeOffcanvas();
		});
		document.querySelectorAll('.lp-offcanvas__link').forEach(function (l) {
			l.addEventListener('click', function () {
				var href = l.getAttribute('href');
				closeOffcanvas();
				if (href && href.startsWith('#')) {
					setTimeout(function () {
						var target = document.querySelector(href);
						if (target) {
							var offset = nav ? nav.offsetHeight : 60;
							window.scrollTo({ top: target.getBoundingClientRect().top + window.pageYOffset - offset, behavior: 'smooth' });
						}
					}, 340);
				}
			});
		});

		/* ── SMOOTH SCROLL for desktop nav ── */
		document.querySelectorAll('a[href^="#"]').forEach(function (a) {
			a.addEventListener('click', function (e) {
				var href = this.getAttribute('href');
				if (href === '#' || this.hasAttribute('data-bs-toggle')) return;
				if (this.closest('.lp-offcanvas')) return;
				var target = document.querySelector(href);
				if (!target) return;
				e.preventDefault();
				var offset = nav ? nav.offsetHeight : 60;
				window.scrollTo({ top: target.getBoundingClientRect().top + window.pageYOffset - offset, behavior: 'smooth' });
			});
		});

		/* ── BACK TO TOP ── */
		var backTop = document.getElementById('backTop');
		window.addEventListener('scroll', function () {
			backTop.classList.toggle('show', window.scrollY > 300);
		}, { passive: true });

		/* ── COUNTER ANIMATION ── */
		function animateCounter(el) {
			var target = parseInt(el.dataset.target, 10);
			var dur = 1800, step = target / (dur / 16);
			var val = 0;
			var t = setInterval(function () {
				val += step;
				if (val >= target) { val = target; clearInterval(t); }
				el.textContent = Math.floor(val);
			}, 16);
		}
		var statsSection = document.querySelector('.lp-stats');
		if (statsSection && 'IntersectionObserver' in window) {
			var io = new IntersectionObserver(function (entries) {
				entries.forEach(function (e) {
					if (e.isIntersecting) {
						e.target.querySelectorAll('.counter').forEach(function (c) {
							if (!c.dataset.done) { c.dataset.done = 1; animateCounter(c); }
						});
					}
				});
			}, { threshold: 0.4 });
			io.observe(statsSection);
		}

		/* ── ABOUT IMAGE SLIDE-IN FROM LEFT ── */
		var aboutImgWrap = document.getElementById('aboutImgWrap');
		if (aboutImgWrap && 'IntersectionObserver' in window) {
			var aboutIO = new IntersectionObserver(function (entries) {
				entries.forEach(function (e) {
					if (e.isIntersecting) {
						e.target.classList.add('slide-in-visible');
						aboutIO.unobserve(e.target);
					}
				});
			}, { threshold: 0.2 });
			aboutIO.observe(aboutImgWrap);
		} else if (aboutImgWrap) {
			aboutImgWrap.classList.add('slide-in-visible');
		}

		/* ══════════════════════════════════════════════
		   PROJECTS — AUTO-SCROLL INFINITE TICKER
		   (replaces old drag-scroll logic entirely)
		══════════════════════════════════════════════ */
		var projGrid = document.getElementById('projectsGrid');
		if (projGrid && projGrid.children.length > 0) {
			/* Wait one frame so layout is painted and scrollWidth is accurate */
			requestAnimationFrame(function () {
				var origWidth = projGrid.scrollWidth;

				/* Clone every card to make the seamless loop */
				Array.from(projGrid.children).forEach(function (card) {
					projGrid.appendChild(card.cloneNode(true));
				});

				/*
				 * Set the CSS variable: animation goes from translateX(0)
				 * to translateX(-origWidth px), then snaps back seamlessly
				 * because the second half is identical to the first.
				 */
				projGrid.style.setProperty('--proj-shift', '-' + origWidth + 'px');
			});
		}

		/* ── TESTIMONIAL INFINITE SCROLL ── */
		var track = document.getElementById('testiTrack');
		if (track) {
			var origWidth = track.scrollWidth;
			Array.from(track.children).forEach(function (c) { track.appendChild(c.cloneNode(true)); });
			track.style.setProperty('--testi-shift', '-' + (origWidth + 8) + 'px');
		}

		/* ── ACTIVE NAV LINK ON SCROLL ── */
		var sections   = document.querySelectorAll('section[id], footer[id]');
		var navLinkEls = document.querySelectorAll('.lp-nav__link');
		window.addEventListener('scroll', function () {
			var current = '';
			sections.forEach(function (s) {
				if (window.pageYOffset >= s.offsetTop - 90) current = s.id;
			});
			navLinkEls.forEach(function (l) {
				l.classList.remove('active');
				if (l.getAttribute('href') === '#' + current) l.classList.add('active');
			});
		}, { passive: true });

		/* ── LIVE FIELD VALIDATION ── */
		var validatorsMap = {
			'modalName':     function (v) { return /^[a-zA-Z\s\.\-\']{2,}$/.test(v.trim()); },
			'modalContact':  function (v) { return /^[0-9]{10}$/.test(v.trim()); },
			'modalLocation': function (v) { return v.trim().length >= 2; },
			'modalBHK':      function (v) { return v !== '' && v !== null; },
			'modalBudget':   function (v) { return /^\d+(\.\d+)?$/.test(v.trim()) && parseFloat(v) > 0; }
		};
		var okMessages = {
			'modalName':     'Looks good!',
			'modalContact':  'Valid number',
			'modalLocation': 'Got it!',
			'modalBHK':      'Selected',
			'modalBudget':   'Amount noted'
		};
		function setFieldState(fieldId, isValid) {
			var input = document.getElementById(fieldId);
			if (!input) return;
			var wrap = input.closest('.lp-field');
			if (!wrap) return;
			var okEl = wrap.querySelector('.lp-field__ok');
			if (!okEl) {
				okEl = document.createElement('span');
				okEl.className = 'lp-field__ok';
				okEl.textContent = okMessages[fieldId] || 'OK';
				var errEl = wrap.querySelector('.lp-field__err');
				if (errEl) errEl.after(okEl); else wrap.appendChild(okEl);
			}
			wrap.classList.toggle('is-valid', isValid);
			wrap.classList.toggle('has-error', false);
		}
		Object.keys(validatorsMap).forEach(function (id) {
			var el = document.getElementById(id);
			if (!el) return;
			el.addEventListener('input', function () {
				if (el.value !== '' || el.tagName === 'SELECT') {
					setFieldState(id, validatorsMap[id](el.value));
				}
			});
			el.addEventListener('change', function () { setFieldState(id, validatorsMap[id](el.value)); });
			el.addEventListener('blur', function () {
				if (el.value !== '') {
					var valid = validatorsMap[id](el.value);
					var wrap = el.closest('.lp-field');
					if (!valid) { wrap.classList.remove('is-valid'); wrap.classList.add('has-error'); }
				}
			});
		});
	});

	/* ── INTEREST FORM SHOW ── */
	function showInterestForm(propertyId, projectName) {
		document.getElementById('modalPropertyId').value = propertyId;
		document.getElementById('modalProjectName').value = projectName;
		document.getElementById('interestModalLabel').textContent = 'Express Interest — ' + projectName;
		document.querySelectorAll('#interestForm .lp-field').forEach(function (f) {
			f.classList.remove('is-valid', 'has-error');
		});
		document.getElementById('interestForm').reset();
		new bootstrap.Modal(document.getElementById('interestModal')).show();
	}

	/* ── FORM SUBMIT ── */
	(function () {
		var form = document.getElementById('interestForm');
		if (!form) return;
		var validators = {
			'modalName':     function (v) { return /^[a-zA-Z\s\.\-\']{2,}$/.test(v.trim()); },
			'modalContact':  function (v) { return /^[0-9]{10}$/.test(v.trim()); },
			'modalLocation': function (v) { return v.trim().length >= 2; },
			'modalBHK':      function (v) { return v !== '' && v !== null; },
			'modalBudget':   function (v) { return /^\d+(\.\d+)?$/.test(v.trim()) && parseFloat(v) > 0; }
		};
		var nameInput = document.getElementById('modalName');
		if (nameInput) {
			nameInput.addEventListener('keypress', function (e) {
				if (/[0-9]/.test(e.key)) { e.preventDefault(); return false; }
			});
			nameInput.addEventListener('input', function () {
				this.value = this.value.replace(/[0-9]/g, '');
			});
		}
		form.addEventListener('submit', function (e) {
			e.preventDefault();
			var allValid = true;
			Object.keys(validators).forEach(function (id) {
				var input = document.getElementById(id);
				var wrap  = input ? input.closest('.lp-field') : null;
				if (!input || !wrap) return;
				var ok = validators[id](input.value);
				wrap.classList.toggle('is-valid', ok);
				wrap.classList.toggle('has-error', !ok);
				if (!ok) allValid = false;
			});
			if (!allValid) return;
			var btn = document.getElementById('submitBtn');
			btn.disabled = true;
			btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Submitting…';
			fetch('/PublicLeads/CaptureInterest', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					Name:              document.getElementById('modalName').value,
					Contact:           document.getElementById('modalContact').value,
					PreferredLocation: document.getElementById('modalLocation').value,
					BHK:               document.getElementById('modalBHK').value,
					Budget:            document.getElementById('modalBudget').value,
					ProjectName:       document.getElementById('modalProjectName').value,
					PropertyId:        parseInt(document.getElementById('modalPropertyId').value, 10)
				})
			})
			.then(function (r) { return r.json(); })
			.then(function (data) {
				btn.disabled = false;
				btn.innerHTML = '<i class="fa fa-paper-plane"></i> Submit Interest';
				if (data.success) {
					bootstrap.Modal.getInstance(document.getElementById('interestModal')).hide();
					form.reset();
					form.querySelectorAll('.lp-field').forEach(function (f) { f.classList.remove('is-valid', 'has-error'); });
					Swal.fire({ icon: 'success', title: 'Thank You!', text: data.message || 'Our team will contact you soon.', confirmButtonColor: '#1A6FA8' });
				} else {
					Swal.fire({ icon: 'error', title: 'Oops!', text: data.message || 'Something went wrong.', confirmButtonColor: '#1A6FA8' });
				}
			})
			.catch(function () {
				btn.disabled = false;
				btn.innerHTML = '<i class="fa fa-paper-plane"></i> Submit Interest';
				Swal.fire({ icon: 'error', title: 'Error', text: 'Please try again.', confirmButtonColor: '#1A6FA8' });
			});
		});
	}());
</script>

<script>
	// Inquiry Form Submission
	document.getElementById('inquiryForm')?.addEventListener('submit', function(e) {
		e.preventDefault();
		var form = this;
		var btn = form.querySelector('button[type=submit]');
		var originalHtml = btn.innerHTML;
		btn.disabled = true;
		btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';

		var data = {
			companyName: form.querySelector('[name=companyName]').value,
			contactPerson: form.querySelector('[name=contactPerson]').value,
			email: form.querySelector('[name=email]').value,
			phone: form.querySelector('[name=phone]').value,
			message: form.querySelector('[name=message]').value,
			selectedPlan: form.querySelector('[name=selectedPlan]').value
		};

		fetch('/Home/SubmitInquiry', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(data)
		})
		.then(function(r) { return r.json(); })
		.then(function(res) {
			btn.disabled = false;
			btn.innerHTML = originalHtml;
			if (res.success) {
				form.reset();
				var modal = bootstrap.Modal.getInstance(document.getElementById('inquiryModal'));
				if (modal) modal.hide();
				Swal.fire({ icon: 'success', title: 'Thank You!', text: res.message, confirmButtonColor: '#1A6FA8' });
			} else {
				Swal.fire({ icon: 'error', title: 'Error', text: res.message });
			}
		})
		.catch(function() {
			btn.disabled = false;
			btn.innerHTML = originalHtml;
			Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong. Please try again.' });
		});
	});


</script>

<script>
	let timeout;

	function showDropdown(el) {
		clearTimeout(timeout);
		const menu = el.querySelector('.dropdown-menu');
		if (menu) {
			menu.style.display = 'block';
		}
	}

	function hideDropdown(el) {
		const menu = el.querySelector('.dropdown-menu');

		timeout = setTimeout(() => {
			if (menu && !menu.matches(':hover')) {
				menu.style.display = 'none';
			}
		}, 300);
	}
</script>