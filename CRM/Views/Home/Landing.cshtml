<section class="lp-projects" id="projects">
	<div class="lp-container">
		<div class="lp-section-header">
			<span class="lp-eyebrow">Projects</span>
			<h2>Our Featured Projects</h2>
		</div>
	</div>
	<!-- Slider sits OUTSIDE lp-container so cards bleed edge-to-edge -->
	<div class="lp-projects__slider">
		<div class="lp-projects__grid" id="projectsGrid">
			@if (ViewBag.Properties != null)
			{
				@foreach (var property in ViewBag.Properties)
				{
					<div class="lp-prop-card" onclick="window.location.href='/Home/ProjectDetails/@property.PropertyId'">
						<div class="lp-prop-card__img-wrap">
							@if (property.Images != null && property.Images.Count > 0)
							{
								@if (property.Images.Count == 1)
								{
									<img src="/Home/GetPropertyImage/@property.Images[0]" alt="@property.PropertyName" class="lp-prop-card__img" />
								}
								else
								{
									<div id="carousel@(property.PropertyId)" class="carousel slide" data-bs-ride="carousel">
										<div class="carousel-inner">
											@for (int i = 0; i < property.Images.Count; i++)
											{
												<div class="carousel-item @(i == 0 ? "active" : "")">
													<img src="/Home/GetPropertyImage/@property.Images[i]" alt="@property.PropertyName" class="lp-prop-card__img" />
												</div>
											}
										</div>
										<button class="carousel-control-prev" type="button" data-bs-target="#carousel@(property.PropertyId)" data-bs-slide="prev" onclick="event.stopPropagation()">
											<span class="carousel-control-prev-icon"></span>
										</button>
										<button class="carousel-control-next" type="button" data-bs-target="#carousel@(property.PropertyId)" data-bs-slide="next" onclick="event.stopPropagation()">
											<span class="carousel-control-next-icon"></span>
										</button>
									</div>
								}
							}
							else
							{
								<img src="~/uploads/Construction.jpg" alt="@property.PropertyName" class="lp-prop-card__img" />
							}
							<div class="lp-prop-card__price-tag">&#6B7B8D77;@(property.MinPrice.ToString("N0"))</div>
						</div>
						<div class="lp-prop-card__body">
							<h5 class="lp-prop-card__name">@property.PropertyName</h5>
							<div class="lp-prop-card__stars">
								@for (int s = 0; s < 5; s++)
								{
									<i class="fa fa-star"></i>
								}
							</div>
							<div class="lp-prop-card__meta">
								<span><i class="fa fa-map-marker-alt"></i> @(property.Location ?? "Location")</span>
								<span><i class="fa fa-building"></i> @(property.AreaSqft ?? 0) Sqft</span>
								<span><i class="fa fa-home"></i> 2–3.5 BHK</span>
							</div>
							<div class="lp-prop-card__actions">
								<button class="lp-btn lp-btn--sm lp-btn--outline-card" onclick="event.stopPropagation();showInterestForm(@property.PropertyId,'@property.PropertyName')">
									<i class="fa fa-heart"></i> Interest
								</button>
								<a href="/Home/ProjectDetails/@property.PropertyId" class="lp-btn lp-btn--sm lp-btn--primary" onclick="event.stopPropagation()">
									<i class="fa fa-eye"></i> Details
								</a>
							</div>
						</div>
					</div>
				}
			}
		</div>
	</div>
</section>

<!-- ═══════════════════════════════════════════════
	 TESTIMONIALS
═══════════════════════════════════════════════ -->
<section class="lp-testimonials">
	<div class="lp-container">
		<div class="lp-section-header">
			<span class="lp-eyebrow">Testimonials</span>
			<h2>What Our Customers Say</h2>
		</div>
	</div>
	<div class="lp-testi__slider">
		<div class="lp-testi__track" id="testiTrack">
			@{
				var testimonials = ViewBag.Testimonials as List<CRM.Models.TestimonialModel>;
			}
			@if (testimonials != null && testimonials.Any())
			{
				var minCards = 10;
				var displayList = testimonials.ToList();
				while (displayList.Count < minCards) { displayList.AddRange(testimonials); }
				if (testimonials.Count >= minCards) { displayList = testimonials; }

				@foreach (var t in displayList)
				{
					<div class="lp-testi-card">
						<div class="lp-testi-card__quote">&#10077;</div>
						<p class="lp-testi-card__text">@(t.Content.Length > 130 ? t.Content.Substring(0, 130) + "…" : t.Content)</p>
						<div class="lp-testi-card__stars">
							@for (int i = 1; i <= 5; i++)
							{
								<i class="fa fa-star @(i <= t.Rating ? "active" : "")"></i>
							}
						</div>
						<div class="lp-testi-card__author">
							@if (!string.IsNullOrEmpty(t.ImageBase64))
							{
								<img src="@t.ImageBase64" alt="@t.Name" class="lp-testi-card__avatar" />
							}
							else
							{
								<div class="lp-testi-card__avatar lp-testi-card__avatar--initials">@t.Name.Substring(0, 1).ToUpper()</div>
							}
							<div>
								<strong>@t.Name</strong>
								<small>@t.Tag</small>
							</div>
						</div>
					</div>
				}
			}
			else
			{
				<div class="lp-testi-card">
					<div class="lp-testi-card__quote">&#10077;</div>
					<p class="lp-testi-card__text">No testimonials yet. Add testimonials from the admin panel.</p>
					<div class="lp-testi-card__stars">
						@for (int i = 0; i < 5; i++)
						{
							<i class="fa fa-star active"></i>
						}
					</div>
					<div class="lp-testi-card__author">
						<div class="lp-testi-card__avatar lp-testi-card__avatar--initials">C</div>
						<div><strong>Your Customer</strong><small>Happy Client</small></div>
					</div>
				</div>
			}
		</div>
	</div>
</section>

