			overflow: hidden;
		}

		.lp-prop-card__img {
			width: 100%;
			height: 148px;
			object-fit: cover;
			transition: transform .4s ease;
		}

		.lp-prop-card:hover .lp-prop-card__img {
			transform: scale(1.04);
		}

		.lp-prop-card__price-tag {
			position: absolute;
			top: 8px;
			left: 8px;
			background: var(--lp-blue);
			color: #FFFFFF;
			font-size: 11px;
			font-weight: 700;
			padding: 3px 9px;
			border-radius: 4px;
			box-shadow: 0 2px 6px rgba(26,111,168,.4);
			letter-spacing: .3px;
		}

		.lp-prop-card__body {
			padding: 11px 12px 12px;
		}

		.lp-prop-card__name {
			font-size: 13px;
			font-weight: 700;
			color: var(--lp-dark);
