			background: var(--lp-grad-mix);
			color: #FFFFFF;
			display: none;
			align-items: center;
			justify-content: center;
			font-size: 14px;
			box-shadow: var(--lp-shadow-md);
			transition: all .28s;
		}

			.lp-back-top:hover {
