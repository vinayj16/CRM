<div class="modal fade" id="interestModal" tabindex="-1" aria-labelledby="interestModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content lp-modal">
			<div class="lp-modal__header">
				<h5 id="interestModalLabel">Express Interest</h5>
				<button type="button" class="lp-modal__close" data-bs-dismiss="modal" aria-label="Close">&times;</button>
			</div>
			<form id="interestForm" novalidate>
				<div class="lp-modal__body">
					<input type="hidden" id="modalPropertyId" name="PropertyId" />
					<input type="hidden" id="modalProjectName" name="ProjectName" />
					<div class="lp-fields-row">
						<div class="lp-field">
							<label for="modalName"><i class="fa fa-user"></i> Full Name <span class="req">*</span></label>
							<div class="lp-input-wrap">
								<input type="text" id="modalName" name="Name" placeholder="Your full name" required autocomplete="off" inputmode="text" />
								<span class="lp-field__icon"></span>
							</div>
							<span class="lp-field__err">Please enter your name</span>
						</div>
						<div class="lp-field">
							<label for="modalContact">Phone Number <span class="req">*</span></label>
							<div class="lp-input-wrap">
								<input type="number" id="modalContact" name="Contact" placeholder="10-digit mobile number" pattern="[0-9]{10}" maxlength="10" required autocomplete="off" />
								<span class="lp-field__icon"></span>
							</div>
							<span class="lp-field__err">Enter a valid 10-digit number</span>
						</div>
					</div>
					<div class="lp-fields-row">
						<div class="lp-field">
							<label for="modalLocation">Preferred Location <span class="req">*</span></label>
							<div class="lp-input-wrap">
								<input type="text" id="modalLocation" name="PreferredLocation" placeholder="e.g. Hyderabad" required autocomplete="off" />
								<span class="lp-field__icon"></span>
							</div>
							<span class="lp-field__err">Please enter preferred location</span>
						</div>
						<div class="lp-field">
							<label for="modalBHK">BHK Type <span class="req">*</span></label>
							<div class="lp-input-wrap">
								<select id="modalBHK" name="BHK" required>
									<option value="" disabled selected>Select BHK type</option>
									<option value="1 BHK">1 BHK</option>
									<option value="2 BHK">2 BHK</option>
									<option value="3 BHK">3 BHK</option>
									<option value="4 BHK">4 BHK</option>
									<option value="5+ BHK">5+ BHK</option>
								</select>
								<span class="lp-field__icon"></span>
							</div>
							<span class="lp-field__err">Please select BHK type</span>
						</div>
					</div>
					<div class="lp-fields-row">
						<div class="lp-field">
							<label for="modalBudget">Budget (Lakhs) <span class="req">*</span></label>
							<div class="lp-input-wrap">
								<input type="text" id="modalBudget" name="Budget" placeholder="e.g. 50" required autocomplete="off" />
								<span class="lp-field__icon"></span>
							</div>
							<span class="lp-field__err">Please enter your budget</span>
						</div>
						<div class="lp-field"></div>
					</div>
				</div>
				<div class="lp-modal__footer">
					<button type="button" class="lp-btn lp-btn--ghost" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="lp-btn lp-btn--primary" id="submitBtn">
						<i class="fa fa-paper-plane"></i> Submit Interest
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

