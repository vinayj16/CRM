@*
    ManageTenantSubscriptions.cshtml
    Extracted directly from provided screenshots.
*@

<style>
	.plan-card {
		border: 1px solid var(--bs-border-color, rgba(0, 0, 0, 0.125));
		transition: all 0.3s ease;
		background: var(--bs-body-bg, white);
	}

		.plan-card:hover {
			transform: translateY(-2px);
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
		}

		.plan-card.active-plan {
			border: 2px solid #F59E0B !important;
			background: var(--bs-warning-bg-subtle, #E8C27E) !important;
		}

	/* Dark mode override for active plan card */
	[data-bs-theme="dark"] .plan-card.active-plan {
		background: #F59E0B !important;
		color: #FFFFFF !important;
	}

		[data-bs-theme="dark"] .plan-card.active-plan *,
		[data-bs-theme="dark"] .plan-card.active-plan .plan-name,
		[data-bs-theme="dark"] .plan-card.active-plan .current-plan-expire,
		[data-bs-theme="dark"] .plan-card.active-plan small {
			color: #FFFFFF !important;
		}

	.plan-header {
		border-bottom: 1px solid var(--bs-border-color, #E8EDF2);
		padding-bottom: 1rem;
		margin-bottom: 1rem;
	}

	.plan-name {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--bs-body-color, #1E2A3A);
		margin-bottom: 0.5rem;
	}

	.plan-type {
		padding: 0.25rem 0.75rem;
		border-radius: 15px;
		font-weight: 500;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	/* Dark mode overrides for plan type badges */
	[data-bs-theme="dark"] .plan-type.basic {
		background: #1A6FA8 !important;
		color: #FFFFFF !important;
		border: none !important;
	}

	[data-bs-theme="dark"] .plan-type.standard {
		background: #15803D !important;
		color: #FFFFFF !important;
		border: none !important;
	}

	[data-bs-theme="dark"] .plan-type.enterprise {
		background: #B45309 !important;
		color: #FFFFFF !important;
		border: none !important;
	}

	/* Table dark mode fixes */
	[data-bs-theme="dark"] .table {
		background-color: var(--bs-body-bg);
		--bs-table-striped-bg: rgba(255, 255, 255, 0.08);
		--bs-table-hover-bg: rgba(255, 255, 255, 0.1);
		--bs-table-border-color: var(--bs-border-color);
		color: var(--bs-body-color);
	}

		[data-bs-theme="dark"] .table > :not(caption) > * > * {
			border-bottom-color: var(--bs-border-color);
		}

	[data-bs-theme="dark"] .table-striped > tbody > tr:nth-of-type(odd) > td {
		background-color: rgba(255, 255, 255, 0.08) !important;
	}

	[data-bs-theme="dark"] .table-striped > tbody > tr:nth-of-type(even) > td {
		background-color: transparent !important;
	}

	/* Fix for table inside card in dark mode */
	[data-bs-theme="dark"] .card .table-striped > tbody > tr:nth-of-type(odd) {
		background-color: rgba(255, 255, 255, 0.08) !important;
	}

	[data-bs-theme="dark"] .card .table-striped > tbody > tr:nth-of-type(even) {
		background-color: transparent !important;
	}

	[data-bs-theme="dark"] .card .table {
		background-color: transparent !important;
	}

	[data-bs-theme="dark"] .table tbody tr {
		color: #FFFFFF !important;
	}

		[data-bs-theme="dark"] .table tbody tr td {
			color: #FFFFFF !important;
		}

	[data-bs-theme="dark"] .card .table tbody tr {
		color: #FFFFFF !important;
	}

		[data-bs-theme="dark"] .card .table tbody tr td {
			color: #FFFFFF !important;
		}

	/* Override any global dark mode styles */
	.dark-mode .table tbody tr,
	.dark-mode .table tbody tr td,
	.dark-mode .card .table tbody tr,
	.dark-mode .card .table tbody tr td {
		color: #FFFFFF !important;
	}

	.price-label {
		font-size: 0.75rem;
		color: var(--bs-secondary-color, #6B7B8D);
		margin-bottom: 0.25rem;
		font-weight: 500;
		text-transform: uppercase;
	}

	.price-amount {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--bs-body-color, #1E2A3A);
	}

	.price-currency {
		font-size: 1rem;
		color: var(--bs-secondary-color, #6B7B8D);
	}

	.feature-group h6 {
		font-weight: 600;
		color: var(--bs-body-color, #2A3A4A);
		margin-bottom: 0.5rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.feature-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.25rem;
		font-size: 0.8rem;
	}

	.modal-dialog {
		max-width: 50% !important;
		width: 50% !important;
	}

	/* Mobile responsive modal */
	@@media (max-width: 768px) {
		.modal-dialog {
			max-width: 95% !important;
			width: 95% !important;
			margin: 0.5rem !important;
		}

		.plan-card {
			margin-bottom: 1rem;
		}

		.plan-header {
			padding-bottom: 0.75rem;
			margin-bottom: 0.75rem;
		}

		.plan-name {
			font-size: 1.1rem;
		}

		.plan-pricing .row {
			margin-bottom: 1rem;
		}

		.price-amount {
			font-size: 1.25rem;
		}

		.feature-group {
			margin-bottom: 1rem;
		}

		.plan-actions .btn {
			font-size: 0.8rem;
			padding: 0.4rem 0.8rem;
		}
	}

	.plan-actions .btn {
		background: #DC2626;
		border-color: #DC2626;
		color: white;
		transition: all 0.3s ease;
	}

		.plan-actions .btn:hover {
			background: #125082;
			border-color: #125082;
			transform: translateY(-1px);
			box-shadow: 0 4px 8px rgba(107,123,141, 0.3);
		}

		.plan-actions .btn:active {
			background: #2A3A4A;
			border-color: #2A3A4A;
		}

	.current-billing-cycle {
		background: var(--bs-warning-bg-subtle, #FEF3C7);
		border: 2px solid #F59E0B;
		border-radius: 8px;
		padding: 0.5rem;
	}

		.current-billing-cycle .price-label {
			color: #B45309;
			font-weight: 600;
		}

		.current-billing-cycle .price-amount {
			color: #B45309;
		}

	/* Dark mode overrides for current billing cycle */
	[data-bs-theme="dark"] .current-billing-cycle {
		background: #FEF3C7 !important;
		border: 2px solid #F59E0B !important;
	}

		[data-bs-theme="dark"] .current-billing-cycle .price-label,
		[data-bs-theme="dark"] .current-billing-cycle .price-amount {
			color: #B45309 !important;
		}

	/* Dark mode overrides for badges */
	[data-bs-theme="dark"] .badge,
	[data-bs-theme="dark"] .current-plan-badge {
		color: #FFFFFF !important;
	}

	.dark-mode .current-billing-cycle,
	.dark-mode .current-billing-cycle *,
	.dark-mode .badge,
	.dark-mode .current-plan-badge {
		color: #F59E0B !important;
	}

	/* Mobile responsive styles */
	@@media (max-width: 768px) {
		.table-responsive {
			display: none;
		}

		.mobile-cards {
			display: block;
		}
	}

	@@media (min-width: 769px) {
		.mobile-cards {
			display: none;
		}
	}

	.subscription-card {
		border: 1px solid var(--bs-border-color, #E2E8F0);
		border-radius: 8px;
		margin-bottom: 1rem;
		padding: 1rem;
		background: var(--bs-body-bg, white);
	}

		.subscription-card .partner-name {
			font-weight: 600;
			font-size: 1.1rem;
			color: var(--bs-body-color, #2A3A4A);
			margin-bottom: 0.5rem;
		}

		.subscription-card .plan-info {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 0.5rem;
		}

		.subscription-card .amount {
			font-weight: 600;
			color: #16A34A;
			font-size: 1.1rem;
		}

	/* Aggressive dark mode overrides for modal */
	[data-bs-theme="dark"] .modal-content,
	[data-bs-theme="dark"] .modal-header,
	[data-bs-theme="dark"] .modal-body,
	[data-bs-theme="dark"] .modal-footer {
		background-color: var(--bs-body-bg) !important;
		color: var(--bs-body-color) !important;
		border-color: var(--bs-border-color) !important;
	}

		[data-bs-theme="dark"] .modal-content *,
		[data-bs-theme="dark"] .modal-header *,
		[data-bs-theme="dark"] .modal-body *,
		[data-bs-theme="dark"] .modal-footer *,
		[data-bs-theme="dark"] .plan-card *,
		[data-bs-theme="dark"] .card *,
		[data-bs-theme="dark"] .card-body *,
		[data-bs-theme="dark"] .plan-name,
		[data-bs-theme="dark"] .price-label,
		[data-bs-theme="dark"] .price-amount,
		[data-bs-theme="dark"] .price-currency,
		[data-bs-theme="dark"] .feature-group h6,
		[data-bs-theme="dark"] .feature-item {
			color: var(--bs-body-color) !important;
		}

	.dark-mode .modal-content,
	.dark-mode .modal-content *,
	.dark-mode .plan-card,
	.dark-mode .plan-card *,
	.dark-mode .card,
	.dark-mode .card-body,
	.dark-mode .plan-name,
	.dark-mode .price-label,
	.dark-mode .price-amount,
	.dark-mode .price-currency,
	.dark-mode .feature-group h6,
	.dark-mode .feature-item {
		color: #FFFFFF !important;
	}

		/* Override any specific current billing cycle or active plan card colors for dark mode */
		.dark-mode .current-billing-cycle,
		.dark-mode .current-billing-cycle *,
		.dark-mode .plan-card.active-plan,
		.dark-mode .plan-card.active-plan * {
			color: #FFFFFF !important;
		}

			/* Override current current billing cycle in dark mode */
			.dark-mode .current-billing-cycle .price-label,
			.dark-mode .current-billing-cycle .price-amount {
				color: #B45309 !important;
			}

		/* Specific override for active plan card */
		.dark-mode .plan-card.active-plan {
			background-color: #F59E0B !important;
		}

			.dark-mode .plan-card.active-plan * {
				color: #FFFFFF !important;
			}

			.dark-mode .plan-card.active-plan .badge {
				color: #FFFFFF !important;
			}
			/* Specific override for active plan card */
			.dark-mode .plan-card.active-plan *[style*="background-color"],
			.dark-mode .plan-card.active-plan *[style*="background-image"],
			.dark-mode .plan-card.active-plan *[style*="background:"],
			.dark-mode .plan-card.active-plan *[class*="-card"],
			.dark-mode .plan-card.active-plan *[class*="-badge"],
			.dark-mode .plan-card.active-plan *[class*="-button"],
			.dark-mode .plan-card.active-plan *[class*="-btn"] {
				color: #FFFFFF !important;
			}

	/* Dark mode support for billing toggle buttons in upgrade modal */
	[data-bs-theme="dark"] .billing-toggle button,
	.dark-mode .billing-toggle button {
		background: #2A3A4A !important;
		color: #FFFFFF !important;
		border-color: #6B7B8D !important;
	}

		[data-bs-theme="dark"] .billing-toggle button.active,
		.dark-mode .billing-toggle button.active {
			background: #2589C9 !important;
			color: #FFFFFF !important;
			border-color: #2589C9 !important;
		}

	/* Billing cycle in dark mode */
	.dark-mode .current-billing-cycle .price-label,
	.dark-mode .current-billing-cycle .price-amount {
		color: #B45309 !important;
	}

	/* Override global dark mode styles with higher specificity */
	.dark-mode *[style*="background-color"],
	.dark-mode *[style*="background-image"],
	.dark-mode *[style*="background:"],
	.dark-mode *[class*="-card"],
	.dark-mode *[class*="-badge"],
	.dark-mode *[class*="-button"],
	.dark-mode *[class*="-btn"] {
		color: #FFFFFF !important;
	}

	/* Billing cycle in dark mode */
	.dark-mode .current-billing-cycle .price-label,
	.dark-mode .current-billing-cycle .price-amount {
		color: #B45309 !important;
	}
</style>
@model List<CRM.MasterDb.Models.TenantSubscriptionModel>
@{
	ViewData["Title"] = "Manage Tenant Subscriptions";
}

<div class="container-fluid">
	<div class="page-hd"><i class="fa-solid fa-server"></i><h4>Manage Tenant Subscriptions</h4></div>
	<div class="row">
		<div class="col-12">
			<div class="card">
				<div class="card-header">
					<h5 class="card-title mb-0">Active Tenant Subscriptions</h5>
				</div>
				<div class="card-body">
					<form method="get" class="mb-4">
						<div class="row g-3">
							<div class="col-md-3">
								<input type="text" class="form-control" name="search" id="searchInput" value="@ViewBag.Search" placeholder="Search partner name..." />
							</div>
							<div class="col-md-2">
								<select class="form-select" name="plan" onchange="autoSubmitForm()">
									<option value="">All Plans</option>
									@if (ViewBag.Plans != null)
									{
										foreach (var plan in ViewBag.Plans)
										{
											<option value="@plan.PlanId" selected="@(ViewBag.SelectedPlan == plan.PlanId.ToString())">@plan.PlanName</option>
										}
									}
								</select>
							</div>
							<div class="col-md-2">
								<select class="form-select" name="billing" onchange="autoSubmitForm()">
									<option value="">All Billing</option>
									<option value="Monthly" selected="@(ViewBag.SelectedBilling == "Monthly")">Monthly</option>
									<option value="Annual" selected="@(ViewBag.SelectedBilling == "Annual")">Annual</option>
								</select>
							</div>
							<div class="col-md-2">
								<input type="date" class="form-control" name="fromDate" value="@ViewBag.FromDate" onchange="autoSubmitForm()" placeholder="From Date" />
							</div>
							<div class="col-md-2">
								<input type="date" class="form-control" name="toDate" value="@ViewBag.ToDate" onchange="autoSubmitForm()" placeholder="To Date" />
							</div>
							<div class="col-md-1">
								<button type="submit" class="btn btn-primary w-100">Filter</button>
							</div>
						</div>
					</form>
					@* 				</div>
			</div>
		</div>
	</div>
</div> *@

					<div class="table-responsive">
						<table class="table table-striped">
							<thead>
								<tr>
									<th>Partner</th>
									<th>Plan</th>
									<th>Billing</th>
									<th>Amount</th>
									<th>Start Date</th>
									<th>End Date</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody>
								@if (Model?.Any() == true)
								{
									foreach (var subscription in Model)
									{
										<tr>
											<td>@subscription.Tenant?.CompanyName</td>
											<td>
												@if (subscription.Plan != null)
												{
													@subscription.Plan.PlanName
												}
												else
												{
													<span class="text-muted">No Plan</span>
												}
											</td>



											<td>
												@if (!string.IsNullOrEmpty(subscription.BillingCycle) && subscription.BillingCycle != "No Plan")
												{
													@subscription.BillingCycle
												}
												else
												{
													<span class="text-muted">-</span>
												}
											</td>
											<td>
												@if (subscription.Amount > 0)
												{
												<span>₹@subscription.Amount.ToString("N2")</span>
											}
											else
											{
												<span class="text-muted">₹0.00</span>
											}
											</td>
											<td>
												@if (subscription.StartDate != DateTime.MinValue)
												{
													@subscription.StartDate.ToString("dd/MM/yyyy")
												}
												else
												{
													<span class="text-muted">-</span>
												}
											</td>
											<td>
												@if (subscription.EndDate != DateTime.MinValue)
												{
													@subscription.EndDate.ToString("dd/MM/yyyy")
													@if (subscription.Status == "Active" && subscription.EndDate <= DateTime.Now)
													{
														<br>

														<small class="text-danger">Expired</small>
													}
													else if (subscription.Status == "Active" && subscription.EndDate <= DateTime.Now.AddDays(7))
													{
														<br>

														<small class="text-warning">Expiring Soon</small>
													}
												}
												else
												{
													<span class="text-muted">-</span>
												}
											</td>
											<td>
												@if (subscription.Status == "Active" && subscription.EndDate > DateTime.Now)
												{
													<button class="btn btn-sm btn-primary" onclick="openUpgradeModal(@subscription.TenantId)">
														<i class="fa-solid fa-rocket me-1"></i>Upgrade
													</button>
												}
												else if (subscription.Status == "No Plan" || subscription.Status == "Expired" || subscription.Status == "Cancelled")
												{
													<button class="btn btn-sm btn-success" onclick="openUpgradeModal(@subscription.TenantId)">
														<i class="fa-solid fa-plus-circle me-1"></i>Assign Plan
													</button>
												}
												else
												{
													<button class="btn btn-sm btn-primary" onclick="openUpgradeModal(@subscription.TenantId)">
														<i class="fa-solid fa-rocket me-1"></i>Manage
													</button>
												}
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="7" class="text-center">No active subscriptions found</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					<div class="mobile-cards">
						@if (Model?.Any() == true)
						{
							@foreach (var subscription in Model)
							{
								<div class="subscription-card">
									<div class="partner-name">@subscription.Tenant?.CompanyName</div>
									<div class="plan-info">
										<span>
											<strong>
												@if (subscription.Plan != null)
												{
													@subscription.Plan.PlanName
												}
												else
												{
													<span class="text-muted">No Plan</span>
												}
											</strong>
										</span>
										<span class="amount">
											@if (subscription.Amount > 0)
											{
												<span>₹@subscription.Amount.ToString("N2")</span>
											}
											else
											{
												<span class="text-muted">₹0.00</span>
											}
										</span>
									</div>
									<div class="row">
										<div class="col-6">
											<small class="text-muted">Billing:</small><br />
											<span>
												@if (!string.IsNullOrEmpty(subscription.BillingCycle) && subscription.BillingCycle != "No Plan")
												{
													@subscription.BillingCycle
												}
												else
												{
													<span class="text-muted">-</span>
												}
											</span>
										</div>
										<div class="col-6">
											<small class="text-muted">End Date:</small><br />
											<span>
												@if (subscription.EndDate != DateTime.MinValue)
												{
													@subscription.EndDate.ToString("dd/MM/yyyy")
													@if (subscription.Status == "Active" && subscription.EndDate <= DateTime.Now)
													{
														<br />

														<small class="text-danger">Expired</small>
													}
													else if (subscription.Status == "Active" && subscription.EndDate <= DateTime.Now.AddDays(7))
													{
														<br />

														<small class="text-warning">Expiring Soon</small>
													}
												}
												else
												{
													<span class="text-muted">-</span>
												}
											</span>
										</div>
									</div>
									<div class="mt-2">
										@if (subscription.Status == "Active" && subscription.EndDate > DateTime.Now)
										{
											<button class="btn btn-sm btn-primary w-100" onclick="openUpgradeModal(@subscription.TenantId)">
												<i class="fa-solid fa-rocket me-1"></i>Upgrade Plan
											</button>
										}
										else if (subscription.Status == "No Plan" || subscription.Status == "Expired" || subscription.Status == "Cancelled" || subscription.Status == "Suspended")
										{
											<button class="btn btn-sm btn-success w-100" onclick="openUpgradeModal(@subscription.TenantId)">
												<i class="fa-solid fa-plus me-1"></i>Assign Plan
											</button>
										}
										else
										{
											<button class="btn btn-sm btn-primary w-100" onclick="openUpgradeModal(@subscription.TenantId)">
												<i class="fa-solid fa-rocket me-1"></i>Manage Plan
											</button>
										}
									</div>
								</div>
							}
						}
						else
						{
							<div class="text-center py-4">
								<p class="text-muted">No active subscriptions found</p>
							</div>
						}
					</div>
					}

					<!-- Pagination -->
					@if (ViewBag.TotalPages > 1)
					{
						<nav aria-label="Page navigation" class="mt-4">
							<ul class="pagination justify-content-center">
								@if (ViewBag.CurrentPage > 1)
								{
									<li class="page-item">
										<a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search&plan=@ViewBag.SelectedPlan&billing=@ViewBag.SelectedBilling&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate">Previous</a>
									</li>
								}

								@for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
								{
									<li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
										<a class="page-link" href="?page=@i&search=@ViewBag.Search&plan=@ViewBag.SelectedPlan&billing=@ViewBag.SelectedBilling&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate">@i</a>
									</li>
								}

								@if (ViewBag.CurrentPage < ViewBag.TotalPages)
								{
									<li class="page-item">
										<a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search&plan=@ViewBag.SelectedPlan&billing=@ViewBag.SelectedBilling&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate">Next</a>
									</li>
								}
							</ul>
						</nav>
					}
				</div>
			</div>
		</div>
	</div>

@Html.Partial("_UpgradeModal")

	<div class="modal fade" id="upgradePlanModal" tabindex="-1">
		<div class="modal-dialog" style="max-width: 50%;">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Upgrade Partner Plan</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body">
					@Html.AntiForgeryToken()
					<input type="hidden" id="tenantId" />
					<input type="hidden" id="currentPlanId" />
					<div class="row">
						@if (ViewBag.AvailablePlans != null)
						{
							@foreach (var plan in ViewBag.AvailablePlans)
							{
								<div class="col-lg-6 col-md-12 mb-4">
									<div class="card h-100 plan-card" id="plan-@plan.PlanId">
										<div class="card-body d-flex flex-column">
											<div class="plan-header">
												<div>
													<h5 class="plan-name">@plan.PlanName</h5>
													@if (!string.IsNullOrEmpty(plan.Description))
													{
														<p class="text-muted mb-0 small">@plan.Description</p>
													}
												</div>
											</div>
											<div class="d-flex align-items-center gap-2 mb-2">
												<span class="plan-type @plan.PlanType.ToLower()">@plan.PlanType</span>
												<span class="badge bg-success current-plan-badge" style="display: none;">Current Plan</span>
											</div>
											<div class="current-plan-expire" style="display: none;">
												<small class="text-muted">Expires: <span class="expire-date"></span></small>
											</div>

											<div class="plan-pricing mb-3 mt-3">
												<div class="row">
													<div class="col-6 monthly-pricing">
														<div class="price-label">Monthly</div>
														<div class="price-amount">
															<span>@plan.PriceCurrency</span>@plan.MonthlyPrice.ToString("N0")
														</div>
													</div>
													<div class="col-6 annual-pricing">
														<div class="price-label">Annual</div>
														<div class="price-amount">
															<span>@plan.PriceCurrency</span>@plan.YearlyPrice.ToString("N0")
														</div>
													</div>
												</div>
											</div>

											<div class="plan-features flex-grow-1">
												@{
													var hasIntegrations = plan.HasWhatsAppIntegration || plan.HasFacebookIntegration || plan.HasEmailIntegration || plan.HasCustomAPIIntegration;
													var hasReportsSupport = plan.HasAdvancedReports || plan.HasPrioritySupport;
												}

												@if (hasIntegrations)
												{
													<div class="feature-group mb-3">
														<h6>Integrations</h6>
														@if (plan.HasWhatsAppIntegration)
														{
															<div class="feature-item">
																<i class="fa-brands fa-whatsapp"></i>
																<span>WhatsApp</span>
															</div>
														}
														@if (plan.HasFacebookIntegration)
														{
															<div class="feature-item">
																<i class="fa-brands fa-facebook"></i>
																<span>Facebook</span>
															</div>
														}
														@if (plan.HasEmailIntegration)
														{
															<div class="feature-item">
																<i class="fa-solid fa-envelope"></i>
																<span>Email</span>
															</div>
														}
														@if (plan.HasCustomAPIIntegration)
														{
															<div class="feature-item">
																<i class="fa-solid fa-code"></i>
																<span>Custom API</span>
															</div>
														}
													</div>
												}

												@if (hasReportsSupport)
												{
													<div class="feature-group mb-3">
														<h6>Reports & Support</h6>
														@if (plan.HasAdvancedReports)
														{
															<div class="feature-item">
																<i class="fa-solid fa-chart-bar"></i>
																<span>Advanced Reports</span>
															</div>
														}
														@if (plan.HasPrioritySupport)
														{
															<div class="feature-item">
																<i class="fa-solid fa-headset"></i>
																<span>@plan.SupportLevel Support</span>
															</div>
														}
													</div>
												}
											</div>

											<div class="plan-actions mt-auto">
												<div class="d-flex gap-1">
													<button type="button" class="btn btn-success btn-sm flex-fill"
															onclick="selectPlan(@plan.PlanId, 'Monthly', @plan.MonthlyPrice, false)">
														Schedule Monthly
													</button>
													<button type="button" class="btn btn-primary btn-sm flex-fill"
															onclick="selectPlan(@plan.PlanId, 'Annual', @plan.YearlyPrice, false)">
														Schedule Annual
													</button>
												</div>
												<div class="d-flex gap-1 mt-2">
													<button type="button" class="btn btn-warning btn-sm flex-fill"
															onclick="selectPlan(@plan.PlanId, 'Monthly', @plan.MonthlyPrice, true)">
														Now Monthly
													</button>
													<button type="button" class="btn btn-danger btn-sm flex-fill"
															onclick="selectPlan(@plan.PlanId, 'Annual', @plan.YearlyPrice, true)">
														Now Annual
													</button>
												</div>
											</div>
										</div>
									</div>
								</div>
							}
						}
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				</div>
			</div>
		</div>
	</div>

	<script>
		let searchTimeout;
		function autoSubmitForm() {
			document.querySelector('form').submit();
		}

		document.getElementById('searchInput').addEventListener('input', function() {
			clearTimeout(searchTimeout);
			searchTimeout = setTimeout(() => {
				autoSubmitForm();
			}, 500);
		});

		function openUpgradeModal(tenantId) {
			console.log('Opening upgrade modal for partner:', tenantId);
			resetUpgradeModal();

			// Load partner data and upgrade options
			fetch(`/SaaSSubscription/GetUpgradeOptions?tenantId=${tenantId}`)
				.then(response => response.json())
				.then(data => {
					console.log('API Response:', data);
					if (data.success) {
						currentPartnerData = data;
						populatePartnerInfo(data.partner);
						populateAvailablePlans(data.availablePlans);

						// Show the modal
						new bootstrap.Modal(document.getElementById('upgradePlanModal')).show();
					} else {
						console.log('Error:', data.message);
						showToast('Error: ' + data.message, 'error');
					}
				})
				.catch(error => {
					console.error('Error loading upgrade options:', error);
					showToast('Failed to load upgrade options', 'error');
				});
		}
	</script>
