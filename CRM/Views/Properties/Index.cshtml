</div>

<!-- Add/Edit Property Modal -->
@await Html.PartialAsync("_PropertyModal")

<!-- ── Bulk Upload Modal ── -->
<div class="modal fade bulk-modal" id="bulkUploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-file-arrow-up"></i> Bulk Upload Properties
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" style="font-size:10px;"></button>
            </div>

            <!-- Body -->
            <form id="bulkUploadForm" novalidate>
                <div class="modal-body">

                    <!-- Drop zone -->
                    <div class="upload-zone" id="uploadZone">
                        <input type="file" id="bulkUploadFile" accept=".xlsx,.xls" tabindex="-1">
                        <div class="uz-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                        <div class="uz-title">Drop file here or click to browse</div>
                        <div class="uz-sub">Supports Excel files only</div>
                        <div class="file-types">
                            <span class="ftype-badge ftype-xlsx">.xlsx</span>
                            <span class="ftype-badge ftype-xls">.xls</span>
                        </div>
                        <div class="uz-filename" id="uzFilename">
                            <i class="fa-solid fa-file-excel"></i>
                            <span id="uzFilenameText"></span>
                        </div>
                    </div>

                    <!-- Error message -->
                    <div class="bulk-err" id="bulkErr">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span id="bulkErrText"></span>
                    </div>

                    <!-- Progress -->
                    <div class="bulk-progress" id="bulkProgress">
                        <div class="bulk-progress-bar"><div class="bulk-progress-fill"></div></div>
                        <div class="bulk-progress-txt">Uploading, please wait...</div>
                    </div>

                    <!-- Sample download row -->
                    <div class="bulk-info-row">
                        <span><i class="fa-solid fa-circle-info me-1"></i>Download sample template to fill data</span>
                        <button type="button" id="downloadSample"
                                style="background:var(--blue);color:#FFFFFF;border:none;border-radius:4px;font-size:10px;padding:3px 9px;font-weight:600;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:3px;">
                            <i class="fa-solid fa-download" style="font-size:9px;"></i>Download
                        </button>
                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="bmf-btn bmf-cancel" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark"></i> Cancel
                    </button>
                    <button type="submit" class="bmf-btn bmf-upload" id="btnBulkUpload" disabled>
                        <i class="fa-solid fa-upload"></i> Upload
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        // ── Global variables ──────────────────────────────────────────────
       
        let allProperties = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        const _enc = {@foreach(var l in Model){
        @Html.Raw($"'{l.PropertyId}': '{IdObfuscator.Encode(l.PropertyId)}',")
    }
    };

    allProperties.forEach(l => l.EncodedId = _enc[l.PropertyId]);

    let filteredProperties = [...allProperties];
        let currentPage = 1;
        let pageSize = 10;
        let isEditMode = false;
        userRole = '@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value';
        let canCreateProperty = @Html.Raw((canCreate ? "true" : "false"));
        let canDeleteProperty = @Html.Raw((canDelete ? "true" : "false"));

        function canEdit()   { return canCreateProperty; }
        function canDelete() { return canDeleteProperty; }

        function getEditButton(propertyId) {
            if (canEdit()) {
                return `<button class="btn-action btn-edit" onclick="editProperty(${propertyId})" title="Edit">
                    <i class="fa-solid fa-pen-to-square"></i> Edit
                </button>`;
            }
            return '';
        }
        function getDeleteButton(propertyId) {
            if (canDelete()) {
                return `<button class="btn-action btn-delete" onclick="deleteProperty(${propertyId})" title="Delete">
                    <i class="fa-solid fa-trash"></i> Del
                </button>`;
            }
            return '';
        }

        // ── Data from server ──────────────────────────────────────────────
        let builders   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Builders   ?? new object[0]));
        let executives = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Executives ?? new object[0]));

        function getBuilderName(builderId) {
            if (!builderId || !builders) return '-';
            const b = builders.find(b => b.BuilderId === builderId);
            return b ? b.BuilderName : '-';
        }
        function getExecutiveName(executiveId) {
            if (!executiveId || !executives) return '-';
            const e = executives.find(e => e.UserId === executiveId);
            if (!e) return '-';
            return (e.FullName && e.FullName.trim()) || (e.Username && e.Username.trim()) || '-';
        }

        // ── Init ──────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            renderTable();
            attachEventListeners();
            initFilters();
            initBulkUpload();
            setTimeout(() => {
                document.querySelectorAll('.alert').forEach(a => bootstrap.Alert.getOrCreateInstance(a).close());
            }, 5000);
        });

        function initFilters() {
            const fc = document.getElementById('filterContent');
            if (window.innerWidth > 768) fc.classList.add('show');
        }
        function toggleFilters() {
            document.getElementById('filterContent').classList.toggle('show');
            document.getElementById('filterToggleIcon').classList.toggle('rotated');
        }

        function attachEventListeners() {
            document.getElementById('searchBox').addEventListener('input', applyFilters);
            document.getElementById('filterBuilder').addEventListener('change', applyFilters);
            const af = document.getElementById('filterAssignedTo');
            if (af) af.addEventListener('change', applyFilters);
            document.getElementById('exportExcel').addEventListener('click', exportToExcel);
            document.getElementById('exportCSV').addEventListener('click', exportToCSV);
            document.getElementById('downloadSample').addEventListener('click', downloadSample);
            document.getElementById('bulkUploadForm').addEventListener('submit', handleBulkUpload);
        }

        // ── Bulk Upload UI logic ──────────────────────────────────────────
        function initBulkUpload() {
            const zone   = document.getElementById('uploadZone');
            const input  = document.getElementById('bulkUploadFile');
            const modal  = document.getElementById('bulkUploadModal');

            // Reset on modal open
            modal.addEventListener('show.bs.modal', resetBulkModal);

            // File selected via click
            input.addEventListener('change', function () {
                handleFileSelected(this.files[0]);
            });

            // Drag & drop
            zone.addEventListener('dragover', function (e) {
                e.preventDefault(); zone.classList.add('drag-over');
            });
            zone.addEventListener('dragleave', function () {
                zone.classList.remove('drag-over');
            });
            zone.addEventListener('drop', function (e) {
                e.preventDefault(); zone.classList.remove('drag-over');
                const file = e.dataTransfer.files[0];
                if (file) { input.files = e.dataTransfer.files; handleFileSelected(file); }
            });
        }

        function resetBulkModal() {
            document.getElementById('bulkUploadFile').value = '';
            document.getElementById('uploadZone').classList.remove('has-file', 'drag-over');
            document.getElementById('uzFilename').classList.remove('show');
            document.getElementById('uzFilenameText').textContent = '';
            hideBulkErr();
            document.getElementById('bulkProgress').classList.remove('show');
            document.getElementById('btnBulkUpload').disabled = true;
        }

        function handleFileSelected(file) {
            hideBulkErr();
            if (!file) return;

            // Validate type
            const allowed = ['application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                             'application/vnd.ms-excel'];
            const ext = file.name.split('.').pop().toLowerCase();
            if (!allowed.includes(file.type) && ext !== 'xlsx' && ext !== 'xls') {
                showBulkErr('Invalid file type. Please upload a .xlsx or .xls file only.');
                document.getElementById('bulkUploadFile').value = '';
                document.getElementById('uploadZone').classList.remove('has-file');
                document.getElementById('uzFilename').classList.remove('show');
                document.getElementById('btnBulkUpload').disabled = true;
                return;
            }

            // Validate size (max 10 MB)
            const maxMB = 10;
            if (file.size > maxMB * 1024 * 1024) {
                showBulkErr(`File too large. Maximum allowed size is ${maxMB} MB.`);
                document.getElementById('bulkUploadFile').value = '';
                document.getElementById('uploadZone').classList.remove('has-file');
                document.getElementById('uzFilename').classList.remove('show');
                document.getElementById('btnBulkUpload').disabled = true;
                return;
            }

            // All good
            document.getElementById('uploadZone').classList.add('has-file');
            document.getElementById('uzFilenameText').textContent = file.name;
            document.getElementById('uzFilename').classList.add('show');
            document.getElementById('btnBulkUpload').disabled = false;
        }

        function showBulkErr(msg) {
            const el = document.getElementById('bulkErr');
            document.getElementById('bulkErrText').textContent = msg;
            el.classList.add('show');
        }
        function hideBulkErr() {
            document.getElementById('bulkErr').classList.remove('show');
        }

        // ── Filters ───────────────────────────────────────────────────────
        function applyFilters() {
            const search = document.getElementById('searchBox').value.toLowerCase();
            const bld = document.getElementById('filterBuilder').value;
            const af = document.getElementById('filterAssignedTo');
            const asgn = af ? af.value : '';
            filteredProperties = allProperties.filter(p => {
                const nm = (p.PropertyName || '').toLowerCase();
                const lc = (p.Location || '').toLowerCase();
                const ok1 = !search || nm.includes(search) || lc.includes(search) || getBuilderName(p.BuilderId).toLowerCase().includes(search);
                const ok2 = !bld  || p.BuilderId  == parseInt(bld);
                const ok3 = !asgn || p.AssignedTo == parseInt(asgn);
                return ok1 && ok2 && ok3;
            });
            currentPage = 1;
            renderTable();
        }
        function clearFilters() {
            document.getElementById('searchBox').value = '';
            document.getElementById('filterBuilder').value = '';
            const af = document.getElementById('filterAssignedTo');
            if (af) af.value = '';
            filteredProperties = [...allProperties];
            currentPage = 1;
            renderTable();
        }

        // ── Render ────────────────────────────────────────────────────────
        function renderTable() {
            const container = document.getElementById('propertiesContainer');
            const start = (currentPage - 1) * pageSize;
            const paged = filteredProperties.slice(start, start + pageSize);
            container.innerHTML = '';

            if (paged.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fa-solid fa-building"></i>
                        <h5 style="font-size:12px;font-weight:700;color:#2A3A4A;margin-bottom:4px;">No Properties Found</h5>
                        <p style="font-size:11px;color:#8FA3B8;margin-bottom:8px;">Add your first property or adjust the filters</p>
                        ${canCreateProperty ? '<button type="button" class="mbtn mbtn-blue" data-bs-toggle="modal" data-bs-target="#addPropertyModal"><i class="fa-solid fa-plus me-1"></i>Add Property</button>' : ''}
                    </div>`;
                document.getElementById('paginationWrapper').style.display = 'none';
            } else {
                paged.forEach(p => {
                    const card = document.createElement('div');
                    card.className = 'prop-card';

                    let imgHtml = `<div class="prop-card-img"><i class="fa-solid fa-image" style="opacity:.4;font-size:14px;"></i></div>`;
                    if (p.PropertyImage) {
                        try {
                            let b64 = '';
                            if (typeof p.PropertyImage === 'string') {
                                b64 = p.PropertyImage;
                            } else if (p.PropertyImage.length > 0) {
                                const bytes = new Uint8Array(p.PropertyImage);
                                let bin = '';
                                for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
                                b64 = btoa(bin);
                            }
                            if (b64) imgHtml = `<div class="prop-card-img"><img src="data:image/jpeg;base64,${b64}" alt="Property"></div>`;
                        } catch (e) { console.error('Image error', e); }
                    }

                    const pid  = p.PropertyId;
                    const nm   = p.PropertyName || 'Unnamed Property';
                    const loc  = p.Location || 'No location';
                    const sqft = p.AreaSqft;
                    const pr   = p.Price;
                    const bid  = p.BuilderId;
                    const aid  = p.AssignedTo;
                    const dt   = p.CreatedOn;

                    card.innerHTML = `
                        ${imgHtml}
                        <div class="prop-card-body">
        <a href="/propertydetails/${p.EncodedId}" class="prop-card-name">${nm}</a>
                            <div class="prop-meta-row">
                                <div class="prop-meta-item"><i class="fa-solid fa-map-marker-alt"></i>${loc}</div>
                                <div class="prop-meta-item"><i class="fa-solid fa-hashtag"></i>ID: ${pid}</div>
                                <div class="prop-meta-item"><i class="fa-solid fa-hammer"></i>${getBuilderName(bid)}</div>
                                <div class="prop-meta-item"><i class="fa-solid fa-user-tie"></i>${getExecutiveName(aid)}</div>
                                <div class="prop-meta-item"><i class="fa-solid fa-calendar"></i>${formatDate(dt)}</div>
                                <div class="prop-meta-item"><i class="fa-solid fa-ruler-combined"></i>${sqft || 'N/A'} sqft</div>
                            </div>
                            <div class="prop-price">₹${pr ? pr.toLocaleString() : 'N/A'}</div>
                        </div>
                        <div class="action-buttons">
                            ${getEditButton(pid)}
                            ${getDeleteButton(pid)}
                        </div>`;
                    container.appendChild(card);
                });
                document.getElementById('paginationWrapper').style.display = 'block';
            }
            updatePaginationInfo();
            renderPagination();
            updateStats();
        }

        function updateStats() {
            const el = document.getElementById('totalProperties');
            if (el) el.textContent = filteredProperties.length;
        }
        function formatDate(d) {
            if (!d) return '-';
            return new Date(d).toLocaleDateString('en-GB');
        }
        function updatePaginationInfo() {
            const total = filteredProperties.length;
            const s = total === 0 ? 0 : (currentPage - 1) * pageSize + 1;
            const e = Math.min(currentPage * pageSize, total);
            ['showingStart','showingStartMob'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = s; });
            ['showingEnd','showingEndMob'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = e; });
            ['totalRecords','totalRecordsMob','totalRecords2'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = total; });
            const s2 = document.getElementById('showingStart2'); if (s2) s2.textContent = s;
            const e2 = document.getElementById('showingEnd2');   if (e2) e2.textContent = e;
        }

        // ── Pagination ────────────────────────────────────────────────────
        function renderPagination() {
            const ul = document.getElementById('pagination');
            const totalPages = Math.ceil(filteredProperties.length / pageSize);
            ul.innerHTML = '';
            if (totalPages <= 1) {
                const li = document.createElement('li'); li.className = 'page-item active';
                li.innerHTML = '<span class="page-link">1</span>'; ul.appendChild(li); return;
            }
            const prev = document.createElement('li');
            prev.className = `page-item ${currentPage===1?'disabled':''}`;
            prev.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage-1});return false;"><span class="d-none d-sm-inline">Prev</span><span class="d-inline d-sm-none">&laquo;</span></a>`;
            ul.appendChild(prev);
            const sp = Math.max(1, currentPage-2), ep = Math.min(totalPages, currentPage+2);
            if (sp > 1) {
                const li = document.createElement('li'); li.className = 'page-item';
                li.innerHTML = `<a class="page-link" href="#" onclick="changePage(1);return false;">1</a>`; ul.appendChild(li);
                if (sp > 2) { const d = document.createElement('li'); d.className = 'page-item disabled'; d.innerHTML = '<span class="page-link">…</span>'; ul.appendChild(d); }
            }
            for (let i = sp; i <= ep; i++) {
                const li = document.createElement('li'); li.className = `page-item ${i===currentPage?'active':''}`;
                li.innerHTML = `<a class="page-link" href="#" onclick="changePage(${i});return false;">${i}</a>`; ul.appendChild(li);
            }
            if (ep < totalPages) {
                if (ep < totalPages-1) { const d = document.createElement('li'); d.className = 'page-item disabled'; d.innerHTML = '<span class="page-link">…</span>'; ul.appendChild(d); }
                const li = document.createElement('li'); li.className = 'page-item';
                li.innerHTML = `<a class="page-link" href="#" onclick="changePage(${totalPages});return false;">${totalPages}</a>`; ul.appendChild(li);
            }
            const next = document.createElement('li');
            next.className = `page-item ${currentPage===totalPages?'disabled':''}`;
            next.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage+1});return false;"><span class="d-none d-sm-inline">Next</span><span class="d-inline d-sm-none">&raquo;</span></a>`;
            ul.appendChild(next);
        }
        function changePage(page) {
            const tp = Math.ceil(filteredProperties.length / pageSize);
            if (page < 1 || page > tp) return;
            currentPage = page; renderTable();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ── CRUD ──────────────────────────────────────────────────────────
        function editProperty(id) {
            fetch(`/Properties/GetProperty?id=${id}`)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        if (window.populatePropertyModal) window.populatePropertyModal(data);
                        new bootstrap.Modal(document.getElementById('addPropertyModal')).show();
                    } else showToast(data.message || 'Error loading property', 'error');
                })
                .catch(() => showToast('Error loading property', 'error'));
        }
        function deleteProperty(id) {
            if (!confirm('Are you sure you want to delete this property?')) return;
            fetch(`/Properties/Delete?id=${id}`, { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        allProperties       = allProperties.filter(p => p.PropertyId !== id);
                        filteredProperties  = filteredProperties.filter(p => p.PropertyId !== id);
                        renderTable(); showToast('Property deleted successfully!', 'success');
                    } else showToast(data.message || 'Error deleting property', 'error');
                })
                .catch(() => showToast('Error deleting property', 'error'));
        }

        // ── Export / Download ─────────────────────────────────────────────
        function downloadSample() {
            const sampleData = [
                ['Property Name','Builder Name','Location','Area (Sqft)','Price','Purchase Type','Flat Number','Floor Number','Unit','Property Group','Inventory','Assigned To (User ID)'],
                ['Sample Property 1','Sample Builder','Hyderabad','1200','5000000','Sale','101','1','Sqft','Residential','Available','1'],
                ['Sample Property 2','Sample Builder','Bangalore','1500','7500000','Rent','201','2','Sqft','Commercial','Sold','1']
            ];
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet(sampleData);
            ws['!cols'] = [{wch:25},{wch:20},{wch:15},{wch:12},{wch:15},{wch:15},{wch:12},{wch:12},{wch:10},{wch:15},{wch:12},{wch:20}];
            XLSX.utils.book_append_sheet(wb, ws, 'Properties');
            XLSX.writeFile(wb, 'Properties_Sample_Template.xlsx');
            showToast('Sample template downloaded!', 'success');
        }
        function exportToExcel() {
            if (!filteredProperties.length) { showToast('No data to export','error'); return; }
            const rows = [['Property ID','Property Name','Builder','Location','Area (Sqft)','Price','Purchase Type','Assigned To','Created Date']];
            filteredProperties.forEach(p => rows.push([p.PropertyId||'',p.PropertyName||'',getBuilderName(p.BuilderId),p.Location||'',p.AreaSqft||'',p.Price||'',p.PurchaseType||'',getExecutiveName(p.AssignedTo),formatDate(p.CreatedOn)]));
            const wb = XLSX.utils.book_new(), ws = XLSX.utils.aoa_to_sheet(rows);
            ws['!cols'] = [{wch:12},{wch:25},{wch:20},{wch:20},{wch:12},{wch:15},{wch:15},{wch:20},{wch:15}];
            XLSX.utils.book_append_sheet(wb, ws, 'Properties');
            XLSX.writeFile(wb, `Properties_Export_${new Date().toISOString().split('T')[0]}.xlsx`);
            showToast('Excel exported!', 'success');
        }
        function exportToCSV() {
            if (!filteredProperties.length) { showToast('No data to export','error'); return; }
            let csv = 'Property ID,Property Name,Builder,Location,Area (Sqft),Price,Purchase Type,Assigned To,Created Date\n';
            filteredProperties.forEach(p => { csv += [p.PropertyId||'',escapeCSV(p.PropertyName),escapeCSV(getBuilderName(p.BuilderId)),escapeCSV(p.Location),p.AreaSqft||'',p.Price||'',escapeCSV(p.PurchaseType),escapeCSV(getExecutiveName(p.AssignedTo)),formatDate(p.CreatedOn)].join(',') + '\n'; });
            const a = Object.assign(document.createElement('a'),{href:URL.createObjectURL(new Blob([csv],{type:'text/csv'})),download:`Properties_Export_${new Date().toISOString().split('T')[0]}.csv`});
            a.click(); URL.revokeObjectURL(a.href);
            showToast('CSV exported!', 'success');
        }
        function escapeCSV(v) {
            if (!v) return ''; v = v.toString();
            return (v.includes(',') || v.includes('"') || v.includes('\n')) ? '"' + v.replace(/"/g,'""') + '"' : v;
        }

        function handleBulkUpload(e) {
            e.preventDefault();
            hideBulkErr();

            const file = document.getElementById('bulkUploadFile').files[0];
            if (!file) {
                showBulkErr('Please select a file before uploading.');
                return;
            }

            // Re-validate on submit
            const ext = file.name.split('.').pop().toLowerCase();
            if (ext !== 'xlsx' && ext !== 'xls') {
                showBulkErr('Invalid file. Only .xlsx or .xls files are accepted.');
                return;
            }
            if (file.size > 10 * 1024 * 1024) {
                showBulkErr('File size exceeds 10 MB limit.');
                return;
            }

            // Show progress & disable button
            document.getElementById('bulkProgress').classList.add('show');
            document.getElementById('btnBulkUpload').disabled = true;

            const fd = new FormData();
            fd.append('file', file);
            const tok = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tok) fd.append('__RequestVerificationToken', tok.value);

            fetch('/Properties/BulkUpload', { method: 'POST', body: fd })
                .then(r => r.json())
                .then(data => {
                    document.getElementById('bulkProgress').classList.remove('show');
                    if (data.success) {
                        showToast(data.message || 'Bulk upload successful!', 'success');
                        bootstrap.Modal.getInstance(document.getElementById('bulkUploadModal')).hide();
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showBulkErr(data.message || 'Upload failed. Please check the file and try again.');
                        document.getElementById('btnBulkUpload').disabled = false;
                    }
                })
                .catch(() => {
                    document.getElementById('bulkProgress').classList.remove('show');
                    showBulkErr('Network error. Please check your connection and try again.');
                    document.getElementById('btnBulkUpload').disabled = false;
                });
        }

        // showToast is global from _Layout.cshtml
        window.addEventListener('property-saved', function () { setTimeout(() => location.reload(), 1000); });
    </script>
}
