    <!-- Properties Grid -->
    <div id="propertiesContainer"></div>

    <!-- Pagination -->
    <div class="pagination-wrapper" id="paginationWrapper" style="display:none;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <p class="text-muted mb-0">Showing <span id="showingStart2">0</span> to <span id="showingEnd2">0</span> of <span id="totalRecords2">0</span> entries</p>
            <nav><ul class="pagination justify-content-end mb-0" id="pagination"></ul></nav>
