}
            </div>

            <div class="filter-foot mt-1">
                <span class="filter-count d-md-none">
                    Showing <span id="showingStartMob">0</span>–<span id="showingEndMob">0</span> of <span id="totalRecordsMob">0</span>
                </span>
                <div style="display:flex;gap:4px;flex-wrap:wrap;">
                    <button type="button" class="mbtn mbtn-outline" onclick="clearFilters()">
                        <i class="fa-solid fa-rotate-left"></i> Clear
                    </button>
                    @if (canCreate)
                    {
                        <button type="button" class="mbtn mbtn-green" id="exportExcel">
                            <i class="fa-solid fa-file-excel"></i>
                            <span class="d-none d-sm-inline">Export </span>Excel
                        </button>
                        <button type="button" class="mbtn mbtn-blue" id="exportCSV">
                            <i class="fa-solid fa-file-csv"></i>
                            <span class="d-none d-sm-inline">Export </span>CSV
                        </button>
                    }
                </div>
            </div>
        </div>
