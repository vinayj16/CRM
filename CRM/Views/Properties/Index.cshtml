        <!-- Filter controls -->
        <div class="filter-mob-content" id="filterContent">
            <div class="filter-grid @(ViewBag.IsPartnerTeam == true ? "" : "filter-grid-4") mt-0">
                <div>
                    <label><i class="fa-solid fa-magnifying-glass me-1"></i>Search</label>
                    <input type="text" class="form-control" id="searchBox" placeholder="Name, location, builder...">
                </div>
