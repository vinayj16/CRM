        function showLoading() {
            document.getElementById('detailSubContent').innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-body-tertiary">Loading content...</p>
                </div>
            `;
        }

        function showError(message) {
            document.getElementById('detailSubContent').innerHTML = `
                <div class="alert alert-danger text-center" role="alert">
                    <i class="fa-solid fa-exclamation-triangle me-2"></i>${message}
                </div>
            `;
        }

        function setActiveTab(element) {
            const navRoot = document.getElementById('navbar-property-detail');
            if (!navRoot) return;

            navRoot.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('active');
                link.classList.remove('active-tab-custom');
                link.removeAttribute('aria-current');
            });

            const link = element && element.classList?.contains('nav-link')
                ? element
                : element?.closest?.('.nav-link');

            if (link) {
                link.classList.add('active');
                link.classList.add('active-tab-custom');
                link.setAttribute('aria-current', 'page');
                return;
            }

            const flatsLink = navRoot.querySelector('.nav-link');
            if (flatsLink) {
                flatsLink.classList.add('active');
                flatsLink.classList.add('active-tab-custom');
                flatsLink.setAttribute('aria-current', 'page');
            }
        }

        function loadBulkUpload(tabElement) {
            setActiveTab(tabElement);
            new bootstrap.Modal(document.getElementById('bulkUploadFlatsModal')).show();
            return false;
        }

        // showToast is global from _Layout.cshtml);
    </script>
