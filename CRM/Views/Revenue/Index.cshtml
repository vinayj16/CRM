@model List<CRM.Models.RevenueModel>
@{
    ViewData["Title"] = "Revenue";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<style>
/* ══════════════════════════════════════════
   SCOPE: .rv-wrap
   --g=#D4A45A gold  --b=#1A6FA8 blue
   Ultra-compact: inputs h-28px, gap-.4rem
   ══════════════════════════════════════════ */
.rv-wrap {
    --g:#D4A45A; --gd:#B8883E; --gp:#FEE2E2; --gl:#E8C27E;
    --b:#1A6FA8; --bd:#0F4C75; --bp:#F0F4F8; --bl:#B8C8D8;
    --tx:#1A2332; --mu:#6B7B8D; --su:#FFFFFF; --bg:#F0F4F8; --br:#E2E8F0;
    --ok:#16A34A; --okp:#F0F4F8; --wa:#DC2626; --wap:#F0F4F8;
    font-family:'Segoe UI',system-ui,sans-serif;
    font-size:12.5px; color:var(--tx);
}
p {
    margin-top: 0;!important;
    margin-bottom: 0px ;
}
/* ── hero header ── */
.rv-hero {
    background:linear-gradient(118deg,#0F4C75 0%,var(--b) 55%,#2589C9 100%);
    border-radius:9px; padding:.8rem 1rem;
    margin-bottom:.5rem; position:relative; overflow:hidden;
    display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:.6rem;
}
.rv-hero::before {
    content:''; position:absolute; top:-30px; right:-30px;
    width:120px; height:120px; border-radius:50%;
    background:rgba(212,164,90,.14); pointer-events:none;
}
.rv-hero-left { position:relative; z-index:1; }
.rv-hero-title {
    font-size:.95rem; font-weight:700; color:#FFFFFF; margin:0;
    display:flex; align-items:center; gap:6px;
}
.rv-hero-title i { color:var(--g); }
.rv-hero-sub { font-size:.67rem; color:rgba(255,255,255,.6); margin:.1rem 0 0; }

/* stats strip */
.rv-stats {
    display:grid; grid-template-columns:repeat(3,1fr);
    gap:.45rem; margin-bottom:.5rem;
}
.rv-sc {
    background:var(--su); border:1px solid var(--br);
    border-radius:7px; padding:.45rem .7rem;
    display:flex; align-items:center; gap:.5rem;
}
.rv-sc-ico {
    width:30px; height:30px; border-radius:6px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; font-size:.82rem;
}
.ico-g  { background:var(--gp); color:var(--gd); }
.ico-b  { background:var(--bp); color:var(--b); }
.ico-ok { background:var(--okp); color:var(--ok); }
.rv-sc-num { font-size:.98rem; font-weight:700; color:var(--tx); line-height:1; margin-bottom:1px; }
.rv-sc-lbl { font-size:.62rem; color:var(--mu); font-weight:500; }

/* ── new revenue btn ── */
.rv-new-btn {
    position:relative; z-index:1;
    background:var(--g); border:none; color:#FFFFFF;
    padding:.35rem .9rem; border-radius:6px;
    font-size:.75rem; font-weight:700;
    display:inline-flex; align-items:center; gap:5px;
    cursor:pointer; box-shadow:0 2px 8px rgba(212,164,90,.35);
    transition:background .15s, transform .12s; white-space:nowrap;
}
.rv-new-btn:hover { background:var(--gd); color:#FFFFFF; transform:translateY(-1px); }

/* ── filter bar ── */
.rv-fbar {
    background:var(--su); border:1px solid var(--br);
    border-radius:7px; padding:.5rem .75rem;
    margin-bottom:.5rem;
}
.rv-fbar-top {
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:.4rem; flex-wrap:wrap; gap:.35rem;
}
.rv-fbar-title {
    font-size:.67rem; font-weight:700; color:var(--mu);
    text-transform:uppercase; letter-spacing:.06em;
    display:flex; align-items:center; gap:5px;
}
.rv-fbar-actions { display:flex; gap:.3rem; flex-wrap:wrap; }
.rv-grid { display:grid; grid-template-columns:1.6fr .8fr 1fr .9fr; gap:.4rem; align-items:end; }
.rv-fl { font-size:.64rem; font-weight:600; color:var(--mu); margin-bottom:2px; display:block; }
.rv-fi {
    width:100%; border:1px solid var(--br); border-radius:5px;
    font-size:.74rem; padding:.2rem .5rem; height:28px;
    color:var(--tx); outline:none; background:var(--su);
    transition:border-color .14s, box-shadow .14s;
    background-image:none !important;
}
.rv-fi:focus { border-color:var(--b); box-shadow:0 0 0 2px rgba(26,111,168,.11); }
.rv-fi-sel { cursor:pointer; }
.rv-btn-sm {
    height:28px; padding:0 .65rem; border-radius:5px;
    font-size:.7rem; font-weight:700; border:none; cursor:pointer;
    display:inline-flex; align-items:center; gap:4px; white-space:nowrap;
    transition:all .14s;
}
.rv-btn-excel { background:#16A34A; color:#FFFFFF; }
.rv-btn-excel:hover { background:#15803D; }

/* custom date range row */
.rv-custom-dates {
    display:none; grid-template-columns:1fr 1fr; gap:.4rem; margin-top:.4rem;
}
.rv-custom-dates.show { display:grid; }

/* ── column headers ── */
.rv-thead {
    display:grid; grid-template-columns:2fr 1.2fr .9fr 90px 60px;
    gap:.4rem; padding:.18rem .75rem; margin-bottom:.15rem;
}
.rv-th { font-size:.59rem; font-weight:700; color:var(--mu); text-transform:uppercase; letter-spacing:.05em; }
.rv-th.r { text-align:right; }
.rv-th.c { text-align:center; }

/* ── revenue row ── */
.rv-row {
    background:var(--su); border:1px solid var(--br);
    border-radius:7px; margin-bottom:.28rem; padding:.5rem .75rem;
    display:grid; grid-template-columns:2fr 1.2fr .9fr 90px 60px;
    align-items:center; gap:.4rem;
    transition:border-color .14s, box-shadow .14s;
    position:relative; overflow:visible; z-index:1;
}
.rv-row:hover { border-color:var(--bl); box-shadow:0 2px 8px rgba(26,111,168,.07); }
.rv-row:has(.dropdown.show) { z-index:9999 !important; }

/* col — description + date */
.rv-desc { font-size:.79rem; font-weight:600; color:var(--tx); margin-bottom:1px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.rv-date { font-size:.67rem; color:var(--mu); display:flex; align-items:center; gap:4px; }
.rv-date i { font-size:.6rem; color:var(--b); opacity:.65; }

/* col — amount */
.rv-amount { font-size:.88rem; font-weight:700; color:var(--ok); white-space:nowrap; }

/* col — type badge */
.rv-badge {
    font-size:.58rem; font-weight:700; padding:.18rem .5rem;
    border-radius:20px; letter-spacing:.03em; text-transform:uppercase;
    display:inline-block; white-space:nowrap;
    background:var(--bp); color:var(--b); border:1px solid var(--bl);
}

/* col — actions */
.rv-acts { display:flex; justify-content:flex-end; align-items:center; }
.rv-acts .dropdown { position:static !important; }
.rv-acts .dropdown-menu { z-index:10000 !important; position:absolute !important; }
.rv-dot-btn {
    width:25px; height:25px; border:1px solid var(--br); background:var(--su);
    border-radius:4px; display:flex; align-items:center; justify-content:center;
    font-size:.67rem; cursor:pointer; color:var(--mu);
    transition:all .13s;
}
.rv-dot-btn:hover { border-color:var(--b); color:var(--b); background:var(--bp); }

/* ── pagination ── */
.rv-pag {
    display:flex; justify-content:space-between; align-items:center;
    margin-top:.4rem; padding:.4rem .65rem;
    background:var(--su); border:1px solid var(--br); border-radius:7px;
}
.rv-pag-info { font-size:.67rem; color:var(--mu); }
.rv-pag-ctrl { display:flex; gap:3px; align-items:center; flex-wrap:wrap; }
.rv-pb {
    padding:.2rem .45rem; border:1px solid var(--br);
    background:var(--su); color:var(--mu); border-radius:4px;
    font-size:.67rem; cursor:pointer; line-height:1.5; transition:all .13s;
}
.rv-pb:hover:not(:disabled):not(.active) { border-color:var(--b); color:var(--b); background:var(--bp); }
.rv-pb:disabled { opacity:.4; cursor:not-allowed; }
.rv-pb.active { background:var(--b); border-color:var(--b); color:#FFFFFF; font-weight:700; }

/* ── empty state ── */
.rv-empty {
    text-align:center; padding:2rem 1.5rem;
    background:var(--su); border:1px solid var(--br); border-radius:9px;
}
.rv-empty i { font-size:2.5rem; color:var(--br); display:block; margin-bottom:.65rem; }
.rv-empty h5 { font-size:.88rem; font-weight:600; margin-bottom:.2rem; }
.rv-empty p  { font-size:.72rem; color:var(--mu); margin-bottom:.6rem; }

/* ══════════════════════════════════════════
   MODAL — ULTRA COMPACT (matches partners)
   inputs h-28px, font .74rem, gap .4rem
   ══════════════════════════════════════════ */
.rv-modal .modal-content { border-radius:10px; overflow:hidden; }
.rv-modal .modal-header {
    background:var(--b); color:#FFFFFF;
    padding:.6rem .9rem; border-bottom:none;
}
.rv-modal .modal-header .btn-close { filter:invert(1); opacity:.7; }
.rv-modal .modal-header .btn-close:hover { opacity:1; }
.rv-modal .modal-title {
    font-size:.85rem; font-weight:700; color:#FFFFFF;
    display:flex; align-items:center; gap:6px;
}
.rv-modal .modal-title i { color:var(--g); }
.rv-modal .modal-body { padding:.7rem .9rem; }
.rv-modal .modal-footer {
    padding:.5rem .9rem; border-top:1px solid var(--br); background:var(--bg);
}

/* ── compact form labels & controls ── */
.rv-modal .form-label {
    font-size:.67rem; font-weight:600; color:var(--mu);
    margin-bottom:2px; display:block;
}
.rv-modal .form-control,
.rv-modal .form-select {
    font-size:.74rem; padding:.2rem .5rem; height:28px;
    border:1px solid var(--br); border-radius:5px;
    color:var(--tx); background:var(--su);
    transition:border-color .14s, box-shadow .14s;
    background-image:none !important;
    padding-right:.5rem !important;
}
.rv-modal textarea.form-control {
    height:64px; resize:vertical;
}
.rv-modal .form-control:focus,
.rv-modal .form-select:focus {
    border-color:var(--b); box-shadow:0 0 0 2px rgba(26,111,168,.11); outline:none;
}

/* ── validation: border only, no icons ── */
.rv-modal .form-control.is-invalid,
.rv-modal .form-select.is-invalid {
    border-color:var(--wa) !important;
    background-image:none !important; padding-right:.5rem !important;
}
.rv-modal .form-control.is-valid,
.rv-modal .form-select.is-valid {
    border-color:var(--ok) !important;
    background-image:none !important; padding-right:.5rem !important;
}
.rv-vmsg {
    font-size:.63rem; margin-top:2px;
    display:none; align-items:center; gap:3px;
}
.rv-vmsg.err { color:var(--wa); display:flex; }
.rv-vmsg.ok  { color:var(--ok); display:flex; }
.rv-modal .invalid-feedback { display:none !important; }

/* ── form grid ── */
.rv-fg2  { display:grid; grid-template-columns:1fr 1fr; gap:.4rem; }
.rv-frow { margin-bottom:.4rem; }

/* ── input-group compact ── */
.rv-modal .input-group { height:28px; }
.rv-modal .input-group .form-control { height:28px; }
.rv-modal .input-group-text {
    font-size:.74rem; padding:.18rem .45rem; height:28px;
    border-color:var(--br); color:var(--mu); background:var(--bg);
}

/* ── submit buttons ── */
.rv-modal-btns { display:flex; gap:.45rem; width:100%; }
.rv-modal-btn {
    flex:1; height:30px; border:none; border-radius:6px;
    font-size:.76rem; font-weight:700; cursor:pointer;
    display:flex; align-items:center; justify-content:center; gap:5px;
    transition:all .14s;
}
.rv-modal-btn-cancel { background:var(--bg); color:var(--mu); border:1px solid var(--br); }
.rv-modal-btn-cancel:hover { border-color:var(--b); color:var(--b); }
.rv-modal-btn-submit { background:var(--b); color:#FFFFFF; }
.rv-modal-btn-submit:hover { background:var(--bd); }

/* ── flatpickr overrides ── */
.flatpickr-calendar { font-size:.74rem !important; border-radius:8px !important; box-shadow:0 5px 18px rgba(0,0,0,.12) !important; }
.flatpickr-day.selected,.flatpickr-day.selected:hover { background:var(--b) !important; border-color:var(--b) !important; }
.flatpickr-day:hover { background:var(--bp) !important; }
.flatpickr-months .flatpickr-month { background:var(--b) !important; color:#FFFFFF !important; }
.flatpickr-current-month .flatpickr-monthDropdown-months { background:var(--b) !important; color:#FFFFFF !important; }
.flatpickr-weekday,span.flatpickr-weekday { background:var(--b) !important; color:rgba(255,255,255,.85) !important; font-weight:700 !important; }

/* ── mobile card layout ── */
.rv-mob { display:none; }

/* ── dark mode ── */
.dark-mode .rv-wrap {
    --su:#1A2332; --br:#1E2A3A; --tx:#E2E8F0; --mu:#6B7B8D;
    --bg:#111827; --bp:#1A2332; --bl:#2A3A4A; --gp:#111827; --okp:#0D1A24;
}
.dark-mode .rv-sc, .dark-mode .rv-row,
.dark-mode .rv-fbar, .dark-mode .rv-pag, .dark-mode .rv-empty {
    background:#1A2332 !important; border-color:#1E2A3A !important;
}
.dark-mode .rv-fi {
    background:#1E2A3A !important; border-color:#2A3A4A !important; color:#E2E8F0 !important;
}
.dark-mode .rv-pb { background:#1E2A3A !important; border-color:#2A3A4A !important; color:#6B7B8D !important; }
.dark-mode .rv-pb.active { background:var(--b) !important; color:#FFFFFF !important; }
.dark-mode .rv-dot-btn { background:#1E2A3A !important; border-color:#2A3A4A !important; color:#6B7B8D !important; }
.dark-mode .rv-modal .modal-content { background:#1A2332 !important; border-color:#1E2A3A !important; }
.dark-mode .rv-modal .form-control,
.dark-mode .rv-modal .form-select {
    background:#1E2A3A !important; border-color:#2A3A4A !important; color:#E2E8F0 !important;
}
.dark-mode .rv-modal .modal-footer { background:#111827 !important; border-color:#1E2A3A !important; }
.dark-mode .rv-modal .input-group-text { background:#1A2332 !important; border-color:#1E2A3A !important; color:#6B7B8D !important; }
.dark-mode .rv-modal-btn-cancel { background:#1E2A3A !important; border-color:#2A3A4A !important; color:#6B7B8D !important; }
.dark-mode .rv-badge { background:#1A2332 !important; border-color:#2A3A4A !important; }

/* ── responsive ── */
@@media (max-width:768px) {
    .rv-thead { display:none; }
    .rv-stats { grid-template-columns:1fr 1fr 1fr; }
    .rv-grid  { grid-template-columns:1fr 1fr; }
    .rv-row   { grid-template-columns:1fr !important; padding:.6rem .75rem; gap:.35rem; }
    .rv-row > *:not(.rv-mob) { display:none !important; }
    .rv-mob   { display:block !important; }
    .rv-pag   { flex-direction:column; gap:.35rem; text-align:center; }
    .rv-fg2   { grid-template-columns:1fr; }
    .rv-hero  { flex-direction:column; align-items:flex-start; }
    .rv-custom-dates.show { grid-template-columns:1fr; }
}
@@media (max-width:500px) {
    .rv-stats { grid-template-columns:1fr; }
    .rv-grid  { grid-template-columns:1fr; }
}

/* ── mobile card inner ── */
.rv-mob-top { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:.35rem; }
.rv-mob-desc { font-size:.8rem; font-weight:700; color:var(--tx); }
.rv-mob-meta { font-size:.67rem; color:var(--mu); margin-bottom:.3rem; display:flex; align-items:center; gap:4px; }
.rv-mob-meta i { font-size:.6rem; color:var(--b); }
.rv-mob-foot { display:flex; justify-content:space-between; align-items:center; padding-top:.32rem; border-top:1px solid var(--br); margin-top:.3rem; }
.rv-mob-amount { font-size:.88rem; font-weight:700; color:var(--ok); }
</style>

<div class="rv-wrap">
    <div class="page-hd"><i class="fa-solid fa-chart-line"></i><h4>Revenue</h4></div>
    <!-- Breadcrumb -->
    <nav class="mb-2" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0" style="font-size:.72rem;">
            <li class="breadcrumb-item"><a href="/Home">Home</a></li>
            <li class="breadcrumb-item active">Revenue</li>
        </ol>
    </nav>

    <!-- HERO -->
    <div class="rv-hero" style="margin-bottom:.5rem;">
        <div class="rv-hero-left">
            <div class="rv-hero-title"><i class="fa-solid fa-coins"></i>Revenue</div>
            <p class="rv-hero-sub">Track all revenue sources and payments</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Sales") || User.IsInRole("Agent") || User.IsInRole("Partner"))
        {
            <button onclick="openRevenueModal()" class="rv-new-btn">
                <i class="fa-solid fa-plus"></i>New Revenue
            </button>
        }
    </div>

    <!-- STATS -->
    <div class="rv-stats">
        <div class="rv-sc">
            <div class="rv-sc-ico ico-b"><i class="fa-solid fa-list"></i></div>
            <div>
                <div class="rv-sc-num" id="statTotal">@Model.Count</div>
                <div class="rv-sc-lbl">Total Entries</div>
            </div>
        </div>
        <div class="rv-sc">
            <div class="rv-sc-ico ico-g"><i class="fa-solid fa-indian-rupee-sign"></i></div>
            <div>
                <div class="rv-sc-num" id="statAmount">₹@Model.Sum(r=>r.Amount).ToString("N0")</div>
                <div class="rv-sc-lbl">Total Revenue</div>
            </div>
        </div>
        <div class="rv-sc">
            <div class="rv-sc-ico ico-ok"><i class="fa-solid fa-tag"></i></div>
            <div>
                <div class="rv-sc-num" id="statSales">@Model.Count(r=>r.Type=="Sale")</div>
                <div class="rv-sc-lbl">Sales</div>
            </div>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="rv-fbar">
        <div class="rv-fbar-top">
            <div class="rv-fbar-title"><i class="fa-solid fa-filter"></i>Filter &amp; Search</div>
            <div class="rv-fbar-actions">
                @if (User.IsInRole("Admin") || User.IsInRole("Sales") || User.IsInRole("Agent"))
                {
                    <button class="rv-btn-sm rv-btn-excel" type="button" onclick="exportData()">
                        <i class="fa-solid fa-file-excel"></i>Excel
                    </button>
                }
            </div>
        </div>
        <div class="rv-grid">
            <div>
                <label class="rv-fl">Search</label>
                <input type="text" class="rv-fi" id="searchInput" placeholder="Search anything…">
            </div>
            <div>
                <label class="rv-fl">Type</label>
                <select class="rv-fi rv-fi-sel" id="typeFilter">
                    <option value="">All Types</option>
                    <option value="Sale">Sale</option>
                    <option value="Booking">Booking</option>
                    <option value="Collection">Collection</option>
                    <option value="Rental">Rental</option>
                    <option value="Service">Service</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div>
                <label class="rv-fl">Date Range</label>
                <select class="rv-fi rv-fi-sel" id="dateRangeFilter">
                    <option value="all">All Time</option>
                    <option value="today">Today</option>
                    <option value="thisWeek">This Week</option>
                    <option value="thisMonth">This Month</option>
                    <option value="last3Months">Last 3 Months</option>
                    <option value="custom">Custom Range</option>
                </select>
            </div>
            <div></div>
        </div>
        <div class="rv-custom-dates" id="customDateRange">
            <div>
                <label class="rv-fl">From Date</label>
                <input type="text" class="rv-fi flatpickr-range" id="startDate" placeholder="Start date" readonly>
            </div>
            <div>
                <label class="rv-fl">To Date</label>
                <input type="text" class="rv-fi flatpickr-range" id="endDate" placeholder="End date" readonly>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- COLUMN HEADERS -->
        <div class="rv-thead">
            <span class="rv-th">Description / Date</span>
            <span class="rv-th">Amount</span>
            <span class="rv-th">Type</span>
            <span class="rv-th c">Badge</span>
            <span class="rv-th r">Actions</span>
        </div>

        <!-- REVENUE ROWS -->
        @foreach (var revenue in Model)
        {
            var hasPersistedDetails = revenue.RevenueId > 0;
            <div class="rv-row paginated-item" data-type="@revenue.Type"
                 data-date="@revenue.Date.ToString("yyyy-MM-dd")"
                 data-amount="@revenue.Amount"
                 data-desc="@revenue.Description">

                <!-- col 1: desc + date -->
                <div>
                    <div class="rv-desc">
                        <i class="fa-solid fa-file-invoice" style="color:var(--b);font-size:.65rem;margin-right:4px;"></i>
                        @revenue.Description
                    </div>
                    <div class="rv-date">
                        <i class="fa-solid fa-calendar"></i>@revenue.Date.ToString("MMM dd, yyyy")
                    </div>
                </div>

                <!-- col 2: amount -->
                <div class="rv-amount">₹@revenue.Amount.ToString("N0")</div>

                <!-- col 3: type text -->
                <div style="font-size:.74rem;color:var(--tx);font-weight:600;">@revenue.Type</div>

                <!-- col 4: badge -->
                <div style="text-align:center;">
                    <span class="rv-badge">@revenue.Type</span>
                </div>

                <!-- col 5: actions -->
                <div class="rv-acts">
                    <div class="dropdown">
                        <button class="rv-dot-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" style="font-size:.75rem;min-width:150px;">
                            @if (hasPersistedDetails)
                            {
                                <li>
                                    <a class="dropdown-item" href="/revenuedetails/@IdObfuscator.Encode(revenue.RevenueId)">
                                        <i class="fa-solid fa-eye me-2" style="color:var(--b);"></i>View Details
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Sales") || User.IsInRole("Agent"))
                                {
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="editRevenue(@revenue.RevenueId)">
                                            <i class="fa-solid fa-edit me-2" style="color:var(--g);"></i>Edit
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" style="margin:.2rem 0;"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="#" onclick="deleteRevenue(@revenue.RevenueId)">
                                            <i class="fa-solid fa-trash me-2"></i>Delete
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li>
                                    <span class="dropdown-item-text text-muted" style="font-size:.72rem;">
                                        <i class="fa-solid fa-circle-info me-2"></i>Summary entry
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- mobile card -->
                <div class="rv-mob">
                    <div class="rv-mob-top">
                        <div>
                            <div class="rv-mob-desc">@revenue.Description</div>
                            <div class="rv-mob-meta"><i class="fa-solid fa-calendar"></i>@revenue.Date.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="dropdown">
                            <button class="rv-dot-btn" type="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" style="font-size:.75rem;">
                                @if (hasPersistedDetails)
                                {
                                    <li><a class="dropdown-item" href="/revenuedetails/@IdObfuscator.Encode(revenue.RevenueId)"><i class="fa-solid fa-eye me-2"></i>View</a></li>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Sales") || User.IsInRole("Agent"))
                                    {
                                        <li><a class="dropdown-item" href="#" onclick="editRevenue(@revenue.RevenueId)"><i class="fa-solid fa-edit me-2"></i>Edit</a></li>
                                        <li><hr class="dropdown-divider" style="margin:.2rem 0;"></li>
                                        <li><a class="dropdown-item text-danger" href="#" onclick="deleteRevenue(@revenue.RevenueId)"><i class="fa-solid fa-trash me-2"></i>Delete</a></li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="rv-mob-foot">
                        <div class="rv-mob-amount">₹@revenue.Amount.ToString("N0")</div>
                        <span class="rv-badge">@revenue.Type</span>
                    </div>
                </div>

            </div>
        }

        <!-- PAGINATION -->
        <div class="rv-pag" id="paginationContainer" style="display:none;">
            <div class="rv-pag-info"><span id="paginationInfo"></span></div>
            <div class="rv-pag-ctrl">
                <button class="rv-pb" id="prevBtn" onclick="changePage(-1)">
                    <i class="fa-solid fa-chevron-left"></i> Prev
                </button>
                <div id="pageNumbers" style="display:flex;gap:3px;"></div>
                <button class="rv-pb" id="nextBtn" onclick="changePage(1)">
                    Next <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="rv-empty">
            <i class="fa-solid fa-coins"></i>
            <h5>No Revenue Found</h5>
            <p>Start by adding your first revenue entry</p>
            @if (User.IsInRole("Admin") || User.IsInRole("Sales") || User.IsInRole("Agent"))
            {
                <button onclick="openRevenueModal()" class="rv-new-btn" style="margin:0 auto;">
                    <i class="fa-solid fa-plus"></i>Create Revenue
                </button>
            }
        </div>
    }

</div><!-- /rv-wrap -->

@await Html.PartialAsync("_RevenueModal")

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
/* ── Revenue data (backend unchanged) ── */
var allRevenueData = @Html.Raw(Json.Serialize(Model.Select(r => new {
    Type        = r.Type,
    Description = r.Description,
    Amount      = r.Amount,
    Date        = r.Date.ToString("yyyy-MM-dd"),
    DateFormatted = r.Date.ToString("MMM dd, yyyy")
})));

/* ── Pagination state ── */
var currentPage  = 1;
var pageSize     = 10;
var filteredItems = [];

/* ════════════════════════════════════
   INIT
════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', function () {

    /* flatpickr — filter custom date range */
    flatpickr('#startDate', {
        dateFormat:'Y-m-d', allowInput:false, disableMobile:true,
        onChange:function(){ applyFilters(); }
    });
    flatpickr('#endDate', {
        dateFormat:'Y-m-d', allowInput:false, disableMobile:true,
        onChange:function(){ applyFilters(); }
    });

    /* filter events */
    document.getElementById('searchInput').addEventListener('input', applyFilters);
    document.getElementById('typeFilter').addEventListener('change', applyFilters);
    document.getElementById('dateRangeFilter').addEventListener('change', function(){
        if(this.value === 'custom') document.getElementById('customDateRange').classList.add('show');
        else { document.getElementById('customDateRange').classList.remove('show'); applyFilters(); }
    });

    /* dropdown z-index fix */
    document.querySelectorAll('.rv-row .dropdown').forEach(function(dd){
        dd.addEventListener('show.bs.dropdown', function(){
            document.querySelectorAll('.rv-row').forEach(function(r){ r.style.zIndex='1'; });
            this.closest('.rv-row').style.zIndex='9999';
        });
        dd.addEventListener('hide.bs.dropdown', function(){
            this.closest('.rv-row').style.zIndex='1';
        });
    });

    /* init pagination */
    filteredItems = Array.from(document.querySelectorAll('.paginated-item'));
    applyFilters();
});

/* ════════════════════════════════════
   FILTERS
════════════════════════════════════ */
function getDateRange(range) {
    var today = new Date();
    switch(range) {
        case 'today':
            var d = today.toISOString().split('T')[0];
            return { start:d, end:d };
        case 'thisWeek':
            var sw = new Date(today); sw.setDate(today.getDate()-today.getDay());
            return { start:sw.toISOString().split('T')[0], end:today.toISOString().split('T')[0] };
        case 'thisMonth':
            var sm = new Date(today.getFullYear(), today.getMonth(), 1);
            return { start:sm.toISOString().split('T')[0], end:today.toISOString().split('T')[0] };
        case 'last3Months':
            var s3 = new Date(today.getFullYear(), today.getMonth()-3, 1);
            return { start:s3.toISOString().split('T')[0], end:today.toISOString().split('T')[0] };
        default: return null;
    }
}

function applyFilters() {
    var search    = document.getElementById('searchInput').value.toLowerCase();
    var type      = document.getElementById('typeFilter').value;
    var rangeKey  = document.getElementById('dateRangeFilter').value;
    var startVal  = document.getElementById('startDate').value;
    var endVal    = document.getElementById('endDate').value;

    var dateFilter = null;
    if(rangeKey !== 'all') {
        if(rangeKey === 'custom' && startVal && endVal) dateFilter = { start:startVal, end:endVal };
        else if(rangeKey !== 'custom') dateFilter = getDateRange(rangeKey);
    }

    var allItems = document.querySelectorAll('.paginated-item');
    filteredItems = [];
    var totalAmount = 0, saleCount = 0;

    allItems.forEach(function(item){
        var ds   = item.dataset;
        var text = (item.textContent||'').toLowerCase();
        var ms   = !search || text.includes(search);
        var mt   = !type   || ds.type === type;
        var md   = true;
        if(dateFilter) md = ds.date >= dateFilter.start && ds.date <= dateFilter.end;

        if(ms && mt && md) {
            filteredItems.push(item);
            totalAmount += parseFloat(ds.amount)||0;
            if(ds.type === 'Sale') saleCount++;
        }
    });

    /* update stats */
    document.getElementById('statTotal').textContent  = filteredItems.length;
    document.getElementById('statAmount').textContent = '₹' + Math.round(totalAmount).toLocaleString('en-IN');
    document.getElementById('statSales').textContent  = saleCount;

    currentPage = 1;
    updatePagination();
}

/* ════════════════════════════════════
   PAGINATION (original logic intact)
════════════════════════════════════ */
function updatePagination() {
    var total    = filteredItems.length;
    var totalPg  = Math.ceil(total / pageSize);
    var startIdx = (currentPage-1)*pageSize;
    var endIdx   = Math.min(startIdx+pageSize, total);

    document.querySelectorAll('.paginated-item').forEach(function(el){ el.style.display='none'; });
    for(var i=startIdx;i<endIdx;i++) if(filteredItems[i]) filteredItems[i].style.display='';

    /* info text */
    var s = total>0 ? startIdx+1 : 0;
    document.getElementById('paginationInfo').textContent =
        'Showing '+s+'–'+endIdx+' of '+total+' revenues';

    /* page number buttons */
    var pn = document.getElementById('pageNumbers');
    pn.innerHTML='';
    if(totalPg>1){
        var sp=Math.max(1,currentPage-2), ep=Math.min(totalPg,sp+4);
        if(ep-sp<4) sp=Math.max(1,ep-4);
        for(var p=sp;p<=ep;p++){
            (function(pp){
                var b=document.createElement('button');
                b.className='rv-pb'+(pp===currentPage?' active':'');
                b.textContent=pp;
                b.onclick=function(){goToPage(pp);};
                pn.appendChild(b);
            })(p);
        }
    }

    document.getElementById('prevBtn').disabled = currentPage===1;
    document.getElementById('nextBtn').disabled = currentPage===totalPg||totalPg===0;
    document.getElementById('paginationContainer').style.display = total>0?'flex':'none';
}

function changePage(dir){
    var tp=Math.ceil(filteredItems.length/pageSize);
    var np=currentPage+dir;
    if(np>=1&&np<=tp){ currentPage=np; updatePagination(); }
}
function goToPage(p){ currentPage=p; updatePagination(); }

/* ════════════════════════════════════
   EXPORT (original logic intact)
════════════════════════════════════ */
function exportData() {
    var visData = [];
    filteredItems.forEach(function(item){
        visData.push({
            Type:        item.dataset.type,
            Description: item.dataset.desc,
            Amount:      item.dataset.amount,
            Date:        item.dataset.date
        });
    });
    if(!visData.length){ Swal.fire('No Data', 'No data to export', 'info'); return; }
    var ws=XLSX.utils.json_to_sheet(visData);
    var wb=XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb,ws,'Revenue');
    XLSX.writeFile(wb,'Revenue_Report_'+new Date().toISOString().split('T')[0]+'.xlsx');
}

/* ════════════════════════════════════
   DELETE (original logic intact)
════════════════════════════════════ */
function deleteRevenue(revenueId) {
    Swal.fire({
        title:'Are you sure?', text:'Do you want to delete this revenue entry?',
        icon:'warning', showCancelButton:true,
        confirmButtonColor:'#1A6FA8', cancelButtonColor:'#6B7B8D',
        confirmButtonText:'Yes, delete it!'
    }).then(function(result){
        if(result.isConfirmed){
            $.ajax({
                url:'/Revenue/DeleteRevenue', type:'POST',
                data:{ revenueId:revenueId },
                success:function(response){
                    if(response.success){
                        Swal.fire({icon:'success',title:'Deleted!',text:'Revenue entry deleted successfully.'})
                            .then(function(){location.reload();});
                    } else {
                        Swal.fire({icon:'error',title:'Error',text:response.message});
                    }
                }
            });
        }
    });
}
</script>
}
