@model CRM.Models.ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_LayoutLogin";
}

<div class="login-container auth-v5 auth-forgot-page">

    <!-- LEFT -->
    <aside class="login-left auth-showcase">
        <div class="auth-showcase-header">
            <div class="brand-logo">
                <i class="fas fa-lock-open"></i>
            </div>

            <h1>Set New Password</h1>
            <p>Create a strong password to secure your account.</p>
        </div>

        <ul class="auth-points list-unstyled">
            <li><i class="fas fa-shield-alt"></i> Minimum 6 characters</li>
            <li><i class="fas fa-key"></i> Include uppercase & lowercase</li>
            <li><i class="fas fa-hashtag"></i> Include number & special character</li>
        </ul>
    </aside>

    <!-- RIGHT -->
    <section class="login-form-section">

        <div class="form-brand">
            <div class="form-brand-logo">
                <i class="fas fa-lock-open"></i>
            </div>

            <div class="form-brand-meta">
                <h2>@(ViewBag.CompanyName ?? "Ultrakey PropTech")</h2>
                <p>Password reset</p>
            </div>
        </div>

        <div class="login-header">
            <h1>Create New Password</h1>
            <p>Hi <strong>@Model.Username</strong>, enter your new password below.</p>
        </div>

        <!-- ERROR -->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-circle-exclamation"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form method="post" asp-action="ResetPasswordWithToken" id="resetForm" novalidate>

            @Html.AntiForgeryToken()

            <!-- TOKEN -->
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <!-- NEW PASSWORD -->
            <div class="input-wrapper">
                <label class="form-label">New Password</label>
                <i class="fas fa-lock"></i>

                <input name="newPassword"
                       id="newPassword"
                       class="form-control"
                       type="password"
                       placeholder="Enter new password"
                       required />

                <button type="button"
                        class="password-toggle"
                        onclick="togglePwd('newPassword','toggleIcon1')">
                    <i class="fas fa-eye" id="toggleIcon1"></i>
                </button>

                <span class="text-danger" id="newPwdError"></span>
            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="input-wrapper">
                <label class="form-label">Confirm Password</label>
                <i class="fas fa-lock"></i>

                <input name="confirmPassword"
                       id="confirmPassword"
                       class="form-control"
                       type="password"
                       placeholder="Confirm new password"
                       required />

                <button type="button"
                        class="password-toggle"
                        onclick="togglePwd('confirmPassword','toggleIcon2')">
                    <i class="fas fa-eye" id="toggleIcon2"></i>
                </button>

                <span class="text-danger" id="confirmPwdError"></span>
            </div>

            <button type="submit" class="btn-primary">
                <i class="fas fa-check-circle"></i>
                Reset Password
            </button>

            <p class="signup-text">
                Remember your password?
                <a href="/Account/Login">Sign In</a>
            </p>

        </form>
    </section>
</div>

@section Scripts {
    <script>
        function togglePwd(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        document.addEventListener("DOMContentLoaded", function () {

            var form = document.getElementById('resetForm');
            var newPwd = document.getElementById('newPassword');
            var confirmPwd = document.getElementById('confirmPassword');

            var newErr = document.getElementById('newPwdError');
            var confirmErr = document.getElementById('confirmPwdError');

            var pwdRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&]).{6,}$/;

            form.addEventListener('submit', function (e) {

                newErr.textContent = '';
                confirmErr.textContent = '';

                if (!newPwd.value) {
                    e.preventDefault();
                    newErr.textContent = 'New password is required';
                    newPwd.focus();
                    return;
                }

                if (!pwdRegex.test(newPwd.value)) {
                    e.preventDefault();
                    newErr.textContent = 'Password must contain uppercase, lowercase, number, and special character';
                    newPwd.focus();
                    return;
                }

                if (!confirmPwd.value) {
                    e.preventDefault();
                    confirmErr.textContent = 'Please confirm your password';
                    confirmPwd.focus();
                    return;
                }

                if (newPwd.value !== confirmPwd.value) {
                    e.preventDefault();
                    confirmErr.textContent = 'Passwords do not match';
                    confirmPwd.focus();
                    return;
                }
            });

        });
    </script>
}