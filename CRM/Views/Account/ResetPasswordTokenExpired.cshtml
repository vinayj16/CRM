@{
    ViewData["Title"] = "Reset Link Expired";
    Layout = "_LayoutLogin";
}

<div class="login-container auth-v5 auth-forgot-page">
    <aside class="login-left auth-showcase">
        <div class="auth-showcase-header">
            <div class="brand-logo">
                <i class="fas fa-clock"></i>
            </div>
            <h1>Link Expired</h1>
            <p>Your password reset link is no longer valid.</p>
        </div>

        <ul class="auth-points list-unstyled">
            <li><i class="fas fa-shield-alt"></i> Links expire after 1 hour</li>
            <li><i class="fas fa-redo"></i> Request a new link anytime</li>
            <li><i class="fas fa-lock"></i> Your account is still secure</li>
        </ul>
    </aside>

    <section class="login-form-section">
        <div class="form-brand">
            <div class="form-brand-logo">
                <i class="fas fa-clock"></i>
            </div>

            <div class="form-brand-meta">
                <h2>@(ViewBag.CompanyName ?? "PropTech CRM")</h2>
                <p>Password reset</p>
            </div>
        </div>

        <div class="login-header">
            <h1>Link Expired</h1>
            <p>This password reset link is invalid or has expired.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-circle-exclamation"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <div style="text-align: center; padding: 1.5rem 0;">
            <i class="fas fa-link-slash"
               style="font-size: 3rem; color: #DC2626; margin-bottom: 1rem;"></i>

            <p style="color: #6B7B8D; margin-bottom: 1.5rem;">
                Password reset links are valid for 1 hour.
                Please request a new one.
            </p>
        </div>

        <a href="/Account/ForgotPassword"
           class="btn-primary"
           style="display: block; text-align: center; text-decoration: none;">
            <i class="fas fa-paper-plane"></i>
            Request New Reset Link
        </a>

        <div class="divider">
            <span>OR</span>
        </div>

        <a href="/Account/Login"
           class="btn-secondary"
           style="display: block; text-align: center; text-decoration: none;">
            <i class="fas fa-arrow-left"></i>
            Back To Login
        </a>

    </section>
</div>