        height: 55vh !important;
        right: -5px !important;
        bottom: 55px !important;
    }
}
</style>

<!-- Chatbot JavaScript -->
<script src="/js/chatbot.js?v=@DateTime.Now.Ticks"></script>

<!-- Additional inline script to ensure message display works -->
<script>
// Override message display function to fix formatting
function addMessageOverride(text, sender, timestamp) {
    const chatMessages = document.getElementById('chatMessages');
    if (!chatMessages) return;
    
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${sender.toLowerCase()}`;
    messageDiv.style.cssText = 'margin-bottom: 15px; display: flex; gap: 10px;';
    
    const avatarDiv = document.createElement('div');
    avatarDiv.className = 'message-avatar';
    avatarDiv.style.cssText = 'width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: bold; color: white;';
    avatarDiv.style.background = sender === 'Bot' ? 'linear-gradient(135deg, #1A6FA8 0%, #125082 100%)' : '#2A3A4A';
    avatarDiv.textContent = sender === 'Bot' ? 'AI' : 'U';
    
    const contentDiv = document.createElement('div');
    contentDiv.className = 'message-content';
    contentDiv.style.cssText = 'max-width: 70%;';
    
    const bubbleDiv = document.createElement('div');
    bubbleDiv.className = 'message-bubble';
    bubbleDiv.style.cssText = 'padding: 12px 16px; border-radius: 18px; font-size: 14px; line-height: 1.5; word-wrap: break-word; white-space: pre-wrap; overflow-wrap: break-word; max-width: 100%; display: block; width: fit-content; min-width: 50px;';
    
    // Handle text properly
    if (typeof text === 'string') {
        const formattedText = text.replace(/\n/g, '<br>').replace(/  /g, ' &nbsp;');
        bubbleDiv.innerHTML = formattedText;
    } else {
        bubbleDiv.textContent = String(text);
    }
    
    // Set bubble background
    if (sender === 'Bot') {
        bubbleDiv.style.cssText += ' background: white; color: #2A3A4A; border: 1px solid #E2E8F0;';
    } else {
        bubbleDiv.style.cssText += ' background: linear-gradient(135deg, #1A6FA8 0%, #125082 100%); color: white;';
    }
    
    const timeDiv = document.createElement('div');
    timeDiv.className = 'message-time';
    timeDiv.style.cssText = 'font-size: 11px; color: #6B7B8D; margin-top: 4px;';
    timeDiv.textContent = new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    
    contentDiv.appendChild(bubbleDiv);
    contentDiv.appendChild(timeDiv);
    
    messageDiv.appendChild(avatarDiv);
    messageDiv.appendChild(contentDiv);
    
    chatMessages.appendChild(messageDiv);
    
    // Scroll to bottom
    setTimeout(() => {
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }, 100);
}

// Override the original addMessage function
if (typeof window.addMessage === 'function') {
    const originalAddMessage = window.addMessage;
    window.addMessage = function(text, sender, timestamp) {
        addMessageOverride(text, sender, timestamp);
        originalAddMessage(text, sender, timestamp);
    };
} else {
    window.addMessage = addMessageOverride;
}

console.log('Chatbot message display override loaded!');

// Direct toggle function as backup
window.toggleChatDirect = function() {
    console.log('Direct toggle called!');
    const chatWindow = document.getElementById('chatWindow');
    const chatButton = document.getElementById('chatButton');
    
    if (chatWindow) {
        const isVisible = chatWindow.style.display === 'flex';
        console.log('Chat window currently visible:', isVisible);
        
        if (!isVisible) {
            // Show chat window with aggressive styling
            chatWindow.style.cssText = `
                display: flex !important;
                visibility: visible !important;
                opacity: 1 !important;
                position: absolute !important;
                bottom: 80px !important;
                right: 0 !important;
                width: 350px !important;
                min-width: 350px !important;
                max-width: 350px !important;
                height: 400px !important;
                min-height: 400px !important;
                max-height: 400px !important;
                background: white !important;
                border-radius: 15px !important;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15) !important;
                flex-direction: column !important;
                overflow: hidden !important;
                z-index: 999998 !important;
                border: 2px solid #1A6FA8 !important;
                margin: 0 !important;
                padding: 0 !important;
                float: none !important;
                clear: both !important;
                transform: none !important;
                transition: none !important;
            `;
            
            // Force all child elements to be visible
            const chatHeader = chatWindow.querySelector('.chat-header');
            const chatMessages = chatWindow.querySelector('.chat-messages');
            const chatInputContainer = chatWindow.querySelector('.chat-input-container');
            
            if (chatHeader) {
                chatHeader.style.cssText = `
                    display: flex !important;
                    background: linear-gradient(135deg, #1A6FA8 0%, #125082 100%) !important;
                    color: white !important;
                    padding: 15px !important;
                    justify-content: space-between !important;
                    align-items: center !important;
                    min-height: 60px !important;
                    height: auto !important;
                `;
            }
            
            if (chatMessages) {
                chatMessages.style.cssText = `
                    flex: 1 !important;
                    padding: 20px !important;
                    overflow-y: auto !important;
                    background: #F0F4F8 !important;
                    min-height: 200px !important;
                    height: auto !important;
                    display: block !important;
                `;
            }
            
            if (chatInputContainer) {
                chatInputContainer.style.cssText = `
                    padding: 15px !important;
                    background: white !important;
                    border-top: 1px solid #E2E8F0 !important;
                    display: block !important;
                    min-height: 60px !important;
                    height: auto !important;
                `;
            }
            
            if (chatButton) {
                chatButton.style.display = 'none';
            }
            console.log('Chat window opened directly with aggressive styling!');
        } else {
            // Hide chat window
            chatWindow.style.display = 'none';
            if (chatButton) {
                chatButton.style.display = 'flex';
            }
            console.log('Chat window closed directly!');
        }
    } else {
        console.error('Chat window not found!');
    }
};

console.log('Direct toggle function loaded!');

// Debug function to inspect chat window
window.debugChatWindow = function() {
    const chatWindow = document.getElementById('chatWindow');
    if (chatWindow) {
        console.log('Chat window element:', chatWindow);
        console.log('Chat window styles:', chatWindow.style.cssText);
        console.log('Chat window computed styles:', window.getComputedStyle(chatWindow));
        console.log('Chat window children:', chatWindow.children);
        console.log('Chat window innerHTML:', chatWindow.innerHTML);
        
        // Check each child element
        const children = chatWindow.children;
        for (let i = 0; i < children.length; i++) {
            const child = children[i];
            console.log(`Child ${i} (${child.className}):`, child);
            console.log(`Child ${i} styles:`, child.style.cssText);
            console.log(`Child ${i} computed:`, window.getComputedStyle(child));
        }
    } else {
        console.error('Chat window not found!');
    }
};

console.log('Debug function loaded! Call debugChatWindow() in console to inspect.');

// Image Upload Functionality
window.initChatImageUpload = function() {
    const imageUploadBtn = document.getElementById('chatImageUpload');
    const imageInput = document.getElementById('chatImageInput');
    const imagePreview = document.getElementById('chatImagePreview');
    const previewImage = document.getElementById('previewImage');
    const removeImageBtn = document.getElementById('removeImage');
    let currentImageData = null;

    // Handle image upload button click
    if (imageUploadBtn) {
        imageUploadBtn.addEventListener('click', function() {
            imageInput.click();
        });
    }

    // Handle file selection
    if (imageInput) {
        imageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    currentImageData = e.target.result;
                    previewImage.src = currentImageData;
                    imagePreview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    }

    // Handle image removal
    if (removeImageBtn) {
        removeImageBtn.addEventListener('click', function() {
            currentImageData = null;
            previewImage.src = '';
            imagePreview.style.display = 'none';
            imageInput.value = '';
        });
    }

    // Expose current image data for sending
    window.getCurrentChatImage = function() {
        return currentImageData;
    };

    window.clearCurrentChatImage = function() {
        currentImageData = null;
        previewImage.src = '';
        imagePreview.style.display = 'none';
        imageInput.value = '';
    };
};

// Add image message to chat
window.addImageMessage = function(imageData, sender, timestamp) {
    const chatMessages = document.getElementById('chatMessages');
    if (!chatMessages) return;
    
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${sender.toLowerCase()}`;
    messageDiv.style.cssText = 'margin-bottom: 15px; display: flex; gap: 10px;';
    
    const avatarDiv = document.createElement('div');
    avatarDiv.className = 'message-avatar';
    avatarDiv.style.cssText = 'width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: bold; color: white;';
    avatarDiv.style.background = sender === 'Bot' ? 'linear-gradient(135deg, #1A6FA8 0%, #125082 100%)' : '#2A3A4A';
    avatarDiv.textContent = sender === 'Bot' ? 'AI' : 'U';
    
    const contentDiv = document.createElement('div');
    contentDiv.className = 'message-content';
    contentDiv.style.cssText = 'max-width: 70%;';
    
    const bubbleDiv = document.createElement('div');
    bubbleDiv.className = 'message-bubble';
    bubbleDiv.style.cssText = 'padding: 12px 16px; border-radius: 18px; font-size: 14px; line-height: 1.5; word-wrap: break-word; white-space: pre-wrap; overflow-wrap: break-word; max-width: 100%; display: block; width: fit-content; min-width: 50px;';
    
    // Add image
    const img = document.createElement('img');
    img.src = imageData;
    img.className = 'message-image';
    img.style.cssText = 'max-width: 200px; max-height: 150px; border-radius: 8px; margin-top: 8px; cursor: pointer; transition: transform 0.2s ease;';
    
    // Set bubble background
    if (sender === 'Bot') {
        bubbleDiv.style.cssText += ' background: white; color: #2A3A4A; border: 1px solid #E2E8F0;';
    } else {
        bubbleDiv.style.cssText += ' background: linear-gradient(135deg, #1A6FA8 0%, #125082 100%); color: white;';
    }
    
    bubbleDiv.appendChild(img);
    
    const timeDiv = document.createElement('div');
    timeDiv.className = 'message-time';
    timeDiv.style.cssText = 'font-size: 11px; color: #6B7B8D; margin-top: 4px;';
    timeDiv.textContent = new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    
    contentDiv.appendChild(bubbleDiv);
    contentDiv.appendChild(timeDiv);
    
    messageDiv.appendChild(avatarDiv);
    messageDiv.appendChild(contentDiv);
    
    chatMessages.appendChild(messageDiv);
    
    // Add click handler for image preview
    img.addEventListener('click', function() {
        window.open(imageData, '_blank');
    });
    
    // Scroll to bottom
    setTimeout(() => {
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }, 100);
};

// Initialize image upload when page loads
document.addEventListener('DOMContentLoaded', function() {
    initChatImageUpload();
});

console.log('Chat image upload functionality loaded!');
</script>
