@{
	Layout = null;
	var orderId = ViewBag.OrderId as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Complete Payment - PropTech CRM</title>

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

	<style>
		body {
			background: #F0F4F8;
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 20px;
			font-family: "Segoe UI", sans-serif;
		}

		.pay-card {
			max-width: 500px;
			width: 100%;
			border-radius: 16px;
			overflow: hidden;
			border: none;
			box-shadow: 0 10px 35px rgba(0,0,0,0.12);
		}

		.pay-header {
			background: linear-gradient(135deg, #1E2A3A, #2A3A4A);
			color: white;
			padding: 2rem;
			text-align: center;
		}

		.pay-body {
			padding: 2rem;
			background: white;
		}

		.detail-row {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 12px 0;
			border-bottom: 1px solid #E2E8F0;
		}

			.detail-row:last-child {
				border-bottom: none;
			}

		.amount-display {
			font-size: 2.5rem;
			font-weight: 800;
			color: #1A6FA8;
		}

		.pay-btn {
			height: 52px;
			font-size: 1.1rem;
			font-weight: 600;
		}

		.loading-area {
			text-align: center;
			padding: 40px 20px;
		}

		.error-area {
			text-align: center;
			padding: 40px 20px;
		}

			.error-area i {
				color: #DC2626;
				margin-bottom: 15px;
			}
	</style>
</head>
<body>

	<div class="card pay-card">

		<div class="pay-header">
			<i class="fas fa-shield-alt fa-2x mb-3"></i>

			<h4 class="mb-1">Complete Your Payment</h4>

			<small>Secure payment via Razorpay</small>
		</div>

		<div class="pay-body" id="paymentDetails">

			<div class="loading-area">
				<i class="fas fa-spinner fa-spin fa-2x text-muted"></i>
				<p class="text-muted mt-3 mb-0">
					Loading order details...
				</p>
			</div>

		</div>

	</div>

	<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

	<script>

		var orderId = '@orderId';

		if (!orderId) {

			document.getElementById('paymentDetails').innerHTML =
				'<div class="error-area">' +
				'<i class="fas fa-exclamation-circle fa-3x"></i>' +
				'<h5>Invalid Order</h5>' +
				'<p class="text-muted">Order ID is missing.</p>' +
				'</div>';
		}
		else {

			loadOrderDetails();
		}

		function loadOrderDetails() {

			fetch('/saassubscription/getorderdetails?orderId=' + encodeURIComponent(orderId))

				.then(function (r) {

					return r.json();
				})

				.then(function (data) {

					console.log('Order Details:', data);

					if (!data.success) {

						// showError(data.message || 'Unable to load order.');
										document.getElementById('paymentDetails').innerHTML = '<div class="text-center py-4"><i class="fas fa-exclamation-circle fa-3x text-danger"></i><p class="mt-3">Order Not found.. Invalid or expired payment link</p></div>';

						return;
					}

					var order = data.order;

					if (!order) {

						showError('Order information not found.');
						return;
					}


					var amount = (order.amount ) / 100;

					document.getElementById('paymentDetails').innerHTML =

						'<div class="text-center mb-4">' +

						'<div class="amount-display">₹' +
						amount.toLocaleString('en-IN') +
						'</div>' +

						'</div>' +

						'<div class="detail-row">' +
						'<span>Plan</span>' +
						'<strong>' + (order.planName || '-') + '</strong>' +
						'</div>' +

						'<div class="detail-row">' +
						'<span>Billing</span>' +
						'<strong>' + (order.billingCycle || '-') + '</strong>' +
						'</div>' +

						'<div class="detail-row">' +
						'<span>Type</span>' +
						'<strong>' + (order.upgradeType || 'Upgrade') + '</strong>' +
						'</div>' +

						'<div class="detail-row">' +
						'<span>Order ID</span>' +
						'<small>' + orderId + '</small>' +
						'</div>' +

						'<button class="btn btn-primary pay-btn w-100 mt-4" id="payBtn" onclick="startPayment()">' +
						'<i class="fas fa-lock me-2"></i>' +
						'Pay ₹' + amount.toLocaleString('en-IN') +
						'</button>';

					window.razorpayKey = data.razorpayKey;
					window.orderData = order;
					window.tenantId = data.tenantId;
				})

				.catch(function (err) {

					console.error(err);

										document.getElementById('paymentDetails').innerHTML = '<div class="text-center py-4"><i class="fas fa-exclamation-circle fa-3x text-danger"></i><p class="mt-3">Failed to load payment details</p></div>';
				});
		}

		function showError(message) {

			document.getElementById('paymentDetails').innerHTML =

				'<div class="error-area">' +
				'<i class="fas fa-exclamation-circle fa-3x"></i>' +
				'<h5>Unable to Continue</h5>' +
				'<p class="text-muted">' + message + '</p>' +
				'</div>';
		}

			function startPayment() {
		var order = window.orderData;
		var options = {
			key: window.razorpayKey,
			amount: order.amount,
			currency: 'INR',
			name: 'CRM Subscription',
			description: order.planName + ' ' + order.billingCycle,
			order_id: order.orderId,
			handler: function(response) {
				// Payment successful - POST to confirm payment
				document.getElementById('paymentDetails').innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-success"></i><p class="mt-3">Processing payment... Please wait.</p></div>';

				fetch('/saassubscription/confirmpayment', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, 
					body: new URLSearchParams({
						razorpayPaymentId: response.razorpay_payment_id,
						razorpayOrderId: response.razorpay_order_id,
						razorpaySignature: response.razorpay_signature,
						planId: order.planId || 0,
						billingCycle: order.billingCycle || 'monthly',
						upgradeType: order.upgradeType || 'immediate',
						tenantId: order.tenantId || 0
					})
				})
				.then(function(r) { return r.json(); })
				.then(function(data) {
					if (data.success) {
						document.getElementById('paymentDetails').innerHTML = '<div class="text-center py-4"><i class="fas fa-check-circle fa-3x text-success"></i><h5 class="mt-3">Payment Successful!</h5><p class="text-muted">' + data.message + '</p><a href="/" class="btn btn-primary mt-3">Go to Dashboard</a></div>';
					} else {
						document.getElementById('paymentDetails').innerHTML = '<div class="text-center py-4"><i class="fas fa-exclamation-circle fa-3x text-danger"></i><h5 class="mt-3">Payment Processing Issue</h5><p class="text-muted">' + (data.message || 'Please contact support.') + '</p></div>';
					}
				})
				.catch(function() {
					document.getElementById('paymentDetails').innerHTML = '<div class="text-center py-4"><i class="fas fa-check-circle fa-3x text-success"></i><h5 class="mt-3">Payment Received!</h5><p class="text-muted">Your plan will be activated shortly.</p><a href="/" class="btn btn-primary mt-3">Go to Dashboard</a></div>';
				});
			},
					prefill: {
					email: order.partnerEmail || ''
				},
				theme: {
					color: '#1A6FA8'
				}
			};

			var rzp = new Razorpay(options);
			rzp.on('payment.failed', function(response) {
				document.getElementById('paymentDetails').innerHTML = '<div class="text-center py-4"><i class="fas fa-times-circle fa-3x text-danger"></i><h5 class="mt-3">Payment Failed</h5>';
			});
			rzp.open();
		}
	</script>
</body>
</html>