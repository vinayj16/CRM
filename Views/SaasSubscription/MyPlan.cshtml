									color: #FFFFFF !important;
								}

							[data-bs-theme="dark"] .swal2-confirm,
							.dark-mode .swal2-confirm {
								color: #FFFFFF !important;
								background-color: #2589C9 !important;
								border-color: #2589C9 !important;
							}

							[data-bs-theme="dark"] .swal2-cancel,
							.dark-mode .swal2-cancel {
								color: #FFFFFF !important;
								background-color: #6B7B8D !important;
								border-color: #6B7B8D !important;
							}

							/* Force button text visibility with highest specificity */
							[data-bs-theme="dark"] .swal2-actions .swal2-confirm,
							[data-bs-theme="dark"] .swal2-actions .swal2-cancel,
							.dark-mode .swal2-actions .swal2-confirm,
							.dark-mode .swal2-actions .swal2-cancel {
								color: #FFFFFF !important;
								font-weight: 600 !important;
							}

							[data-bs-theme="dark"] .swal2-actions button,
							.dark-mode .swal2-actions button {
								color: #FFFFFF !important;
							}

							.plan-card {
								cursor: pointer;
								transition: all 0.3s ease;
								border: 2px solid transparent;
							}

								.plan-card:hover {
									transform: translateY(-3px);
									box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
								}

								.plan-card.selected {
									border-color: #16A34A !important;
									background: linear-gradient(135deg, #DCFCE7 0%, #B8C8D8 100%) !important;
								}

								.plan-card.current-plan {
									border-color: var(--bs-primary, #2589C9) !important;
									background: var(--bs-primary-bg-subtle,#F59E0B11) !important;
								}

							/* Dark mode support for current plan card - show in green */
							[data-bs-theme="dark"] .plan-card.current-plan,
							.dark-mode .plan-card.current-plan {
								border-color: #16A34A !important;
								background: #15803D !important;
								color: #FFFFFF !important;
							}

								[data-bs-theme="dark"] .plan-card.current-plan .card-title,
								[data-bs-theme="dark"] .plan-card.current-plan .card-text,
								[data-bs-theme="dark"] .plan-card.current-plan h5,
								[data-bs-theme="dark"] .plan-card.current-plan p,
								.dark-mode .plan-card.current-plan .card-title,
								.dark-mode .plan-card.current-plan .card-text,
								.dark-mode .plan-card.current-plan h5,
								.dark-mode .plan-card.current-plan p {
									color: #FFFFFF !important;
								}

								[data-bs-theme="dark"] .plan-card.current-plan *,
								.dark-mode .plan-card.current-plan * {
									color: #FFFFFF !important;
								}

							.billing-toggle {
								display: flex;
								justify-content: center;
								margin-bottom: 1rem;
							}

								.billing-toggle button {
									padding: 0.5rem 1rem;
									border: 2px solid #E2E8F0;
									background: white;
									color: #6B7B8D;
									font-weight: 600;
									transition: all 0.2s ease;
								}

									.billing-toggle button:first-child {
										border-radius: 25px 0 0 25px;
										border-right: none;
									}

									.billing-toggle button:last-child {
										border-radius: 0 25px 25px 0;
										border-left: none;
									}

									.billing-toggle button.active {
										background: #2589C9;
										color: white;
										border-color: #2589C9;
									}

							/* Dark mode support for billing toggle */
							[data-bs-theme="dark"] .billing-toggle button,
							.dark-mode .billing-toggle button {
								background: #2A3A4A !important;
								color: #FFFFFF !important;
								border-color: #6B7B8D !important;
							}

								[data-bs-theme="dark"] .billing-toggle button.active,
								.dark-mode .billing-toggle button.active {
									background: #2589C9 !important;
									color: #FFFFFF !important;
									border-color: #2589C9 !important;
								}

								/* Force text visibility with highest specificity */
								.dark-mode .billing-toggle button:not(.active) {
									background: #2A3A4A !important;
									color: #FFFFFF !important;
									border-color: #6B7B8D !important;
								}

							.feature-list {
								list-style: none;
								padding: 0;
							}

								.feature-list li {
									padding: 0.25rem 0;
									font-size: 0.875rem;
								}

									.feature-list li i {
										width: 16px;
										margin-right: 0.5rem;
									}

							/* Compact SweetAlert modal - fit to screen without scrolling */
							.swal2-popup {
								max-height: 85vh !important;
							}

							.swal2-html-container {
								max-height: 55vh !important;
								overflow-y: auto !important;
								padding: 0.5rem 1rem !important;
							}

								.swal2-html-container h6 {
									font-size: 13px !important;
									margin-bottom: 8px !important;
								}

								.swal2-html-container p {
									margin: 3px 0 !important;
									font-size: 12px !important;
								}

								.swal2-html-container hr {
									margin: 8px 0 !important;
								}

								.swal2-html-container > div {
									padding: 10px !important;
									margin-bottom: 2px !important;
								}

							.swal2-title {
								margin-bottom: 2px !important;
								padding-bottom: 2px !important;
							}

							.swal2-actions {
								margin-top: 5px !important;
								padding-top: 5px !important;
							}

							/* Hide SweetAlert icon */
							.swal2-icon {
								display: none !important;
							}
						</style>
@section Scripts {
							<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
							<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	@{
		var jsCurrentPlanId = currentSubscription?.PlanId ?? 0;
		var jsCurrentBilling = currentSubscription?.BillingCycle?.ToLower() ?? "monthly";
		var jsCurrentExpiry = currentSubscription?.EndDate.ToString("MMMM dd, yyyy") ?? "";
		var jsScheduledPlanId = scheduledSubscription?.PlanId ?? 0;
		var jsScheduledPlanName = scheduledSubscription?.Plan?.PlanName ?? "N/A";
		var jsScheduledBilling = scheduledSubscription?.BillingCycle ?? "N/A";
		var jsScheduledAmount = scheduledSubscription?.Amount ?? 0;
		var jsScheduledStartDate = scheduledSubscription?.StartDate.ToString("MMMM dd, yyyy") ?? "N/A";
		var jsScheduledStatus = scheduledSubscription?.Status ?? "N/A";
		var jsScheduledSubscriptionId = scheduledSubscription?.SubscriptionId ?? 0;
	}

							<script>
								window.selectedPlanId = null;
								window.selectedBillingCycle = '@jsCurrentBilling';

								document.addEventListener('DOMContentLoaded', function () {
									toggleBilling('@jsCurrentBilling');

									const defaultSelectedCard = document.querySelector('.upgrade-type-card.selected');
									if (defaultSelectedCard) {
										selectUpgradeType(defaultSelectedCard.dataset.type);
									}
								});

								function toggleBilling(planIdOrCycle, cycle) {
									if (cycle) {
										const planId = planIdOrCycle;
										const card = document.querySelector(`[data-plan-id="${planId}"]`);
										if (!card) return;

										const monthlyBtn = card.querySelector('.monthly-btn');
										const annualBtn = card.querySelector('.annual-btn');
										const monthlyPrice = card.querySelector('.monthly-price');
										const annualPrice = card.querySelector('.annual-price');

										if (!monthlyBtn || !annualBtn || !monthlyPrice || !annualPrice) return;

										monthlyBtn.classList.toggle('active', cycle === 'monthly');
										annualBtn.classList.toggle('active', cycle === 'annual');
										monthlyPrice.style.display = cycle === 'monthly' ? 'block' : 'none';
										annualPrice.style.display = cycle === 'annual' ? 'block' : 'none';

										const currentPlanId = '@jsCurrentPlanId';
										const currentBilling = '@jsCurrentBilling';

										if (planId == currentPlanId) {
											const currentPlanBadge = card.querySelector('.current-plan-badge');

											if (cycle === currentBilling) {
												card.classList.add('current-plan');
												card.classList.add('current');
												if (currentPlanBadge) currentPlanBadge.style.display = 'block';
											} else {
												card.classList.remove('current-plan');
												card.classList.remove('current');
												if (currentPlanBadge) currentPlanBadge.style.display = 'none';
											}
										}
										const scheduledPlanId = '@jsScheduledPlanId';
										const scheduledBilling = '@jsScheduledBilling'.toLowerCase();

										if (planId == scheduledPlanId) {
											const scheduledPlanBadge = card.querySelector('.scheduled-plan-badge');

											if (cycle === scheduledBilling) {
												card.classList.add('scheduled');

												if (scheduledPlanBadge)
													scheduledPlanBadge.style.display = 'block';
											} else {
												card.classList.remove('scheduled');

												if (scheduledPlanBadge)
													scheduledPlanBadge.style.display = 'none';
											}
										}

										if (window.selectedPlanId == planId) {
											window.selectedBillingCycle = cycle;
										}

										return;
									}

									const globalCycle = planIdOrCycle;
									window.selectedBillingCycle = globalCycle;

																	// ADD THIS
								document.querySelectorAll('.plan-card').forEach(card => {
									const monthlyBtn = card.querySelector('.monthly-btn');
									const annualBtn = card.querySelector('.annual-btn');

									if (!monthlyBtn || !annualBtn) return;

									monthlyBtn.classList.toggle('active', globalCycle === 'monthly');
									annualBtn.classList.toggle('active', globalCycle === 'annual');
								});

									document.querySelectorAll('.monthly-price').forEach(el => {
										el.style.display = globalCycle === 'monthly' ? 'block' : 'none';
									});

									document.querySelectorAll('.annual-price').forEach(el => {
										el.style.display = globalCycle === 'annual' ? 'block' : 'none';
									});

									updateCurrentPlanButtons(globalCycle);
								}

								function updateCurrentPlanButtons(cycle) {
									const currentBilling = '@jsCurrentBilling';
									const currentPlanId = '@jsCurrentPlanId';

								const scheduledPlanId = '@jsScheduledPlanId';
								const scheduledBilling = '@jsScheduledBilling';

									document.querySelectorAll('.plan-card').forEach(card => {
										const planId = card.getAttribute('data-plan-id');
										const currentPlanBadge = card.querySelector('.current-plan-badge');

										card.classList.remove('current');

										if (planId == currentPlanId && currentBilling === cycle) {
											card.classList.add('current');
											card.classList.add('current-plan');
											if (currentPlanBadge) currentPlanBadge.style.display = 'block';
										} else if (planId == currentPlanId) {
											card.classList.remove('current-plan');
											if (currentPlanBadge) currentPlanBadge.style.display = 'none';
										}

								// Scheduled Plan
								const scheduledPlanBadge = card.querySelector('.scheduled-plan-badge');

								card.classList.remove('scheduled');

								if (planId == scheduledPlanId && scheduledBilling === cycle) {
									card.classList.add('scheduled');

									if (scheduledPlanBadge)
										scheduledPlanBadge.style.display = 'block';
								}
								else if (planId == scheduledPlanId) {

									if (scheduledPlanBadge)
										scheduledPlanBadge.style.display = 'none';
								}
									});
								}

								function selectUpgradeType(type) {
									document.querySelectorAll('.upgrade-type-card').forEach(card => {
										card.classList.remove('selected');
										const details = card.querySelector('.upgrade-details');
										if (details) details.style.display = 'none';
									});

									const selectedCard = document.querySelector(`[data-type="${type}"]`);
									if (selectedCard) {
										selectedCard.classList.add('selected');
										const details = selectedCard.querySelector('.upgrade-details');
										if (details) details.style.display = 'block';
									}

									const upgradeTypeDetails = document.getElementById('upgradeTypeDetails');
									if (!upgradeTypeDetails) return;

									const alertDiv = upgradeTypeDetails.querySelector('.alert');
									if (!alertDiv) return;

									if (type === 'existing') {
										alertDiv.className = 'alert alert-info';
										alertDiv.innerHTML = '<strong>Day-based conversion:</strong><br>Remaining amount � upgrade per-day rate = days<br>+1 day if any remainder > 0';
									}

									if (type === 'immediate') {
										alertDiv.className = 'alert alert-success';
										alertDiv.innerHTML = '<strong>Full duration:</strong><br>Monthly: 30 days | Annual: 365 days<br>Remaining amount credit applied from current plan';
									}

									if (type === 'scheduled') {
										alertDiv.className = 'alert alert-warning';
										alertDiv.innerHTML = '<strong>Future activation:</strong><br>Starts on current plan end date + 1 day<br>Full plan duration applies';
									}
								}

								function selectPlan(planId) {
								const currentPlanId = '@jsCurrentPlanId';
								const currentBilling = '@jsCurrentBilling';

								const scheduledPlanId = '@jsScheduledPlanId';
								const scheduledBilling = '@jsScheduledBilling'.toLowerCase();

								const planCard = document.querySelector(`[data-plan-id="${planId}"]`);
								if (!planCard) return;

								const annualBtn = planCard.querySelector('.annual-btn');
								const selectedBilling =
									annualBtn && annualBtn.classList.contains('active')
										? 'annual'
										: 'monthly';

								if (
									planId == scheduledPlanId &&
									selectedBilling === scheduledBilling &&
									scheduledPlanId != 0
								) {
									Swal.fire({
										title: 'Plan Already Scheduled',
										html: `
											<div class="text-center">
												<i class="fa-solid fa-calendar-check text-info" style="font-size: 3rem;"></i>
												<h5 class="mt-3">This plan is already scheduled</h5>
												<p class="text-muted">
													Your <strong>@jsScheduledPlanName</strong> plan will activate on
													<strong>@jsScheduledStartDate</strong>
												</p>
											</div>
										`,
										icon: 'info',
										confirmButtonColor: '#2589C9',
										confirmButtonText: 'OK'
									});
									return;
								}

									

									if (planId == currentPlanId && selectedBilling === currentBilling) {
										Swal.fire({
											title: 'Current Active Plan',
											html: `
												<div class="text-center">
													<i class="fa-solid fa-crown text-primary" style="font-size: 3rem;"></i>
													<h5 class="mt-3">This is your current active plan</h5>
													<p class="text-muted">Your plan expires on <strong>@jsCurrentExpiry</strong></p>
												</div>
											`,
											icon: 'info',
											confirmButtonColor: '#2589C9',
											confirmButtonText: 'OK'
										});
										return;
									}

									window.selectedPlanId = planId;
									window.selectedBillingCycle = selectedBilling;

									const selectedUpgradeCard = document.querySelector('.upgrade-type-card.selected');
									if (!selectedUpgradeCard) {
										Swal.fire({
											title: 'Select Upgrade Type',
											text: 'Please select an upgrade type first.',
											icon: 'warning',
											confirmButtonColor: '#F59E0B'
										});
										return;
									}

									calculateUpgrade(planId, selectedBilling, selectedUpgradeCard.dataset.type);
								}

								function calculateUpgrade(planId, billingCycle, upgradeType) {
									fetch('/saassubscription/CalculateUpgrade', {
										method: 'POST',
										headers: {
											'Content-Type': 'application/x-www-form-urlencoded'
										},
										body: new URLSearchParams({
											tenantId: '@tenantId',
											newPlanId: planId,
											billingCycle: billingCycle,
											upgradeType: upgradeType
										})
									})
									.then(response => response.json())
									.then(data => {
										if (data.success) {
											displayCalculationResults(data);
										} else {
											Swal.fire('Calculation Error', data.message, 'error');
										}
									})
									.catch(() => {
										Swal.fire('Error', 'Failed to calculate upgrade', 'error');
									});
								}

								function displayCalculationResults(data) {
									const calc = data.calculation || {};

									if (data.insufficientAmount) {
										Swal.fire({
											title: 'Insufficient Amount',
											html: `
												<div style="text-align: left; font-size: 14px;">
													<p><strong>Current Plan:</strong> ${calc.currentPlan || 'N/A'}</p>
													<p><strong>Remaining Amount:</strong> ?${(calc.remainingAmount || 0).toLocaleString()}</p>
													<p><strong>Required for 1 day:</strong> ?${(calc.requiredAmount || 0).toLocaleString()}</p>
													<p><strong>Shortfall:</strong> ?${(calc.shortfall || 0).toLocaleString()}</p>
													<p class="text-danger"><strong>Your remaining amount is not sufficient for this upgrade.</strong></p>
												</div>
											`,
											icon: 'error',
											confirmButtonText: 'Choose Different Option',
											confirmButtonColor: '#DC2626'
										});
										return;
									}

									let content = '';

									if (data.upgradeType === 'existing') {
										content = `
											<div style="text-align: left; font-size: 14px;">
												<p><strong>Current Plan:</strong> ${calc.currentPlan || 'N/A'}</p>
												<p><strong>Remaining Days:</strong> ${calc.remainingDays || 0}</p>
												<p><strong>Remaining Amount:</strong> ?${(calc.remainingAmount || 0).toLocaleString()}</p>
												<hr>
												<p><strong>New Plan:</strong> ${calc.newPlan || 'N/A'}</p>
												<p><strong>Per-day Rate:</strong> ?${(calc.upgradePerDayRate || 0).toLocaleString()}</p>
												<p><strong>You will get:</strong> ${calc.convertedDays || 0} days</p>
												<p class="text-success"><strong>No additional payment required.</strong></p>
											</div>
										`;
									}

									if (data.upgradeType === 'immediate') {
										content = `
											<div style="text-align: left; font-size: 14px;">
												<p><strong>New Plan:</strong> ${calc.newPlan || 'N/A'}</p>
												<p><strong>New Plan Cost:</strong> ?${(calc.newAmount || 0).toLocaleString()}</p>
												<p><strong>Credit From Current Plan:</strong> -?${(calc.creditAmount || 0).toLocaleString()}</p>
												<hr>
												<p><strong>My Referral Amount:</strong> ?${(calc.rewardPoints || 0).toLocaleString()}</p>

												<p><strong>Amount to Pay:</strong> ?${(calc.adjustedAmount || 0).toLocaleString()}</p>
												<p><strong>Start Date:</strong> ${calc.startDate ? new Date(calc.startDate).toLocaleDateString() : 'Immediate'}</p>
												<p><strong>End Date:</strong> ${calc.endDate ? new Date(calc.endDate).toLocaleDateString() : 'N/A'}</p>
											</div>
										`;
									}

									if (data.upgradeType === 'scheduled') {
										content = `
											<div style="text-align: left; font-size: 14px;">
												<p><strong>Plan:</strong> ${calc.newPlan || 'N/A'}</p>
												<p><strong>My Referral Amount:</strong> ?${(calc.rewardPoints || 0).toLocaleString()}</p>

												<p><strong>Amount to Pay:</strong> ?${(calc.paymentRequired || 0).toLocaleString()}</p>
												<p><strong>Activation Date:</strong> ${calc.startDate ? new Date(calc.startDate).toLocaleDateString() : 'N/A'}</p>
												<p class="text-info">Plan will activate automatically after your current plan expires.</p>
											</div>
										`;
									}

									const requiresPayment = data.upgradeType === 'scheduled' || ((calc.adjustedAmount || 0) > 0);

									Swal.fire({
										title: 'Upgrade Calculation',
										html: content,
										showCancelButton: true,
										confirmButtonText: requiresPayment ? 'Proceed to Payment' : 'Activate Now',
										cancelButtonText: 'Cancel',
										confirmButtonColor: '#2589C9',
										cancelButtonColor: '#6B7B8D',
										width: '550px'
									}).then(result => {
										if (!result.isConfirmed) return;

										if (requiresPayment) {
											initiateRazorpayPayment(data);
										} else {
											activateUpgrade(data);
										}
									});
								}

								function initiateRazorpayPayment(data) {
									const selectedUpgradeCard = document.querySelector('.upgrade-type-card.selected');
									const upgradeType = selectedUpgradeCard ? selectedUpgradeCard.dataset.type : 'immediate';

									fetch('/saassubscription/SelectPlan', {
										method: 'POST',
										headers: {
											'Content-Type': 'application/x-www-form-urlencoded'
										},
										body: new URLSearchParams({
											planId: window.selectedPlanId,
											billingCycle: window.selectedBillingCycle,
											upgradeType: upgradeType
										})
									})
									.then(response => response.json())
									.then(orderData => {
										if (!orderData.success) {
											Swal.fire('Error', orderData.message || 'Failed to create payment order.', 'error');
											return;
										}
										const options = {
											key: '@razorpayKeyId',
											amount: orderData.amount,
											currency: 'INR',
											name: 'CRM Upgrade',
											description: `Upgrade to ${data.calculation.newPlan}`,
											order_id: orderData.orderId,
											handler: function (response) {
												handlePaymentSuccess(response);
											},
											modal: {
												ondismiss: function () {
													Swal.fire('Payment Cancelled', 'Your upgrade was not processed.', 'info');
												}
											}
										};

										const rzp = new Razorpay(options);
										rzp.open();
									})
									.catch(() => {
										Swal.fire('Error', 'Failed to create payment order.', 'error');
									});
								}

								function handlePaymentSuccess(paymentResponse) {
									const selectedUpgradeCard = document.querySelector('.upgrade-type-card.selected');
									const upgradeType = selectedUpgradeCard ? selectedUpgradeCard.dataset.type : 'immediate';

										fetch('/SaasSubscription/ConfirmPayment', {
										method: 'POST',
										headers: {
											'Content-Type': 'application/x-www-form-urlencoded'
										},
										body: new URLSearchParams({
											razorpayPaymentId: paymentResponse.razorpay_payment_id,
											razorpayOrderId: paymentResponse.razorpay_order_id,
											razorpaySignature: paymentResponse.razorpay_signature,
											planId: window.selectedPlanId,
											billingCycle: window.selectedBillingCycle,
											upgradeType: upgradeType
										})
									})
									.then(response => response.json())
									.then(data => {
										if (data.success) {
											Swal.fire('Success!', data.message || 'Your plan has been activated successfully.', 'success')
												.then(() => location.reload());
										} else {
											Swal.fire('Error', data.message || 'Payment processing failed.', 'error');
										}
									})
									.catch(() => {
										Swal.fire('Error', 'Failed to process payment.', 'error');
									});
								}

								function activateUpgrade(data) {
									fetch('/saassubscription/CalculateUpgrade', {
										method: 'POST',
										headers: {
											'Content-Type': 'application/x-www-form-urlencoded'
										},
										body: new URLSearchParams({
											tenantId: '@tenantId',
											newPlanId: window.selectedPlanId,
											billingCycle: window.selectedBillingCycle,
											upgradeType: data.upgradeType,
											activateNow: 'true'
										})
									})
									.then(response => response.json()) // only once
									.then(res => {

										if (res.success) {
											Swal.fire({
												title: 'Success!',
												text: res.message || 'Plan activated successfully.',
												icon: 'success',
												confirmButtonColor: '#2589C9'
											}).then(() => {
												location.reload();
											});

										} else {
											Swal.fire({
												title: 'Error',
												text: res.message || 'Activation failed.',
												icon: 'error'
											});
										}
									})
									.catch(err => {
										console.error("Error:", err);

										Swal.fire({
											title: 'Error',
											text: 'Something went wrong!',
											icon: 'error'
										});
									});
								}

								function cancelScheduledPlan() {
									Swal.fire({
										title: 'Cancel Scheduled Plan',
										html: `
											<div class="text-start">
												<p><strong>Scheduled Plan:</strong> @jsScheduledPlanName</p>
												<p><strong>Activation Date:</strong> @jsScheduledStartDate</p>
												<p><strong>Amount Paid:</strong> ?@jsScheduledAmount.ToString("N0")</p>
												<hr>
												<p class="text-danger">
													<i class="fa-solid fa-exclamation-triangle me-2"></i>
													<strong>Full Refund:</strong> The scheduled plan will be cancelled and refund will be processed within 5-7 business days.
												</p>
											</div>
										`,
										icon: 'warning',
										showCancelButton: true,
										confirmButtonText: 'Cancel & Refund',
										cancelButtonText: 'Keep Scheduled Plan',
										confirmButtonColor: '#DC2626'
									}).then(result => {
										if (!result.isConfirmed) return;

										fetch('/saassubscription/CancelScheduledPlan', {
											method: 'POST',
											headers: {
												'Content-Type': 'application/x-www-form-urlencoded'
											},
											body: new URLSearchParams({
												subscriptionId: '@jsScheduledSubscriptionId'
											})
										})
										.then(response => response.json())
										.then(data => {
											if (data.success) {
												Swal.fire('Scheduled Plan Cancelled!', 'The scheduled plan has been cancelled and full refund will be processed within 5-7 business days.', 'success')
													.then(() => location.reload());
											} else {
												Swal.fire('Error', data.message, 'error');
											}
										})
										.catch(() => {
											Swal.fire('Error', 'Failed to cancel scheduled plan. Please try again.', 'error');
										});
									});
								}

								function showScheduledPlanDetails() {
									Swal.fire({
										title: 'Scheduled Plan Details',
										html: `
											<div class="text-start">
												<p><strong>Plan:</strong> @jsScheduledPlanName</p>
												<p><strong>Billing Cycle:</strong> @jsScheduledBilling</p>
												<p><strong>Amount Paid:</strong> ?@jsScheduledAmount.ToString("N0")</p>
												<p><strong>Activation Date:</strong> @jsScheduledStartDate</p>
												<p><strong>Status:</strong> <span class="badge bg-info">@jsScheduledStatus</span></p>
												<hr>
												<p class="text-info">
													<i class="fa-solid fa-info-circle me-2"></i>
													This plan will automatically activate when your current plan expires.
												</p>
											</div>
										`,
										icon: 'info',
										confirmButtonText: 'OK',
										confirmButtonColor: '#2589C9'
									});
								}
							</script>
}



