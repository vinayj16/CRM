                                <span class="ag-vi ag-er"><i class="fas fa-times-circle"></i></span>
                            </div>
                            <div class="ag-em" id="em_Phone">Valid 10-digit phone required</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="ag-ml">Address</label>
                            <input name="Address" class="ag-mi" placeholder="Address (optional)">
                        </div>
                    </div>

                    <div class="ag-sec">Compensation</div>
                    <div class="row g-2">
                        <div class="col-sm-4">
                            <label class="ag-ml">Agent Type <span class="ag-req">*</span></label>
                            <div class="ag-mw">
                                <select name="AgentType" class="ag-ms" required onchange="agV(this)">
                                    <option value="">Select Type</option>
                                    <option value="Salary">Salary</option>
                                    <option value="Hybrid">Hybrid</option>
                                    <option value="Commission">Commission</option>
                                </select>
                                <span class="ag-vi ag-ok"><i class="fas fa-check-circle"></i></span>
                                <span class="ag-vi ag-er"><i class="fas fa-times-circle"></i></span>
                            </div>
                            <div class="ag-em" id="em_AgentType">Select agent type</div>
                        </div>
                        <div class="col-sm-4">
                            <label class="ag-ml">Salary (optional)</label>
                            <input name="Salary" class="ag-mi" type="number" step="0.01" placeholder="0.00">
                        </div>
                        <div class="col-sm-4">
                            <label class="ag-ml">Commission <span class="ag-req">*</span></label>
                            <div class="ag-mw">
                                <select name="CommissionRules" class="ag-ms" required onchange="agV(this)">
