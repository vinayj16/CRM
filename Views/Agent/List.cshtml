                        </div>
                    </div>

                    <div class="ag-sec">Documents</div>
                    <button type="button" class="ag-add-doc-btn" onclick="addNewDocument()">
                        <i class="fa-solid fa-plus"></i>Add Document
                    </button>
                    <div id="documentsList" style="display:none;margin-top:6px;">
                        <div id="documentsContainer"></div>
                    </div>

                    <div id="onboardSuccess" class="ag-malert alert alert-success d-none">Agent onboarded successfully!</div>
                    <div id="onboardError"   class="ag-malert alert alert-danger  d-none"></div>
                </form>
            </div>

            <div class="ag-mf">
                <button type="button" class="ag-mcancel" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" id="modalSubmitBtn" form="onboardForm" class="ag-msave">
                    <i class="fa-solid fa-paper-plane me-1"></i>Submit
