</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>setTimeout(function(){showToast('@TempData["Success"]','success');},500);</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>setTimeout(function(){showToast('@TempData["Error"]','error');},500);</script>
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
/* ── Flatpickr date pickers ── */
document.addEventListener('DOMContentLoaded', function () {
    flatpickr('#filterFromDate', {
        dateFormat: 'd-m-Y',
        allowInput: false,
        onChange: function () { applyFilters(); }
    });
    flatpickr('#filterToDate', {
        dateFormat: 'd-m-Y',
        allowInput: false,
        onChange: function () { applyFilters(); }
    });
    renderTable();
    attachEventListeners();
    setupFilterToggle();
});

/* ── Filter toggle (mobile) ── */
function setupFilterToggle() {
    const toggle = document.getElementById('filterToggle');
    const content = document.getElementById('filterContent');
    const chevron = document.getElementById('filterChevron');
    if (!toggle) return;
    function syncCollapse() {
        if (window.innerWidth <= 767) {
            content.style.maxHeight = content.classList.contains('collapsed') ? '0' : content.scrollHeight + 'px';
        } else {
            content.style.maxHeight = '';
            content.classList.remove('collapsed');
            chevron.style.transform = '';
        }
    }
    if (window.innerWidth <= 767) {
        content.classList.add('collapsed');
        chevron.style.transform = 'rotate(0deg)';
    }
    toggle.addEventListener('click', function () {
        if (window.innerWidth <= 767) {
            content.classList.toggle('collapsed');
            chevron.style.transform = content.classList.contains('collapsed') ? 'rotate(0deg)' : 'rotate(180deg)';
            syncCollapse();
        }
    });
    window.addEventListener('resize', syncCollapse);
}

/* ── Validation helpers ── */
function agV(el) {
    const wrap = el.closest('.ag-mw'); if (!wrap) return true;
    el.classList.remove('v-ok', 'v-er');
    wrap.querySelectorAll('.ag-vi').forEach(v => v.style.display = 'none');
    const em = document.getElementById('em_' + el.name);
    const bad = (el.required && el.value.trim() === '') || (el.validity && !el.validity.valid);
    if (bad) {
        el.classList.add('v-er');
        const e = wrap.querySelector('.ag-er'); if (e) e.style.display = 'flex';
        if (em) em.style.display = 'block';
    } else {
        el.classList.add('v-ok');
        const o = wrap.querySelector('.ag-ok'); if (o) o.style.display = 'flex';
        if (em) em.style.display = 'none';
    }
    return !bad;
}
function agLiveV(el) { if (el.classList.contains('v-ok') || el.classList.contains('v-er')) agV(el); }
function agResetForm() {
    ['FullName','Email','Phone','AgentType','CommissionRules'].forEach(n => {
        const el = document.querySelector(`[name="${n}"]`); if (!el) return;
        el.classList.remove('v-ok', 'v-er');
        const w = el.closest('.ag-mw'); if (w) w.querySelectorAll('.ag-vi').forEach(v => v.style.display = 'none');
        const em = document.getElementById('em_' + n); if (em) em.style.display = 'none';
    });
}

/* ── Email check ── */
let emailValid = false;
function agCheckEmail(el) {
    const email = el.value.trim();
    const errDiv = document.getElementById('modalEmailError');
    const okVi = document.getElementById('vi_emailOk');
    const erVi = document.getElementById('vi_emailEr');
    if (!email) { emailValid = false; errDiv.style.display = 'none'; return; }
    fetch(`/Agent/CheckEmailExists?email=${encodeURIComponent(email)}`)
        .then(r => r.json()).then(data => {
            if (data.exists) {
                emailValid = false;
                errDiv.textContent = 'This email is already registered'; errDiv.style.display = 'block';
                el.classList.remove('v-ok'); el.classList.add('v-er');
                if (okVi) okVi.style.display = 'none'; if (erVi) erVi.style.display = 'flex';
                document.getElementById('modalSubmitBtn').disabled = true;
            } else {
                emailValid = true; errDiv.style.display = 'none';
                el.classList.remove('v-er'); el.classList.add('v-ok');
                if (erVi) erVi.style.display = 'none'; if (okVi) okVi.style.display = 'flex';
                document.getElementById('modalSubmitBtn').disabled = false;
            }
        }).catch(() => { emailValid = false; errDiv.textContent = 'Error checking email'; errDiv.style.display = 'block'; });
}

/* ── Globals ── */
// let allAgents = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
let allAgents = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
                const _enc = {@foreach(var l in Model){
                @Html.Raw($"'{l.AgentId}': '{IdObfuscator.Encode(l.AgentId)}',")
        }
    };
                    allAgents.forEach(l => l.EncodedId = _enc[l.AgentId]);

let filteredAgents = [...allAgents];
let currentPage = 1, pageSize = 10;
let selectedDocuments = [];

function attachEventListeners() {
    document.getElementById('searchBox').addEventListener('input', applyFilters);
    document.getElementById('filterStatus').addEventListener('change', applyFilters);
    document.getElementById('filterType').addEventListener('change', applyFilters);
    document.getElementById('clearFilters').addEventListener('click', clearFilters);
    document.getElementById('exportExcel').addEventListener('click', exportToExcel);
    document.getElementById('exportCSV').addEventListener('click', exportToCSV);
    document.getElementById('onboardForm').addEventListener('submit', handleOnboard);
    document.getElementById('onboardModal').addEventListener('hidden.bs.modal', resetForm);
}

/* ── Documents ── */
function addNewDocument() {
    selectedDocuments.push({ id: Date.now(), file: null, name: '', type: '' });
    renderDocuments();
    document.getElementById('documentsList').style.display = 'block';
}
function handleFileSelect(index, event) {
    const file = event.target.files[0];
    if (file) { selectedDocuments[index].file = file; renderDocuments(); }
}
function renderDocuments() {
    const c = document.getElementById('documentsContainer'); c.innerHTML = '';
    selectedDocuments.forEach((doc, i) => {
        const d = document.createElement('div'); d.className = 'ag-doc-item';
        if (doc.file) {
            const fs = (doc.file.size / 1024).toFixed(2);
            d.innerHTML = `<div class="ag-doc-row">
                <div><div class="ag-doc-fname">${doc.file.name}</div><div class="ag-doc-fsize">${fs} KB</div></div>
                <div><input type="text" class="ag-doc-name-input" placeholder="Document Name" value="${doc.name}" onchange="updateDocumentName(${i},this.value)" required/></div>
                <div><select class="ag-doc-type-select" onchange="updateDocumentType(${i},this.value)" required>
                    <option value="">Type</option>
                    <option value="Aadhar Card" ${doc.type==='Aadhar Card'?'selected':''}>Aadhar Card</option>
                    <option value="PAN Card" ${doc.type==='PAN Card'?'selected':''}>PAN Card</option>
                    <option value="Resume" ${doc.type==='Resume'?'selected':''}>Resume</option>
                    <option value="Experience Letter" ${doc.type==='Experience Letter'?'selected':''}>Exp. Letter</option>
                    <option value="Bank Details" ${doc.type==='Bank Details'?'selected':''}>Bank Details</option>
                    <option value="Educational Certificate" ${doc.type==='Educational Certificate'?'selected':''}>Edu. Cert.</option>
                    <option value="Photo" ${doc.type==='Photo'?'selected':''}>Photo</option>
                    <option value="Other" ${doc.type==='Other'?'selected':''}>Other</option>
                </select></div>
                <div><button type="button" class="ag-doc-rm" onclick="removeDocument(${i})" title="Remove"><i class="fa-solid fa-times"></i></button></div>
            </div>`;
        } else {
            d.innerHTML = `<div class="ag-doc-row"><div style="grid-column:1/-1;display:flex;align-items:center;gap:8px;">
                <label class="ag-doc-upload-btn"><i class="fa-solid fa-upload"></i>Choose File
                    <input type="file" class="ag-doc-file-input" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" onchange="handleFileSelect(${i},event)"/>
                </label>
                <button type="button" class="ag-mcancel" onclick="removeDocument(${i})" style="font-size:.62rem;padding:3px 8px;">Remove</button>
            </div></div>`;
        }
        c.appendChild(d);
    });
}
function updateDocumentName(i, v) { selectedDocuments[i].name = v; }
function updateDocumentType(i, v) { selectedDocuments[i].type = v; }
function removeDocument(i) {
    selectedDocuments.splice(i, 1);
    if (selectedDocuments.length === 0) document.getElementById('documentsList').style.display = 'none';
    renderDocuments();
}

/* ── Filters ── */
function getDateFromFlatpickr(id) {
    const fp = document.getElementById(id)._flatpickr;
    return fp && fp.selectedDates.length ? fp.selectedDates[0] : null;
}
function applyFilters() {
    const s = document.getElementById('searchBox').value.toLowerCase();
    const status = document.getElementById('filterStatus').value;
    const type = document.getElementById('filterType').value;
    const fd = getDateFromFlatpickr('filterFromDate');
    const td = getDateFromFlatpickr('filterToDate');
    filteredAgents = allAgents.filter(a => {
        const ms = !s || (a.FullName && a.FullName.toLowerCase().includes(s)) || (a.Email && a.Email.toLowerCase().includes(s)) || (a.Phone && a.Phone.includes(s));
        const mst = !status || a.Status === status;
        const mt = !type || a.AgentType === type;
        let md = true;
        if (fd || td) {
            const ad = new Date(a.CreatedOn || new Date());
            if (fd) md = md && ad >= fd;
            if (td) { const te = new Date(td); te.setHours(23, 59, 59); md = md && ad <= te; }
        }
        return ms && mst && mt && md;
    });
    currentPage = 1; renderTable();
}
function clearFilters() {
    document.getElementById('searchBox').value = '';
    document.getElementById('filterStatus').value = '';
    document.getElementById('filterType').value = '';
    const fpFrom = document.getElementById('filterFromDate')._flatpickr;
    const fpTo = document.getElementById('filterToDate')._flatpickr;
    if (fpFrom) fpFrom.clear();
    if (fpTo) fpTo.clear();
    filteredAgents = [...allAgents]; currentPage = 1; renderTable();
}

/* ── Render ── */
function renderTable() {
    const c = document.getElementById('agentsContainer');
    const s = (currentPage - 1) * pageSize, e = s + pageSize;
    const pg = filteredAgents.slice(s, e);
    c.innerHTML = '';
    if (pg.length === 0) {
        c.innerHTML = `<div class="empty-state">
            <i class="fa-solid fa-user-tie"></i>
            <h3>No Agents Found</h3>
            <p>Onboard your first agent or adjust your filters</p>
            <button type="button" class="ag-onboard-btn" data-bs-toggle="modal" data-bs-target="#onboardModal" style="margin:0 auto;">
                <i class="fa-solid fa-plus"></i>Onboard Agent
            </button>
        </div>`;
        document.getElementById('paginationWrapper').style.display = 'none';
    } else {
        pg.forEach(agent => {
            const div = document.createElement('div'); div.className = 'agent-card';
            const statusClass = (agent.Status || 'pending').toLowerCase();
            const pendingBtns = agent.Status === 'Pending' ? `
                <button class="btn-act btn-approve" onclick="approveAgent(${agent.AgentId})" title="Approve"><i class="fa-solid fa-check"></i> Approve</button>
                <button class="btn-act btn-reject" onclick="rejectAgent(${agent.AgentId})" title="Reject"><i class="fa-solid fa-times"></i> Reject</button>` : '';
            div.innerHTML = `
                <div class="card-top">
        <a href="/Agentdetails/${agent.EncodedId}" class="agent-name">${agent.FullName || 'Unnamed Agent'}</a>
                    <div class="card-badges">
                        <span class="type-badge">${agent.AgentType || '-'}</span>
                        <span class="status-badge status-${statusClass}">${agent.Status || 'Pending'}</span>
                    </div>
                </div>
                <div class="card-info">
                    <div class="info-item"><i class="fa-solid fa-envelope"></i><span>${agent.Email || '-'}</span></div>
                    <div class="info-item"><i class="fa-solid fa-phone"></i><span>${agent.Phone || '-'}</span></div>
                    <div class="info-item"><i class="fa-solid fa-map-marker-alt"></i><span>${agent.Address || '-'}</span></div>
                    <div class="info-item"><i class="fa-solid fa-indian-rupee-sign"></i><span>${agent.Salary ? '₹' + agent.Salary.toLocaleString('en-IN') : 'No salary'}</span></div>
                </div>
                <div class="card-commission"><i class="fa-solid fa-percentage"></i><strong>${agent.CommissionRules || 'No commission'}</strong></div>
                <div class="card-actions">
                    ${pendingBtns}
                    <button class="btn-act btn-edit" onclick="editAgent(${agent.AgentId})" title="Edit"><i class="fa-solid fa-edit"></i> Edit</button>
                    <button class="btn-act btn-del" onclick="deleteAgent(${agent.AgentId})" title="Delete"><i class="fa-solid fa-trash"></i></button>
                </div>`;
            c.appendChild(div);
        });
        document.getElementById('paginationWrapper').style.display = 'flex';
    }
    updatePaginationInfo(); renderPagination(); updateStats();
}

function updateStats() {
    document.getElementById('totalAgents').textContent = filteredAgents.length;
    document.getElementById('pendingAgents').textContent = filteredAgents.filter(a => a.Status === 'Pending').length;
    document.getElementById('approvedAgents').textContent = filteredAgents.filter(a => a.Status === 'Approved').length;
    document.getElementById('rejectedAgents').textContent = filteredAgents.filter(a => a.Status === 'Rejected').length;
}
function updatePaginationInfo() {
    const tot = filteredAgents.length, s = tot === 0 ? 0 : (currentPage - 1) * pageSize + 1, e = Math.min(currentPage * pageSize, tot);
    document.getElementById('showingStart').textContent = s;
    document.getElementById('showingEnd').textContent = e;
    document.getElementById('totalRecords').textContent = tot;
}
function renderPagination() {
    const pg = document.getElementById('pagination');
    const tp = Math.ceil(filteredAgents.length / pageSize);
    pg.innerHTML = '';
    if (tp <= 1) { const li = document.createElement('li'); li.className = 'page-item active'; li.innerHTML = '<span class="page-link">1</span>'; pg.appendChild(li); return; }
    const prev = document.createElement('li'); prev.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
    prev.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage - 1});return false;">&laquo;</a>`; pg.appendChild(prev);
    const sp = Math.max(1, currentPage - 2), ep = Math.min(tp, currentPage + 2);
    for (let i = sp; i <= ep; i++) { const li = document.createElement('li'); li.className = `page-item ${i === currentPage ? 'active' : ''}`; li.innerHTML = `<a class="page-link" href="#" onclick="changePage(${i});return false;">${i}</a>`; pg.appendChild(li); }
    const next = document.createElement('li'); next.className = `page-item ${currentPage === tp ? 'disabled' : ''}`;
    next.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage + 1});return false;">&raquo;</a>`; pg.appendChild(next);
}
function changePage(p) { const tp = Math.ceil(filteredAgents.length / pageSize); if (p < 1 || p > tp) return; currentPage = p; renderTable(); window.scrollTo({ top: 0, behavior: 'smooth' }); }

/* ── Agent actions ── */
function approveAgent(id) {
    Swal.fire({ title: 'Documents Verified', text: 'Approve this agent?', icon: 'question', showCancelButton: true, confirmButtonColor: '#1A6FA8', cancelButtonColor: '#6B7B8D', confirmButtonText: 'OK' }).then(r => { if (r.isConfirmed) { const f = _mkForm('/Agent/Approve', { agentId: id }); f.submit(); } });
}
function deleteAgent(id) {
    Swal.fire({ title: 'Are you sure?', text: 'Agent will be deleted.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#DC2626', cancelButtonColor: '#6B7B8D', confirmButtonText: 'Yes, delete!' }).then(r => { if (r.isConfirmed) { const f = _mkForm('/Agent/Delete', { agentId: id }); f.submit(); } });
}
function rejectAgent(id) {
    Swal.fire({ title: 'Reject Agent?', text: 'Reject this agent?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#DC2626', cancelButtonColor: '#6B7B8D', confirmButtonText: 'Yes, reject!' }).then(r => { if (r.isConfirmed) { const f = _mkForm('/Agent/Reject', { agentId: id }); f.submit(); } });
}
function _mkForm(action, fields) {
    const f = document.createElement('form'); f.method = 'POST'; f.action = action;
    const tok = document.querySelector('input[name="__RequestVerificationToken"]');
    if (tok) { const t = document.createElement('input'); t.type = 'hidden'; t.name = '__RequestVerificationToken'; t.value = tok.value; f.appendChild(t); }
    Object.entries(fields).forEach(([k, v]) => { const i = document.createElement('input'); i.type = 'hidden'; i.name = k; i.value = v; f.appendChild(i); });
    document.body.appendChild(f); return f;
}

function handleOnboard(e) {
    e.preventDefault();
    const form = e.target;
    const isEdit = form.action.includes('UpdateAgent');
    const reqFields = ['FullName', 'Email', 'Phone', 'AgentType', 'CommissionRules'];
    let valid = true;
    reqFields.forEach(n => { const el = document.querySelector(`[name="${n}"]`); if (el && !agV(el)) valid = false; });
    if (!form.checkValidity()) { form.classList.add('was-validated'); valid = false; }
    if (!isEdit && !emailValid && document.getElementById('modalEmailInput').value.trim()) {
        document.getElementById('onboardError').textContent = 'Please use a unique email address';
        document.getElementById('onboardError').classList.remove('d-none'); valid = false;
    }
    if (!valid) return;
    if (selectedDocuments.length > 0) {
        for (let i = 0; i < selectedDocuments.length; i++) {
            const d = selectedDocuments[i];
            if (!d.file) { document.getElementById('onboardError').textContent = 'Please select a file for all documents or remove empty rows'; document.getElementById('onboardError').classList.remove('d-none'); return; }
            if (!d.name || !d.type) { document.getElementById('onboardError').textContent = 'Please provide name and type for all documents'; document.getElementById('onboardError').classList.remove('d-none'); return; }
        }
    }
    const formData = new FormData(form);
    selectedDocuments.forEach(d => { if (d.file) { formData.append('DocumentFiles', d.file); formData.append('DocumentNames', d.name); formData.append('DocumentTypes', d.type); } });
    const url = isEdit ? form.action : '/Agent/Onboard';
    const btn = document.getElementById('modalSubmitBtn'); btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Submitting...';
    fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: formData })
        .then(r => r.json()).then(data => {
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('onboardModal')).hide();
                setTimeout(() => showToast(data.message || 'Agent onboarded successfully!', 'success'), 500);
                setTimeout(() => location.reload(), 2500);
            } else {
                document.getElementById('onboardError').textContent = data.message || (data.errors ? data.errors.join(', ') : 'Submission failed');
                document.getElementById('onboardError').classList.remove('d-none');
                document.getElementById('onboardSuccess').classList.add('d-none');
            }
        }).catch(err => {
            document.getElementById('onboardError').textContent = 'Error: ' + err.message;
            document.getElementById('onboardError').classList.remove('d-none');
        }).finally(() => { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i>Submit'; });
}

function resetForm() {
    document.getElementById('onboardForm').reset();
    document.getElementById('onboardForm').classList.remove('was-validated');
    document.getElementById('onboardSuccess').classList.add('d-none');
    document.getElementById('onboardError').classList.add('d-none');
    document.getElementById('modalEmailError').style.display = 'none';
    document.getElementById('modalSubmitBtn').disabled = false;
    selectedDocuments = [];
    document.getElementById('documentsContainer').innerHTML = '';
    document.getElementById('documentsList').style.display = 'none';
    emailValid = false;
    document.getElementById('onboardModalLabel').textContent = 'Agent Onboarding';
    document.getElementById('onboardForm').action = '';
    agResetForm();
}

function editAgent(id) {
    fetch(`/Agent/GetAgent?id=${id}`).then(r => r.json()).then(data => {
        if (data.success) {
            const a = data.agent;
            document.querySelector('[name="FullName"]').value = a.fullName || '';
            document.querySelector('[name="Email"]').value = a.email || '';
            document.querySelector('[name="Phone"]').value = a.phone || '';
            document.querySelector('[name="Address"]').value = a.address || '';
            document.querySelector('[name="AgentType"]').value = a.agentType || '';
            document.querySelector('[name="Salary"]').value = a.salary || '';
            document.querySelector('[name="CommissionRules"]').value = a.commissionRules || '';
            document.getElementById('onboardModalLabel').textContent = 'Edit Agent';
            document.getElementById('onboardForm').action = `/Agent/UpdateAgent?id=${id}`;
            emailValid = true;
            new bootstrap.Modal(document.getElementById('onboardModal')).show();
        }
    }).catch(err => console.error('Error:', err));
}

function exportToExcel() {
    const wd = [['Full Name','Email','Phone','Address','Agent Type','Salary','Commission Rules','Status','Documents']];
    filteredAgents.forEach(a => wd.push([a.FullName||'',a.Email||'',a.Phone||'',a.Address||'',a.AgentType||'',a.Salary||'',a.CommissionRules||'',a.Status||'',a.Documents||'']));
    const wb = XLSX.utils.book_new(); const ws = XLSX.utils.aoa_to_sheet(wd);
    ws['!cols'] = [{wch:20},{wch:25},{wch:15},{wch:30},{wch:12},{wch:12},{wch:30},{wch:12},{wch:30}];
    XLSX.utils.book_append_sheet(wb, ws, 'Agents'); XLSX.writeFile(wb, `Agents_Export_${new Date().toISOString().split('T')[0]}.xlsx`);
    showToast('Excel exported!', 'success');
}
function exportToCSV() {
    let csv = 'Full Name,Email,Phone,Address,Agent Type,Salary,Commission Rules,Status,Documents\n';
    filteredAgents.forEach(a => { csv += [escapeCSV(a.FullName),escapeCSV(a.Email),escapeCSV(a.Phone),escapeCSV(a.Address),escapeCSV(a.AgentType),a.Salary||'',escapeCSV(a.CommissionRules),escapeCSV(a.Status),escapeCSV(a.Documents)].join(',') + '\n'; });
    const blob = new Blob([csv], {type:'text/csv'}); const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = `Agents_Export_${new Date().toISOString().split('T')[0]}.csv`; a.click(); window.URL.revokeObjectURL(url);
    showToast('CSV exported!', 'success');
}
function escapeCSV(v) { if (!v) return ''; v = v.toString(); if (v.includes(',') || v.includes('"') || v.includes('\n')) return '"' + v.replace(/"/g, '""') + '"'; return v; }
    </script>
