                                    <option value="None (0% of sale)">0% (None)</option>
                                    <option value="0.5% of sale">0.5%</option>
                                    <option value="1% of sale">1%</option>
                                    <option value="1.5% of sale">1.5%</option>
                                    <option value="2% of sale">2%</option>
                                    <option value="2.5% of sale">2.5%</option>
                                    <option value="3% of sale">3%</option>
                                    <option value="3.5% of sale">3.5%</option>
                                    <option value="4% of sale">4%</option>
                                    <option value="4.5% of sale">4.5%</option>
                                    <option value="5% of sale">5%</option>
                                    <option value="5.5% of sale">5.5%</option>
                                    <option value="6% of sale">6%</option>
                                    <option value="6.5% of sale">6.5%</option>
                                    <option value="7% of sale">7%</option>
                                    <option value="7.5% of sale">7.5%</option>
                                    <option value="8% of sale">8%</option>
                                    <option value="8.5% of sale">8.5%</option>
                                    <option value="9% of sale">9%</option>
                                    <option value="9.5% of sale">9.5%</option>
                                    <option value="10% of sale">10%</option>
                                    <option value="11% of sale">11%</option>
                                    <option value="12% of sale">12%</option>
                                    <option value="13% of sale">13%</option>
                                    <option value="14% of sale">14%</option>
                                    <option value="15% of sale">15%</option>
                                    <option value="20% of sale">20%</option>
                                </select>
                                <span class="ag-vi ag-ok"><i class="fas fa-check-circle"></i></span>
                                <span class="ag-vi ag-er"><i class="fas fa-times-circle"></i></span>
                            </div>
