		padding: 0;
		margin: 0;
	}

		.feature-list li {
			padding: 0.25rem 0;
			font-size: 0.875rem;
		}

			.feature-list li i {
				width: 16px;
				margin-right: 0.5rem;
			}

	#saasUpgradeModal .modal-body {
		padding: 10px !important;
	}

	#saasUpgradeModal .card {
		margin-bottom: 10px !important;
	}

	#saasUpgradeModal .card-body {
		padding: 10px !important;
	}

	#saasUpgradeModal .card-header {
		padding: 8px 10px !important;
	}

	#saasUpgradeModal h6 {
		font-size: 13px !important;
		margin-bottom: 8px !important;
	}

	#saasUpgradeModal p {
		margin: 3px 0 !important;
