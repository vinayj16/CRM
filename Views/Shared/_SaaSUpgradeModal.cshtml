</style>

<script>
	(function () {
		let saasSelectedUpgradeType = null;
		let saasSelectedPlanId = null;
		let saasSelectedBillingCycle = 'monthly';
		let saasCurrentTenantData = null;
		let calculationData = null;

		function money(value) {
			return Number(value || 0).toLocaleString();
		}

		function escapeHtml(value) {
			return String(value ?? '')
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#125082;');
		}

		function getPartner() {
			return saasCurrentTenantData ? (saasCurrentTenantData.partner || saasCurrentTenantData.tenant) : null;
		}

		function getTenantId() {
			const partner = getPartner();
			return partner ? (partner.tenantId || partner.TenantId) : null;
		}

		async function readJsonResponse(response, endpointName) {
			const text = await response.text();

			if (!response.ok) {
				console.error(endpointName + ' failed:', response.status, text);
				throw new Error('HTTP ' + response.status);
			}

			try {
				return JSON.parse(text);
			} catch (error) {
				console.error(endpointName + ' returned non JSON:', text);
				throw error;
			}
		}

		window.openSaasUpgradeModal = function (tenantId) {
			console.log('=== UPGRADE MODAL OPENED ===');
			console.log('Tenant ID:', tenantId);

			resetSaasUpgradeModal();

			fetch('/saassubscription/GetUpgradeOptions?tenantId=' + encodeURIComponent(tenantId))
				.then(response => readJsonResponse(response, 'GetUpgradeOptions'))
				.then(data => {
					console.log('=== API RESPONSE ===');
					console.log('Response data:', data);

					if (!data.success) {
						Swal.fire('Error', data.message || 'Failed to load upgrade options', 'error');
						return;
					}

					saasCurrentTenantData = data;
					populateSaasTenantInfo(data.partner || data.tenant);
					populateSaasCurrentSubscription(data.currentSubscription);
					populateSaasAvailablePlans(data.availablePlans || []);

					new bootstrap.Modal(document.getElementById('saasUpgradeModal')).show();
				})
				.catch(error => {
					console.error('Error loading upgrade options:', error);
					Swal.fire('Error', 'Failed to load upgrade options', 'error');
				});
		};

		function resetSaasUpgradeModal() {
			saasSelectedUpgradeType = null;
			saasSelectedPlanId = null;
			saasSelectedBillingCycle = 'monthly';
			saasCurrentTenantData = null;
			calculationData = null;

			document.getElementById('saasPartnerInfo').style.display = 'none';
			document.getElementById('saasCurrentSubscriptionCard').style.display = 'none';
			document.getElementById('saasUpgradeTypeDetails').style.display = 'none';
			document.getElementById('saasPlanSelectionSection').style.display = 'none';
			document.getElementById('saasCalculationResults').style.display = 'none';
			document.getElementById('saasRefundSection').style.display = 'none';
			document.getElementById('saasSendPaymentLinkBtn').style.display = 'none';

			document.querySelectorAll('.upgrade-type-card, .plan-card').forEach(card => {
				card.classList.remove('selected');
			});

			document.getElementById('saasAvailablePlans').innerHTML = '';
			document.getElementById('saasCalculationContent').innerHTML = '';
			document.getElementById('saasRefundableTransactions').innerHTML = '';
		}

		function populateSaasTenantInfo(partner) {
			if (!partner) return;

			document.getElementById('saasPartnerName').textContent = partner.companyName || partner.CompanyName || partner.contactPerson || '';
			document.getElementById('saasPartnerEmail').textContent = partner.email || partner.Email || '';
			document.getElementById('saasPartnerInfo').style.display = 'block';
		}

		function populateSaasCurrentSubscription(subscription) {
			if (subscription) {
				document.getElementById('saasCurrentPlanName').textContent = subscription.planName || '';
				document.getElementById('saasCurrentAmount').textContent =subscription.amount.toLocaleString();
				document.getElementById('saasCurrentBilling').textContent = subscription.billingCycle || '';
				document.getElementById('saasCurrentExpiry').textContent = new Date(subscription.endDate).toLocaleDateString();

			   var daysEl = document.getElementById('saasDaysRemaining');
				if (subscription.daysRemaining <= 0) {
					daysEl.textContent = 'Expired';
					daysEl.className = 'badge bg-danger';
				} else {
					daysEl.textContent = `${subscription.daysRemaining} days remaining`;
				}
				document.getElementById('saasCurrentSubscriptionCard').style.display = 'block';

			}

			// Show scheduled subscription if exists
				if (saasCurrentTenantData && saasCurrentTenantData.scheduledSubscription) {
					var scheduled = saasCurrentTenantData.scheduledSubscription;
					var scheduledHtml = `<div class="mt-2 p-2" style="background: #FEF3C7; border-radius: 6px; border: 1px solid #F59E0B;">
						<strong><i class="fa-solid fa-calendar-check me-1"></i>Scheduled Plan:</strong> ${scheduled.planName} (${scheduled.billingCycle}) - ₹${scheduled.amount.toLocaleString()}
						<br><small>Activates: ${new Date(scheduled.startDate).toLocaleDateString()} -> ${new Date(scheduled.endDate).toLocaleDateString()}</small>
					</div>`;
					var cardBody = document.querySelector('#saasCurrentSubscriptionCard .card-body');
					if (cardBody) {
						cardBody.insertAdjacentHTML('beforeend', scheduledHtml);
					}
					document.getElementById('saasCurrentSubscriptionCard').style.display = 'block';
				}
		}


			function populateSaasAvailablePlans(plans) {
		const container = document.getElementById('saasAvailablePlans');
		container.innerHTML = '';

		plans.forEach(plan => {
			const planCard = createPlanCard(plan);
			container.appendChild(planCard);
		});

		// Highlight current plan after all plans are loaded
		if (saasCurrentTenantData && saasCurrentTenantData.currentSubscription) {
			const currentPlanId = saasCurrentTenantData.currentSubscription.planId;
	console.log('DEBUG: currentPlanId =', currentPlanId, typeof currentPlanId);
	console.log('DEBUG: available cards =', document.querySelectorAll('#saasUpgradeModal [data-plan-id]').length);
	const currentPlanCard = document.querySelector(`#saasUpgradeModal [data-plan-id="${currentPlanId}"]`);
	console.log('DEBUG: currentPlanCard found =', currentPlanCard);
			if (currentPlanCard) {
				currentPlanCard.classList.add('current-plan');

				// Add current plan badge
				const cardBody = currentPlanCard.querySelector('.card-body');
				if (cardBody && !cardBody.querySelector('.current-plan-badge')) {
					const badge = document.createElement('div');
					badge.className = 'badge bg-primary current-plan-badge mb-2';
					var isExpired = saasCurrentTenantData.currentSubscription.saasDaysRemaining <= 0;
					badge.textContent = isExpired ? `Expired (${saasCurrentTenantData.currentSubscription.billingCycle})` : `Current Plan (${saasCurrentTenantData.currentSubscription.billingCycle})`;
					if (isExpired) badge.className = 'badge bg-danger current-plan-badge mb-2';
					cardBody.insertBefore(badge, cardBody.firstChild);
				}
			}
		}
	}

			function createPlanCard(plan) {
		const col = document.createElement('div');
		col.className = 'col-md-6 col-lg-4 mb-3';

		col.innerHTML = `
			<div class="card h-100 plan-card" data-plan-id="${plan.planId}" onclick="selectPlan('${plan.planId}')">
				<div class="card-body">
					<h5 class="card-title">${plan.planName}</h5>
					<p class="card-text small text-muted">${plan.description || ''}</p>

					<div class="billing-toggle mb-3">
						<button type="button" class="monthly-btn active" onclick="event.stopPropagation(); toggleBilling('${plan.planId}', 'monthly')">Monthly</button>
						<button type="button" class="annual-btn" onclick="event.stopPropagation(); toggleBilling('${plan.planId}', 'annual')">Annual</button>
					</div>

					<div class="text-center mb-3">
						<div class="monthly-price">
							<h3 class="text-primary">₹${plan.monthlyPrice.toLocaleString()}</h3>
							<small class="text-muted">per month</small>
						</div>
						<div class="annual-price" style="display: none;">
							<h3 class="text-primary">₹${plan.yearlyPrice.toLocaleString()}</h3>
							<small class="text-muted">per year</small>
							${plan.monthlyPrice > 0 ? `<div class="badge bg-success mt-1">Save ${Math.round(((plan.monthlyPrice * 12 - plan.yearlyPrice) / (plan.monthlyPrice * 12)) * 100)}%</div>` : ''}
						</div>
					</div>

					<ul class="feature-list">
						<li><i class="fa-solid fa-users text-primary"></i> ${plan.maxAgents === -1 ? 'Unlimited' : plan.maxAgents} Agents</li>
						<li><i class="fa-solid fa-chart-line text-primary"></i> ${plan.maxLeadsPerMonth === -1 ? 'Unlimited' : plan.maxLeadsPerMonth} Leads/Month</li>
						<li><i class="fa-solid fa-database text-primary"></i> ${plan.maxStorageGB === -1 ? 'Unlimited' : plan.maxStorageGB + ' GB'} Storage</li>
						<li><i class="fa-solid ${plan.hasWhatsAppIntegration ? 'fa-check text-success' : 'fa-times text-danger'}"></i> WhatsApp Integration</li>
						<li><i class="fa-solid ${plan.hasAdvancedReports ? 'fa-check text-success' : 'fa-times text-danger'}"></i> Advanced Reports</li>
						<li><i class="fa-solid fa-headset text-primary"></i> ${plan.supportLevel} Support</li>
					</ul>
				</div>
			</div>
		`;

		return col;
	}

		function isSamePlan(subscription, plan) {
			if (!subscription || !plan) return false;

			if (subscription.planId != null && plan.planId != null) {
				return Number(subscription.planId) === Number(plan.planId);
			}

			return String(subscription.planName || '').toLowerCase() === String(plan.planName || '').toLowerCase();
		}

			window.toggleBilling = function(planId, cycle) {
				console.log(planId,cycle,saasCurrentTenantData?.currentSubscription?.billingCycle,saasCurrentTenantData?.currentSubscription?.planId)
		const card = document.querySelector(`[data-plan-id="${planId}"]`);
		const monthlyBtn = card.querySelector('.monthly-btn');
		const annualBtn = card.querySelector('.annual-btn');
		const monthlyPrice = card.querySelector('.monthly-price');
		const annualPrice = card.querySelector('.annual-price');

		if (cycle === 'monthly') {
			monthlyBtn.classList.add('active');
			annualBtn.classList.remove('active');
			monthlyPrice.style.display = 'block';
			annualPrice.style.display = 'none';
		} else {
			monthlyBtn.classList.remove('active');
			annualBtn.classList.add('active');
			monthlyPrice.style.display = 'none';
			annualPrice.style.display = 'block';
		}

		// Update current plan badge visibility
		const currentPlanBadge = card.querySelector('.current-plan-badge');
		console.log('found' ,currentPlanBadge);
		if (currentPlanBadge && saasCurrentTenantData && saasCurrentTenantData.currentSubscription) {
			const currentPlanId = saasCurrentTenantData.currentSubscription.planId;
			const saasCurrentBillingCycle = saasCurrentTenantData.currentSubscription.billingCycle;

			// Show badge only if both plan ID and billing cycle match
			if (String(planId) === String(currentPlanId) && cycle.toLowerCase() === saasCurrentBillingCycle.toLowerCase()) {
				currentPlanBadge.style.setProperty('display','block','important');
				card.classList.add('current-plan');
			} else {
				console.log(planId, currentPlanId , cycle.toLowerCase() , saasCurrentBillingCycle.toLowerCase())
				currentPlanBadge.style.setProperty('display','none','important');
				card.classList.remove('current-plan');
			}
		}

		// Update global billing cycle if this is the selected plan
		if (saasSelectedPlanId === planId) {
			saasSelectedBillingCycle = cycle;
			window.calculateUpgrade();
		}
	};

		window.selectUpgradeType = function (type) {
			saasSelectedUpgradeType = type;

			// Update UI - scope to saasUpgradeModal only
			document.querySelectorAll('#saasUpgradeModal .upgrade-type-card').forEach(card => {
				card.classList.remove('selected');
			});

			const selectedCard = document.querySelector(`#saasUpgradeModal [data-type="${type}"]`);
			if (selectedCard) selectedCard.classList.add('selected');

			const detailsSection = document.getElementById('saasUpgradeTypeDetails');
			const detailsContent = document.getElementById('saasUpgradeTypeDetailsContent');

			if (type === 'existing') {
				detailsContent.className = 'alert alert-info mb-0';
				detailsContent.innerHTML = '<strong>Day-based conversion:</strong><br>Remaining amount / upgrade per-day rate = days<br>+1 day if any remainder &gt; 0';
			} else if (type === 'immediate') {
				detailsContent.className = 'alert alert-success mb-0';
				detailsContent.innerHTML = '<strong>Full duration:</strong><br>Monthly: 30 days | Annual: 365 days<br>Credit applied from current plan';
			} else if (type === 'scheduled') {
				detailsContent.className = 'alert alert-warning mb-0';
				detailsContent.innerHTML = '<strong>Future activation:</strong><br>Starts on current plan end date + 1 day<br>Full plan duration applies';
			}

			detailsSection.style.display = 'block';
			document.getElementById('saasPlanSelectionSection').style.display = 'block';

			// if (saasSelectedPlanId) {
			// 	window.calculateUpgrade();
			// }
		};

		window.selectPlan = function(planId) {
	console.log('=== PLAN SELECTED ===');
	console.log('Plan ID:', planId);
	console.log('selectPlan called with planId:', planId);

	// Get the selected card to check billing cycle
	const selectedCard = document.querySelector(`[data-plan-id="${planId}"]`);
	const isAnnualActive = selectedCard ? selectedCard.querySelector('.annual-btn').classList.contains('active') : false;
	saasSelectedBillingCycle = isAnnualActive ? 'annual' : 'monthly';

	// Check if this is the current plan with same billing cycle
	if (saasCurrentTenantData && saasCurrentTenantData.currentSubscription &&
		saasCurrentTenantData.currentSubscription.planId === planId &&
		saasCurrentTenantData.currentSubscription.billingCycle.toLowerCase() === saasSelectedBillingCycle.toLowerCase()) {

		const subscription = saasCurrentTenantData.currentSubscription;
		const expiryDate = new Date(subscription.endDate).toLocaleDateString();

			Swal.fire({
				title: 'Current Active Plan',
				text: `This is your current active plan. It will expire on ${expiryDate}.`,
				icon: 'info',
				confirmButtonText: 'OK'
			});
			return;
		}

		// Check if upgrade type is selected first
		if (!saasSelectedUpgradeType) {
			Swal.fire('Select Upgrade Type', 'Please select an upgrade type first (Existing Upgrade, Immediate Upgrade, or Scheduled Plan)', 'warning');
			console.log('Please select an upgrade type first (Existing Upgrade, Immediate Upgrade, or Scheduled Plan)');
			return;
		}

		saasSelectedPlanId = planId;

		// Update UI
		document.querySelectorAll('.plan-card').forEach(card => {
			card.classList.remove('selected');
		});

		if (selectedCard) {
			selectedCard.classList.add('selected');

			// Update global billing cycle
			window.saasSelectedBillingCycle = saasSelectedBillingCycle;
			console.log('Selected billing cycle:', saasSelectedBillingCycle);

			// Calculate upgrade
			window.calculateUpgrade();
		} else {
			console.error('Selected card not found for planId:', planId);
		}
	};

		window.calculateUpgrade = function () {
			console.log('=== CALCULATE UPGRADE CALLED ===');

			const tenantId = getTenantId();

			if (!tenantId || !saasSelectedUpgradeType || !saasSelectedPlanId) {
				console.log('Missing required data for calculation');
				return;
			}

			fetch('/saassubscription/calculateupgrade', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/x-www-form-urlencoded'
				},
				body: new URLSearchParams({
					tenantId: tenantId,
					newPlanId: saasSelectedPlanId,
					billingCycle: saasSelectedBillingCycle,
					upgradeType: saasSelectedUpgradeType
				})
			})
				.then(response => readJsonResponse(response, 'CalculateUpgrade'))
				.then(data => {
					console.log('=== CALCULATION RESPONSE ===');
					console.log('Calculation data:', data);

					if (data.success) {
						calculationData = data;
						displayCalculationResults(data);
					} else {
						Swal.fire('Error', data.message || 'Failed to calculate upgrade', 'error');
					}
				})
				.catch(error => {
					console.error('Error calculating upgrade:', error);
					Swal.fire('Error', 'Failed to calculate upgrade', 'error');
				});
		};

		function displayCalculationResults(data) {
			const calc = data.calculation || {};

			if (data.insufficientAmount) {
				const shortfall = calc.shortfall || 0;
				const requiredAmount = calc.requiredAmount || 0;
				const remainingAmount = calc.remainingAmount || 0;

				Swal.fire({
					title: 'Insufficient Amount',
					html: `
						<div style="text-align:left;font-size:14px;">
							<div style="background:#F0F4F8;padding:15px;border-radius:8px;border:2px solid #E8C27E;">
								<h6 style="color:#DC2626;margin-bottom:10px;">Insufficient Amount</h6>
								<p><strong>Current Plan:</strong> ${escapeHtml(calc.currentPlan || 'N/A')}</p>
								<p><strong>Remaining Amount:</strong> ₹${money(remainingAmount)}</p>
								<p><strong>Required for 1 day:</strong> ₹${money(requiredAmount)}</p>
								<p><strong>Shortfall:</strong> ₹${money(shortfall)}</p>
								<hr>
								<p style="color:#DC2626;font-weight:bold;">Your remaining amount is not sufficient for this upgrade.</p>
								<p style="font-size:12px;color:#6B7B8D;">Please choose Immediate Upgrade or Scheduled Plan instead.</p>
							</div>
						</div>
					`,
					icon: 'error',
					confirmButtonText: 'Choose Different Option',
					confirmButtonColor: '#DC2626',
					width: '500px'
				});
				return;
			}

			let content = '';

				 switch (data.upgradeType) {
			case 'existing': {
				const existingCurrentAmount = calc.currentAmount || 0;
				const existingRemainingDays = calc.remainingDays || 0;
				const currentPerDayRate =
					existingRemainingDays > 0
						? existingCurrentAmount / existingRemainingDays
						: 0;
				const upgradePerDayRate = calc.upgradePerDayRate || 0;
				const convertedDays = calc.convertedDays || 0;

			content = `
				<div style="text-align: left; font-size: 12px;">
					<div style="background: #FFFFFF; padding: 12px; border-radius: 8px; margin-bottom: 2px;">
						<h6 style="color: #2589C9; margin-bottom: 10px;"><i class="fa-solid fa-chart-bar me-2"></i>Current Plan Analysis</h6>
						<p><strong>Current Plan:</strong> ${calc.currentPlan || 'N/A'}</p>
						<p><strong>Plan Amount:</strong> ₹${existingCurrentAmount.toLocaleString()}</p>
						<p><strong>Remaining Days:</strong> ${existingRemainingDays} days</p>
						<p><strong>Current Per Day Rate:</strong> ₹${currentPerDayRate.toFixed(2)}/day</p>
						<p><strong>Remaining Amount:</strong> ₹${(calc.remainingAmount || 0).toLocaleString()}</p>
					</div>

					<div style="background: #F0F4F8; padding: 15px; border-radius: 8px;">
						<h6 style="color: #16A34A; margin-bottom: 10px;"><i class="fa-solid fa-arrows-rotate me-2"></i>Conversion Calculation</h6>
						<p><strong>New Plan Per Day Rate:</strong> ₹${upgradePerDayRate.toFixed(2)}/day</p>
						<p><strong>Conversion Formula:</strong>
							₹${(calc.remainingAmount || 0).toLocaleString()}
							÷ ₹${upgradePerDayRate.toFixed(2)}
							= ${convertedDays} days
						</p>
						<hr>
						<p><strong>You will get:</strong> ${convertedDays} days of ${calc.newPlan || 'N/A'}</p>
						<p style="color: #16A34A;"><strong>No additional payment required!</strong></p>
					</div>
				</div>
			`;
				break;
			}

		case 'immediate': {
			const immediateCurrentAmount = calc.currentAmount || 0;
			const immediateRemainingDays = calc.remainingDays || 0;
			const creditAmount = calc.creditAmount || 0;

			content = `
				<div style="text-align: left; font-size: 14px;">
					<div style="display: flex; gap: 10px; margin-bottom: 10px;">
						<div style="flex: 1; background: #FFFFFF; padding: 10px; border-radius: 8px;">
							<h6 style="color: #2589C9;"><i class="fa-solid fa-chart-bar me-2"></i>Current Plan Analysis</h6>
							<p><strong>Current Plan:</strong> ${calc.currentPlan || 'N/A'}</p>
							<p><strong>Plan Amount:</strong> ₹${immediateCurrentAmount.toLocaleString()}</p>
							<p><strong>Remaining Days:</strong> ${immediateRemainingDays} days</p>
							<p><strong>Per Day Rate:</strong>
								₹${(immediateCurrentAmount / Math.max(1, immediateRemainingDays)).toFixed(2)}/day
							</p>
							<p><strong>Remaining Value:</strong> ₹${creditAmount.toFixed(2)}</p>
						</div>

						<div style="flex: 1; background: #FFFFFF; padding: 10px; border-radius: 8px;">
							<h6 style="color: #2589C9;"><i class="fa-solid fa-credit-card me-2"></i>Payment Breakdown</h6>
							<p><strong>New Plan Cost:</strong> ₹${(calc.newAmount || 0).toLocaleString()}</p>
							<p><strong>Credit from Current Plan:</strong> -₹${creditAmount.toLocaleString()}</p>
							<hr>
							<p>
								<strong><i class="fa-solid fa-credit-card me-2"></i>Amount to Pay:</strong>
								<span style="color: #DC2626;">
									₹${(calc.adjustedAmount || 0).toLocaleString()}
								</span>
							</p>
						</div>
					</div>

					<div style="background: #F0F4F8; padding: 10px; border-radius: 8px;">
						<h6 style="color: #16A34A;"><i class="fa-solid fa-calendar me-2"></i>New Subscription Details</h6>
						<p><strong>Plan:</strong> ${calc.newPlan || 'N/A'}</p>
						<p><strong>Duration:</strong> Full ${saasSelectedBillingCycle || 'monthly'} period</p>
						<p><strong>Starts:</strong>
							${calc.startDate
								? new Date(calc.startDate).toLocaleDateString()
									: 'Immediately'}
							</p>
							<p><strong>Expires:</strong>
								${calc.endDate
									? new Date(calc.endDate).toLocaleDateString()
									: 'N/A'}
							</p>
						</div>
					</div>
				`;
				break;
			}

		case 'scheduled': {
			content = `
				<div style="text-align: left; font-size: 14px;">
					<div style="background: #FEF3C7; padding: 10px; border-radius: 8px;">
						<h6 style="color: #F59E0B;"><i class="fa-solid fa-calendar me-2"></i>Scheduled Plan Details</h6>
						<p><strong>Plan:</strong> ${calc.newPlan || 'N/A'}</p>
						<p>
							<strong>Amount to Pay:</strong>
							<span style="color: #DC2626;">
								₹${(calc.newAmount || 0).toLocaleString()}
							</span>
						</p>
						<p><strong>Activation Date:</strong>
							${calc.startDate
								? new Date(calc.startDate).toLocaleDateString()
								: 'N/A'}
						</p>
						<p style="font-size: 12px; color: #6B7B8D;">
							Plan will activate automatically after your current plan expires.
						</p>
					</div>
				</div>
			`;
			break;
		}
		}

		const isExistingUpgrade = data.upgradeType === 'existing';

	Swal.fire({
		title: '<i class="fa-solid fa-chart-bar me-2"></i>Upgrade Calculation',
			html: content,
			showCancelButton: true,
			confirmButtonText: isExistingUpgrade
				? 'Activate Now'
				: 'Proceed to Payment',
			cancelButtonText: 'Cancel',
			confirmButtonColor: '#2589C9',
			cancelButtonColor: '#6B7B8D',
			width: '600px'
		}).then((result) => {
			if (result.isConfirmed) {
				if (isExistingUpgrade) {
					activatePlanNow();
				} else {
					document.getElementById('saasSendPaymentLinkBtn').style.display = 'block';
					sendPaymentLink();
				}
			}
		});
	}


		window.sendPaymentLink = function() {
	console.log('=== SEND PAYMENT LINK CLICKED ===');
	console.log('calculationData:', calculationData);
	console.log('saasCurrentTenantData:', saasCurrentTenantData);

	if (!calculationData || !saasCurrentTenantData) {
		console.log('Missing data - showing error');
		Swal.fire('Error', 'Missing calculation data', 'error');
		return;
	}

	const tenantId = saasCurrentTenantData.partner.tenantId;
	let amount = 0;

	// Get the correct amount based on upgrade type
	if (calculationData.upgradeType === 'immediate') {
		amount = calculationData.calculation.adjustedAmount || calculationData.calculation.paymentRequired || 0;
	} else if (calculationData.upgradeType === 'scheduled') {
		amount = calculationData.calculation.newAmount || calculationData.calculation.paymentRequired || 0;
	} else {
		amount = calculationData.calculation.paymentRequired || 0;
	}

	console.log('Payment amount:', amount);

	if (amount <= 0) {
		console.log('No payment required');
		Swal.fire('No Payment Required', 'No payment required for this upgrade', 'info');
		return;
	}

	console.log('Creating payment link...');

	fetch('/saassubscription/createpaymentlink', {
		method: 'POST',
		headers: {
			'Content-Type': 'application/x-www-form-urlencoded',
		},
			body: new URLSearchParams({
				tenantId: tenantId,
				planId: saasSelectedPlanId,
				billingCycle: saasSelectedBillingCycle,
				upgradeType: saasSelectedUpgradeType,
				amount: amount
			})
		})
		.then(response => {
			console.log('Response status:', response.status);
			if (!response.ok) {
				return response.text().then(text => { throw new Error('Server returned ' + response.status + ': ' + text.substring(0, 200)); });
			}
			return response.json();
		})
		.then(data => {
			console.log('Payment link response:', data);
			if (data.success) {
				showPaymentLinkSuccess(data);
			} else {
				Swal.fire('Error', data.message, 'error');
			}
		})
		.catch(error => {
			console.error('Error creating payment link:', error);
			Swal.fire('Error', error.message || 'Failed to create payment link', 'error');
		});
	}
		function showPaymentLinkSuccess(data) {
			const payLink = data.paymentLink || '';
			const emailStatus = data.emailSent
				? 'Email sent to ' + (data.partnerEmail || 'tenant')
				: 'Tenant email not configured - share link manually';

			const amount = data.amount ? data.amount / 100 : 0;
			let linkHtml = '';

			if (payLink) {
				linkHtml = `
					<div class="input-group mb-3">
						<input type="text" class="form-control" value="${escapeHtml(payLink)}" id="payLinkCopy" readonly>
						<button class="btn btn-primary" id="copyLinkBtn" type="button">Copy Link</button>
					</div>
				`;
			}

			Swal.fire({
				title: 'Payment Link Created!',
				html: '<p>' + escapeHtml(emailStatus) + '</p>' + linkHtml +
					'<p><strong>Plan:</strong> ' + escapeHtml(data.planName || '') +
					' | <strong>Amount:</strong> ₹' + money(amount) + '</p>',
				icon: 'success',
				didOpen: function () {
					const btn = document.getElementById('copyLinkBtn');

					if (btn) {
						btn.addEventListener('click', function () {
							const input = document.getElementById('payLinkCopy');
							navigator.clipboard.writeText(input.value);
							btn.textContent = 'Copied!';
							btn.className = 'btn btn-success';
						});
					}
				}
			}).then(function () {
				const modal = bootstrap.Modal.getInstance(document.getElementById('saasUpgradeModal'));
				if (modal) modal.hide();
				location.reload();
			});
		}

		window.showRefundSection = function () {
			const tenantId = getTenantId();

			if (!tenantId) {
				Swal.fire('Error', 'No partner selected', 'error');
				return;
			}

			document.getElementById('saasPlanSelectionSection').style.display = 'none';
			document.getElementById('saasCalculationResults').style.display = 'none';
			document.getElementById('saasSendPaymentLinkBtn').style.display = 'none';
			document.getElementById('saasRefundSection').style.display = 'block';

			loadRefundableTransactions(tenantId);
		};

		function loadRefundableTransactions(tenantId) {
			fetch('/saassubscription/getrefundabletransactions?tenantId=' + encodeURIComponent(tenantId))
				.then(response => readJsonResponse(response, 'GetRefundableTransactions'))
				.then(data => {
					if (data.success) {
						displayRefundableTransactions(data.transactions || []);
					} else {
						Swal.fire('Error', data.message || 'Failed to load refundable transactions', 'error');
					}
				})
				.catch(error => {
					console.error('Error loading refundable transactions:', error);
					Swal.fire('Error', 'Failed to load refundable transactions', 'error');
				});
		}

		function displayRefundableTransactions(transactions) {
			const container = document.getElementById('saasRefundableTransactions');

			if (!transactions.length) {
				container.innerHTML = `
					<div class="alert alert-info">
						<i class="fa-solid fa-info-circle me-2"></i>
						No refundable transactions found for this partner.
					</div>
				`;
				return;
			}

			let html = `
				<div class="table-responsive">
					<table class="table table-sm">
						<thead>
							<tr>
								<th>Date</th>
								<th>Plan</th>
								<th>Amount</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
			`;

			transactions.forEach(transaction => {
				html += `
					<tr>
						<td>${escapeHtml(transaction.transactionDate)}</td>
						<td>${escapeHtml(transaction.planName)} (${escapeHtml(transaction.billingCycle)})</td>
						<td>₹${money(transaction.amount)}</td>
						<td>
							<button class="btn btn-sm btn-danger" onclick="processRefund('${escapeHtml(transaction.transactionId)}', '${escapeHtml(transaction.planName)}', ${Number(transaction.amount || 0)})">
								<i class="fa-solid fa-undo me-1"></i>Refund
							</button>
						</td>
					</tr>
				`;
			});

			html += `
						</tbody>
					</table>
				</div>
			`;

			container.innerHTML = html;
		}

		window.processRefund = function (transactionId, planName, amount) {
			const reason = prompt('Process Refund for ' + planName + ' (₹' + money(amount) + ')\nEnter refund reason:');

			if (reason && reason.trim()) {
				executeRefund(transactionId, reason.trim());
			}
		};

		function executeRefund(transactionId, refundReason) {
			fetch('/saassubscription/processrefund', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/x-www-form-urlencoded'
				},
				body: new URLSearchParams({
					transactionId: transactionId,
					refundReason: refundReason
				})
			})
				.then(response => readJsonResponse(response, 'ProcessRefund'))
				.then(data => {
					if (data.success) {
						Swal.fire('Refund Processed', data.message || ('Refund ID: ' + data.refundId), 'success');
						loadRefundableTransactions(getTenantId());
					} else {
						Swal.fire('Refund Failed', data.message || 'Refund failed', 'error');
					}
				})
				.catch(error => {
					console.error('Error processing refund:', error);
					Swal.fire('Error', 'Failed to process refund. Please try again.', 'error');
				});
		}

		window.activatePlanNow = function () {
			const tenantId = getTenantId();

			if (!tenantId || !calculationData) {
				Swal.fire('Error', 'Missing calculation data', 'error');
				return;
			}

			Swal.fire({
				title: 'Activating Plan...',
				text: 'Please wait while we activate your new plan.',
				allowOutsideClick: false,
				didOpen: function () {
					Swal.showLoading();
				}
			});

			fetch('/saassubscription/calculateupgrade', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/x-www-form-urlencoded'
				},
				body: new URLSearchParams({
					tenantId: tenantId,
					newPlanId: saasSelectedPlanId,
					billingCycle: saasSelectedBillingCycle,
					upgradeType: saasSelectedUpgradeType,
					activateNow: 'true'
				})
			})
				.then(response => readJsonResponse(response, 'ActivatePlanNow'))
				.then(data => {
					if (data.success) {
						Swal.fire({
							title: 'Success!',
							text: data.message || 'Plan activated successfully.',
							icon: 'success',
							confirmButtonText: 'OK'
						}).then(function () {
							const modal = bootstrap.Modal.getInstance(document.getElementById('saasUpgradeModal'));
							if (modal) modal.hide();
							location.reload();
						});
					} else {
						Swal.fire('Error', data.message || 'Failed to activate plan', 'error');
					}
				})
				.catch(error => {
					console.error('Error activating plan:', error);
					Swal.fire('Error', 'Failed to activate plan', 'error');
				});
		};
	})();
</script>
