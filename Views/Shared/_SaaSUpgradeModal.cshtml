<div class="modal fade" id="saasUpgradeModal" tabindex="-1" aria-labelledby="saasUpgradeModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="saasUpgradeModalLabel">
					<i class="fa-solid fa-rocket me-2"></i>Upgrade Tenant Plan
				</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div class="alert alert-info mb-4" id="saasPartnerInfo" style="display:none;">
					<div class="d-flex align-items-center">
						<i class="fa-solid fa-building me-3" style="font-size:2rem;"></i>
						<div>
							<h6 class="mb-1" id="saasPartnerName"></h6>
							<small class="text-muted" id="saasPartnerEmail"></small>
						</div>
					</div>
				</div>

				<div class="card mb-4" id="saasCurrentSubscriptionCard" style="display:none;">
					<div class="card-header">
						<h6 class="mb-0"><i class="fa-solid fa-crown me-2"></i>Current Subscription</h6>
					</div>
					<div class="card-body">
						<div class="row g-2">
							<div class="col-md-3">
								<strong>Plan:</strong> <span id="saasCurrentPlanName"></span>
							</div>
							<div class="col-md-3">
								<strong>Amount:</strong> ₹<span id="saasCurrentAmount"></span>
							</div>
							<div class="col-md-3">
								<strong>Billing:</strong> <span id="saasCurrentBilling"></span>
							</div>
							<div class="col-md-3">
								<strong>Expires:</strong> <span id="saasCurrentExpiry"></span>
							</div>
						</div>
						<div class="mt-2">
							<span class="badge bg-warning text-dark" id="saasDaysRemaining"></span>
						</div>
					</div>
				</div>

				<div class="row mb-4">
					<div class="col-12">
						<h6 class="mb-3">Choose Upgrade Type:</h6>
						<div class="row g-3">
							<div class="col-md-4">
								<div class="card h-100 upgrade-type-card" data-type="existing" onclick="selectUpgradeType('existing')">
									<div class="card-body text-center">
										<div class="upgrade-icon mb-3">
											<i class="fa-solid fa-exchange-alt" style="font-size:2.5rem;color:#2589C9;"></i>
										</div>
										<h6 class="card-title">Existing + Upgrade</h6>
										<p class="card-text small text-muted">
											Convert remaining amount to upgrade plan days.
											Starts immediately, existing plan stops.
										</p>
									</div>
								</div>
							</div>

							<div class="col-md-4">
								<div class="card h-100 upgrade-type-card" data-type="immediate" onclick="selectUpgradeType('immediate')">
									<div class="card-body text-center">
										<div class="upgrade-icon mb-3">
											<i class="fa-solid fa-bolt" style="font-size:2.5rem;color:#16A34A;"></i>
										</div>
										<h6 class="card-title">Immediate Upgrade</h6>
										<p class="card-text small text-muted">
											Full plan duration starts immediately.
											Remaining amount adjusted from price.
										</p>
									</div>
								</div>
							</div>

							<div class="col-md-4">
								<div class="card h-100 upgrade-type-card" data-type="scheduled" onclick="selectUpgradeType('scheduled')">
									<div class="card-body text-center">
										<div class="upgrade-icon mb-3">
											<i class="fa-solid fa-calendar-plus" style="font-size:2.5rem;color:#F59E0B;"></i>
										</div>
										<h6 class="card-title">Scheduled Plan</h6>
										<p class="card-text small text-muted">
											Starts after current plan expires.
											No remaining amount calculations.
										</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="row mb-4" id="saasUpgradeTypeDetails" style="display:none;">
					<div class="col-12">
						<div class="alert alert-info mb-0" id="saasUpgradeTypeDetailsContent"></div>
					</div>
				</div>

				<div id="saasPlanSelectionSection" style="display:none;">
					<h6 class="mb-3">Select New Plan:</h6>
					<div class="row" id="saasAvailablePlans"></div>
				</div>

				<div id="saasCalculationResults" style="display:none;">
					<div class="card">
						<div class="card-header">
							<h6 class="mb-0"><i class="fa-solid fa-calculator me-2"></i>Upgrade Calculation</h6>
						</div>
						<div class="card-body" id="saasCalculationContent"></div>
					</div>
				</div>

				<div id="saasRefundSection" style="display:none;">
					<div class="card border-warning">
						<div class="card-header bg-warning text-dark">
							<h6 class="mb-0"><i class="fa-solid fa-undo me-2"></i>Process Refund</h6>
						</div>
						<div class="card-body">
							<div class="alert alert-warning">
								<i class="fa-solid fa-exclamation-triangle me-2"></i>
								<strong>Warning:</strong> This will process a refund through Razorpay for successful upgrade transactions.
							</div>
							<div id="saasRefundableTransactions"></div>
						</div>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

				<button type="button" class="btn btn-warning" id="saasShowRefundBtn" onclick="showRefundSection()" style="display:none;">
					<i class="fa-solid fa-undo me-2"></i>Process Refund
				</button>

				<button type="button" class="btn btn-primary" id="saasSendPaymentLinkBtn" onclick="sendPaymentLink()" style="display:none;">
					<i class="fa-solid fa-paper-plane me-2"></i>Send Payment
				</button>
			</div>
		</div>
	</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
	.upgrade-type-card,
	.plan-card {
		cursor: pointer;
		transition: all 0.3s ease;
		border: 2px solid transparent;
	}

		.upgrade-type-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
		}

		.upgrade-type-card.selected {
			border-color: #2589C9 !important;
			background: linear-gradient(135deg, #E2E8F0 0%, #E2E8F0 100%) !important;
		}

		.plan-card:hover {
			transform: translateY(-3px);
			box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
		}

		.plan-card.selected {
			border-color: #16A34A !important;
			background: linear-gradient(135deg, #DCFCE7 0%, #B8C8D8 100%) !important;
		}

		.plan-card.current-plan {
			border-color: var(--bs-primary, #2589C9) !important;
			background: var(--bs-primary-bg-subtle, #E2E8F0) !important;
