                        $.post('/Account/StopImpersonation', function(data) {
                            if (data.success) { Swal.fire({ icon:'success', title:'Stopped', text:data.message, timer:2000, showConfirmButton:false }).then(function() { window.location.href = data.redirectUrl || '/Impersonation'; }); }
                            else { Swal.fire('Error', data.message, 'error'); }
                        }).fail(function() { Swal.fire('Error', 'Failed to stop impersonation', 'error'); });
