<script>
function toggleDarkMode() {
    var html = document.documentElement;
    var body = document.body;
    if (html.classList.contains('dark-mode')) {
        html.classList.remove('dark-mode');
        if (body) body.classList.remove('dark-mode');
        localStorage.setItem('darkMode', 'disabled');
    } else {
        html.classList.add('dark-mode');
        if (body) body.classList.add('dark-mode');
        localStorage.setItem('darkMode', 'enabled');
    }
}

// Sidebar toggle is handled centrally by app.js (single handler) to avoid
// multiple competing handlers cancelling each other out on click.
document.addEventListener('DOMContentLoaded', function() {
    // Handle scrollbar styles for smooth scrolling
    initializeSmoothScroll();
});

// Initialize scroll navigators for horizontally overflowing elements
function initializeScrollNavigators() {
    // Find all elements that might benefit from scroll navigation
    var scrollContainers = document.querySelectorAll('.table-responsive, .scrollable-x, .scroll-container, .card-columns, .row-cols-*');
    
    scrollContainers.forEach(function(container) {
        // Check if element actually overflows horizontally
        if (container.scrollWidth > container.clientWidth) {
            // Add scroll navigation buttons if they don't exist
            if (!container.querySelector('.scroll-nav-btn')) {
                addScrollNavigationButtons(container);
            }
            
            // Update button visibility based on scroll position
            updateScrollButtonVisibility(container);
            
            // Update visibility when user scrolls
            container.addEventListener('scroll', function() {
                updateScrollButtonVisibility(container);
            });
        }
    });
}

// Add left/right navigation buttons to a scroll container
function addScrollNavigationButtons(container) {
    // Create navigation container
    var navContainer = document.createElement('div');
    navContainer.className = 'scroll-nav-container';
    navContainer.style.position = 'absolute';
    navContainer.style.top = '0';
    navContainer.style.left = '0';
    navContainer.style.width = '100%';
    navContainer.style.height = '100%';
    navContainer.style.pointerEvents = 'none'; // Let pointer events go through to children
    navContainer.style.zIndex = '10';
    
    // Create left button
    var leftBtn = document.createElement('button');
    leftBtn.className = 'scroll-nav-btn scroll-nav-left';
    leftBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
    leftBtn.style.position = 'absolute';
    leftBtn.style.top = '50%';
    leftBtn.style.left = '5px';
    leftBtn.style.transform = 'translateY(-50%)';
    leftBtn.style.background = 'rgba(255,255,255,0.8)';
    leftBtn.style.border = 'none';
    leftBtn.style.width = '35px';
    leftBtn.style.height = '35px';
    leftBtn.style.borderRadius = '50%';
    leftBtn.style.display = 'flex';
    leftBtn.style.alignItems = 'center';
    leftBtn.style.justifyContent = 'center';
    leftBtn.style.cursor = 'pointer';
    leftBtn.style.zIndex = '11';
    leftBtn.style.boxShadow = '0 2px 5px rgba(0,0,0,0.2)';
    leftBtn.style.opacity = '0.7';
    leftBtn.style.transition = 'opacity 0.2s, transform 0.2s';
    
    // Create right button
    var rightBtn = document.createElement('button');
    rightBtn.className = 'scroll-nav-btn scroll-nav-right';
    rightBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
    rightBtn.style.position = 'absolute';
    rightBtn.style.top = '50%';
    rightBtn.style.right = '5px';
    rightBtn.style.transform = 'translateY(-50%)';
    rightBtn.style.background = 'rgba(255,255,255,0.8)';
    rightBtn.style.border = 'none';
    rightBtn.style.width = '35px';
    rightBtn.style.height = '35px';
    rightBtn.style.borderRadius = '50%';
    rightBtn.style.display = 'flex';
    rightBtn.style.alignItems = rightBtn.style.justifyContent = 'center';
    rightBtn.style.cursor = 'pointer';
    rightBtn.style.zIndex = '11';
    rightBtn.style.boxShadow = '0 2px 5px rgba(0,0,0,0.2)';
    rightBtn.style.opacity = '0.7';
    rightBtn.style.transition = 'opacity 0.2s, transform 0.2s';
    
    // Add hover effects
    leftBtn.addEventListener('mouseenter', function() {
        this.style.opacity = '1';
        this.style.transform = 'translateY(-50%) scale(1.1)';
    });
    leftBtn.addEventListener('mouseleave', function() {
        this.style.opacity = '0.7';
        this.style.transform = 'translateY(-50%) scale(1)';
    });
    
    rightBtn.addEventListener('mouseenter', function() {
        this.style.opacity = '1';
        this.style.transform = 'translateY(-50%) scale(1.1)';
    });
    rightBtn.addEventListener('mouseleave', function() {
        this.style.opacity = '0.7';
        this.style.transform = 'translateY(-50%) scale(1)';
    });
    
    // Add click handlers
    leftBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        scrollContainerByAmount(container, -200); // Scroll left by 200px
    });
    
    rightBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        scrollContainerByAmount(container, 200); // Scroll right by 200px
    });
    
    // Add touch support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    
    container.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    
    container.addEventListener('touchend', function(e) {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipeGesture();
    }, { passive: true });
    
    function handleSwipeGesture() {
        const swipeThreshold = 50;
        const diff = touchStartX - touchEndX;
        
        if (Math.abs(diff) > swipeThreshold) {
            if (diff > 0) {
                // Swipe left - scroll right
                scrollContainerByAmount(container, 200);
            } else {
                // Swipe right - scroll left
                scrollContainerByAmount(container, -200);
            }
        }
    }
    
    // Append buttons to container
    // We need to make the container position relative for absolute positioning of buttons
    if (getComputedStyle(container).position === 'static') {
        container.style.position = 'relative';
    }
    
    navContainer.appendChild(leftBtn);
    navContainer.appendChild(rightBtn);
    container.appendChild(navContainer);
}

// Scroll container by specified amount (negative = left, positive = right)
function scrollContainerByAmount(container, amount) {
    container.scrollBy({
        left: amount,
        behavior: 'smooth'
    });
    
    // Update button visibility after scroll
    setTimeout(function() {
        updateScrollButtonVisibility(container);
    }, 300); // Wait for scroll animation to complete
}

// Update visibility of scroll navigation buttons based on scroll position
function updateScrollButtonVisibility(container) {
    var leftBtn = container.querySelector('.scroll-nav-left');
    var rightBtn = container.querySelector('.scroll-nav-right');
    
    if (!leftBtn || !rightBtn) return;
    
    var scrollLeft = container.scrollLeft;
    var scrollWidth = container.scrollWidth;
    var clientWidth = container.clientWidth;
    
    // Hide left button if at the start
    if (scrollLeft <= 10) {
        leftBtn.style.opacity = '0.3';
        leftBtn.style.pointerEvents = 'none';
    } else {
        leftBtn.style.opacity = '0.7';
        leftBtn.style.pointerEvents = 'all';
    }
    
    // Hide right button if at the end
    if (scrollLeft + clientWidth >= scrollWidth - 10) {
        rightBtn.style.opacity = '0.3';
        rightBtn.style.pointerEvents = 'none';
    } else {
        rightBtn.style.opacity = '0.7';
        rightBtn.style.pointerEvents = 'all';
    }
}

// Initialize smooth scrolling and other scroll-related enhancements
function initializeSmoothScroll() {
    // Add smooth scroll behavior to all anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            const href = this.getAttribute('href');
            
            // Only apply to actual anchor links (not empty href or other protocols)
            if (href && href !== '#' && !href.startsWith('http') && !href.startsWith('mailto:')) {
                // Prevent default anchor click behavior
                e.preventDefault();
                
                const targetElement = document.querySelector(href) || 
                                    (href === '' || href === '#' ? document.documentElement : null);
                
                if (targetElement) {
                    targetElement.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            }
        });
    });
    
    // Enhance scrollbar appearance for webkit browsers
    const style = document.createElement('style');
    style.textContent = `
        /* Custom scrollbar for main content area */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
        }
        
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 4px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.3);
        }
        
        /* Dark mode scrollbar */
        .dark-mode ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }
        
        .dark-mode ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
        }
        
        .dark-mode ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }
    `;
    document.head.appendChild(style);
}
</script>

