@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject CRM.AppDbContext _context
@inject CRM.MasterDb.MasterDbContext _mastercontext
@inject CRM.Services.PermissionService _permissionService
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using CRM.Models
@using CRM.Helpers

@{
    bool hasImpersonation = false;
    bool HasCustomAPIAccess = false;
    bool HasWhatsAppIntegration = false;
    bool HasFacebookIntegration = false;
    bool HasEmailIntegration = false;
    string activePlanName = "No Active Plan";
    var tIdClaim = Context.User.FindFirst("TenantId")?.Value;
    if (!string.IsNullOrEmpty(tIdClaim) && int.TryParse(tIdClaim, out int tId))
    {
        var sub = _mastercontext.TenantSubscriptions
            .Where(s => s.TenantId == tId && (s.Status == "Active" || s.Status == "Trial"))
            .OrderByDescending(s => s.StartDate)
            .FirstOrDefault();
        if (sub != null)
        {
            var plan = _mastercontext.SaasPlans.FirstOrDefault(p => p.PlanId == sub.PlanId);
            hasImpersonation = plan?.HasImpersonation ?? false;
            HasCustomAPIAccess = plan?.HasCustomAPIAccess ?? false;
            HasWhatsAppIntegration = plan?.HasWhatsAppIntegration ?? false;
            HasFacebookIntegration = plan?.HasFacebookIntegration ?? false;
            HasEmailIntegration = plan?.HasEmailIntegration ?? false;
            activePlanName = plan?.PlanName ?? "No Active Plan";
        }
    }
    bool HasAIChatbot = false;
    if (!string.IsNullOrEmpty(tIdClaim) && int.TryParse(tIdClaim, out int tId2))
    {
        var sub2 = _mastercontext.TenantSubscriptions
            .Where(s => s.TenantId == tId2 && (s.Status == "Active" || s.Status == "Trial"))
            .OrderByDescending(s => s.StartDate)
            .FirstOrDefault();
        if (sub2 != null)
        {
            var plan2 = _mastercontext.SaasPlans.FirstOrDefault(p => p.PlanId == sub2.PlanId);
            HasAIChatbot = plan2?.HasAIChatbot ?? false;
        }
    }
}
@{
    var token = HttpContextAccessor.HttpContext?.Request.Cookies["jwtToken"];
    var emails = HttpContextAccessor.HttpContext?.Session.GetString("Email")
        ?? HttpContextAccessor.HttpContext?.Request.Cookies["Email"];
    string role = Context.User?.FindFirst(ClaimTypes.Role)?.Value ?? "";
    string username = Context.User?.FindFirst(ClaimTypes.Name)?.Value ?? Context.User?.FindFirst("name")?.Value ?? "";
    string email = "";
    string profileImageSrc = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23cbd5e1'%3E%3Cpath d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-4.48S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34 3-3 1.34-3 3 3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z'/%3E%3C/svg%3E";
    if (!string.IsNullOrEmpty(username) && role != "SuperAdmin")
    {
        var userIdClaim = Context.User.FindFirst("UserId")?.Value;
        if (!string.IsNullOrEmpty(userIdClaim) && int.TryParse(userIdClaim, out int userId))
        {
            var userProfile = _context.UserProfiles.FirstOrDefault(u => u.UserId == userId);
            if (userProfile != null)
            {
                if (!string.IsNullOrEmpty(userProfile.ProfileImagePath))
                {
                    profileImageSrc = userProfile.ProfileImagePath;
                }
                else if (userProfile.ProfileImage != null)
                {
                    profileImageSrc = $"data:image/png;base64,{Convert.ToBase64String(userProfile.ProfileImage)}";
                }
            }
        }
    }
    else if (role == "SuperAdmin")
    {
        var superAdminProfile = _mastercontext.SuperAdmins.FirstOrDefault();
        if (superAdminProfile != null)
        {
            if (!string.IsNullOrEmpty(superAdminProfile.ProfileImagePath))
            {
                profileImageSrc = superAdminProfile.ProfileImagePath;
            }
            else if (superAdminProfile.ProfileImage != null)
            {
                profileImageSrc = $"data:image/png;base64,{Convert.ToBase64String(superAdminProfile.ProfileImage)}";
            }
        }
    }
    int? subdomainPartnerId = Context.Items["subdomainPartnerId"] as int?;
    string subdomainPartnerName = Context.Items["subdomainPartnerName"] as string;
    int? userChannelPartnerId = subdomainPartnerId;
    int? userTenantId = Context.Items["TenantId"] as int?;
    bool isPartnerAgent = false;
    if (!string.IsNullOrEmpty(username) && role != "SuperAdmin")
    {
        var userRecord = _context.Users.FirstOrDefault(u => u.Username == username);
        userChannelPartnerId = userRecord?.ChannelPartnerId;
        userTenantId = userRecord?.TenantId > 0 ? userRecord.TenantId : userTenantId;
        isPartnerAgent = userRecord?.ChannelPartnerId != null && (role == "Sales" || role == "Agent");
    }
    // Company logos (uploaded via Settings > Company Logo / Collapsed Sidebar Logo) with default fallbacks.
    // Scoped by tenant so each company sees its own branding (never another tenant's).
    var logoPartnerId = userChannelPartnerId is > 0 ? userChannelPartnerId : null;
    var sidebarFullLogo = BrandingResolver.ResolveCompanyLogo(_context, logoPartnerId, userTenantId);
    var sidebarCollapsedLogo = BrandingResolver.ResolveCollapsedLogo(_context, logoPartnerId, userTenantId);
    var footerCompanyName = role == "SuperAdmin"
        ? "Ultrakey PropTech"
        : BrandingResolver.ResolveCompanyName(_context, logoPartnerId, userTenantId, "Ultrakey PropTech");
    bool hasPartnerFeature = false;
    bool HasAdvancedReports = false;
    if (role != "SuperAdmin" && !string.IsNullOrEmpty(token))
    {
        var tenantIdClaim = Context.User.FindFirst("TenantId")?.Value;
        if (!string.IsNullOrEmpty(tenantIdClaim) && int.TryParse(tenantIdClaim, out int tid))
        {
            var activeSub = _mastercontext.TenantSubscriptions
                .Where(s => s.TenantId == tid && (s.Status == "Active" || s.Status == "Trial"))
                .OrderByDescending(s => s.StartDate)
                .FirstOrDefault();
            if (activeSub != null)
            {
                var activePlan = _mastercontext.SaasPlans.FirstOrDefault(p => p.PlanId == activeSub.PlanId);
                if (activePlan != null && activePlan.MaxPartners > 0)
                    hasPartnerFeature = true;
                HasAdvancedReports = activePlan?.HasAdvancedReports ?? false;
            }
        }
    }

    // SidebarCollapsed preference (set via Settings page) - tenant scoped so companies don't override each other
    var sidebarCollapsedVal = (userTenantId is > 0
        ? _context.Settings.FirstOrDefault(s => s.SettingKey == "SidebarCollapsed" && s.TenantId == userTenantId.Value && s.ChannelPartnerId == null)
        : _context.Settings.FirstOrDefault(s => s.SettingKey == "SidebarCollapsed" && s.ChannelPartnerId == null))?.SettingValue;
    var sidebarCollapsed = sidebarCollapsedVal == "true";
    List<string> allowedModules = null;
    if (!string.IsNullOrEmpty(role) && role != "SuperAdmin")
    {
        var rolePermission = _context.RolePermissions.Where(r => r.RoleName == role).OrderByDescending(r => r.CreatedAt).FirstOrDefault();
        if (rolePermission != null && !string.IsNullOrWhiteSpace(rolePermission.AllowedModules))
        {
            var split = rolePermission.AllowedModules.Split(',').Select(m => m.Trim()).Where(m => !string.IsNullOrEmpty(m)).ToList();
            if (split.Any())
                allowedModules = split;
        }
        // Fallback for standard roles when DB record doesn't have AllowedModules set
        if (allowedModules == null)
        {
            if (role == "Sales")
            {
                allowedModules = new List<string> { "Dashboard", "Leads & Properties", "Sales", "Attendance", "Settings" };
            }
            else if (role == "Agent")
            {
                allowedModules = new List<string> { "Dashboard", "Leads & Properties", "Attendance", "Settings" };
            }
        }
    }
    bool canAccessModule(string moduleName)
    {
        if (allowedModules == null) return true;
        
        if (allowedModules.Any(m => m.Equals("All", StringComparison.OrdinalIgnoreCase)))
            return true;
        
        return allowedModules.Any(m => m.Equals(moduleName, StringComparison.OrdinalIgnoreCase));
    }
    var roleText = role ?? "User";
    var roleShort = roleText.Length >= 2 ? roleText.Substring(0, 2).ToUpper() : roleText.ToUpper();
    var bg = "linear-gradient(135deg,#1A6FA8,#D4A45A)";
    }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, shrink-to-fit=no">
    <meta name="description" content="Responsive Admin & Dashboard Template based on Bootstrap 5">
    <meta name="author" content="AdminKit">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link rel="icon" type="image/png" href="~/icons/PropTech_Logo_Favicon.png">
    <link rel="shortcut icon" href="~/icons/PropTech_Logo_Favicon.png">
    <title>@ViewData["Title"] - Ultrakey PropTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/app.css" rel="stylesheet">
    <link href="~/css/crm-theme.css" rel="stylesheet">
    <link href="~/css/responsive-fixes.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        if (localStorage.getItem('darkMode') === 'enabled') {
            document.documentElement.classList.add('dark-mode');
        }
    </script>
    <style>
        /* =====================================================
           CSS VARIABLES - THEME TOKENS
           ===================================================== */
        :root {
            --gold: #D4A45A;
            --gold-light: #E8C27E;
            --gold-dark: #B8883E;
            --blue: #1A6FA8;
            --blue-light: #2589C9;
            --blue-dark: #125082;
            --sidebar-bg: #0F1C2E;
            --sidebar-bg2: #162436;
            --sidebar-text: #B8C8D8;
            --sidebar-active-bg: linear-gradient(90deg, #1A6FA8, #D4A45A);
            --navbar-bg: #FFFFFF;
            --navbar-height: 54px;
            --sidebar-width: 248px;
            --sidebar-collapsed: 50px;
            --body-bg: #F0F4F8;
            --card-bg: #FFFFFF;
            --text-primary: #1A2332;
            --text-muted: #6B7B8D;
            --border-color: #E2E8F0;
            --radius: 10px;
        }

        /* =====================================================
           BASE FONT SIZING - Consistent across all pages
           ===================================================== */
        body { font-size: 15px !important; line-height: 1.6 !important; }
        .content, .main, .card, .wrapper { font-size: 15px !important; }
        .content > * { font-size: 14px !important; }
        .content h1 { font-size: 1.6rem !important; }
        .content h2 { font-size: 1.35rem !important; }
        .content h3 { font-size: 1.15rem !important; }
        .content h4 { font-size: 1.05rem !important; }
        .content h5 { font-size: 0.95rem !important; }
        .content small, .content .text-muted, .content .help-text { font-size: 0.82rem !important; }
        .content .table { font-size: 0.9rem !important; }
        .content .form-control, .content .form-select { font-size: 0.9rem !important; }
        .content .badge { font-size: 0.78rem !important; }
        .content .btn { font-size: 0.88rem !important; }

        /* Sidebar text sizing - identical for every menu item */
        .sidebar-link { font-size: 13px !important; }
        .sidebar-dropdown .sidebar-link { font-size: 13px !important; }
        .sidebar-header { font-size: 11px !important; letter-spacing: 1.2px !important; }
        .sidebar-brand span { font-size: 1rem !important; }
        .sa-profile-info strong { font-size: 12px !important; }
        .sa-profile-info small { font-size: 10px !important; }

        /* Dashboard stat consistency */
        .stat-number { font-size: 1.8rem !important; }
        .stat-label { font-size: 0.82rem !important; }

        html.dark-mode {
            --navbar-bg: #1A2332;
            --body-bg: #111827;
            --card-bg: #1E2A3A;
            --text-primary: #E8EDF2;
            --text-muted: #8FA3B8;
            --border-color: #2A3A4A;
            --sidebar-bg: #0D1724;
            --sidebar-bg2: #121F2E;
        }
        /* =====================================================
           BASE RESET
           ===================================================== */
        *, *::before, *::after { box-sizing: border-box; }
        html {
            overflow-y: auto !important;
            overflow-x: hidden !important;
            scrollbar-gutter: auto !important;
            font-family: 'Inter', sans-serif;
        }
        html.dark-mode { background: var(--body-bg) !important; color-scheme: dark; }
        html.dark-mode body { background: var(--body-bg) !important; }
        html:not(.ready) * { transition: none !important; animation: none !important; }
        body { font-family: 'Inter', sans-serif; background: var(--body-bg); color: var(--text-primary); }

        /* =====================================================
           SIDEBAR CORE
           ===================================================== */
        .sidebar {
            background: var(--sidebar-bg) !important;
            border-right: 1px solid rgba(212,164,90,0.15);
            box-shadow: 2px 0 20px rgba(0,0,0,0.25) !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            scrollbar-width: thin !important;
            scrollbar-color: rgba(212,164,90,0.3) transparent !important;
            display: flex !important;
            flex-direction: column !important;
        }
        .sidebar-content {
            flex: 1 1 auto !important;
            min-height: 0 !important;
            display: flex !important;
            flex-direction: column !important;
            overflow-x: hidden !important;
            max-width: 100% !important;
        }
        .sidebar-nav {
            flex: 1 1 auto !important;
            min-height: 0 !important;
            overflow-x: hidden !important;
            overflow-y: auto !important;
            max-width: 100% !important;
            margin-bottom: 0 !important;
            padding-bottom: 8px !important;
        }
        .sidebar::-webkit-scrollbar { width: 3px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(212,164,90,0.35); border-radius: 2px; }
        .sidebar::-webkit-scrollbar-thumb:hover { background: var(--gold); }

        /* Sidebar footer - always pinned to the bottom edge, fully visible */
        .sidebar-footer {
            position: relative !important;
            bottom: auto !important;
            margin-top: auto !important;
            flex-shrink: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            padding: 8px 12px !important;
            background: linear-gradient(135deg, #0F4C75, #162436) !important;
            border-top: 1px solid rgba(212,164,90,0.35) !important;
            color: rgba(255,255,255,0.75) !important;
            font-size: 10.5px !important;
            line-height: 1.5 !important;
            text-align: center !important;
            box-sizing: border-box !important;
            overflow: visible !important;
            white-space: normal !important;
            text-overflow: clip !important;
            word-wrap: break-word !important;
            z-index: 6 !important;
            display: block !important;
        }
        .sidebar-footer a { color: var(--gold-light) !important; text-decoration: none !important; }
        .sidebar.collapsed .sidebar-footer { padding: 6px 4px !important; }
        .sidebar.collapsed .sidebar-footer span {
            display: block !important;
            font-size: 8px !important;
            line-height: 1.35 !important;
            margin-top: 3px !important;
            word-wrap: break-word !important;
        }
        .sidebar.collapsed .sidebar-footer i { margin-right: 0 !important; }
        html.dark-mode .sidebar-footer { background: #0D1724 !important; border-top-color: rgba(212,164,90,0.3) !important; }

        /* Brand area */
        .sidebar-brand {
            background: var(--sidebar-bg2) !important;
            border-bottom: 1px solid rgba(212,164,90,0.2) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        .sidebar-brand .sidebar-logo-full {
            height: 38px !important; width: 100% !important;
            max-width: 100% !important; object-fit: contain !important; display: block !important;
        }
        .sidebar-brand .sidebar-logo-collapsed {
            height: 36px !important; width: 36px !important;
            object-fit: contain !important; display: none !important;
        }
        .sidebar-brand span {
            color: var(--gold) !important;
            font-size: 1.1rem; font-weight: 700; letter-spacing: 0.5px;
        }

        /* SIDEBAR SECTION HEADERS */
        .sidebar-header {
            font-size: 11px !important;
            font-weight: 700 !important;
            letter-spacing: 1.2px !important;
            color: rgba(212,164,90,0.6) !important;
            text-transform: uppercase !important;
            display: block !important;
            line-height: 1.2 !important;
            pointer-events: none !important;
        }
        .sidebar.collapsed .sidebar-header {
            opacity: 0 !important; height: 0 !important;
            padding: 0 !important; overflow: hidden !important;
        }

        /* Sidebar Links - consistent box sizing */
        .sidebar-link {
            color: var(--sidebar-text) !important;
            font-weight: 500 !important;
            font-size: 13px !important;
            border-radius: 8px !important;
            gap: 10px !important;
            transition: all 0.18s ease !important;
            text-decoration: none !important;
        }
        .sidebar-link:hover {
            color: #FFFFFF !important;
            background: rgba(26,111,168,0.25) !important;
        }
        .sidebar-link .feather, .sidebar-link svg:not(.sidebar-chevron) {
            stroke: rgba(184,200,216,0.7) !important;
            transition: stroke 0.18s ease !important;
        }
        .sidebar-link:hover .feather, .sidebar-link:hover svg { stroke: #FFFFFF !important; }
        .sidebar-link span.align-middle { transition: opacity 0.2s ease; }

        /* Active state */
        .sidebar-item.active > .sidebar-link,
        .sidebar-dropdown .sidebar-item.active > .sidebar-link {
            background: linear-gradient(90deg, #1A6FA8, #B8883E) !important;
            color: #FFFFFF !important;
            font-weight: 600 !important;
            box-shadow: 0 3px 10px rgba(26,111,168,0.4) !important;
        }
        .sidebar-item.active > .sidebar-link .feather,
        .sidebar-item.active > .sidebar-link svg,
        .sidebar-dropdown .sidebar-item.active > .sidebar-link .feather,
        .sidebar-dropdown .sidebar-item.active > .sidebar-link svg { stroke: #FFFFFF !important; }
        .sidebar-item.active > .sidebar-link span.align-middle,
        .sidebar-dropdown .sidebar-item.active > .sidebar-link span.align-middle { color: #FFFFFF !important; }

        
        /* Sidebar Chevron removed */
        .sidebar-chevron { transition: transform 0.2s ease; opacity: 0.6; }
        .sidebar-chevron.open { transform: rotate(180deg); opacity: 1; }
        .sidebar.collapsed .sidebar-chevron { display: none !important; }
        body.superadmin-layout .sidebar .sidebar-chevron { display: none !important; }

        /* =====================================================
           SA PROFILE CARD
           ===================================================== */
        .sa-profile-card {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 14px; margin: 0 10px; border-radius: 10px;
            background: linear-gradient(135deg, #1A6FA8, #D4A45A);
            color: #FFFFFF; box-shadow: 0 4px 14px rgba(0,0,0,0.3);
            white-space: nowrap; overflow: hidden;
            width: 100%; max-width: 100%; box-sizing: border-box;
        }
        .sa-profile-avatar {
            width: 30px; height: 30px; border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; flex-shrink: 0; font-weight: 700;
        }
        .sa-profile-info { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
        .sa-profile-info small { font-size: 9.5px; opacity: 0.8; color: #FFFFFF !important; }
        .sa-profile-info strong { font-size: 12px; color: #FFFFFF !important; }
        .sa-profile-card-collapsed {
            width: 40px; height: 40px; border-radius: 10px;
            background: linear-gradient(135deg, #1A6FA8, #D4A45A);
            color: #FFFFFF; display: flex; align-items: center; justify-content: center;
            font-size: 16px; margin: 6px auto; font-weight: 700;
        }
        .superadmin-layout .sidebar.collapsed .sa-profile-card { display: none !important; }
        .superadmin-layout .sidebar:not(.collapsed) .sa-profile-card-collapsed { display: none !important; }

        /* =====================================================
           SA BADGES
           ===================================================== */
        .sa-badge {
            display: inline-flex !important; align-items: center !important;
            justify-content: center !important; min-width: 18px; height: 18px;
            padding: 0 5px; border-radius: 9px; font-size: 10px; font-weight: 700;
            line-height: 1; margin-left: auto; flex-shrink: 0;
            color: #FFFFFF !important; filter: none !important;
        }
        .sa-badge-teal   { background: #125082 !important; }
        .sa-badge-red    { background: #DC2626 !important; }
        .sa-badge-blue   { background: #2589C9 !important; }
        .sa-badge-amber  { background: var(--gold) !important; }
        .sa-badge-purple { background: #8FA3B8 !important; }
        html.dark-mode .sa-badge { color: #FFFFFF !important; filter: none !important; }

        /* Ensure consistent spacing and no extra gaps */
        .sidebar-nav li:last-child {
            margin-bottom: 0 !important;
        }
        .sidebar-item {
            margin-bottom: 2px !important;
        }
        .sidebar.collapsed .sidebar-item {
            margin-bottom: 2px !important;
        }

        /* =====================================================
           NAVBAR - CRITICAL MOBILE FIX
           ===================================================== */
        /* Force navbar-collapse to display as horizontal flex row */
        .navbar-collapse { display: flex !important; flex-direction: row !important; align-items: center !important; flex-grow: 0 !important; margin-left: auto !important; visibility: visible !important; }
        .navbar-collapse.collapse:not(.show) { display: flex !important; }
        .navbar-nav { display: flex !important; flex-direction: row !important; align-items: center !important; gap: 2px !important; }
        .navbar-nav .nav-item { display: flex !important; align-items: center !important; }
        .nav-icon { color: #1A2332 !important; font-size: 18px !important; display: flex !important; align-items: center !important; justify-content: center !important; }
        html.dark-mode .nav-icon { color: #E8EDF2 !important; }

        /* Navbar profile name — always visible in light & dark mode */
        .navbar-bg .text-dark, .navbar-profile-name { color: #1A2332 !important; overflow: visible !important; white-space: nowrap !important; text-overflow: clip !important; display: inline-block !important; visibility: visible !important; min-width: 0; }
        html.dark-mode .navbar-bg .text-dark, html.dark-mode .navbar-profile-name { color: #E8EDF2 !important; }

        .navbar, .navbar-bg {
            z-index: 1050 !important;
            position: fixed !important;
            top: 0 !important; left: calc(var(--sidebar-width) + 5px) !important; right: 0 !important;
            height: var(--navbar-height) !important;
            min-height: var(--navbar-height) !important;
            max-height: var(--navbar-height) !important;
            width: calc(100% - var(--sidebar-width) - 5px) !important;
            background: var(--navbar-bg) !important;
            border-bottom: 2px solid rgba(212,164,90,0.25) !important;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08) !important;
            display: flex !important;
            align-items: center !important;
            padding: 0 10px !important;
        }

