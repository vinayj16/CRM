    <script>
        // ==========================================
        // CHAT UNREAD BADGE POLLING
        // ==========================================
        function updateChatBadges() {
            fetch('/CompanyChat/GetUnreadCount')
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        var count = data.count || 0;
                        var badges = document.querySelectorAll('#saChatUnreadBadge, #chatUnreadBadge');
                        badges.forEach(function(b) {
                            if (count > 0) {
                                b.style.display = '';
                                b.textContent = count > 99 ? '99+' : count;
                            } else {
                                b.style.display = 'none';
                            }
                        });
                    }
                })
                .catch(function() {});
        }
        // Poll every 30 seconds
        if (document.querySelector('#saChatUnreadBadge, #chatUnreadBadge')) {
            updateChatBadges();
            setInterval(updateChatBadges, 30000);
        }

        // ==========================================
        // SIGNALR CONNECTION FOR COMPANY CHAT (Global - single instance)
        // ==========================================
        window.chatConnection = null;
        function initCompanyChatSignalR() {
            if (typeof signalR === 'undefined') return; // CDN blocked -> never throw, never block the page
            if (window.chatConnection && window.chatConnection.state === 'Connected') return;
            window.chatConnection = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect()
                .build();

            window.chatConnection.on('ReceiveCompanyMessage', function(msg) {
                // Update badge when new message arrives
                updateChatBadges();
                // Show toast notification if not on chat page
                if (window.location.pathname.toLowerCase().indexOf('/companychat') === -1) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'info',
                            title: 'New message from ' + msg.senderName,
                            text: msg.messageText ? msg.messageText.substring(0, 60) + (msg.messageText.length > 60 ? '...' : '') : 'Sent a file',
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 4000
                        });
                    }
                }
            });

            window.chatConnection.onreconnected(function() {
                window.chatConnection.invoke('JoinCompanyChat').catch(function() {});
            });

            window.chatConnection.start()
                .then(function() {
                    window.chatConnection.invoke('JoinCompanyChat').catch(function() {});
                })
                .catch(function(err) {
                    console.error('SignalR connection error:', err);
                    setTimeout(initCompanyChatSignalR, 10000);
                });
        }
        // Initialize SignalR when page loads (wrapped so a failure can never break page scripts)
        if (document.cookie.indexOf('.AspNetCore.Cookies') !== -1 || document.cookie.indexOf('jwtToken') !== -1) {
            try { initCompanyChatSignalR(); } catch (e) { /* never break page scripts */ }
        }

        var _pl = document.getElementById("pageLoader");
        if (_pl) _pl.classList.add("d-none");
        requestAnimationFrame(function() { requestAnimationFrame(function() { document.documentElement.classList.add('ready'); }); });

        var _featherTimer = null;
        function debouncedFeatherReplace() {
            if (_featherTimer) clearTimeout(_featherTimer);
            _featherTimer = setTimeout(function() {
                if (typeof feather !== 'undefined') feather.replace();
                document.querySelectorAll('[data-feather]').forEach(function(el) {
                    el.style.width = '15px'; el.style.height = '15px';
                });
            }, 50);
        }
    </script>

    <script>
        $(document).ready(function() {
            // Force navbar visibility
            function forceNavbarVisibility() {
                $('.navbar,.navbar-bg,.navbar-collapse,.navbar-nav,.nav-item,.nav-icon,.nav-link,#themeToggle,#alertsDropdown,.avatar,.text-dark,#notificationCount,.sidebar-toggle,.hamburger').each(function() {
                    $(this).css({ visibility:'visible', opacity:'1' });
                });
            }
            forceNavbarVisibility();
            requestAnimationFrame(forceNavbarVisibility);
            $(window).on('load', forceNavbarVisibility);

            // Sidebar toggle is handled centrally by app.js (single handler)
        });

        document.addEventListener('DOMContentLoaded', function() {
            var darkMode = localStorage.getItem('darkMode');
            var themeToggle = document.getElementById('themeToggle');
            var themeIcon = document.getElementById('themeIcon');

            function updateIcon(isDark) {
                if (!themeIcon) return;
                themeIcon.classList.remove('fa-moon','fa-sun');
                themeIcon.classList.add(isDark ? 'fa-sun' : 'fa-moon');
            }
            
            function setDarkMode(isDark) {
                if (isDark) {
                    document.documentElement.classList.add('dark-mode');
                    document.body.classList.add('dark-mode');
                } else {
                    document.documentElement.classList.remove('dark-mode');
                    document.body.classList.remove('dark-mode');
                }
                localStorage.setItem('darkMode', isDark ? 'enabled' : 'disabled');
                updateIcon(isDark);
                window.dispatchEvent(new CustomEvent('crm:theme-changed', { detail: { isDark: isDark } }));
                applyThemeToCharts();
            }

            if (darkMode === 'enabled') { setDarkMode(true); }

            themeToggle && themeToggle.addEventListener('click', function(e) {
                e.preventDefault();
                var isDark = !document.documentElement.classList.contains('dark-mode');
                setDarkMode(isDark);
            });

            function applyThemeToCharts() {
                if (typeof Chart === 'undefined') return;
                var isDark = document.documentElement.classList.contains('dark-mode');
                var textColor = isDark ? '#E8EDF2' : '#1A2332';
                var gridColor = isDark ? 'rgba(255,255,255,0.1)' : 'rgba(107,123,141,0.15)';
                Chart.defaults.color = textColor;
                document.querySelectorAll('canvas').forEach(function(canvas) {
                    var chart = typeof Chart.getChart === 'function' ? Chart.getChart(canvas) : null;
                    if (!chart) return;
                    var cfg = chart.config;
                    cfg.options = cfg.options || {};
                    cfg.options.plugins = cfg.options.plugins || {};
                    cfg.options.plugins.legend = cfg.options.plugins.legend || {};
                    cfg.options.plugins.legend.labels = cfg.options.plugins.legend.labels || {};
                    cfg.options.plugins.legend.labels.color = textColor;
                    if (cfg.options.scales) {
                        Object.keys(cfg.options.scales).forEach(function(key) {
                            var s = cfg.options.scales[key];
                            if (!s) return;
                            s.ticks = s.ticks || {}; s.grid = s.grid || {};
                            s.ticks.color = textColor; s.grid.color = gridColor;
                        });
                    }
                    chart.update('none');
                });
            }

            if (typeof feather !== 'undefined') { feather.replace(); }
            initializeSidebarDropdowns();
        });

        function initializeSidebarDropdowns() {
            function expandDropdown($item) {
                $item.addClass('has-active');
                $item.find('.collapse').first().addClass('show');
                $item.find('> .sidebar-link').removeClass('collapsed').attr('aria-expanded', 'true');
                $item.find('> .sidebar-link .sidebar-chevron').addClass('open');
            }
            function collapseDropdown($item) {
                $item.removeClass('has-active');
                $item.find('.collapse').first().removeClass('show');
                $item.find('> .sidebar-link').addClass('collapsed').attr('aria-expanded', 'false');
                $item.find('> .sidebar-link .sidebar-chevron').removeClass('open');
            }
            var currentPath = window.location.pathname;
            var pathParts = currentPath.split('/').filter(function(p) { return p; });
            var currentController = pathParts[0] || '';

            var dropdownMappings = {
                'dashboardCollapse': ['Home', 'MilestoneTracking'],
                'leadsPropertiesCollapse': ['Leads', 'SalesPipelines', 'Tasks', 'WebhookLeads', 'Properties'],
                'salesCollapse': ['Quotations', 'Bookings', 'Invoices', 'Payments'],
                'financeCollapse': ['Expenses', 'Revenue', 'Profit'],
                'teamCollapse': ['Agent'],
                'attendanceCollapse': ['Attendance'],
                'payoutsCollapse': ['AgentPayout', 'PartnerCommission'],
                'userManagementCollapse': ['ManageUsers'],
                'settingsCollapse': ['Profile', 'Settings', 'EmailSettings'],
                'subscriptionsCollapse': ['Subscription', 'SaasSubscription', 'RazorpayTransactions', 'PartnerTransactions'],
                'financialSettingsCollapse': ['Financial'],
                'integrationsCollapse': ['Integrations'],
                'testimonialsCollapse': ['Testimonials']
            };
            var specialCases = {
                '/ManageUsers/PartnerApproval': 'teamCollapse',
                '/Home/SalesOverview': 'dashboardCollapse',
                '/Home/TeamDashboard': 'dashboardCollapse',
                '/MilestoneTracking/Index': 'dashboardCollapse',
                '/Settings/Testimonials': 'testimonialsCollapse'
            };

            function getActiveDropdown() {
                for (var path in specialCases) { if (currentPath.indexOf(path) !== -1) return specialCases[path]; }
                for (var dropdownId in dropdownMappings) { if (dropdownMappings[dropdownId].includes(currentController)) return dropdownId; }
                return null;
            }

            var dropdownToOpen = getActiveDropdown() || localStorage.getItem('activeDropdown');
            $('.sidebar-item.has-dropdown.has-active').each(function() { expandDropdown($(this)); });
            if (dropdownToOpen) {
                var $dd = $('#' + dropdownToOpen);
                if ($dd.length) { expandDropdown($dd.closest('.sidebar-item.has-dropdown')); localStorage.setItem('activeDropdown', dropdownToOpen); }
            }

            $('.sidebar-item.has-dropdown > .sidebar-link').on('click', function(e) {
                e.preventDefault();
                var isSidebarCollapsed = $('.sidebar').hasClass('collapsed');
                var $parent = $(this).parent();
                var $collapse = $parent.find('.collapse').first();
                var collapseId = $collapse.attr('id');
                var isOpen = $collapse.hasClass('show');
                if (isSidebarCollapsed) {
                    $('.sidebar').removeClass('collapsed'); localStorage.setItem('crm.sidebar.collapsed', '0');
                    $('.main').removeClass('expanded');
                    $('.sidebar-item.has-dropdown').each(function() { if (this !== $parent[0]) collapseDropdown($(this)); });
                    expandDropdown($parent);
                    if (collapseId) localStorage.setItem('activeDropdown', collapseId);
                    return;
                }
                if (isOpen) { collapseDropdown($parent); localStorage.removeItem('activeDropdown'); }
                else {
                    $('.sidebar-item.has-dropdown').each(function() { if (this !== $parent[0]) collapseDropdown($(this)); });
                    expandDropdown($parent);
                    if (collapseId) localStorage.setItem('activeDropdown', collapseId);
                }
            });

            $(document).on('click', '.sidebar-dropdown .sidebar-link', function() {
                var collapseId = $(this).closest('.sidebar-item.has-dropdown').find('.collapse').attr('id');
                if (collapseId) localStorage.setItem('activeDropdown', collapseId);
            });
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Currency -->
    <script>
        window.formatIndianCurrency = function(amount) {
            var num = parseFloat(amount);
            if (isNaN(num)) return amount;
            var numStr = Math.floor(num).toString();
            var lastThree = numStr.substring(numStr.length - 3);
            var otherNumbers = numStr.substring(0, numStr.length - 3);
            if (otherNumbers !== '') lastThree = ',' + lastThree;
            return '₹' + otherNumbers.replace(/\B(?=(\d{2})+(?!\d))/g, ',') + lastThree;
        };
        $(document).ready(function() {
            $('.indian-currency').each(function() {
                var amount = $(this).data('amount');
                if (amount) {
                    var t = $(this).text();
                    var prefix = t.includes('Paid:') ? 'Paid: ' : t.includes('Balance:') ? 'Balance: ' : t.includes('Deduction:') ? 'Deduction: ' : t.includes('Total:') ? 'Total: ' : '';
                    $(this).text(prefix + formatIndianCurrency(amount));
                }
            });
        });
    </script>

    <!-- Subscription Upgrade -->
    <script>
        window.handleSubscriptionUpgrade = function(response) {
            if (response && response.showUpgrade) {
                Swal.fire({ icon:'warning', title:'Subscription Limit Reached', text:response.message, showCancelButton:true, confirmButtonColor:'#1A6FA8', cancelButtonColor:'#6B7B8D', confirmButtonText:'Upgrade Plan', cancelButtonText:'Cancel' })
                    .then(function(result) { if (result.isConfirmed) window.location.href = response.upgradeUrl || '/Subscription/MyPlan'; });
                return true;
            }
            return false;
        };
        $(document).ready(function() {
            @if (TempData["ShowUpgrade"] != null && TempData["UpgradePrompt"] != null)
            {
                <text>
                Swal.fire({ icon:'warning', title:'Subscription Limit Reached', text:'@TempData["UpgradePrompt"]', showCancelButton:true, confirmButtonColor:'#1A6FA8', cancelButtonColor:'#6B7B8D', confirmButtonText:'Upgrade Plan', cancelButtonText:'Cancel' })
                    .then(function(result) { if (result.isConfirmed) window.location.href = '/Subscription/MyPlan'; });
                </text>
            }
        });
    </script>

    <!-- Pagination -->
    <script>
        function initializePagination(itemsPerPage) {
            itemsPerPage = itemsPerPage || 10;
            var items = document.querySelectorAll('.paginated-item');
            var totalItems = items.length;
            var totalPages = Math.ceil(totalItems / itemsPerPage);
            var currentPage = 1;
            function showPage(page) {
                var start = (page - 1) * itemsPerPage;
                var end = start + itemsPerPage;
                items.forEach(function(item, index) { item.style.display = (index >= start && index < end) ? 'block' : 'none'; });
                var html = '<nav><ul class="pagination justify-content-center">';
                html += '<li class="page-item ' + (page === 1 ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="goToPage(' + (page - 1) + ')">Prev</a></li>';
                for (var i = 1; i <= totalPages; i++) {
                    if (i === 1 || i === totalPages || (i >= page - 2 && i <= page + 2)) {
                        html += '<li class="page-item ' + (i === page ? 'active' : '') + '"><a class="page-link" href="#" onclick="goToPage(' + i + ')">' + i + '</a></li>';
                    } else if (i === page - 3 || i === page + 3) {
                        html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                    }
                }
                html += '<li class="page-item ' + (page === totalPages ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="goToPage(' + (page + 1) + ')">Next</a></li></ul></nav>';
                var pc = document.getElementById('pagination-container');
                if (pc) pc.innerHTML = html;
            }
            window.goToPage = function(page) { if (page >= 1 && page <= totalPages) { currentPage = page; showPage(page); } };
            if (totalItems > 0) showPage(1);
        }
        document.addEventListener('DOMContentLoaded', function() { if (document.querySelectorAll('.paginated-item').length > 0) initializePagination(); });
    </script>

    <!-- Notifications -->
    <script>
        window.notificationHandler = {
            handleNotification: function(notification) {
                if (typeof window.loadNotifications === 'function') window.loadNotifications();
                if (Notification.permission === 'granted' && notification.title) {
                    var n = new Notification(notification.title, { body: notification.message || '', icon: '/img/icons/icon-48x48.png', tag: 'crm-' + Date.now() });
                    n.onclick = function() { window.focus(); if (notification.link) window.location.href = notification.link; n.close(); };
                    setTimeout(function() { n.close(); }, 5000);
                }
            }
        };

        var _isSuperAdmin = (function() {
            try {
                var token = document.cookie.split(';').find(function(c) { return c.trim().startsWith('jwtToken='); });
                if (token) {
                    var payload = JSON.parse(atob(token.split('=').slice(1).join('=').split('.')[1]));
                    return (payload['http://schemas.microsoft.com/ws/2008/06/identity/claims/role'] || payload['role']) === 'SuperAdmin';
                }
            } catch(e) {}
            return false;
        })();

        // Validate that a notification link points to data that exists on the site.
        // Returns the link if it is a known/valid route, otherwise null (so we don't navigate to dead pages).
        window.isValidNotificationLink = function(link) {
            if (!link || link === '#' || link === '' || link.indexOf('javascript:') === 0) return null;
            var allowedPrefixes = [
                '/home', '/leaddetails/', '/quotationdetails/', '/invoicedetails/',
                '/bookingdetails/', '/paymentreceipt/', '/WebhookLeads', '/tasks',
                '/Leads', '/Quotations', '/Invoices', '/Bookings', '/Payments',
                '/Profile', '/Settings', '/Ticket'
            ];
            for (var i = 0; i < allowedPrefixes.length; i++) {
                if (link.indexOf(allowedPrefixes[i]) === 0) return link;
            }
            return null;
        };

        window.loadNotifications = function() {
            if (typeof $ === 'undefined') return Promise.reject('jQuery not loaded');
            if (_isSuperAdmin) {
                return $.get('/SuperAdmin/GetNotifications').then(function(data) {
                    if (!data.success) return;
                    var count = data.count || 0;
                    var $badge = $('#notificationCount');
                    if (count > 0) { $badge.text(count).removeClass('hidden').show(); } else { $badge.addClass('hidden').hide(); }
                    $('#notificationHeader').text('Notifications');
                    var html = '';
                    if (!data.notifications || data.notifications.length === 0) {
                        html = '<div class="list-group-item text-center text-muted py-3">No notifications</div>';
                    } else {
                        data.notifications.forEach(function(n) {
                            var safeLink = window.isValidNotificationLink(n.link);
                            html += buildNotificationItem({ id:n.id, title:n.title, message:n.message, priority:n.priority, createdOn:n.createdOn, link:safeLink, isRead:true });
                        });
                    }
                    $('#notificationList').html(html);
                    bindNotificationEvents();
                }).catch(function() {});
            }
            return $.when($.get('/Notification/GetNotifications'), $.get('/Tasks/GetTodayTaskNotifications'))
                .then(function(notifResp, taskResp) {
                    var data = notifResp[0]; var taskData = taskResp[0];
                    if (!data.success) return;
                    var unreadCount = data.count || 0;
                    var notifications = data.notifications || [];
                    var taskCount = taskData.count || 0;
                    var tasks = taskData.tasks || [];
                    var totalUnread = unreadCount + taskCount;
                    var allItems = [];
                    var seenKeys = {};
                    notifications.forEach(function(n) {
                        var key = 'n_' + n.id;
                        if (seenKeys[key]) return;
                        seenKeys[key] = true;
                        allItems.push({ type:'notification', data:n });
                    });
                    tasks.forEach(function(t) {
                        var key = 't_' + t.leadId;
                        if (seenKeys[key]) return;
                        seenKeys[key] = true;
                        allItems.push({ type:'task', data: { id:'task_'+t.leadId, title:'Follow-up Due Today', message:t.name+' - '+t.contact, type:'FollowUpDue', link:'/leaddetails/'+t.encodedId, priority:'High', createdOn:'Today', isRead:false } });
                    });
                    var $badge = $('#notificationCount');
                    if (totalUnread > 0) { $badge.text(totalUnread).removeClass('hidden').show(); } else { $badge.addClass('hidden').hide(); }
                    $('#notificationHeader').text(totalUnread > 0 ? totalUnread + ' Unread Notifications' : 'Notifications');
                    var html = '';
                    if (allItems.length === 0) { html = '<div class="list-group-item text-center text-muted py-3">No notifications</div>'; }
                    else {
                        allItems.forEach(function(item) {
                            var n = item.data;
                            var nId = item.type === 'notification' ? n.id : null;
                            var safeLink = window.isValidNotificationLink(n.link);
                            html += buildNotificationItem({ id:nId, title:n.title, message:n.message, priority:n.priority, createdOn:n.createdOn, link:safeLink, isRead:n.isRead });
                        });
                    }
                    $('#notificationList').html(html);
                    bindNotificationEvents();
                }).catch(function() {});
        };

        // Build a single notification item with a "Mark as read" button.
        function buildNotificationItem(opts) {
            var nId = opts.id;
            var link = opts.link; // already validated (null if invalid)
            var isRead = opts.isRead || false;
            var priorityClass = 'notification-' + (opts.priority || 'Normal').toLowerCase();
            var borderColor = getPriorityColor(opts.priority);
            var clickAttr = link ? 'href="' + link + '"' : 'href="javascript:void(0)"';
            var dataAttr = nId ? ' data-notification-id="' + nId + '"' : '';
            var readStyle = isRead ? 'opacity:0.6;' : '';
            var readBadge = isRead ? '<small class="text-muted" style="font-size:10px;">Read</small>' : '';
            var html = '<div class="list-group-item notification-item ' + priorityClass + '"' + dataAttr
                + ' style="padding:10px 14px;border-left:3px solid ' + borderColor + ';display:flex;flex-direction:column;gap:4px;' + readStyle + '">';
            html += '<div class="d-flex align-items-start justify-content-between gap-2">';
            html += '<a class="notification-link text-decoration-none flex-grow-1"' + clickAttr + ' style="min-width:0;">'
                + '<div class="fw-bold text-truncate" style="font-size:13px;color:var(--text-primary);">' + escapeHtml(opts.title) + '</div>'
                + '<div class="small text-truncate" style="color:var(--text-muted);">' + escapeHtml(opts.message) + '</div>'
                + readBadge
                + '<div class="small text-muted mt-1"><i class="far fa-clock me-1"></i>' + escapeHtml(opts.createdOn) + '</div></a>';
            html += '<button type="button" class="btn btn-sm mark-read-btn" title="Mark as read" data-mark-read="' + (nId || '') + '"'
                + ' style="flex-shrink:0;border:none;background:transparent;color:var(--text-muted);font-size:11px;font-weight:600;line-height:1;padding:3px 8px;border-radius:4px;"'
                + (nId ? '' : ' disabled') + '>Read</button>';
            html += '</div></div>';
            return html;
        }

        function escapeHtml(str) {
            if (str == null) return '';
            return String(str).replace(/[&<>"']/g, function(c) {
                return { '&':'&', '<':'<', '>':'>', '"':'"', "'":'&#39;' }[c];
            });
        }

        function bindNotificationEvents() {
            $('.notification-link').off('click').on('click', function(e) {
                var href = $(this).attr('href');
                if (!href || href === '#' || href === 'javascript:void(0)' || href.indexOf('javascript:') === 0) {
                    e.preventDefault();
                    return;
                }
                var nId = $(this).closest('.notification-item').data('notification-id');
                if (nId) markNotificationAsRead(nId, true);
            });
            $('.mark-read-btn').off('click').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var nId = $(this).data('mark-read');
                if (nId) markNotificationAsRead(nId, false);
            });
        }

        function getPriorityColor(p) { return { Urgent:'#DC2626', High:'#D4A45A', Normal:'#1A6FA8', Low:'#6B7B8D' }[p] || '#1A6FA8'; }

        function markNotificationAsRead(notificationId, navigateAfter) {
            if (typeof $ === 'undefined') return;
            var $n = $('[data-notification-id="' + notificationId + '"]');
            if ($n.length) {
                $n.css('opacity', '0.6');
                var readBadge = $n.find('.read-badge');
                if (readBadge.length === 0) {
                    var msgDiv = $n.find('.small.text-truncate');
                    if (msgDiv.length) {
                        msgDiv.after('<small class="text-muted read-badge" style="font-size:10px;"> Read</small>');
                    }
                }
                var $badge = $('#notificationCount');
                var cur = parseInt($badge.text()) || 0;
                if (cur > 1) { $badge.text(cur - 1); } else { $badge.text(0).addClass('hidden').hide(); }
                $('#notificationHeader').text((cur - 1 > 0 ? (cur - 1) + ' Unread Notifications' : 'Notifications'));
            }
            $.ajax({ url:'/Notification/MarkAsRead', type:'POST', data:{ notificationId:notificationId }, headers:{ 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success:function(data) {
                    if (!data.success && $n.length) { $n.css('opacity', '1'); }
                    setTimeout(loadNotifications, 1500);
                },
                error:function() { if ($n.length) $n.css('opacity', '1'); loadNotifications(); }
            });
        }

        if (typeof jQuery !== 'undefined') {
            $(document).ready(function() {
                function initNotifications() { loadNotifications().catch(function() { setTimeout(loadNotifications, 3000); }); }
                initNotifications(); setTimeout(initNotifications, 1000);

                $('#markAllRead').click(function(e) {
                    e.preventDefault();
                    var $btn = $(this); $btn.prop('disabled', true).text('Marking...');
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    $.when(
                        $.ajax({ url:'/Notification/MarkAllAsRead', type:'POST', headers:{ 'RequestVerificationToken':token } }),
                        $.ajax({ url:'/Tasks/MarkTodayTasksAsRead', type:'POST', headers:{ 'RequestVerificationToken':token } })
                    ).done(function() { $('#notificationCount').addClass('hidden').hide(); $('#notificationHeader').text('Notifications'); setTimeout(loadNotifications, 800); })
                    .fail(function() { loadNotifications(); })
                    .always(function() { $btn.prop('disabled', false).text('Mark all as read'); });
                });

                var isDropdownOpen = false;
                $('#alertsDropdown').on('show.bs.dropdown', function() { isDropdownOpen = true; loadNotifications(); });
                $('#alertsDropdown').on('hide.bs.dropdown', function() { isDropdownOpen = false; });
                setInterval(function() { if (!isDropdownOpen) loadNotifications(); }, 15000);
                $(window).focus(function() { if (!isDropdownOpen) loadNotifications(); });
            });
        }

        window.showToast = function(message, type) {
            function fireToast() {
                var iconType = { success:'success', error:'error', warning:'warning' }[type] || 'info';
                var bg = { success:'#16A34A', error:'#DC2626', warning:'#D4A45A' }[type] || '#1A6FA8';
                var textColor = type === 'warning' ? '#1A2332' : '#FFFFFF';
                Swal.fire({ toast:true, position:'top-end', icon:iconType, iconColor:textColor, title:message, showConfirmButton:false, timer:5000, timerProgressBar:false, background:bg, color:textColor, width:'auto', customClass:{ title:'swal-toast-title' } });
            }
            if (typeof Swal !== 'undefined') { fireToast(); } else { setTimeout(function() { if (typeof Swal !== 'undefined') fireToast(); }, 500); }
        };
    </script>

    <!-- Impersonation -->
    <script>
        function loadImpersonationUsers() {
