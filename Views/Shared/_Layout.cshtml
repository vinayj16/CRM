        <!-- Expand active dropdown immediately -->
        <script>
            (function() {
                var path = window.location.pathname;
                var parts = path.split('/').filter(function(p) { return p; });
                var ctrl = parts[0] || '';
                var action = parts[1] || '';
                var map = {
                    'Home': 'dashboardCollapse', 'MilestoneTracking': 'dashboardCollapse',
                    'Leads': 'leadsPropertiesCollapse', 'SalesPipelines': 'leadsPropertiesCollapse',
                    'Tasks': 'leadsPropertiesCollapse', 'WebhookLeads': 'leadsPropertiesCollapse', 'Properties': 'leadsPropertiesCollapse',
                    'Quotations': 'salesCollapse', 'Bookings': 'salesCollapse', 'Invoices': 'salesCollapse', 'Payments': 'salesCollapse',
                    'Expenses': 'financeCollapse', 'Revenue': 'financeCollapse', 'Profit': 'financeCollapse',
                    'Agent': 'teamCollapse', 'Attendance': 'attendanceCollapse',
                    'AgentPayout': 'payoutsCollapse', 'PartnerCommission': 'payoutsCollapse',
                    'Profile': 'settingsCollapse', 'Settings': 'settingsCollapse', 'EmailSettings': 'settingsCollapse',
                    'Subscription': 'subscriptionsCollapse', 'RazorpayTransactions': 'subscriptionsCollapse',
                    'SaasSubscription': 'subscriptionsCollapse', 'PartnerTransactions': 'subscriptionsCollapse',
                    'Financial': 'financialSettingsCollapse', 'Integrations': 'integrationsCollapse', 'Testimonials': 'testimonialsCollapse'
                };
                var id = null;
                if (ctrl === 'ManageUsers' && action === 'PartnerApproval') id = 'teamCollapse';
                else if (ctrl === 'ManageUsers') id = 'userManagementCollapse';
                else id = map[ctrl];
                if (id) {
                    var el = document.getElementById(id);
                    if (el) {
                        el.classList.add('show');
                        var link = el.parentElement.querySelector(':scope > .sidebar-link');
                        if (link) {
                            link.classList.remove('collapsed'); link.setAttribute('aria-expanded', 'true');
                            var chev = link.querySelector('.sidebar-chevron');
                            if (chev) chev.classList.add('open');
                        }
                    }
                }
            })();
        </script>

        <!-- SA Badge Loader -->
        <script>
            (function() {
                var isSA = document.body.classList.contains('superadmin-layout');
                if (!isSA) return;
                function setBadge(id, count, bgColor) {
                    var el = document.getElementById(id);
                    if (!el) return;
                    if (count > 0) {
                        el.textContent = count;
                        el.setAttribute('style', 'display:inline-flex !important;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 5px;border-radius:9px;font-size:10px;font-weight:700;line-height:1;margin-left:auto;flex-shrink:0;background:' + bgColor + ' !important;color:#FFFFFF !important;filter:none !important;');
                    } else {
                        el.setAttribute('style', 'display:none !important;');
                    }
                }
                function loadSABadges() {
                    fetch('/SuperAdmin/GetTenantCount').then(function(r){return r.json();}).then(function(data){setBadge('sa-tenant-count', data.count||data.Count||0, '#1A6FA8');}).catch(function(){});
                    fetch('/SuperAdmin/GetInquiryCount').then(function(r){return r.json();}).then(function(data){setBadge('sa-inquiry-count', data.count||data.Count||0, '#DC2626');}).catch(function(){});
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', function() { loadSABadges(); setInterval(loadSABadges, 60000); });
                } else { loadSABadges(); setInterval(loadSABadges, 60000); }
            })();
        </script>

