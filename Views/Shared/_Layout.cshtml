                        html += '<h6 class="dropdown-header">' + r + '</h6>';
                        data.users[r].forEach(function(u) { html += '<a class="dropdown-item" href="#" onclick="startImpersonation(' + u.UserId + ',\'' + u.Username + '\')"> ' + u.Username + '</a>'; });
