@* Shared hero welcome section - used by Home/Index, Home/SalesOverview,
   Home/TeamDashboard, Home/PartnerDashboard. Expects ViewBag.Username,
   ViewBag.CompanyName and optional ViewBag.CompanyLogo. *@
<div class="hero-welcome card mb-4 border-0 overflow-hidden" style="background:linear-gradient(135deg,#1A6FA8 0%,#D4A45A 100%);border-radius:16px;box-shadow:0 8px 32px rgba(26,111,168,0.15);">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center" style="width:64px;height:64px;flex-shrink:0;background:rgba(255,255,255,0.25);">
                        <i class="fa-solid fa-user text-white" style="font-size:1.8rem;"></i>
                    </div>
                    <div>
                        <h2 class="text-white mb-1 fw-bold" style="font-size:1.8rem;">Welcome, @ViewBag.Username!</h2>
                        <p class="text-white-50 mb-0"><i class="fa-solid fa-briefcase me-2"></i>@ViewBag.CompanyName</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="d-flex align-items-center justify-content-md-end gap-3">
                    @if (!string.IsNullOrEmpty(ViewBag.CompanyLogo as string))
                    {
                        <div class="company-badge-hero d-flex align-items-center gap-2 rounded-3 px-3 py-2" style="background:rgba(255,255,255,0.15);">
                            <img src="@ViewBag.CompanyLogo" style="height:36px;width:auto;max-width:100px;object-fit:contain;border-radius:4px;" alt="Logo" />
                            <span class="text-white fw-semibold" style="font-size:0.95rem;">@ViewBag.CompanyName</span>
                        </div>
                    }
                    else
                    {
                        <div class="company-badge-hero d-flex align-items-center gap-2 rounded-3 px-3 py-2" style="background:rgba(255,255,255,0.15);">
                            <i class="fa-solid fa-building text-white" style="font-size:1.4rem;"></i>
                            <span class="text-white fw-semibold" style="font-size:0.95rem;">@ViewBag.CompanyName</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
