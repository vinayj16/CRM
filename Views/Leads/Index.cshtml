        const wb = XLSX.utils.book_new(); const ws = XLSX.utils.aoa_to_sheet(ws_data);
        ws['!cols'] = [{wch:20},{wch:15},{wch:25},{wch:15},{wch:12},{wch:15},{wch:15},{wch:20},{wch:10},{wch:12},{wch:15},{wch:15},{wch:10},{wch:18},{wch:20},{wch:12},{wch:15},{wch:10},{wch:30}];
