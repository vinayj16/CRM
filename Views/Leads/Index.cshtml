    function deleteLead(id) {
    if (!confirm('Are you sure you want to delete this lead?')) return;

    fetch(`/Leads/Delete?id=${id}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
    })
    .then(response => response.json())
    .then(data => {
    if (data.success) {
    // Successfully removed from database
    allLeads = allLeads.filter(l => l.LeadId !== id);
    filteredLeads = filteredLeads.filter(l => l.LeadId !== id);
    renderTable();
    showToast('Lead deleted successfully!', 'success');
    }
    else {
    // Check if the server's error message points to a foreign key/reference constraint
    var errMsg = data.message || '';
    if (errMsg.includes('REFERENCE constraint') || errMsg.includes('FK_Quotations_Lead') || errMsg.includes('Quotations')) {
    // Display a clear explanation instead of the raw SQL string
    Swal.fire({
    icon: 'warning',
    title: 'Cannot Delete Lead',
    text: 'This lead has associated Quotations, Bookings, or Invoices. Please delete or reassign those documents first before removing this lead.',
    confirmButtonColor: '#1A6FA8'
    });
    } else {
    // Fallback for any other type of error
    showToast(errMsg || 'Error deleting lead', 'error');
    }
    }
    })
    .catch(error => {
    console.error('Error:', error);
    showToast('Error deleting lead', 'error');
    });
    }

