@model CRM.Models.LeadModel
@{
    ViewData["Title"] = "Lead Details";
    var executives = ViewBag.Executives as IEnumerable<dynamic>;
    var isPartnerTeamUser = ViewBag.IsPartnerTeamUser != null && (bool)ViewBag.IsPartnerTeamUser;
    var displayedExecutiveId = (isPartnerTeamUser && Model.PartnerAssignedAgentUserId.HasValue)
        ? Model.PartnerAssignedAgentUserId.Value
        : (Model.ExecutiveId ?? 0);
    string executiveName = "Unassigned";

    if (displayedExecutiveId > 0 && executives != null)
    {
        foreach (var e in executives)
        {
            try
            {
                int eId = Convert.ToInt32(e.UserId);
                if (eId == displayedExecutiveId)
                {
                    executiveName = (string)(e.FullName ?? e.Username ?? "Unassigned");
                    break;
                }
            }
            catch { }
        }

        // Fallback: direct DB lookup if not found in executives list
        if (executiveName == "Unassigned")
        {
            var db = Context.RequestServices.GetService<CRM.AppDbContext>();
            var user = db?.Users.FirstOrDefault(u => u.UserId == displayedExecutiveId);
            if (user != null)
            {
                var profile = db?.UserProfiles.FirstOrDefault(p => p.UserId == displayedExecutiveId);
                executiveName = (profile != null && !string.IsNullOrWhiteSpace(profile.FirstName))
                    ? $"{profile.FirstName} {profile.LastName}".Trim()
                    : user.Username ?? "Unassigned";
            }
        }
    }
}

<!-- Flatpickr: lightweight date/time picker used for the Follow-up form's
     date and time fields. Loaded from CDN; does not touch any backend code. -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
    /* ===========================================================
    DESIGN TOKENS
    =========================================================== */
    :root {
    --brand-primary: #1A6FA8;
    --brand-primary-dark: #125082;
    --brand-primary-light: rgba(26,111,168, 0.08);
    --brand-accent: #D4A45A;
    --brand-accent-dark: #B8883E;
    --brand-accent-light: rgba(212,164,90, 0.12);
    --ink-900: #1E2A3A;
    --ink-600: #6B7B8D;
    --ink-400: #8FA3B8;
    --surface: #FFFFFF;
    --surface-muted: #F0F4F8;
    --border-soft: rgba(26,111,168, 0.12);
    --danger: #DC2626;
    --success: #16A34A;
    --radius-lg: 10px;
    --radius-md: 8px;
    --radius-sm: 6px;
    }

    /* Mobile responsive styles */
    @@media (max-width: 768px) {
    /* Prevent horizontal scroll */
    body {
    overflow-x: hidden;
    }

    html, body {
    max-width: 100vw;
    overflow-x: hidden;
    }

    .row[style*="flex-wrap:nowrap"] {
    flex-wrap: wrap !important;
    }

    .row[style*="flex-wrap:nowrap"] > [style*="max-width:380px"] {
    max-width: 100% !important;
    flex-shrink: 1 !important;
    }

    .sticky-leads-sidebar {
    position: relative !important;
    margin-bottom: 0.75rem;
    }

    .pb-9 {
    padding-bottom: 1.25rem !important;
    }
    /* Prevent horizontal overflow and remove gaps - MOBILE ONLY */
    main.content {
    padding: 0.5rem !important;
    overflow-x: hidden !important;
    max-width: 100vw;
    }

    main.content > .container-fluid {
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
    max-width: 100% !important;
    margin: 0 !important;
    overflow-x: hidden !important;
    }

    .row {
    margin-left: 0 !important;
    margin-right: 0 !important;
    max-width: 100%;
    }

    .col-12, .col-md-5, .col-md-7, .col-lg-5, .col-lg-7,
    .col-xl-4, .col-xl-8, [class*="col-"] {
    padding-left: 0.4rem !important;
    padding-right: 0.4rem !important;
    max-width: 100%;
    }

    .avatar-name {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    }
    /* Card adjustments */
    .card {
    margin-bottom: 0.6rem !important;
    overflow-x: hidden;
    }

    .card-body {
    overflow-x: hidden;
    word-wrap: break-word;
    }
    /* Make cards more compact */
    .card-body h6 {
    font-size: 0.8125rem;
    }

    .card-body p {
    font-size: 0.8125rem;
    margin-bottom: 0.5rem !important;
    }
    /* Make tables responsive */
    .table-responsive {
    margin-left: 0;
    margin-right: 0;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    }

    .table {
    margin-bottom: 0;
    }
    /* Adjust button groups */
    .d-flex.flex-wrap.gap-2 {
    gap: 0.4rem !important;
    }

    .btn {
    font-size: 0.8125rem;
    padding: 0.375rem 0.7rem;
    white-space: nowrap;
    }
    /* Adjust tab styling for mobile */
    .nav-tabs .nav-link {
    padding: 0.4rem 0.65rem;
    font-size: 0.8125rem;
    }
    /* Fix breadcrumb */
    .breadcrumb {
    font-size: 0.8125rem;
    margin-bottom: 0.4rem !important;
    }
    /* Fix tab content padding */
    .tab-content {
    padding: 0.6rem 0.4rem !important;
    overflow-x: hidden;
    }
    /* Grid columns in cards */
    .g-3, .g-md-4, .g-xl-6 {
    --bs-gutter-x: 0.4rem !important;
    --bs-gutter-y: 0.4rem !important;
    }
    /* Prevent wide content from breaking layout */
    p, h1, h2, h3, h4, h5, h6, span, div {
    word-wrap: break-word;
    overflow-wrap: break-word;
    }
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      crossorigin="anonymous" referrerpolicy="no-referrer" />

<div class="content">
    <!-- Breadcrumb - Outside of header card -->
    <nav class="mb-2" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0" style="background: transparent; padding: 0; font-size: 0.8125rem;">
            <li class="breadcrumb-item"><a href="/Home" style="color: var(--ink-400); text-decoration: none;">Home</a></li>
            <li class="breadcrumb-item"><a href="/Leads/Index" style="color: var(--ink-400); text-decoration: none;">Leads</a></li>
            <li class="breadcrumb-item active" style="color: var(--ink-900);">@Model.Name</li>
        </ol>
    </nav>  

    <!-- Modern Header -->
    <div class="modern-header-section mb-3">
        <div class="modern-header-bg">
            <div class="header-content-wrapper">
                <!-- Header Title -->
                <div class="modern-header-title">
                    <div class="d-flex align-items-center">
                        <div class="header-icon me-3">
                            <i class="fa-solid fa-user-circle"></i>
                        </div>
                        <div>
                            <h1 class="header-main-title mb-1">@Model.Name</h1>
                            <p class="header-subtitle mb-0">Lead Details &amp; Activity Management</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pb-9">
        <!-- Header Actions -->
        <div class="row">
            <div class="col-12">
                <div class="row align-items-center justify-content-between g-2 mb-3">
                    <div class="col-12 col-md-auto">
                        <h2 class="mb-0 section-title">Lead Details</h2>
                    </div>
                    <div class="col-12 col-md-auto">
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-success" onclick="openNoteModal()">
                                <span class="fa-solid fa-note-sticky me-2"></span>Add Note
                            </button>
                            <button class="btn btn-info" onclick="openFollowUpModal(@Model.LeadId)" style="color: #FFFFFF;">
                                <span class="fa-solid fa-calendar-plus me-2"></span>Add Follow-up
                            </button>
                            <a href="/Leads/Index" class="btn btn-phoenix-secondary">
                                <span class="fa-solid fa-arrow-left me-2"></span>Back to Leads
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="row g-3 g-md-3 g-xl-4" style="flex-wrap:nowrap;">
            <!-- Left Sidebar - Lead Info Cards -->
            <div class="col-12 col-md-5 col-lg-5 col-xl-4" style="max-width:380px;flex-shrink:0;">
                <div class="sticky-leads-sidebar">
                    <!-- Lead Profile Card -->
                    <div class="card mb-3 position-relative">
                        <!-- WhatsApp Icon Button - Hidden for future implementation -->
                        <button class="whatsapp-icon-btn"
                                onclick="openWhatsAppModal(@Model.LeadId, '@Model.Name', '@Model.Contact')"
                                title="Send WhatsApp Message"
                                style="display: none;">
                            <i class="fab fa-whatsapp"></i>
                        </button>

                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar avatar-xl" style="flex-shrink: 0;">
                                    <div class="avatar-name rounded-circle" style="width: 54px; height: 54px; display: flex; align-items: center; justify-content: center;">
                                        <span class="fs-5 fw-bold">@Model.Name.Substring(0, 1).ToUpper()</span>
                                    </div>
                                </div>
                                <div class="flex-1" style="min-width: 0;">
                                    <h3 class="fw-bolder mb-1 profile-name">@Model.Name</h3>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="badge badge-phoenix badge-phoenix-@(Model.Status == "Active" ? "success" : Model.Status == "Hot" ? "danger" : Model.Status == "Warm" ? "warning" : Model.Status == "Cold" ? "info" : "secondary")">
                                            @Model.Status
                                        </span>
                                        <span class="badge badge-phoenix badge-phoenix-@(Model.Stage == "New" ? "primary" : Model.Stage == "Qualified" ? "success" : Model.Stage == "Negotiation" ? "warning" : Model.Stage == "Closed" ? "success" : "secondary")">
                                            @Model.Stage
                                        </span>
                                        @if (!string.IsNullOrEmpty(Model.Rating))
                                        {
                                            <span class="badge badge-rating">@Model.Rating</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Information Card -->
                    <div class="card mb-3">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <h4 class="mb-0">Contact Information</h4>
                            </div>

                            <div class="info-row">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="me-2 fa-solid fa-envelope info-icon"></span>
                                    <h5 class="text-body-highlight mb-0 fs-9">Email</h5>
                                </div>
                                <div class="d-flex align-items-center gap-2 info-value">
                                    <a href="mailto:@Model.Email" class="text-primary-brand">@(Model.Email ?? "Not provided")</a>
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        <a href="mailto:@Model.Email" class="btn btn-outline-danger btn-sm" title="Send Email" style="padding: 2px 8px; font-size: 0.75rem;">
                                            <i class="fa-solid fa-paper-plane"></i>
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="me-2 fa-solid fa-phone info-icon"></span>
                                    <h5 class="text-body-highlight mb-0 fs-9">Phone</h5>
                                </div>
                                <div class="d-flex align-items-center gap-2 info-value">
                                    <a href="tel:@Model.Contact" class="text-primary-brand">@Model.Contact</a>
                                    @if (!string.IsNullOrEmpty(Model.Contact))
                                    {
                                        <a href="https://wa.me/@(Model.Contact.TrimStart('+').Replace(" ", "").Replace("-", ""))" target="_blank" class="btn btn-success btn-sm" title="Chat on WhatsApp" style="padding: 2px 8px; font-size: 0.75rem;">
                                            <i class="fab fa-whatsapp"></i>
                                        </a>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.GroupName))
                            {
                                <div class="info-row">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-users info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">Group Name</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.GroupName</p>
                                </div>
                            }

                            <div class="info-row">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="me-2 fa-solid fa-user-tie info-icon"></span>
                                    <h5 class="text-body-highlight mb-0 fs-9">Assigned Executive</h5>
                                </div>
                                <p class="mb-0 text-body-secondary fw-semibold info-value">@executiveName</p>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Source))
                            {
                                <div class="info-row">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-bullseye info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">Lead Source</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.Source</p>
                                </div>
                            }

                            <div class="info-row">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="me-2 fa-solid fa-clock info-icon"></span>
                                    <h5 class="text-body-highlight mb-0 fs-9">Created On</h5>
                                </div>
                                <p class="mb-0 text-body-secondary info-value">@Model.CreatedOn.ToString("MMMM dd, yyyy hh:mm tt")</p>
                            </div>

                            @if (Model.ModifiedOn.HasValue)
                            {
                                <div class="info-row info-row-last">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-pen info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">Last Modified</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.ModifiedOn.Value.ToString("MMMM dd, yyyy hh:mm tt")</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Property Requirements Card -->
                    <div class="card mb-3">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <h4 class="mb-0">Property Requirements</h4>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.PreferredLocation))
                            {
                                <div class="info-row">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-location-dot info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">Preferred Location</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.PreferredLocation</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Type))
                            {
                                <div class="info-row">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-tag info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">Type</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.Type</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.PropertyType))
                            {
                                <div class="info-row">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-building info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">Property Type</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.PropertyType</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.BHK))
                            {
                                <div class="info-row">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-home info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">BHK</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.BHK</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Sqft))
                            {
                                <div class="info-row">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-ruler-combined info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">Square Feet</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.Sqft sq.ft</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Facing))
                            {
                                <div class="info-row">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-compass info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">Facing</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.Facing</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.LocationDistance))
                            {
                                <div class="info-row info-row-last">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2 fa-solid fa-road info-icon"></span>
                                        <h5 class="text-body-highlight mb-0 fs-9">Location Distance</h5>
                                    </div>
                                    <p class="mb-0 text-body-secondary info-value">@Model.LocationDistance</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Matching Properties Card (auto-matched from lead preferences) -->
                    <div class="card mb-3">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h4 class="mb-0"><i class="fas fa-building me-2" style="color:var(--brand-primary)"></i>Matching Properties</h4>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="loadMatchingProperties()">
                                    <i class="fas fa-sync-alt me-1"></i>Refresh
                                </button>
                            </div>
                            <div id="matchingPropertiesContainer">
                                <div class="text-center text-muted small py-2">
                                    <i class="fas fa-spinner fa-spin me-1"></i>Loading matching properties...
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Details Card -->
                    @if (!string.IsNullOrEmpty(Model.Requirement) || !string.IsNullOrEmpty(Model.Comments))
                    {
                        <div class="card mb-3">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <h4 class="mb-0">Additional Details</h4>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Requirement))
                                {
                                    <div class="info-row">
                                        <div class="d-flex align-items-center mb-1">
                                            <span class="me-2 fa-solid fa-list-check info-icon"></span>
                                            <h5 class="text-body-highlight mb-0 fs-9">Requirements</h5>
                                        </div>
                                        <p class="mb-0 text-body-secondary info-value">@Model.Requirement</p>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Model.Comments))
                                {
                                    <div class="info-row info-row-last">
                                        <div class="d-flex align-items-center mb-1">
                                            <span class="me-2 fa-solid fa-comment info-icon"></span>
                                            <h5 class="text-body-highlight mb-0 fs-9">Comments</h5>
                                        </div>
                                        <p class="mb-0 text-body-secondary info-value">@Model.Comments</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Follow-up Date Card -->
                    @if (Model.FollowUpDate.HasValue)
                    {
                        var daysRemaining = (Model.FollowUpDate.Value.Date - CRM.Helpers.IndianTime.Today).Days;
                        var statusClass = Model.Status switch
                        {
                            "Active" => "success",
                            "Hot" => "danger",
                            "Warm" => "warning",
                            "Cold" => "info",
                            _ => "primary"
                        };

                        <div class="card mb-3 followup-card">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="me-2 fa-solid fa-calendar-check fs-5" style="color: var(--brand-accent-dark);"></span>
                                    <h5 class="mb-0" style="color: var(--brand-primary-dark); font-weight: 700;">Next Follow-up</h5>
                                </div>
                                <p class="mb-1 fw-semibold fs-7">@Model.FollowUpDate.Value.ToString("MMMM dd, yyyy")</p>
                                <p class="mb-2 text-body-tertiary fs-9">
                                    @if (daysRemaining == 0)
                                    {
                                        <span class="text-danger fw-bold">Today</span>
                                    }
                                    else if (daysRemaining == 1)
                                    {
                                        <span class="text-warning fw-bold">Tomorrow</span>
                                    }
                                    else if (daysRemaining < 0)
                                    {
                                        <span class="text-danger fw-bold">@Math.Abs(daysRemaining) days overdue</span>
                                    }
                                    else
                                    {
                                        <span>@daysRemaining days remaining</span>
                                    }
                                </p>
                                @if (!string.IsNullOrEmpty(Model.Stage))
                                {
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-primary fs-10">@Model.Stage</span>
                                        @if (!string.IsNullOrEmpty(Model.Status))
                                        {
                                            <span class="badge bg-@statusClass fs-10">@Model.Status</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Content Area - Activity Tabs -->
            <div class="col-12 col-md" style="min-width:0;">
                <div class="lead-details-container">
                    <!-- Tab Navigation -->
                    <nav class="pb-0 px-0 bg-white nav-underline-scrollspy" id="navbar-lead-detail">
                        <ul class="nav nav-underline fs-9 flex-nowrap scrollbar">
                            <li class="nav-item">
                                <a class="nav-link active me-2" href="#scrollspyHistory"
                                   onclick="loadHistory(@Model.LeadId)">
                                    <span class="fa-solid fa-clock-rotate-left me-1"></span>Activities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link me-2" href="#scrollspyFollowups"
                                   onclick="loadFollowups(@Model.LeadId)">
                                    <span class="fa-solid fa-calendar-days me-1"></span>Follow-ups
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link me-2" href="#scrollspyNotes"
                                   onclick="loadNotes(@Model.LeadId)">
                                    <span class="fa-solid fa-note-sticky me-1"></span>Notes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link me-2" href="#scrollspyUploads"
                                   onclick="loadUploads(@Model.LeadId)">
                                    <span class="fa-solid fa-file-arrow-up me-1"></span>Uploads
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#scrollspySiteVisits"
                                   onclick="loadSiteVisits(@Model.LeadId)">
                                    <span class="fa-solid fa-building-circle-check me-1"></span>Site Visit Activities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#scrollspyDocuments" onclick="loadDocuments(@Model.LeadId)">
                                    <span class="fa-solid fa-file-invoice me-1"></span>Documents &amp; Transactions
                                </a>
                            </li>
