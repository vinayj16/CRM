@model List<CRM.Models.TestimonialModel>
@{
    ViewData["Title"] = "Testimonials";
}

<div class="container-fluid">
    <div class="page-hd"><i class="fa-solid fa-quote-left"></i><h4>Testimonials</h4></div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Manage Testimonials</h5>
                    <button class="btn btn-primary" onclick="openModal()">
                        <i class="fa-solid fa-plus me-2"></i>Add Testimonial
                    </button>
                </div>
                <div class="card-body">
                    @if (Model?.Any() == true)
                    {
                        <div class="row">
                            @foreach (var t in Model)
                            {
                                <div class="col-12 col-sm-6 col-lg-4 mb-3">
                                    <div class="card h-100 testimonial-card">
                                        <div class="card-body text-center">
                                            @if (!string.IsNullOrEmpty(t.ImageBase64))
                                            {
                                                <img src="@t.ImageBase64" class="rounded-circle mb-3" width="80" height="80" style="object-fit: cover;" alt="@t.Name" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px;font-size:2rem;">
                                                    @t.Name.Substring(0, 1).ToUpper()
                                                </div>
                                            }
                                            <p class="mb-2 small testimonial-content" title="@t.Content">"@(t.Content.Length > 150 ? t.Content.Substring(0, 150) + "..." : t.Content)"</p>
                                            <h6 class="fw-bold mb-0">@t.Name</h6>
                                            <small class="text-muted">@t.Tag</small>
                                            <div class="mt-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fa fa-star @(i <= t.Rating ? "text-warning" : "text-muted")"></i>
                                                }
                                            </div>
                                            <div class="mt-2">
                                                @if (t.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </div>
                                            <div class="d-flex justify-content-center gap-2 mt-3">
                                                <button class="btn btn-primary btn-sm" onclick="editTestimonial(@t.TestimonialId)">
                                                    <i class="fa-solid fa-edit me-1"></i>Edit
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm" onclick="deleteTestimonial(@t.TestimonialId)">
                                                    <i class="fa-solid fa-trash me-1"></i>Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa-solid fa-quote-left fa-3x text-muted mb-3"></i>
                            <h5>No Testimonials Yet</h5>
                            <p class="text-muted">Add testimonials to display on your landing page</p>
                            <button class="btn btn-primary" onclick="openModal()">
                                <i class="fa-solid fa-plus me-2"></i>Add Testimonial
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Testimonial Modal -->
<div class="modal fade" id="testimonialModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="width: 50%; max-width: 50%;">
        <div class="modal-content" style="max-height: 90vh; overflow-y: auto;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Testimonial</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="testimonialForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="testimonialId" name="TestimonialId" value="0">

                    <div class="mb-3">
                        <label class="form-label">Photo <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" name="Image" id="imageInput" accept="image/*">
                        <div id="imagePreview" class="mt-2"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Name" id="nameInput" required maxlength="100">
                        <div class="invalid-feedback">Name is required</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tag / Designation <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Tag" id="tagInput" required maxlength="100" placeholder="e.g. Property Owner, Investor">
                        <div class="invalid-feedback">Tag is required</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Content <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="Content" id="contentInput" rows="3" required maxlength="500"></textarea>
                        <div class="invalid-feedback">Content is required</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Rating <span class="text-danger">*</span></label>
                        <div id="ratingStars" class="d-flex gap-2" style="font-size: 1.5rem; cursor: pointer;">
                            <i class="fa fa-star text-muted" data-value="1"></i>
                            <i class="fa fa-star text-muted" data-value="2"></i>
                            <i class="fa fa-star text-muted" data-value="3"></i>
                            <i class="fa fa-star text-muted" data-value="4"></i>
                            <i class="fa fa-star text-muted" data-value="5"></i>
                        </div>
                        <input type="hidden" name="Rating" id="ratingInput" value="0" required>
                        <div class="text-danger small" id="ratingError" style="display:none;">Rating is required</div>
                    </div>

                    <div class="form-check">
                        <input type="hidden" name="IsActive" value="false">
                        <input class="form-check-input" type="checkbox" name="IsActive" id="isActiveInput" value="true" checked>
                        <label class="form-check-label" for="isActiveInput">Show on landing page</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Testimonial</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let selectedRating = 0;

document.querySelectorAll('#ratingStars i').forEach(star => {
    star.addEventListener('click', function () {
        selectedRating = parseInt(this.dataset.value);
        document.getElementById('ratingInput').value = selectedRating;
        document.getElementById('ratingError').style.display = 'none';
        updateStars(selectedRating);
    });
});

function updateStars(rating) {
    document.querySelectorAll('#ratingStars i').forEach(s => {
        s.classList.toggle('text-warning', parseInt(s.dataset.value) <= rating);
        s.classList.toggle('text-muted', parseInt(s.dataset.value) > rating);
    });
}

document.getElementById('imageInput').addEventListener('change', function () {
    const file = this.files[0];
    const preview = document.getElementById('imagePreview');
    if (file) {
        const reader = new FileReader();
        reader.onload = e => preview.innerHTML = `<img src="${e.target.result}" class="rounded-circle" width="80" height="80" style="object-fit:cover;">`;
        reader.readAsDataURL(file);
    } else {
        preview.innerHTML = '';
    }
});

function openModal() {
    document.getElementById('modalTitle').textContent = 'Add Testimonial';
    document.getElementById('testimonialForm').reset();
    document.getElementById('testimonialId').value = '0';
    document.getElementById('imagePreview').innerHTML = '';
    document.getElementById('testimonialForm').classList.remove('was-validated');
    document.getElementById('ratingError').style.display = 'none';
    document.getElementById('isActiveInput').checked = true;
    selectedRating = 0;
    updateStars(0);
    new bootstrap.Modal(document.getElementById('testimonialModal')).show();
}

function editTestimonial(id) {
    fetch('/Settings/GetTestimonial?id=' + id)
        .then(r => r.json())
        .then(res => {
            if (!res.success) return Swal.fire('Not Found', 'Testimonial not found', 'warning');
            var d = res.data;
            document.getElementById('modalTitle').textContent = 'Edit Testimonial';
            document.getElementById('testimonialId').value = d.testimonialId;
            document.getElementById('nameInput').value = d.name;
            document.getElementById('tagInput').value = d.tag;
            document.getElementById('contentInput').value = d.content;
            document.getElementById('isActiveInput').checked = d.isActive;
            selectedRating = d.rating;
            document.getElementById('ratingInput').value = d.rating;
            updateStars(d.rating);
            var preview = document.getElementById('imagePreview');
            preview.innerHTML = d.imageBase64 ? `<img src="${d.imageBase64}" class="rounded-circle" width="80" height="80" style="object-fit:cover;">` : '';
            document.getElementById('testimonialForm').classList.remove('was-validated');
            new bootstrap.Modal(document.getElementById('testimonialModal')).show();
        });
}

function deleteTestimonial(id) {
    Swal.fire({
        title: 'Delete Testimonial?',
        text: 'Are you sure you want to delete this testimonial?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#DC2626',
        confirmButtonText: 'Yes, delete!'
    }).then((result) => {
        if (!result.isConfirmed) return;
        fetch('/Settings/DeleteTestimonial', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) { Swal.fire('Deleted!', 'Deleted successfully!', 'success').then(() => location.reload()); }
            else Swal.fire('Error', 'Error: ' + data.message, 'error');
        });
    });
}

document.getElementById('testimonialForm').addEventListener('submit', function (e) {
    e.preventDefault();
    if (!this.checkValidity()) { this.classList.add('was-validated'); return; }
    if (selectedRating === 0 && document.getElementById('testimonialId').value === '0') {
        document.getElementById('ratingError').style.display = 'block';
        return;
    }
    var formData = new FormData(this);
    formData.set('IsActive', document.getElementById('isActiveInput').checked ? 'true' : 'false');
    fetch('/Settings/SaveTestimonial', { method: 'POST', body: formData })
        .then(r => r.json())
        .then(data => {
            if (data.success) { Swal.fire('Saved!', 'Saved successfully!', 'success').then(() => location.reload()); }
            else Swal.fire('Error', 'Error: ' + data.message, 'error');
        });
});
</script>

<style>
.testimonial-card { transition: transform 0.2s; border: 1px solid #E2E8F0; min-height: 340px; display: flex; flex-direction: column; }
.testimonial-card .card-body { display: flex; flex-direction: column; align-items: center; }
.testimonial-card .testimonial-content { flex: 1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; }
.testimonial-card:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
.dark-mode .testimonial-card { background: #1E2A3A !important; border-color: #2A3A4A !important; }

#ratingStars i.text-muted { color: #6B7B8D !important; }
.dark-mode #ratingStars i.text-muted { color: #8FA3B8 !important; }
.dark-mode #ratingStars i.text-warning, .dark-mode #ratingStars i[style*="color"] { color: #F59E0B !important; }
.dark-mode .testimonial-card .fa-star.text-warning { color: #F59E0B !important; }
.dark-mode .fa-star.text-warning { color: #F59E0B !important; }
.dark-mode #testimonialModal .modal-content { background: #1E2A3A !important; color: #E2E8F0 !important; }
.dark-mode #testimonialModal .modal-header { border-color: #2A3A4A !important; }
.dark-mode #testimonialModal .modal-footer { border-color: #2A3A4A !important; }
.dark-mode #testimonialModal .form-control, .dark-mode #testimonialModal .form-select { background: #2A3A4A !important; color: #E2E8F0 !important; border-color: #2A3A4A !important; }
.dark-mode #testimonialModal .form-label { color: #E2E8F0 !important; }
.dark-mode #testimonialModal .form-check-label { color: #E2E8F0 !important; }
.invalid-feedback { display: none; }
.was-validated .form-control:invalid ~ .invalid-feedback { display: block; }

@@media (min-width: 992px) {
    #testimonialModal .modal-dialog { width: 50% !important; max-width: 50% !important; }
}
@@media (max-width: 991px) {
    #testimonialModal .modal-dialog { width: 95% !important; max-width: 95% !important; margin: 0.5rem !important; }
    #testimonialModal .modal-body { padding: 1rem !important; }
    #testimonialModal .modal-footer { flex-wrap: nowrap; }
    #testimonialModal .modal-footer .btn { flex: 1; }
}
</style>
