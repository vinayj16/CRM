            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var FLATPICKR_JS  = 'https://cdn.jsdelivr.net/npm/flatpickr';
    var FLATPICKR_CSS = 'https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css';

    // Loads flatpickr if it isn't already present on the page. This matters
    // if this view ever gets injected into a tab/container after the main
    // page has already loaded (e.g. via an AJAX content swap) — in that
    // situation a plain <script src="..."> tag in the markup does not get
    // executed by the browser, so window.flatpickr would be undefined and
    // clicking the date field would silently do nothing.
    function loadFlatpickrThen(callback) {
        if (window.flatpickr) { callback(); return; }

        if (!document.querySelector('link[href="' + FLATPICKR_CSS + '"]')) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = FLATPICKR_CSS;
            document.head.appendChild(link);
        }

        var script = document.createElement('script');
        script.src = FLATPICKR_JS;
        script.onload = callback;
        script.onerror = function () {
            console.error('Could not load flatpickr from CDN — check network/CSP settings.');
        };
        document.head.appendChild(script);
    }

    function autoSubmitForm() {
        var form = document.querySelector('form');
        if (form) form.submit();
    }
    window.autoSubmitForm = autoSubmitForm; // used by onchange="autoSubmitForm()" on the plan/billing selects

    function parseYmd(ymd) {
        if (!ymd) return null;
        var p = ymd.split('-');
        if (p.length !== 3) return null;
        return new Date(parseInt(p[0]), parseInt(p[1]) - 1, parseInt(p[2]));
    }

    function setupSearchDebounce() {
        var searchInput = document.getElementById('searchInput');
        if (!searchInput || searchInput.dataset.debounceBound) return;
        searchInput.dataset.debounceBound = '1';
        var searchTimeout;
        searchInput.addEventListener('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(autoSubmitForm, 500);
        });
    }

    function setupDatePickers() {
        var fromInput  = document.getElementById('fromDateInput');
        var toInput    = document.getElementById('toDateInput');
        var fromHidden = document.getElementById('fromDateHidden');
        var toHidden   = document.getElementById('toDateHidden');
        if (!fromInput || !toInput || !fromHidden || !toHidden) return;

        // Destroy any earlier instance so re-running this script (e.g. if the
        // view is reloaded into its container more than once) never stacks
        // duplicate calendars on the same input.
        if (fromInput._flatpickr) fromInput._flatpickr.destroy();
        if (toInput._flatpickr) toInput._flatpickr.destroy();

        flatpickr(fromInput, {
            dateFormat: 'd-m-Y',        // display: 28-05-2026
            allowInput: false,
            disableMobile: true,
            static: true,                // keeps calendar anchored correctly inside the filter row
            defaultDate: parseYmd(fromHidden.value),
            onChange: function (selectedDates) {
                if (selectedDates.length > 0) {
                    var d = selectedDates[0];
                    fromHidden.value =
                        d.getFullYear() + '-' +
                        String(d.getMonth() + 1).padStart(2, '0') + '-' +
                        String(d.getDate()).padStart(2, '0');
                } else {
                    fromHidden.value = '';
                }
                // Small delay so the picked date is visibly painted into the
                // input box before the page navigates away on submit.
                setTimeout(autoSubmitForm, 250);
            }
        });

        flatpickr(toInput, {
            dateFormat: 'd-m-Y',
            allowInput: false,
            disableMobile: true,
            static: true,
            defaultDate: parseYmd(toHidden.value),
            onChange: function (selectedDates) {
                if (selectedDates.length > 0) {
                    var d = selectedDates[0];
                    toHidden.value =
                        d.getFullYear() + '-' +
                        String(d.getMonth() + 1).padStart(2, '0') + '-' +
                        String(d.getDate()).padStart(2, '0');
                } else {
                    toHidden.value = '';
                }
                setTimeout(autoSubmitForm, 250);
            }
        });
    }

    function init() {
        setupSearchDebounce();
        loadFlatpickrThen(setupDatePickers);
    }

    // Don't rely solely on DOMContentLoaded — if this script executes after
    // the page has already finished loading (readyState is no longer
    // "loading"), DOMContentLoaded will never fire again, so run immediately.
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();

// Function to open upgrade modal
function openUpgradeModal(partnerId) {
    console.log('Opening upgrade modal for partner:', partnerId);
    resetUpgradeModal();
    fetch('/Subscription/GetUpgradeOptions?partnerId=' + partnerId)
        .then(response => response.json())
        .then(data => {
            console.log('API Response:', data);
            if (data.success) {
                currentPartnerData = data;
                populatePartnerInfo(data.partner);
                populateCurrentSubscription(data.currentSubscription);
                populateAvailablePlans(data.availablePlans);
                new bootstrap.Modal(document.getElementById('upgradeModal')).show();
            } else {
                console.log('Error:', data.message);
                showToast('Error: ' + data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error loading upgrade options:', error);
            showToast('Failed to load upgrade options', 'error');
        });
}
</script>
