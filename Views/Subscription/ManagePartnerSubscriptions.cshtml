                                                    @if (plan.HasEmailIntegration)   { <div class="feature-item"><i class="fa-solid fa-envelope"></i><span>Email</span></div> }
                                                    @if (plan.HasCustomAPIAccess)    { <div class="feature-item"><i class="fa-solid fa-code"></i><span>Custom API</span></div> }
                                                </div>
                                            }
                                            @if (hasReportsSupport)
                                            {
                                                <div class="feature-group mb-2">
                                                    <h6>Reports & Support</h6>
                                                    @if (plan.HasAdvancedReports) { <div class="feature-item"><i class="fa-solid fa-chart-bar"></i><span>Advanced Reports</span></div> }
                                                    @if (plan.HasCustomReports)   { <div class="feature-item"><i class="fa-solid fa-file-chart"></i><span>Custom Reports</span></div> }
                                                    @if (plan.HasDataExport)      { <div class="feature-item"><i class="fa-solid fa-download"></i><span>Data Export</span></div> }
                                                    @if (plan.HasPrioritySupport) { <div class="feature-item"><i class="fa-solid fa-headset"></i><span>@plan.SupportLevel Support</span></div> }
