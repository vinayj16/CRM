    <script src="~/js/subscription-alerts.js"></script>
<script>
/* ============================================================
   VALIDATION HELPERS
   ============================================================ */
function setFieldState(inputEl, iconEl, msgEl, state, message) {
    // state: 'valid' | 'invalid' | 'reset'
    inputEl.classList.remove('field-valid', 'field-invalid');
    iconEl.classList.remove('show-icon', 'icon-valid', 'icon-invalid');
    msgEl.className = 'field-msg';
    msgEl.innerHTML = '';

    if (state === 'valid') {
        inputEl.classList.add('field-valid');
        iconEl.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
        iconEl.classList.add('show-icon', 'icon-valid');
        if (message) {
            msgEl.classList.add('msg-valid');
            msgEl.innerHTML = '<i class="fa-solid fa-check"></i> ' + message;
        }
    } else if (state === 'invalid') {
        inputEl.classList.add('field-invalid');
        iconEl.innerHTML = '<i class="fa-solid fa-circle-xmark"></i>';
        iconEl.classList.add('show-icon', 'icon-invalid');
        if (message) {
            msgEl.classList.add('msg-invalid');
            msgEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ' + message;
        }
    }
}

function validateName(val) {
    if (!val.trim()) return { ok: false, msg: 'Name is required' };
    if (val.trim().length < 2) return { ok: false, msg: 'At least 2 characters' };
    if (val.trim().length > 50) return { ok: false, msg: 'Max 50 characters' };
    if (!/^[a-zA-Z\s'.]+$/.test(val.trim())) return { ok: false, msg: 'Letters only' };
    return { ok: true, msg: 'Looks good!' };
}

function validateEmail(val) {
    if (!val.trim()) return { ok: false, msg: 'Email is required' };
    var re = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;
    if (!re.test(val.trim())) return { ok: false, msg: 'Enter a valid email address' };
    return { ok: true, msg: 'Valid email' };
}

function validateRole(val) {
    if (!val) return { ok: false, msg: 'Please select a role' };
    return { ok: true, msg: 'Role selected' };
}

function validatePhone(val) {
    if (!val.trim()) return { ok: true, msg: '' }; // optional
    if (!/^[0-9]{10}$/.test(val.trim())) return { ok: false, msg: 'Enter exactly 10 digits' };
    return { ok: true, msg: 'Valid number' };
}

function validatePassword(val) {
    if (!val) return { ok: false, msg: 'Password is required' };
    if (val.length < 6) return { ok: false, msg: 'Minimum 6 characters' };
    return { ok: true, msg: 'Strong enough' };
}

function getPasswordStrength(val) {
    if (!val) return { width: 0, color: '#E2E8F0', label: '' };
    var score = 0;
    if (val.length >= 6) score++;
    if (val.length >= 10) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^a-zA-Z0-9]/.test(val)) score++;

    if (score <= 1) return { width: 20, color: '#DC2626', label: 'Weak', labelClass: 'msg-invalid' };
    if (score === 2) return { width: 40, color: '#F59E0B', label: 'Fair', labelClass: '' };
    if (score === 3) return { width: 65, color: '#F59E0B', label: 'Good', labelClass: '' };
    if (score === 4) return { width: 85, color: '#16A34A', label: 'Strong', labelClass: 'msg-valid' };
    return { width: 100, color: '#16A34A', label: 'Very Strong', labelClass: 'msg-valid' };
}

/* ============================================================
   WIRE UP VALIDATION — generic factory
   ============================================================ */
function wireValidation(prefix, hasPassword) {
    var nameIn    = document.getElementById(prefix + 'Username');
    var nameIcon  = document.getElementById(prefix + 'UsernameIcon');
    var nameMsg   = document.getElementById(prefix + 'UsernameMsg');

    var emailIn   = document.getElementById(prefix + 'Email');
    var emailIcon = document.getElementById(prefix + 'EmailIcon');
    var emailMsg  = document.getElementById(prefix + 'EmailMsg');

    var roleIn    = document.getElementById(prefix + 'Role');
    var roleIcon  = document.getElementById(prefix + 'RoleIcon');
    var roleMsg   = document.getElementById(prefix + 'RoleMsg');

    var phoneIn   = document.getElementById(prefix + 'Phone');
    var phoneIcon = document.getElementById(prefix + 'PhoneIcon');
    var phoneMsg  = document.getElementById(prefix + 'PhoneMsg');

    // Bind name
    if (nameIn) {
        nameIn.addEventListener('input', function() {
            var r = validateName(this.value);
            setFieldState(nameIn, nameIcon, nameMsg, r.ok ? 'valid' : 'invalid', r.msg);
        });
        nameIn.addEventListener('blur', function() {
            var r = validateName(this.value);
            setFieldState(nameIn, nameIcon, nameMsg, r.ok ? 'valid' : 'invalid', r.msg);
        });
    }

    // Bind email
    if (emailIn) {
        emailIn.addEventListener('input', function() {
            var r = validateEmail(this.value);
            setFieldState(emailIn, emailIcon, emailMsg, r.ok ? 'valid' : 'invalid', r.msg);
        });
        emailIn.addEventListener('blur', function() {
            var r = validateEmail(this.value);
            setFieldState(emailIn, emailIcon, emailMsg, r.ok ? 'valid' : 'invalid', r.msg);
        });
    }

    // Bind role
    if (roleIn) {
        roleIn.addEventListener('change', function() {
            var r = validateRole(this.value);
            setFieldState(roleIn, roleIcon, roleMsg, r.ok ? 'valid' : 'invalid', r.msg);
        });
    }

    // Bind phone — digits only
    if (phoneIn) {
        phoneIn.addEventListener('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
            if (this.value.length > 0) {
                var r = validatePhone(this.value);
                setFieldState(phoneIn, phoneIcon, phoneMsg, r.ok ? 'valid' : 'invalid', r.msg);
            } else {
                setFieldState(phoneIn, phoneIcon, phoneMsg, 'reset', '');
            }
        });
        phoneIn.addEventListener('blur', function() {
            if (this.value.length > 0) {
                var r = validatePhone(this.value);
                setFieldState(phoneIn, phoneIcon, phoneMsg, r.ok ? 'valid' : 'invalid', r.msg);
            }
        });
    }

    // Bind password (add form only)
    if (hasPassword) {
        var pwdIn       = document.getElementById(prefix + 'Password');
        var pwdMsg      = document.getElementById(prefix + 'PasswordMsg');
        var pwdFill     = document.getElementById(prefix + 'PwdFill');
        var pwdStrText  = document.getElementById(prefix + 'PwdStrengthText');
        var toggleBtn   = document.getElementById('toggle' + prefix.charAt(0).toUpperCase() + prefix.slice(1) + 'Password');
        var eyeIcon     = document.getElementById(prefix + 'PasswordIcon2');

        if (pwdIn) {
            pwdIn.addEventListener('input', function() {
                var val = this.value;
                var r = validatePassword(val);
                var s = getPasswordStrength(val);

                // Strength bar
                if (pwdFill) {
                    pwdFill.style.width = s.width + '%';
                    pwdFill.style.background = s.color;
                }
                if (pwdStrText) {
                    pwdStrText.className = 'field-msg pwd-strength-text ' + (s.labelClass || '');
                    pwdStrText.textContent = s.label ? 'Strength: ' + s.label : '';
                    pwdStrText.style.color = s.color;
                }
                if (pwdMsg) {
                    if (!r.ok) {
                        pwdMsg.className = 'field-msg msg-invalid';
                        pwdMsg.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ' + r.msg;
                    } else {
                        pwdMsg.className = 'field-msg';
                        pwdMsg.innerHTML = '';
                    }
                }
                // Border color on input itself
                pwdIn.classList.remove('field-valid', 'field-invalid');
                if (val.length > 0) {
                    pwdIn.classList.add(r.ok ? 'field-valid' : 'field-invalid');
                }
            });
        }

        // Password toggle
        if (toggleBtn && pwdIn) {
            toggleBtn.addEventListener('click', function() {
                if (pwdIn.type === 'password') {
                    pwdIn.type = 'text';
                    if (eyeIcon) { eyeIcon.classList.remove('fa-eye-slash'); eyeIcon.classList.add('fa-eye'); }
                } else {
                    pwdIn.type = 'password';
                    if (eyeIcon) { eyeIcon.classList.remove('fa-eye'); eyeIcon.classList.add('fa-eye-slash'); }
                }
            });
        }
    }
}

/* ============================================================
   VALIDATE ENTIRE FORM before submit — returns true/false
   ============================================================ */
function validateForm(prefix, hasPassword) {
    var valid = true;

    var nameIn    = document.getElementById(prefix + 'Username');
    var nameIcon  = document.getElementById(prefix + 'UsernameIcon');
    var nameMsg   = document.getElementById(prefix + 'UsernameMsg');
    var emailIn   = document.getElementById(prefix + 'Email');
    var emailIcon = document.getElementById(prefix + 'EmailIcon');
    var emailMsg  = document.getElementById(prefix + 'EmailMsg');
    var roleIn    = document.getElementById(prefix + 'Role');
    var roleIcon  = document.getElementById(prefix + 'RoleIcon');
    var roleMsg   = document.getElementById(prefix + 'RoleMsg');
    var phoneIn   = document.getElementById(prefix + 'Phone');
    var phoneIcon = document.getElementById(prefix + 'PhoneIcon');
    var phoneMsg  = document.getElementById(prefix + 'PhoneMsg');

    if (nameIn) { var r = validateName(nameIn.value); setFieldState(nameIn, nameIcon, nameMsg, r.ok ? 'valid' : 'invalid', r.msg); if (!r.ok) valid = false; }
    if (emailIn) { var r = validateEmail(emailIn.value); setFieldState(emailIn, emailIcon, emailMsg, r.ok ? 'valid' : 'invalid', r.msg); if (!r.ok) valid = false; }
    if (roleIn) { var r = validateRole(roleIn.value); setFieldState(roleIn, roleIcon, roleMsg, r.ok ? 'valid' : 'invalid', r.msg); if (!r.ok) valid = false; }
    if (phoneIn && phoneIn.value.length > 0) { var r = validatePhone(phoneIn.value); setFieldState(phoneIn, phoneIcon, phoneMsg, r.ok ? 'valid' : 'invalid', r.msg); if (!r.ok) valid = false; }

    if (hasPassword) {
        var pwdIn  = document.getElementById(prefix + 'Password');
        var pwdMsg = document.getElementById(prefix + 'PasswordMsg');
        if (pwdIn) {
            var r = validatePassword(pwdIn.value);
            if (!r.ok) {
                pwdIn.classList.remove('field-valid'); pwdIn.classList.add('field-invalid');
                if (pwdMsg) { pwdMsg.className = 'field-msg msg-invalid'; pwdMsg.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ' + r.msg; }
                valid = false;
            }
        }
    }
    return valid;
}

/* ============================================================
   RESET MODAL STATE
   ============================================================ */
function resetModalFields(prefix, hasPassword) {
    var fields = [prefix + 'Username', prefix + 'Email', prefix + 'Role', prefix + 'Phone'];
    if (hasPassword) fields.push(prefix + 'Password');
    fields.forEach(function(id) {
        var el = document.getElementById(id);
        if (el) { el.classList.remove('field-valid', 'field-invalid'); if (el.tagName === 'INPUT') el.value = ''; else if (el.tagName === 'SELECT') el.value = ''; }
    });
    var icons = [prefix + 'UsernameIcon', prefix + 'EmailIcon', prefix + 'RoleIcon', prefix + 'PhoneIcon'];
    icons.forEach(function(id) { var el = document.getElementById(id); if (el) { el.className = 'field-icon'; el.innerHTML = ''; } });
    var msgs = [prefix + 'UsernameMsg', prefix + 'EmailMsg', prefix + 'RoleMsg', prefix + 'PhoneMsg', prefix + 'PasswordMsg'];
    msgs.forEach(function(id) { var el = document.getElementById(id); if (el) { el.className = 'field-msg'; el.innerHTML = ''; } });

    if (hasPassword) {
        var fill = document.getElementById(prefix + 'PwdFill');
        var txt  = document.getElementById(prefix + 'PwdStrengthText');
        if (fill) { fill.style.width = '0%'; }
        if (txt)  { txt.textContent = ''; }
        var pwdIn = document.getElementById(prefix + 'Password');
        if (pwdIn) { pwdIn.type = 'password'; }
        var eyeIcon = document.getElementById(prefix + 'PasswordIcon2');
        if (eyeIcon) { eyeIcon.className = 'fa-solid fa-eye-slash'; }
    }
}

/* ============================================================
   MAIN DOCUMENT READY
   ============================================================ */
$(document).ready(function () {

    // Wire live validation
    wireValidation('add', true);
    wireValidation('edit', false);

    // Reset add modal on close
    $('#addUserModal').on('hidden.bs.modal', function() {
        resetModalFields('add', true);
        document.getElementById('addActive').checked = true;
    });

    // Reset edit modal on close
    $('#editUserModal').on('hidden.bs.modal', function() {
        resetModalFields('edit', false);
    });

    // Handle dropdown z-index
    $('.user-card .dropdown').on('show.bs.dropdown', function () {
        $('.user-card').css('z-index', '1');
        $(this).closest('.user-card').css('z-index', '9999');
    });
    $('.user-card .dropdown').on('hide.bs.dropdown', function () {
        $(this).closest('.user-card').css('z-index', '1');
    });

    // Search and filter functionality
    function applyFilters() {
        var search = $('#searchBox').val().toLowerCase();
        var role = $('#filterRole').val();
        var status = $('#filterStatus').val();

        filteredUsers = [];
        $('.user-card').each(function () {
            var card = $(this);
            var text = card.text().toLowerCase();
            var cardRole = card.data('role');
            var cardStatus = card.data('status');

            var matchSearch = !search || text.includes(search);
            var matchRole = !role || cardRole === role;
            var matchStatus = !status || cardStatus === status;

            if (matchSearch && matchRole && matchStatus) {
                filteredUsers.push(card[0]);
            }
        });
        currentPage = 1;
        updatePagination();
    }

    $('#searchBox, #filterRole, #filterStatus').on('input change', applyFilters);

    $('#clearFilters').on('click', function () {
        $('#searchBox').val('');
        $('#filterRole').val('');
        $('#filterStatus').val('');
        applyFilters();
    });

    // Edit user button — load data then show modal
    $('.edit-user-btn').on('click', function () {
        var userId = $(this).data('user-id');
        resetModalFields('edit', false);
        $.getJSON('/ManageUsers/GetUser/' + userId, function (user) {
            $('#editUserId').val(user.userId);
            $('#editUsername').val(user.username);
            $('#editEmail').val(user.email);
            $('#editRole').val(user.role);
            $('#editPhone').val(user.phone);
            if (user.isActive) {
                $('#editActive').prop('checked', true);
            } else {
                $('#editInactive').prop('checked', true);
            }
            $('#editUserModal').modal('show');
        });
    });

    // Delete user button
    $('.delete-user-btn').on('click', function () {
        var userId = $(this).data('user-id');
        if (confirm('Are you sure you want to delete this user?')) {
            $.post('/ManageUsers/DeleteUser/' + userId, function () {
                location.reload();
            });
        }
    });

        // Impersonate user button
        $('.impersonate-user-btn').on('click', function () {
        var userId = $(this).data('user-id');
        var username = $(this).data('username');
        Swal.fire({
        title: 'Confirm Impersonation',
        text: 'You are about to impersonate ' + username + '. You will be logged in as this user.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, Impersonate',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#F59E0B'
        }).then((result) => {
        if (result.isConfirmed) {
        $.post('/Account/StartImpersonation', { userId: userId })
        .done(function (response) {
        if (response.success) {
        Swal.fire({
        title: 'Impersonation Started',
        text: response.message,
        icon: 'success',
        timer: 1500,
        showConfirmButton: false
        }).then(() => {
        window.location.href = '/home';
        });
        } else {
        Swal.fire('Error', response.message || 'Failed to start impersonation', 'error');
        }
        })
        .fail(function () {
        Swal.fire('Error', 'Failed to start impersonation', 'error');
        });
        }
        });
        });


    // ADD form submit with validation
    $('#addUserForm').on('submit', function (e) {
        e.preventDefault();
        if (!validateForm('add', true)) return;

        var submitBtn = document.getElementById('addSubmitBtn');
        submitBtn.classList.add('btn-loading');
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating…';

        var formData = new FormData(this);
        $.ajax({
            url: $(this).attr('action'),
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function(response) {
                submitBtn.classList.remove('btn-loading');
                submitBtn.innerHTML = '<i class="fa-solid fa-user-plus"></i> Create User';
                if (response.success) {
                    location.reload();
                } else if (response.agentLimitReached) {
                    SubscriptionAlerts.showAgentLimitAlert(response.message, response.availablePlans);
                } else if (response.storageLimitReached) {
                    SubscriptionAlerts.showStorageLimitAlert(response.message, response.currentUsageGB, response.limitGB, response.availablePlans);
                } else {
                    Swal.fire('Error', response.message || 'Error occurred', 'error');
                }
            },
            error: function() {
                submitBtn.classList.remove('btn-loading');
                submitBtn.innerHTML = '<i class="fa-solid fa-user-plus"></i> Create User';
                Swal.fire('Error', 'Error occurred while adding user', 'error');
            }
        });
    });

    // EDIT form submit with validation
    $('#editUserForm').on('submit', function (e) {
        e.preventDefault();
        if (!validateForm('edit', false)) return;

        var submitBtn = document.getElementById('editSubmitBtn');
        submitBtn.classList.add('btn-loading');
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving…';

        $.post($(this).attr('action'), $(this).serialize(), function () {
            location.reload();
        }).fail(function() {
            submitBtn.classList.remove('btn-loading');
            submitBtn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Changes';
            Swal.fire('Error', 'Error saving changes', 'error');
        });
    });

    // Load SweetAlert2 if not already loaded
    if (typeof Swal === 'undefined') {
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
        document.head.appendChild(script);
    }

    // ── PAGINATION ──────────────────────────────────────────
    let currentPage = 1;
    let pageSize = 10;
    let filteredUsers = [];

    function initializePagination() {
        const userCards = document.querySelectorAll('.user-card');
        filteredUsers = Array.from(userCards);
        if (filteredUsers.length > 0) {
            document.getElementById('paginationContainer').style.display = 'flex';
            updatePagination();
        }
    }

    function updatePagination() {
        const totalPages = Math.ceil(filteredUsers.length / pageSize);
        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = Math.min(startIndex + pageSize, filteredUsers.length);

        document.querySelectorAll('.user-card').forEach(card => { card.style.display = 'none'; });
        for (let i = startIndex; i < endIndex; i++) {
            if (filteredUsers[i]) filteredUsers[i].style.display = 'block';
        }

        const start = filteredUsers.length > 0 ? startIndex + 1 : 0;
        document.getElementById('paginationInfo').textContent =
            `Showing ${start}-${endIndex} of ${filteredUsers.length} users`;

        updatePageNumbers(totalPages);
        document.getElementById('prevBtn').disabled = currentPage === 1;
        document.getElementById('nextBtn').disabled = currentPage === totalPages || totalPages === 0;
    }

    function updatePageNumbers(totalPages) {
        const pageNumbers = document.getElementById('pageNumbers');
        pageNumbers.innerHTML = '';
        if (totalPages <= 1) return;

        const maxVisiblePages = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
        let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
        if (endPage - startPage + 1 < maxVisiblePages) startPage = Math.max(1, endPage - maxVisiblePages + 1);

        for (let i = startPage; i <= endPage; i++) {
            const btn = document.createElement('button');
            btn.className = `pagination-btn ${i === currentPage ? 'active' : ''}`;
            btn.textContent = i;
            btn.onclick = () => goToPage(i);
            pageNumbers.appendChild(btn);
        }
    }

    window.changePage = function(direction) {
        const totalPages = Math.ceil(filteredUsers.length / pageSize);
        const newPage = currentPage + direction;
        if (newPage >= 1 && newPage <= totalPages) { currentPage = newPage; updatePagination(); }
    };

    function goToPage(page) { currentPage = page; updatePagination(); }

    initializePagination();
});
</script>
}
