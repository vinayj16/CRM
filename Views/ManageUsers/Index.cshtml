@model IEnumerable<CRM.Models.UserModel>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@inject CRM.MasterDb.MasterDbContext _mastercontext


@{
    bool hasImpersonation = false;
    var tIdClaim = Context.User.FindFirst("TenantId")?.Value;
    if (!string.IsNullOrEmpty(tIdClaim) && int.TryParse(tIdClaim, out int tId))
    {
        var sub = _mastercontext.TenantSubscriptions
            .Where(s => s.TenantId == tId && (s.Status == "Active" || s.Status == "Trial"))
            .OrderByDescending(s => s.StartDate)
            .FirstOrDefault();
        if (sub != null)
        {
            var plan = _mastercontext.SaasPlans.FirstOrDefault(p => p.PlanId == sub.PlanId);
            hasImpersonation = plan?.HasImpersonation ?? false;
        }
    }
}

@{
    ViewData["Title"] = "Manage Users";
    var usersList = Model.ToList();
    var totalUsers = usersList.Count;
    var activeUsers = usersList.Count(u => u.IsActive);
    var inactiveUsers = totalUsers - activeUsers;
    
    // Get current user info from JWT token
    var token = HttpContextAccessor.HttpContext?.Request.Cookies["jwtToken"];
    string role = "";
    string username = "";
    
    if (!string.IsNullOrEmpty(token))
    {
        try
        {
            var handler = new JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(token);
            role = jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role || c.Type == "role")?.Value ?? "";
            username = jwt.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name || c.Type == "name")?.Value ?? "";
        }
        catch { role = ""; username = ""; }
    }
}

