@model CRM.Models.RevenueModel
@{
    ViewData["Title"] = "Revenue Details";
}
<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h4>Revenue Details</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">@Model.Type</dd>
                <dt class="col-sm-3">Amount</dt>
                <dd class="col-sm-9">₹@Model.Amount.ToString("N0")</dd>
                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.Date.ToString("MMM dd, yyyy")</dd>
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>
            <a href="/Revenue/Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>



