@model CRM.Models.EmailSettingModel
@{
    ViewData["Title"] = "Email Settings";
}

@section Scripts {
<script>
    // Gate this page behind the "email" feature
    if (window.FeatureGate) {
        FeatureGate.requireFeature('email', 'Email Integration').then(function(hasAccess) {
            if (!hasAccess) {
                // Will be redirected by the modal - disable the page
                document.querySelectorAll('.es-btn, .es-form-control').forEach(function(el) {
                    el.disabled = true;
                });
            }
        });
    }

    function togglePassword() {
        const input = document.getElementById('smtpPassword');
        const icon = document.getElementById('toggleIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    function saveSmtp() {
        // Check feature access before saving
        if (window.FeatureGate) {
            FeatureGate.requireFeature('email', 'Email Integration').then(function(hasAccess) {
                if (hasAccess) doSaveSmtp();
            });
            return;
        }
        doSaveSmtp();
    }

    function doSaveSmtp() {
        const from = document.getElementById('smtpFrom').value;
        const password = document.getElementById('smtpPassword').value;

        if (!from || !password) {
            showToast('Please fill all fields', 'warning');
            return;
        }

        fetch('/EmailSettings/SaveSmtp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `smtpFrom=${encodeURIComponent(from)}&smtpPassword=${encodeURIComponent(password)}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast(data.message, 'success');
                location.reload();
            }
        });
    }
</script>
}

<div class="es-wrap">
    <div class="page-hd"><i class="fa-solid fa-envelope"></i><h4>Email Settings</h4></div>
    <div class="es-card">
        <div class="es-card-header">
            <div class="es-card-title">
                <span class="es-icon-circle"><i class="fas fa-envelope"></i></span>
                <h5 class="mb-0">Email Settings</h5>
            </div>
            <button class="es-btn es-btn-primary" data-bs-toggle="modal" data-bs-target="#smtpModal">
                <i class="fas fa-cog me-1"></i> Configure SMTP
            </button>
        </div>

        <div class="es-card-body">
            @if (Model != null)
            {
                <div class="es-alert es-alert-success">
                    <i class="fas fa-check-circle"></i>
                    <span>SMTP configured for <strong>@Model.SmtpFrom</strong></span>
                </div>

                <div class="es-info-grid">
                    <div class="es-info-row">
                        <span class="es-info-label">SMTP Host</span>
                        <span class="es-info-value">@Model.SmtpHost</span>
                    </div>
                    <div class="es-info-row">
                        <span class="es-info-label">SMTP Port</span>
                        <span class="es-info-value">@Model.SmtpPort</span>
                    </div>
                    <div class="es-info-row">
                        <span class="es-info-label">SSL Enabled</span>
                        <span class="es-info-value">
                            @if (Model.EnableSsl)
                            {
                                <span class="es-badge es-badge-on">Yes</span>
                            }
                            else
                            {
                                <span class="es-badge es-badge-off">No</span>
                            }
                        </span>
                    </div>
                    <div class="es-info-row">
                        <span class="es-info-label">Last Updated</span>
                        <span class="es-info-value">@(Model.UpdatedOn?.ToString("dd MMM yyyy hh:mm tt") ?? Model.CreatedOn.ToString("dd MMM yyyy hh:mm tt"))</span>
                    </div>
                </div>
            }
            else
            {
                <div class="es-alert es-alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>No SMTP settings configured. Click "Configure SMTP" to set up email.</span>
                </div>
            }

            @if (ViewBag.Role == "Admin")
            {
                <div class="es-alert es-alert-info">
                    <i class="fas fa-info-circle"></i>
                    <span><strong>Admin:</strong> Your email settings will apply to all agents without their own configuration.</span>
                </div>
            }
            else if (ViewBag.Role == "Partner")
            {
                <div class="es-alert es-alert-info">
                    <i class="fas fa-info-circle"></i>
                    <span><strong>Partner:</strong> Your email settings will apply to your agents only.</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- SMTP Configuration Modal -->
<div class="modal fade" id="smtpModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content es-modal-content">
            <div class="modal-header es-modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-cog me-2"></i>Configure SMTP Settings
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body es-modal-body">
                <form id="smtpForm">
                    <div class="es-form-group">
                        <label class="es-form-label">From Email <span class="es-required">*</span></label>
                        <input type="email" class="es-form-control" id="smtpFrom" value="@Model?.SmtpFrom" required>
                    </div>
                    <div class="es-form-group">
                        <label class="es-form-label">Password <span class="es-required">*</span></label>
                        <div class="es-password-wrap">
                            <input type="password" class="es-form-control" id="smtpPassword" value="@Model?.SmtpPassword" required style="padding-right: 42px;">
                            <button type="button" class="es-toggle-pass" onclick="togglePassword()">
                                <i class="fas fa-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <small class="es-hint">For Gmail, use App Password</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer es-modal-footer">
                <button type="button" class="es-btn es-btn-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="es-btn es-btn-primary" onclick="saveSmtp()">Save Settings</button>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --es-gold: #D4A45A;
        --es-blue: #1A6FA8;
        --es-gold-soft: #FEE2E2;
        --es-blue-soft: #F0F4F8;
    }

    /* Layout */
    .es-wrap {
        padding: 1.25rem;
        max-width: 760px;
        margin: 0 auto;
    }

    .es-card {
        background: #FFFFFF;
        border: 1px solid #FEE2E2;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(26,111,168, 0.06);
    }

    .es-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.85rem 1.1rem;
        background: linear-gradient(135deg, var(--es-blue) 0%, #125082 100%);
        color: #FFFFFF;
    }

    .es-card-title {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .es-card-title h5 {
        font-size: 0.98rem;
        font-weight: 600;
        letter-spacing: 0.2px;
    }

    .es-icon-circle {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--es-gold);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #FFFFFF;
        font-size: 0.8rem;
        flex-shrink: 0;
    }

    .es-card-body {
        padding: 1.1rem;
    }

    /* Buttons */
    .es-btn {
        border: none;
        border-radius: 7px;
        padding: 0.45rem 0.95rem;
        font-size: 0.83rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .es-btn-primary {
        background: var(--es-gold);
        color: #FFFFFF;
    }

    .es-btn-primary:hover {
        background: #B8883E;
        color: #FFFFFF;
    }

    .es-btn-outline {
        background: transparent;
        color: var(--es-blue);
        border: 1px solid var(--es-blue);
    }

    .es-btn-outline:hover {
        background: var(--es-blue-soft);
    }

    /* Alerts */
    .es-alert {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        padding: 0.65rem 0.85rem;
        border-radius: 8px;
        font-size: 0.85rem;
        line-height: 1.4;
        margin-bottom: 0.85rem;
        border-left: 3px solid transparent;
    }

    .es-alert i {
        margin-top: 0.15rem;
        flex-shrink: 0;
    }

    .es-alert-success {
        background: var(--es-blue-soft);
        color: #0F4C75;
        border-left-color: var(--es-blue);
    }

    .es-alert-warning {
        background: var(--es-gold-soft);
        color: #B45309;
        border-left-color: var(--es-gold);
    }

    .es-alert-info {
        background: var(--es-blue-soft);
        color: #0F4C75;
        border-left-color: var(--es-blue);
        margin-bottom: 0;
        margin-top: 0.85rem;
    }

    /* Info grid (replaces table) */
    .es-info-grid {
        border: 1px solid #FEE2E2;
        border-radius: 8px;
        overflow: hidden;
    }

    .es-info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.55rem 0.85rem;
        font-size: 0.85rem;
        border-bottom: 1px solid #FEE2E2;
    }

    .es-info-row:last-child {
        border-bottom: none;
    }

    .es-info-row:nth-child(odd) {
        background: #FFFFFF;
    }

    .es-info-label {
        color: #6B7B8D;
        font-weight: 600;
    }

    .es-info-value {
        color: #1E2A3A;
        font-weight: 500;
        text-align: right;
    }

    .es-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.15rem 0.55rem;
        border-radius: 20px;
    }

    .es-badge-on {
        background: var(--es-blue-soft);
        color: var(--es-blue);
    }

    .es-badge-off {
        background: #E8EDF2;
        color: #B8883E;
    }

    /* Modal */
    .es-modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
    }

    .es-modal-header {
        background: linear-gradient(135deg, var(--es-blue) 0%, #125082 100%);
        color: #FFFFFF;
        border: none;
        padding: 0.9rem 1.1rem;
    }

    .es-modal-header .modal-title {
        font-size: 0.95rem;
        font-weight: 600;
    }

    .es-modal-body {
        padding: 1.1rem;
    }

    .es-modal-footer {
        border-top: 1px solid #FEE2E2;
        padding: 0.8rem 1.1rem;
        gap: 0.5rem;
    }

    .es-form-group {
        margin-bottom: 0.9rem;
    }

    .es-form-group:last-child {
        margin-bottom: 0;
    }

    .es-form-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: #2A3A4A;
        margin-bottom: 0.3rem;
    }

    .es-required {
        color: var(--es-gold);
    }

    .es-form-control {
        width: 100%;
        padding: 0.5rem 0.7rem;
        font-size: 0.85rem;
        border: 1px solid #B8C8D8;
        border-radius: 7px;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        box-sizing: border-box;
    }

    .es-form-control:focus {
        border-color: var(--es-blue);
        box-shadow: 0 0 0 3px rgba(26,111,168, 0.12);
    }

    .es-password-wrap {
        position: relative;
    }

    .es-toggle-pass {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--es-blue);
        cursor: pointer;
        padding: 4px 6px;
        font-size: 0.85rem;
    }

    .es-hint {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.74rem;
        color: #B8883E;
    }

    /* Responsive */
    @@media (min-width: 577px) {
        #smtpModal .modal-dialog {
            max-width: 420px !important;
        }
    }

    @@media (max-width: 576px) {
        .es-wrap {
            padding: 0.7rem;
        }

        .es-card-body {
            padding: 0.85rem;
        }

        .es-card-header {
            flex-direction: column;
            align-items: stretch;
            gap: 0.6rem;
        }

        .es-btn-primary[data-bs-toggle] {
            width: 100%;
        }

        .es-info-row {
            font-size: 0.8rem;
        }

        .modal-dialog {
            margin: 0.5rem;
        }
    }
</style>

