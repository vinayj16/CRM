@model Dictionary<string, string>
@{
    ViewData["Title"] = "System Settings";
}

<style>
    .settings-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .settings-card {
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        margin-bottom: 2rem;
    }

    .settings-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .settings-header {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 12px 12px 0 0;
        display: flex;
        align-items: center;
        gap: 1rem;
        border-bottom: 2px solid var(--gold);
    }

    .settings-header h4 {
        margin: 0;
        font-weight: 600;
    }

    .settings-body {
        padding: 2rem;
    }

    .form-label {
        font-weight: 600;
        color: #2A3A4A;
        margin-bottom: 0.5rem;
        font-size: 0.875rem;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #E2E8F0;
        padding: 0.75rem;
        font-size: 0.875rem;
        transition: all 0.3s ease;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 0.2rem rgba(26,111,168, 0.15);
    }

    .settings-icon {
        width: 40px;
        height: 40px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .save-btn {
        background: linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
        border: none;
        color: #FFFFFF !important;
        padding: 0.875rem 2.5rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(26,111,168, 0.3);
    }

    .save-btn:hover {
        color: #FFFFFF !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(26,111,168, 0.4);
    }

    .save-btn:focus,
    .save-btn:active,
    .save-btn:disabled,
    html.dark-mode .save-btn,
    html.dark-mode .save-btn:hover,
    html.dark-mode .save-btn:focus,
    html.dark-mode .save-btn:active,
    html.dark-mode .save-btn:disabled {
        color: #FFFFFF !important;
    }

    .save-btn i,
    html.dark-mode .save-btn i {
        color: #FFFFFF !important;
    }

    /* ━━ DARK MODE FIXES ━━ */
    html.dark-mode .settings-body {
        background: #1A2332;
    }

    html.dark-mode .settings-header h4,
    html.dark-mode .settings-header small,
    html.dark-mode .settings-body strong,
    html.dark-mode .form-label,
    html.dark-mode .help-text,
    html.dark-mode .breadcrumb-item.active,
    html.dark-mode h2 {
        color: #E2E8F0 !important;
    }

    html.dark-mode .form-control,
    html.dark-mode .form-select {
        background-color: #1E2A3A;
        border-color: #2A3A4A;
        color: #E2E8F0;
    }

    html.dark-mode .text-muted {
        color: #8FA3B8 !important;
    }

    html.dark-mode .bg-light {
        background-color: #1E2A3A !important;
    }

    html.dark-mode .border {
        border-color: #2A3A4A !important;
    }

    html.dark-mode .alert-info {
        background-color: rgba(26,111,168, 0.2);
        border-color: var(--blue);
        color: #B8C8D8;
    }

    .help-text {
        font-size: 0.8rem;
        color: #6B7B8D;
        margin-top: 0.25rem;
    }

    .input-group-text {
        background-color: var(--body-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px 0 0 8px;
        font-weight: 600;
        color: var(--text-primary);
    }
    
    /* Required field asterisk styling */
    .text-danger {
        color: #DC2626 !important;
    }
    
    /* Invalid field styling */
    .is-invalid {
        border-color: #DC2626 !important;
        box-shadow: 0 0 0 0.2rem rgba(220,38,38, 0.25) !important;
    }
    
    .invalid-feedback {
        color: #DC2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    @@media (max-width: 768px) {
        .settings-body {
            padding: 1rem;
        }

        .save-btn {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .btn-remove-settings {
            width: 20px !important;
            height: 20px !important;
            font-size: 10px !important;
            line-height: 20px !important;
        }
    }
</style>


<div class="content settings-container">
    <!-- Breadcrumb -->
    <nav class="mb-3" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/home">Home</a></li>
            <li class="breadcrumb-item active">Settings</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">System Settings</h2>
            <p class="text-muted mb-0">Configure company information and default values</p>
        </div>
        @{
            var currentRole = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        }
        @if (currentRole == "Admin")
        {
            <div>
                <a href="@Url.Action("Branding", "Settings")" class="btn btn-outline-primary me-2">
                    <i class="fas fa-palette me-2"></i>Landing Page Branding
                </a>
                <a href="@Url.Action("Impersonation", "Settings")" class="btn btn-outline-warning">
                    <i class="fas fa-user-secret me-2"></i>User Impersonation
                </a>
            </div>
        }
    </div>

    <form id="settingsForm">
    @Html.AntiForgeryToken()
