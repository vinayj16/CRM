@model CRM.MasterDb.Models.SuperAdminModel
@{
    ViewData["Title"] = "SuperAdmin Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="sa-header">
    <div class="sa-header-icon">
        <i class="fa-solid fa-user-circle"></i>
    </div>
    <div class="sa-header-text">
        <h2>SuperAdmin Profile</h2>
        <p>Manage your profile picture and account settings</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body text-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:150px;height:150px;background:rgba(0,0,0,0.05);overflow:hidden;position:relative;">
                    @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                    {
                        <img src="@Model.ProfileImagePath" alt="Profile" style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {
                        <i class="fa-solid fa-user" style="font-size:4rem;color:#B8C8D8;"></i>
                    }
                </div>
                <h5 class="card-title">@Model.FullName</h5>
                <p class="text-muted mb-3">@Model.Email</p>
                <input type="file" id="profileImageInput" accept="image/*" class="d-none" />
                <button type="button" class="btn btn-primary mb-2" onclick="document.getElementById('profileImageInput').click()">
                    <i class="fa-solid fa-camera me-2"></i>Change Picture
                </button>
                <br>
                <button type="button" class="btn btn-outline-danger btn-sm" id="removeProfileImage" style="@(string.IsNullOrEmpty(Model.ProfileImagePath) ? "display:none;" : "")">
                    <i class="fa-solid fa-trash me-1"></i>Remove
                </button>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Profile Information</h5>
                <form id="profileForm">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" class="form-control" id="fullName" value="@Model.FullName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" value="@Model.Email" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <input type="text" class="form-control" value="@Model.Role" disabled />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-save me-2"></i>Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('profileImageInput').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (!file) return;

            var formData = new FormData();
            formData.append('profileImage', file);

            fetch('/SuperAdmin/UploadProfilePicture', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Profile picture updated',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Upload Failed', (data.error || 'Unknown error'), 'error');
                }
            })
            .catch(err => {
                Swal.fire('Upload Failed', err.message, 'error');
            });
        });

        document.getElementById('removeProfileImage').addEventListener('click', function() {
            Swal.fire({
                title: 'Remove profile picture?',
                text: 'This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, remove it',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (!result.isConfirmed) return;

                fetch('/SuperAdmin/RemoveProfilePicture', {
                    method: 'POST'
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Profile picture removed',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => location.reload());
                    } else {
                        Swal.fire('Remove Failed', (data.error || 'Unknown error'), 'error');
                    }
                })
                .catch(err => {
                    Swal.fire('Remove Failed', err.message, 'error');
                });
            });
        });

        document.getElementById('profileForm').addEventListener('submit', function(e) {
            e.preventDefault();
            var fullName = document.getElementById('fullName').value;
            if (!fullName.trim()) {
                Swal.fire('Required Field', 'Full name is required', 'warning');
                return;
            }

            fetch('/SuperAdmin/UpdateProfile', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fullName: fullName })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Profile updated successfully',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Update Failed', (data.error || 'Unknown error'), 'error');
                }
            })
            .catch(err => {
                Swal.fire('Update Failed', err.message, 'error');
            });
        });
    </script>
}
