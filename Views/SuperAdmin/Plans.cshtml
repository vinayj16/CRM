@section Scripts {
    <script>
        function togglePlanStatus(planId, isActive) {
        if (isActive) {
        fetch('/SuperAdmin/GetPlan?id=' + planId)
        .then(r => r.json())
        .then(data => {
        if (data.hasActiveSubscribers) {
        Swal.fire({
        title: 'Cannot Deactivate Plan',
        html: 'This plan has <strong>' + data.count + '</strong> active subscribers.',
        icon: 'error',
        confirmButtonText: 'Create New Plan',
        showCancelButton: true,
        cancelButtonText: 'Cancel'
        }).then(r => { if (r.isConfirmed) window.location.href = '/SuperAdmin/CreatePlan'; });
        } else {
        Swal.fire({
        title: 'Deactivate Plan?',
        text: 'Are you sure you want to deactivate this plan?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, Deactivate',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#DC2626'
        }).then(r => { if (r.isConfirmed) submitToggleForm(planId, false); });
        }
        })
        .catch(() => Swal.fire('Error', 'Failed to check active subscribers', 'error'));
        } else {
        Swal.fire({
        title: 'Activate Plan?',
        text: 'Are you sure you want to activate this plan?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Yes, Activate',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#15803D'
        }).then(r => { if (r.isConfirmed) submitToggleForm(planId, true); });
        }
        }

        function submitToggleForm(planId, isActive) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        const formData = new FormData();
        if (token) formData.append('__RequestVerificationToken', token.value);
        formData.append('planId', planId);
        formData.append('isActive', isActive.toString());

        fetch('/SuperAdmin/TogglePlanStatus', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                Swal.fire({ icon: 'success', title: 'Success', text: data.message, timer: 1500, showConfirmButton: false });
                setTimeout(() => location.reload(), 1500);
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: data.message });
            }
        })
        .catch(() => Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to toggle plan status' }));
        }

        function editPlan(planId) {
        function setChk(name, val) {
            const el = form.querySelector('[name="' + name + '"][type="checkbox"]');
            if (el) el.checked = val;
        }
        function setVal(name, val) {
            const el = form.querySelector('[name="' + name + '"]');
            if (el) el.value = val;
        }

        fetch('/SuperAdmin/GetPlan?id=' + planId)
        .then(r => r.json())
        .then(data => {
        if (!data.success) { Swal.fire('Error', 'Plan not found', 'error'); return; }
        const p = data.plan;
        const form = document.getElementById('spPlanForm');
        document.getElementById('spEditPlanId').value = p.planId;
        document.getElementById('spModalLabel').textContent = 'Edit Plan: ' + p.planName;
        document.getElementById('spSubmitBtn').textContent = 'Update Plan';

        form.querySelector('[name="PlanName"]').value = p.planName;
        form.querySelector('[name="PlanType"]').value = p.planType;
        form.querySelector('[name="MonthlyPrice"]').value = p.monthlyPrice;
        form.querySelector('[name="YearlyPrice"]').value = p.yearlyPrice;
        form.querySelector('[name="SupportLevel"]').value = p.supportLevel;
        form.querySelector('[name="SortOrder"]').value = p.sortOrder;
        form.querySelector('[name="Description"]').value = p.description || '';
        form.querySelector('[name="MaxAgents"]').value = p.maxAgents;
        form.querySelector('[name="MaxPartners"]').value = p.maxPartners;
        form.querySelector('[name="MaxLeadsPerMonth"]').value = p.maxLeadsPerMonth;
        form.querySelector('[name="ShowOnLandingPage"]').value = (p.showOnLandingPage === null || p.showOnLandingPage === true) ? "true" : "false";

        // Legacy integrations
        form.querySelector('[name="HasWhatsAppIntegration"][type="checkbox"]').checked = p.hasWhatsAppIntegration;
        form.querySelector('[name="HasFacebookIntegration"][type="checkbox"]').checked = p.hasFacebookIntegration;
        form.querySelector('[name="HasEmailIntegration"][type="checkbox"]').checked = p.hasEmailIntegration;
        form.querySelector('[name="HasCustomAPIAccess"][type="checkbox"]').checked = p.hasCustomAPIAccess;
        if (form.querySelector('[name="HasImpersonation"][type="checkbox"]'))
        form.querySelector('[name="HasImpersonation"][type="checkbox"]').checked = p.hasImpersonation;
        if (form.querySelector('[name="HasCustomBranding"][type="checkbox"]'))
        form.querySelector('[name="HasCustomBranding"][type="checkbox"]').checked = p.hasCustomBranding;
        if (form.querySelector('[name="HasAdvancedReports"][type="checkbox"]'))
        form.querySelector('[name="HasAdvancedReports"][type="checkbox"]').checked = p.hasAdvancedReports;

        // Core features
        setChk('HasLeadScoring', p.hasLeadScoring);
        setChk('HasQuotationManagement', p.hasQuotationManagement);
        setChk('HasSiteVisitManagement', p.hasSiteVisitManagement);
        setChk('HasDocumentManagement', p.hasDocumentManagement);
        setChk('HasInventoryManagement', p.hasInventoryManagement);
        setChk('HasInvoiceAutomation', p.hasInvoiceAutomation);
        setChk('HasCampaignManagement', p.hasCampaignManagement);
        setChk('HasLegalManagement', p.hasLegalManagement);

        // Advanced features
        setChk('HasWorkflowAutomation', p.hasWorkflowAutomation);
        setChk('HasCustomerPortal', p.hasCustomerPortal);
        setChk('HasAIScoring', p.hasAIScoring);
        setChk('HasAIChatbot', p.hasAIChatbot);
        setChk('HasMobileApp', p.hasMobileApp);
        setChk('HasTwoFactorAuth', p.hasTwoFactorAuth);
        setChk('HasCallIntegration', p.hasCallIntegration);
        setChk('HasSmsIntegration', p.hasSmsIntegration);
        setChk('HasMultiLanguage', p.hasMultiLanguage);
        setChk('HasGpsTracking', p.hasGpsTracking);

        // Limitchk fields
        setVal('MaxSiteVisitsPerMonth', p.maxSiteVisitsPerMonth);
        setVal('MaxDocuments', p.maxDocuments);
        setVal('MaxProperties', p.maxProperties);
        setVal('MaxQuotationsPerMonth', p.maxQuotationsPerMonth);
        setVal('MaxEmailCampaigns', p.maxEmailCampaigns);

        new bootstrap.Modal(document.getElementById('spCreateModal')).show();
        })
        .catch(() => Swal.fire('Error', 'Failed to load plan', 'error'));
        }

        document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('spPlanForm');
        const modal = document.getElementById('spCreateModal');

        form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!this.checkValidity()) {
        e.stopPropagation();
        this.classList.add('was-validated');
        return;
        }
        const formData = new FormData(this);
        const isEdit = document.getElementById('spEditPlanId').value !== '';
        const url = isEdit ? '/SuperAdmin/UpdatePlan' : '/SuperAdmin/CreatePlan';
        if (isEdit) formData.append('PlanId', document.getElementById('spEditPlanId').value);

        fetch(url, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
        })
        .then(r => r.json())
        .then(data => {
        if (data.success) {
        showToast(data.message || (isEdit ? 'Plan updated!' : 'Plan created!'), 'success');
        modal.querySelector('.btn-close').click();
        location.reload();
        } else {
        const errors = data.errors || ['An error occurred'];
        showToast(errors.join(', '), 'error');
        }
        })
        .catch(() => showToast('An error occurred', 'error'));
        });

        modal.addEventListener('hidden.bs.modal', function () {
        document.getElementById('spEditPlanId').value = '';
        document.getElementById('spModalLabel').textContent = 'Create Subscription Plan';
