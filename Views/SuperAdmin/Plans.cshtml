@model IEnumerable<CRM.MasterDb.Models.SaasSubscriptionPlanModel>
@{
    ViewData["Title"] = "Subscription Plans";
}

<style>
    .sp-page {
        padding: 0.5rem;
    }

    .sp-page p {
        font-size: 0.95rem !important;
        line-height: 1.6 !important;
        margin-bottom: 1px !important;
    }

    /* ── Header ── */
    .sp-header {
        background: linear-gradient(135deg, #1A6FA8 0%, #2589C9 100%);
        border-radius: 9px;
        padding: 0.65rem 1rem;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .sp-header-left {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .sp-header-icon {
        width: 32px;
        height: 32px;
        background: rgba(255,255,255,0.18);
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .sp-header-title {
        font-size: 1rem;
        font-weight: 700;
        color: #FFFFFF;
        margin: 0;
    }

    .sp-header-sub {
        font-size: 0.72rem;
        color: rgba(255,255,255,0.78);
        margin: 0;
    }

    .sp-btn-create {
        background: #FFFFFF;
        color: #1A6FA8;
        border: none;
        border-radius: 7px;
        padding: 0.38rem 0.85rem;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
        text-decoration: none;
        transition: opacity .15s;
    }

        .sp-btn-create:hover {
            opacity: 0.88;
            color: #1A6FA8;
            text-decoration: none;
        }

    /* ── Plans Grid ── */
    .sp-plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.6rem;
    }

    /* ── Plan Card ── */
    .sp-plan-card {
        background: var(--bs-body-bg, white);
        border: 1px solid var(--bs-border-color, rgba(0, 0, 0, 0.125));
        border-radius: 9px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform .18s, box-shadow .18s;
    }

        .sp-plan-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(0,0,0,0.1);
        }

    .sp-plan-top {
        padding: 0.6rem 0.8rem 0.45rem;
    }

    .sp-badge-row {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        flex-wrap: wrap;
        margin-bottom: 0.3rem;
    }

    .sp-type-badge {
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        padding: 0.13rem 0.45rem;
        border-radius: 20px;
    }

        .sp-type-badge.basic {
            background: #E2E8F0;
            color: #1A6FA8;
        }

        .sp-type-badge.standard {
            background: #DCFCE7;
            color: #15803D;
        }

        .sp-type-badge.enterprise {
            background: #FEF3C7;
            color: #B45309;
        }

        .sp-type-badge.premium {
            background: #F0F4F8;
            color: #6B7B8D;
        }

        .sp-type-badge.ultimate {
            background: #FEE2E2;
            color: #991B1B;
        }

    [data-bs-theme="dark"] .sp-type-badge,
    html.dark-mode .sp-type-badge {
        color: #FFFFFF !important;
        border: none !important;
    }

        [data-bs-theme="dark"] .sp-type-badge.basic, html.dark-mode .sp-type-badge.basic {
            background: #2589C9 !important;
        }

        [data-bs-theme="dark"] .sp-type-badge.standard, html.dark-mode .sp-type-badge.standard {
            background: #16A34A !important;
        }

        [data-bs-theme="dark"] .sp-type-badge.enterprise, html.dark-mode .sp-type-badge.enterprise {
            background: #F59E0B !important;
        }

        [data-bs-theme="dark"] .sp-type-badge.premium, html.dark-mode .sp-type-badge.premium {
            background: #6B7B8D !important;
        }

        [data-bs-theme="dark"] .sp-type-badge.ultimate, html.dark-mode .sp-type-badge.ultimate {
            background: #DC2626 !important;
        }

    .sp-status-badge {
        font-size: 0.6rem;
        padding: 0.13rem 0.4rem;
        border-radius: 20px;
        font-weight: 600;
    }

        .sp-status-badge.active {
            background: #DCFCE7;
            color: #15803D;
        }

        .sp-status-badge.inactive {
            background: var(--bs-secondary-bg, #E8EDF2);
            color: var(--bs-secondary-color, #6B7B8D);
        }

    [data-bs-theme="dark"] .sp-status-badge.active, html.dark-mode .sp-status-badge.active {
        background: #1E2A3A;
        color: #B8C8D8;
    }

    [data-bs-theme="dark"] .sp-status-badge.inactive, html.dark-mode .sp-status-badge.inactive {
        background: #2A3A4A;
        color: var(--bs-secondary-color, #6B7B8D);
    }

    .sp-plan-name {
        font-size: 0.88rem;
        font-weight: 700;
        margin: 0 0 0.12rem;
        color: var(--bs-body-color, #1E2A3A);
    }

    .sp-plan-desc {
        font-size: 0.7rem;
        color: var(--bs-secondary-color, #6B7B8D);
        margin: 0;
        line-height: 1.3;
    }

    /* ── Price Row ── */
    .sp-price-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: var(--bs-tertiary-bg, #FFFFFF);
        border-top: 2px solid #1A6FA8;
        border-bottom: 1px solid var(--bs-border-color, rgba(0, 0, 0, 0.125));
    }

    .sp-price-cell {
        text-align: center;
        padding: 0.38rem 0.4rem;
    }

        .sp-price-cell:first-child {
            border-right: 1px solid var(--bs-border-color, rgba(0, 0, 0, 0.125));
        }

    .sp-price-lbl {
        font-size: 0.58rem;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        color: var(--bs-secondary-color, #6B7B8D);
        margin-bottom: 1px;
    }

    .sp-price-val {
        font-size: 0.92rem;
        font-weight: 700;
        color: #1A6FA8;
    }

        .sp-price-val small {
            font-size: 0.62rem;
            font-weight: 400;
            color: var(--bs-secondary-color, #6B7B8D);
        }

    /* ── Plan Body ── */
    .sp-plan-body {
        padding: 0.5rem 0.8rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .sp-section-lbl {
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: #1A6FA8;
        margin-bottom: 0.15rem;
        border-bottom: 1px solid var(--bs-border-color, rgba(0, 0, 0, 0.125));
        padding-bottom: 2px;
    }

    .sp-feat-list {
        display: flex;
        flex-direction: column;
        gap: 0.12rem;
    }

    .sp-feat-item {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.72rem;
        color: var(--bs-body-color, #1E2A3A);
    }

        .sp-feat-item i {
            font-size: 11px;
            width: 13px;
            text-align: center;
        }

    .sp-feat-on {
        color: #16A34A;
    }

    .sp-feat-warn {
        color: #F59E0B;
    }

    /* ── Actions ── */
    .sp-plan-actions {
        padding: 0.45rem 0.8rem;
        border-top: 1px solid var(--bs-border-color, rgba(0, 0, 0, 0.125));
        display: flex;
        gap: 0.4rem;
        background: var(--bs-tertiary-bg, #FFFFFF);
    }

    .sp-btn-action {
        flex: 1;
        border-radius: 6px;
        padding: 0.25rem 0.4rem;
        font-size: 0.7rem;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid var(--bs-border-color, rgba(0, 0, 0, 0.125));
        background: transparent;
        color: var(--bs-body-color, #1E2A3A);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.28rem;
        transition: background .13s, color .13s, border-color .13s;
    }

    .sp-btn-edit:hover {
        background: var(--bs-body-bg, #FFFFFF);
        color: #1A6FA8;
        border-color: #1A6FA8;
    }

    .sp-btn-deact {
        color: #DC2626;
        border-color: #E8C27E;
    }

        .sp-btn-deact:hover {
            background: rgba(220,38,38,0.07);
            color: #DC2626;
        }

    .sp-btn-activ {
        color: #16A34A;
        border-color: #B8C8D8;
    }

        .sp-btn-activ:hover {
            background: rgba(22,163,74,0.07);
            color: #16A34A;
        }

    [data-bs-theme="dark"] .sp-btn-deact, html.dark-mode .sp-btn-deact {
        color: #E8C27E;
        border-color: rgba(232,194,126,0.35);
    }

    [data-bs-theme="dark"] .sp-btn-activ, html.dark-mode .sp-btn-activ {
        color: #8FA3B8;
        border-color: rgba(143,163,184,0.35);
    }

    /* ── Stats Cards ── */
    .sp-stats { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
    .sp-stat-card { flex: 1; min-width: 120px; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 10px; padding: 6px 10px; display: flex; align-items: center; gap: 8px; transition: transform .18s, box-shadow .18s; }
    .sp-stat-card:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(26,111,168,0.10); }
    .sp-stat-icon { width: 26px; height: 26px; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 12px; color: #FFFFFF; }
    .sp-stat-icon.teal { background: linear-gradient(135deg, #1A6FA8, #2589C9); }
    .sp-stat-icon.green { background: linear-gradient(135deg, #16A34A, #2589C9); }
    .sp-stat-icon.gray { background: linear-gradient(135deg, #6B7B8D, #8FA3B8); }
    .sp-stat-num { font-size: 1.05rem; font-weight: 700; color: var(--text-primary); line-height: 1.1; }
    .sp-stat-lbl { font-size: 0.62rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.4px; }
    html.dark-mode .sp-stat-card:hover { box-shadow: 0 4px 14px rgba(26,111,168,0.25); }

    /* ── Empty ── */
    .sp-empty {
        text-align: center;
        padding: 3rem 2rem;
        background: var(--bs-body-bg, white);
        border-radius: 9px;
        border: 1px solid var(--bs-border-color, rgba(0, 0, 0, 0.125));
    }

        .sp-empty i {
            font-size: 2.8rem;
            color: var(--bs-secondary-color, #E2E8F0);
        }

    /* ── Modal & Form Structural Styling ── */
    @@media (min-width: 992px) {
        #spCreateModal .modal-dialog {
            max-width: 1100px !important;
        }
    }

    @@media (max-width: 991px) {
        #spCreateModal .modal-dialog {
            margin: 0.5rem;
            max-width: calc(100% - 1rem);
        }

        .modal-footer {
            flex-wrap: nowrap;
        }

            .modal-footer .btn {
                flex: 1;
            }
    }

    .sp-modal-body {
        padding: 0.65rem 0.9rem;
        background: var(--bs-body-bg);
    }

    .sp-form-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.45rem;
    }

    @@media (max-width: 767px) {
        .sp-form-grid {
            grid-template-columns: 1fr;
        }

        .sp-plans-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 480px) {
        .sp-plans-grid {
            grid-template-columns: 1fr;
        }
    }

    .sp-form-full {
        grid-column: 1 / -1;
    }

    .sp-form-group {
        display: flex;
        flex-direction: column;
        gap: 0.18rem;
    }

    .sp-form-lbl {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--bs-body-color, #1E2A3A);
    }

    .sp-section-sep {
        font-size: 0.7rem;
        font-weight: 700;
        color: #1A6FA8;
        margin: 0.55rem 0 0.3rem;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

        .sp-section-sep::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--bs-border-color, rgba(0, 0, 0, 0.125));
        }

    /* Dark Mode SweetAlert overrides */
    [data-bs-theme="dark"] .swal2-popup, html.dark-mode .swal2-popup {
        background-color: var(--bs-body-bg, #1E2A3A) !important;
        color: var(--bs-body-color, #FFFFFF) !important;
    }

    [data-bs-theme="dark"] .swal2-title, html.dark-mode .swal2-title,
    [data-bs-theme="dark"] .swal2-html-container, html.dark-mode .swal2-html-container {
        color: var(--bs-body-color, #FFFFFF) !important;
    }
</style>

<div class="sp-page content">
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-0" style="font-size:.76rem">
            <li class="breadcrumb-item"><a href="/SuperAdmin/Dashboard">SuperAdmin</a></li>
            <li class="breadcrumb-item active">Subscription Plans</li>
        </ol>
    </nav>

    <div class="sp-header">
        <div class="sp-header-left">
            <div class="sp-header-icon">
                <i class="fa-solid fa-layer-group" style="font-size:1rem;color:#FFFFFF"></i>
            </div>
            <div>
                <p class="sp-header-title">Subscription Plans</p>
                <p class="sp-header-sub">Create and manage pricing plans for your tenants</p>
            </div>
        </div>
        <button type="button" class="sp-btn-create" data-bs-toggle="modal" data-bs-target="#spCreateModal">
            <i class="fa-solid fa-plus"></i> Create New Plan
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="sp-stats">
        <div class="sp-stat-card">
            <div class="sp-stat-icon teal"><i class="fa-solid fa-layer-group"></i></div>
            <div>
                <div class="sp-stat-num">@Model.Count()</div>
                <div class="sp-stat-lbl">Total Plans</div>
            </div>
        </div>
        <div class="sp-stat-card">
            <div class="sp-stat-icon green"><i class="fa-solid fa-check-circle"></i></div>
            <div>
                <div class="sp-stat-num">@Model.Count(p => p.IsActive)</div>
                <div class="sp-stat-lbl">Active</div>
            </div>
        </div>
        <div class="sp-stat-card">
            <div class="sp-stat-icon gray"><i class="fa-solid fa-pause-circle"></i></div>
            <div>
                <div class="sp-stat-num">@Model.Count(p => !p.IsActive)</div>
                <div class="sp-stat-lbl">Inactive</div>
            </div>
        </div>
    </div>

    <div id="spPlansContainer">
        @if (Model != null && Model.Any())
        {
            <div class="sp-plans-grid">
                @foreach (var plan in Model)
                {
                    var hasIntegrations = plan.HasWhatsAppIntegration || plan.HasFacebookIntegration || plan.HasEmailIntegration || plan.HasCustomAPIAccess || plan.HasImpersonation;
                    var hasReports = plan.HasAdvancedReports || plan.HasCustomBranding || plan.HasPrioritySupport;
                    var hasCoreFeatures = plan.HasLeadScoring || plan.HasQuotationManagement || plan.HasSiteVisitManagement || plan.HasDocumentManagement || plan.HasInventoryManagement || plan.HasInvoiceAutomation;
                    var hasAdvancedFeatures = plan.HasWorkflowAutomation || plan.HasCustomerPortal || plan.HasAIScoring || plan.HasAIChatbot || plan.HasMobileApp || plan.HasTwoFactorAuth || plan.HasCallIntegration || plan.HasSmsIntegration;

                    <div class="sp-plan-card">
                        <div class="sp-plan-top">
                            <div class="sp-badge-row">
                                <span class="sp-type-badge @plan.PlanType.ToLower()">@plan.PlanType</span>
                                @if (plan.IsActive)
                                {
                                    <span class="sp-status-badge active">Active</span>
                                }
                                else
                                {
                                    <span class="sp-status-badge inactive">Inactive</span>
                                }
                            </div>
                            <p class="sp-plan-name">@plan.PlanName</p>
                            @if (!string.IsNullOrEmpty(plan.Description))
                            {
                                <p class="sp-plan-desc">@plan.Description</p>
                            }
                        </div>

                        <div class="sp-price-row">
                            <div class="sp-price-cell">
                                <div class="sp-price-lbl">Monthly</div>
                                <div class="sp-price-val"><small>Rs. </small>@plan.MonthlyPrice.ToString("N0")</div>
                            </div>
                            <div class="sp-price-cell">
                                <div class="sp-price-lbl">Annual</div>
                                <div class="sp-price-val"><small>Rs. </small>@plan.YearlyPrice.ToString("N0")</div>
                            </div>
                        </div>

                        <div class="sp-plan-body">
                            <div>
                                <div class="sp-section-lbl">Limits</div>
                                <div class="sp-feat-list">
                                    <div class="sp-feat-item">
                                        <i class="fa-solid fa-users @(plan.MaxAgents == -1 ? "sp-feat-on" : "sp-feat-warn")"></i>
                                        <span>@(plan.MaxAgents == -1 ? "Unlimited" : plan.MaxAgents.ToString()) Agents</span>
                                    </div>
                                    <div class="sp-feat-item">
                                        <i class="fa-solid fa-handshake @(plan.MaxPartners == -1 ? "sp-feat-on" : "sp-feat-warn")"></i>
                                        <span>@(plan.MaxPartners == -1 ? "Unlimited" : plan.MaxPartners.ToString()) Partners</span>
                                    </div>
                                    <div class="sp-feat-item">
                                        <i class="fa-solid fa-chart-line @(plan.MaxLeadsPerMonth == -1 ? "sp-feat-on" : "sp-feat-warn")"></i>
                                        <span>@(plan.MaxLeadsPerMonth == -1 ? "Unlimited" : plan.MaxLeadsPerMonth.ToString()) Leads/Mo</span>
                                    </div>
                                    @if (plan.MaxSiteVisitsPerMonth > 0)
                                    {
                                        <div class="sp-feat-item"><i class="fa-solid fa-calendar-check sp-feat-warn"></i><span>@plan.MaxSiteVisitsPerMonth Site Visits/Mo</span></div>
                                    }
                                    @if (plan.MaxDocuments > 0)
                                    {
                                        <div class="sp-feat-item"><i class="fa-solid fa-file sp-feat-warn"></i><span>@plan.MaxDocuments Documents</span></div>
                                    }
                                    @if (plan.MaxProperties > 0)
                                    {
                                        <div class="sp-feat-item"><i class="fa-solid fa-building sp-feat-warn"></i><span>@plan.MaxProperties Properties</span></div>
                                    }
                                    @if (plan.MaxQuotationsPerMonth > 0)
                                    {
                                        <div class="sp-feat-item"><i class="fa-solid fa-file-invoice sp-feat-warn"></i><span>@plan.MaxQuotationsPerMonth Quotations/Mo</span></div>
                                    }
                                    @if (plan.MaxEmailCampaigns > 0)
                                    {
                                        <div class="sp-feat-item"><i class="fa-solid fa-envelope sp-feat-warn"></i><span>@plan.MaxEmailCampaigns Campaigns/Mo</span></div>
                                    }
                                </div>
                            </div>

                            @if (hasCoreFeatures)
                            {
                                <div>
                                    <div class="sp-section-lbl">Core Features</div>
                                    <div class="sp-feat-list">
                                        @if (plan.HasLeadScoring) { <div class="sp-feat-item"><i class="fa-solid fa-star sp-feat-on"></i><span>Lead Scoring</span></div> }
                                        @if (plan.HasQuotationManagement) { <div class="sp-feat-item"><i class="fa-solid fa-file-invoice sp-feat-on"></i><span>Quotation Management</span></div> }
                                        @if (plan.HasSiteVisitManagement) { <div class="sp-feat-item"><i class="fa-solid fa-calendar-check sp-feat-on"></i><span>Site Visit Management</span></div> }
                                        @if (plan.HasDocumentManagement) { <div class="sp-feat-item"><i class="fa-solid fa-folder-open sp-feat-on"></i><span>Document Management</span></div> }
                                        @if (plan.HasInventoryManagement) { <div class="sp-feat-item"><i class="fa-solid fa-warehouse sp-feat-on"></i><span>Inventory Management</span></div> }
                                        @if (plan.HasInvoiceAutomation) { <div class="sp-feat-item"><i class="fa-solid fa-file-invoice-dollar sp-feat-on"></i><span>Invoice Automation</span></div> }
                                        @if (plan.HasCampaignManagement) { <div class="sp-feat-item"><i class="fa-solid fa-bullhorn sp-feat-on"></i><span>Campaign Management</span></div> }
                                        @if (plan.HasLegalManagement) { <div class="sp-feat-item"><i class="fa-solid fa-gavel sp-feat-on"></i><span>Legal Management</span></div> }
                                    </div>
                                </div>
                            }

                            @if (hasAdvancedFeatures)
                            {
                                <div>
                                    <div class="sp-section-lbl">Advanced</div>
                                    <div class="sp-feat-list">
                                        @if (plan.HasWorkflowAutomation) { <div class="sp-feat-item"><i class="fa-solid fa-diagram-project sp-feat-on"></i><span>Workflow Automation</span></div> }
                                        @if (plan.HasCustomerPortal) { <div class="sp-feat-item"><i class="fa-solid fa-user-lock sp-feat-on"></i><span>Customer Portal</span></div> }
                                        @if (plan.HasAIScoring) { <div class="sp-feat-item"><i class="fa-solid fa-brain sp-feat-on"></i><span>AI Scoring</span></div> }
                                        @if (plan.HasAIChatbot) { <div class="sp-feat-item"><i class="fa-solid fa-robot sp-feat-on"></i><span>AI Chatbot</span></div> }
                                        @if (plan.HasMobileApp) { <div class="sp-feat-item"><i class="fa-solid fa-mobile-screen sp-feat-on"></i><span>Mobile App</span></div> }
                                        @if (plan.HasTwoFactorAuth) { <div class="sp-feat-item"><i class="fa-solid fa-shield-halved sp-feat-on"></i><span>Two-Factor Auth</span></div> }
                                        @if (plan.HasCallIntegration) { <div class="sp-feat-item"><i class="fa-solid fa-phone sp-feat-on"></i><span>Call Integration</span></div> }
                                        @if (plan.HasSmsIntegration) { <div class="sp-feat-item"><i class="fa-solid fa-message sp-feat-on"></i><span>SMS Integration</span></div> }
                                    </div>
                                </div>
                            }

                            @if (hasIntegrations)
                            {
                                <div>
                                    <div class="sp-section-lbl">Integrations</div>
                                    <div class="sp-feat-list">
                                        @if (plan.HasWhatsAppIntegration)
                                        {
                                            <div class="sp-feat-item"><i class="fa-brands fa-whatsapp sp-feat-on"></i><span>WhatsApp</span></div>
                                        }
                                        @if (plan.HasFacebookIntegration)
                                        {
                                            <div class="sp-feat-item"><i class="fa-brands fa-facebook sp-feat-on"></i><span>Facebook</span></div>
                                        }
                                        @if (plan.HasEmailIntegration)
                                        {
                                            <div class="sp-feat-item"><i class="fa-solid fa-envelope sp-feat-on"></i><span>Email Integration</span></div>
                                        }
                                        @if (plan.HasCustomAPIAccess)
                                        {
                                            <div class="sp-feat-item"><i class="fa-solid fa-code sp-feat-on"></i><span>Custom API</span></div>
                                        }
                                        @if (plan.HasImpersonation)
                                        {
                                            <div class="sp-feat-item"><i class="fa-solid fa-user-secret sp-feat-on"></i><span>Impersonation</span></div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (hasReports)
                            {
                                <div>
                                    <div class="sp-section-lbl">Reports &amp; Support</div>
                                    <div class="sp-feat-list">
                                        @if (plan.HasAdvancedReports)
                                        {
                                            <div class="sp-feat-item"><i class="fa-solid fa-chart-bar sp-feat-on"></i><span>Advanced Dashboard</span></div>
                                        }
                                        @if (plan.HasCustomBranding)
                                        {
                                            <div class="sp-feat-item"><i class="fa-solid fa-palette sp-feat-on"></i><span>Custom Branding</span></div>
                                        }
                                        @if (plan.HasPrioritySupport)
                                        {
                                            <div class="sp-feat-item"><i class="fa-solid fa-headset sp-feat-on"></i><span>@plan.SupportLevel Support</span></div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="sp-plan-actions">
                            <button type="button" class="sp-btn-action sp-btn-edit" onclick="editPlan(@plan.PlanId)">
                                <i class="fa-solid fa-pencil"></i> Edit
                            </button>
                            <button type="button"
                                    class="sp-btn-action @(plan.IsActive ? "sp-btn-deact" : "sp-btn-activ")"
                                    onclick="togglePlanStatus(@plan.PlanId, @plan.IsActive.ToString().ToLower())">
                                <i class="fa-solid fa-@(plan.IsActive ? "pause" : "play")"></i>
                                @(plan.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sp-empty">
                <i class="fa-solid fa-layer-group d-block mb-3"></i>
                <h5 style="font-size:.95rem;margin:0 0 4px;color:var(--bs-body-color)">No Subscription Plans</h5>
                <p style="color:var(--bs-secondary-color)" class="small mb-3">Create your first subscription plan to get started</p>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#spCreateModal">
                    <i class="fa-solid fa-plus me-1"></i> Create Plan
                </button>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

