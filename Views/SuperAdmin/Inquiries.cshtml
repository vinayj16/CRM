@model List<CRM.Models.InquiryViewModel>
@{
    ViewData["Title"] = "Inquiries";
}

<style>
    *, *::before, *::after { box-sizing: border-box; }

    .sa-container { max-width: 100%; padding: 0; }

    .sa-container h1, .sa-container .h1 {
        font-size: 1.5rem !important;
        font-weight: 700 !important;
        margin-bottom: 1px !important;
    }

    .sa-container p {
        font-size: 0.95rem !important;
        line-height: 1.6 !important;
        margin-bottom: 0px !important;
    }

    /* -- Header -- */
    .sa-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
    }

    .sa-header-left { display: flex; align-items: center; gap: 10px; }

    .sa-header-icon {
        width: 34px; height: 34px;
        background: var(--blue);
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .sa-header-icon i { color: #FFFFFF; font-size: 15px; }

    .sa-header-text h1 {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--blue);
        margin: 0;
        line-height: 1.2;
    }

    .sa-header-text p {
        font-size: 0.74rem;
        color: var(--text-muted);
        margin: 0;
    }

    /* -- Card -- */
    .sa-card {
        background: var(--card-bg);
        border-radius: 10px;
        border: 1px solid var(--border-color);
        box-shadow: 0 2px 10px rgba(26,111,168,0.07);
        overflow: hidden;
    }

    /* -- Filter bar -- */
    .filter-bar {
        background: var(--card-bg);
        border-radius: 9px;
        border: 1px solid var(--border-color);
        padding: 0.55rem 0.85rem;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: flex-end;
        gap: 0.55rem;
        flex-wrap: wrap;
        box-shadow: 0 1px 5px rgba(26,111,168,0.05);
    }

    .filter-bar .form-label {
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--blue);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 3px;
        display: block;
    }

    .filter-bar .form-select {
        font-size: 0.8rem;
        padding: 0.27rem 0.6rem;
        border: 1.5px solid var(--border-color);
        border-radius: 6px;
        color: var(--text-primary);
        background-color: var(--body-bg);
        height: 30px;
        outline: none;
        transition: border-color .18s;
        min-width: 140px;
    }

    .filter-bar .form-select:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 2px rgba(26,111,168,0.1);
    }
    .btn-filter {
        height: 30px;
        padding: 0 0.85rem;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        background: var(--blue);
        color: #FFFFFF;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: opacity .18s;
    }

    .btn-filter:hover { opacity: 0.88; }

    .btn-clear {
        height: 30px;
        padding: 0 0.8rem;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 500;
        border: 1.5px solid var(--gold);
        cursor: pointer;
        background: var(--card-bg);
        color: var(--gold-dark);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
        transition: all .18s;
    }

    .btn-clear:hover { background: var(--body-bg); color: var(--gold-dark); text-decoration: none; }

    /* -- Table -- */
    .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }

    table.iq-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
        color: var(--text-primary);
    }

    .iq-table thead tr {
        background: var(--body-bg);
        border-bottom: 2px solid var(--gold);
    }

    .iq-table thead th {
        padding: 0.5rem 0.8rem;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.55px;
        color: var(--blue);
        white-space: nowrap;
    }

    .iq-table tbody tr {
        border-bottom: 1px solid var(--border-color);
        transition: background .12s;
    }

    .iq-table tbody tr:last-child { border-bottom: none; }
    .iq-table tbody tr:hover { background: var(--body-bg); }

    .iq-table td {
        padding: 0.5rem 0.8rem;
        vertical-align: middle;
    }

    .cell-primary { font-weight: 700; color: var(--text-primary); font-size: 0.81rem; }
    .cell-sub { font-size: 0.72rem; color: var(--text-muted); margin-top: 1px; }
    .cell-email { color: var(--blue); font-size: 0.79rem; font-weight: 500; }

    .msg-cell {
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.76rem;
        color: var(--text-muted);
    }

    /* -- Badges -- */
    .sa-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .sa-badge::before {
        content: '';
        width: 5px; height: 5px;
        border-radius: 50%;
        background: currentColor;
        display: inline-block;
        flex-shrink: 0;
    }

    .sa-badge-new       { background: rgba(26,111,168,0.72);  color: #FFFFFF; }
    .sa-badge-contacted { background: rgba(212,164,90,0.90);  color: #FFFFFF; }
    .sa-badge-converted { background: rgba(22,163,74,0.15);   color: #15803D; }
    .sa-badge-rejected  { background: rgba(220,38,38,0.78);   color: #FFFFFF; }

    /* dark mode badge text adjustments */
    html.dark-mode .sa-badge-new       { background: rgba(26,111,168,0.25);  color: #8FA3B8; }
    html.dark-mode .sa-badge-contacted { background: rgb(212 164 90 / 90%);  color: var(--gold-light); }
    html.dark-mode .sa-badge-converted { background: rgba(22,163,74,0.18);   color: #8FA3B8; }
    html.dark-mode .sa-badge-rejected  { background: rgba(220,38,38,0.20);   color: #E8C27E; }

    /* -- Referral -- */
    .referral-code {
        font-weight: 700;
        color: var(--gold);
        font-size: 0.78rem;
    }

    /* -- Action dropdown -- */
    .dropdown { position: relative; }

    .btn-action {
        height: 26px;
        padding: 0 0.65rem;
        border-radius: 5px;
        font-size: 0.73rem;
        font-weight: 600;
        border: 1.5px solid var(--border-color);
        cursor: pointer;
        background: var(--card-bg);
        color: var(--blue);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all .15s;
        white-space: nowrap;
    }

    .btn-action:hover { background: var(--body-bg); border-color: var(--blue); }
    .btn-action:focus { outline: none; box-shadow: 0 0 0 2px rgba(26,111,168,0.15); }

    .iq-dropdown-menu {
        position: absolute;
        right: 0;
        top: calc(100% + 4px);
        min-width: 155px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        box-shadow: 0 6px 20px rgba(26,111,168,0.13);
        z-index: 999;
        display: none;
        overflow: hidden;
        padding: 4px 0;
    }

    .iq-dropdown-menu.show { display: block; }

    .iq-dropdown-item {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0.38rem 0.8rem;
        font-size: 0.77rem;
        color: var(--text-primary);
        cursor: pointer;
        border: none;
        background: none;
        width: 100%;
        text-align: left;
        text-decoration: none;
        transition: background .12s;
        font-weight: 500;
    }

    .iq-dropdown-item:hover { background: var(--body-bg); text-decoration: none; }
    .iq-dropdown-item.danger  { color: #DC2626; }
    .iq-dropdown-item.success { color: #15803D; font-weight: 700; }

    html.dark-mode .iq-dropdown-item.danger  { color: #E8C27E; }
    html.dark-mode .iq-dropdown-item.success { color: #8FA3B8; }

    .iq-dropdown-item i { font-size: 11px; width: 13px; text-align: center; opacity: 0.8; }

    .iq-divider { height: 1px; background: var(--border-color); margin: 3px 0; }

    /* -- Empty state -- */
    .empty-state {
        text-align: center;
        padding: 2.5rem 1rem;
        color: var(--text-muted);
    }

    .empty-state i { font-size: 2rem; color: var(--gold); margin-bottom: 0.6rem; display: block; opacity: 0.5; }
    .empty-state p { font-size: 0.83rem; margin: 0; }

    /* -- Stats Cards -- */
    .sa-section-title { display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin: 2px 0 10px 0; }
    .sa-section-title i { color: var(--blue); font-size: 0.95rem; }
    .sa-section-title span { font-size: 0.75rem; font-weight: 500; color: var(--text-muted); }
    .iq-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 150px)); gap: 8px; margin-bottom: 10px; justify-content: center; }
    .iq-stat-card { min-height: 0; height: auto; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 6px 10px; display: flex; align-items: center; gap: 8px; transition: transform .18s, box-shadow .18s; box-sizing: border-box; max-width: 100%; }
    .iq-stat-card:hover { transform: translateY(-1px); box-shadow: 0 3px 10px rgba(26,111,168,0.08); }
    .iq-stat-icon { width: 26px; height: 26px; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 12px; color: #FFFFFF; }
    .iq-stat-icon.blue { background: linear-gradient(135deg, #1A6FA8, #2589C9); }
    .iq-stat-icon.green { background: linear-gradient(135deg, #16A34A, #2589C9); }
    .iq-stat-icon.amber { background: linear-gradient(135deg, #F59E0B, #F59E0B); }
    .iq-stat-icon.purple { background: linear-gradient(135deg, #6B7B8D, #B8C8D8); }
    .iq-stat-icon.red { background: linear-gradient(135deg, #DC2626, #D4A45A); }
    .iq-stat-num { font-size: 1.05rem; font-weight: 700; color: var(--text-primary); line-height: 1.1; margin-bottom: 0; }
    .iq-stat-lbl { font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.3px; margin-top: 1px; }
    html.dark-mode .iq-stat-card:hover { box-shadow: 0 4px 14px rgba(26,111,168,0.20); }

    /* -- Responsive -- */
    @@media (max-width: 640px) {
        .sa-section-title { font-size: 0.85rem; margin: 0 0 8px 0; }
        .sa-section-title span { font-size: 0.7rem; }
        .sa-header { flex-direction: column; align-items: flex-start; }
        .filter-bar { flex-direction: column; align-items: stretch; }
        .filter-bar .form-select { min-width: 100%; }
        .btn-filter, .btn-clear { width: 100%; justify-content: center; }
        .iq-table thead th:nth-child(3),
        .iq-table td:nth-child(3),
        .iq-table thead th:nth-child(4),
        .iq-table td:nth-child(4) { display: none; }
    }

    @@media (max-width: 400px) {
        .iq-table thead th:nth-child(5),
        .iq-table td:nth-child(5),
        .iq-table thead th:nth-child(6),
        .iq-table td:nth-child(6) { display: none; }
        .cell-primary { font-size: 0.77rem; }
    }

    /* -- Inquiry row click/hover -- */
    .iq-table tbody tr {
        cursor: pointer !important;
        transition: all 0.15s ease !important;
    }
    .iq-table tbody tr:hover {
        background: rgba(26,111,168,0.06) !important;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(26,111,168,0.08);
    }
    .iq-table tbody tr:active {
        transform: translateY(0);
        background: rgba(26,111,168,0.12) !important;
    }
    /* -- Inquiry Overview Modal -- */
    .inq-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.45); z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        animation: fadeIn 0.2s ease;
    }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    .inq-card {
        background: var(--card-bg); border-radius: 14px;
        max-width: 560px; width: 90%; max-height: 85vh; overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0,0,0,0.25);
        animation: slideUp 0.25s ease;
    }
    .inq-card-header {
        padding: 16px 20px; border-bottom: 2px solid var(--gold);
        display: flex; align-items: center; justify-content: space-between;
        background: linear-gradient(135deg, #1A6FA8, #125082);
        border-radius: 14px 14px 0 0; color: #FFFFFF;
    }
    .inq-card-header h3 { margin: 0; font-size: 1.1rem; font-weight: 700; color: #FFFFFF !important; }
    .inq-card-header button {
        background: rgba(255,255,255,0.15); border: none; color: #FFFFFF;
        width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-size: 16px;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.15s;
    }
    .inq-card-header button:hover { background: rgba(255,255,255,0.3); }
    .inq-card-body { padding: 20px; }
    .inq-field { margin-bottom: 14px; }
    .inq-field-label { font-size: 0.72rem; font-weight: 700; color: var(--blue); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px; }
    .inq-field-value { font-size: 0.92rem; color: var(--text-primary); font-weight: 500; word-break: break-word; }
    .inq-msg { background: var(--body-bg); border-radius: 8px; padding: 12px; font-size: 0.85rem; line-height: 1.5; color: var(--text-primary); margin-top: 4px; border-left: 3px solid var(--gold); }
    .inq-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-color); }
    .inq-actions .btn { padding: 7px 16px; border-radius: 7px; font-size: 0.82rem; font-weight: 600; border: none; cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; gap: 6px; }
    .inq-actions .btn-contact { background: var(--blue); color: #FFFFFF; }
    .inq-actions .btn-convert { background: #16A34A; color: #FFFFFF; }
    .inq-actions .btn-reject { background: #DC2626; color: #FFFFFF; }
    .inq-actions .btn-tenant { background: var(--gold); color: #FFFFFF; }
    .inq-actions .btn:hover { opacity: 0.85; transform: translateY(-1px); }
    html.dark-mode .inq-card { background: #1E2A3A; }
    html.dark-mode .inq-msg { background: #1E2A3A; }
    html.dark-mode .inq-field-label { color: #8FA3B8; }
    html.dark-mode .inq-field-value { color: #E8EDF2; }
</style>

<div class="sa-container">

    <!-- Breadcrumb -->
    <nav class="mb-3" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0" style="font-size:.76rem;background:transparent;padding:0;">
            <li class="breadcrumb-item"><a href="/SuperAdmin/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active" style="color:var(--text-muted)">Inquiries</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="sa-header">
        <div class="sa-header-left">
            <div class="sa-header-icon">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            </div>
            <div class="sa-header-text">
                <h1>Inquiries</h1>
                <p>Manage and track all incoming tenant inquiries</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="sa-section-title">
        <i class="fa-solid fa-inbox"></i> Inquiries Overview
        <span>Status breakdown</span>
    </div>

    <div class="iq-stats">
        <div class="iq-stat-card">
            <div class="iq-stat-icon blue"><i class="fa-solid fa-envelope"></i></div>
            <div>
                <div class="iq-stat-num">@Model.Count</div>
                <div class="iq-stat-lbl">Total</div>
            </div>
        </div>
        <div class="iq-stat-card">
            <div class="iq-stat-icon green"><i class="fa-solid fa-circle"></i></div>
            <div>
                <div class="iq-stat-num">@Model.Count(i => i.Inquiry?.Status == "New")</div>
                <div class="iq-stat-lbl">New</div>
            </div>
        </div>
        <div class="iq-stat-card">
            <div class="iq-stat-icon amber"><i class="fa-solid fa-phone"></i></div>
            <div>
                <div class="iq-stat-num">@Model.Count(i => i.Inquiry?.Status == "Contacted")</div>
                <div class="iq-stat-lbl">Contacted</div>
            </div>
        </div>
        <div class="iq-stat-card">
            <div class="iq-stat-icon purple"><i class="fa-solid fa-check-circle"></i></div>
            <div>
                <div class="iq-stat-num">@Model.Count(i => i.Inquiry?.Status == "Converted")</div>
                <div class="iq-stat-lbl">Converted</div>
            </div>
        </div>
        <div class="iq-stat-card">
            <div class="iq-stat-icon red"><i class="fa-solid fa-ban"></i></div>
            <div>
                <div class="iq-stat-num">@Model.Count(i => i.Inquiry?.Status == "Rejected")</div>
                <div class="iq-stat-lbl">Rejected</div>
            </div>
        </div>
    </div>

    <!-- Filter -->
    <div class="filter-bar">
        <form method="get" style="display:flex;gap:0.55rem;align-items:flex-end;flex-wrap:wrap;width:100%">
            <div>
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New"       selected="@(ViewBag.Status == "New")">New</option>
                    <option value="Contacted" selected="@(ViewBag.Status == "Contacted")">Contacted</option>
                    <option value="Converted" selected="@(ViewBag.Status == "Converted")">Converted</option>
                    <option value="Rejected"  selected="@(ViewBag.Status == "Rejected")">Rejected</option>
                </select>
            </div>
            <button type="submit" class="btn-filter">
                <i class="fa-solid fa-filter" aria-hidden="true"></i> Filter
            </button>
            <a href="/SuperAdmin/Inquiries" class="btn-clear">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i> Clear
            </a>
        </form>
    </div>

    <!-- Table card -->
    <div class="sa-card">

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-inbox" aria-hidden="true"></i>
                <p>No inquiries found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="iq-table">
                    <thead>
                        <tr>
                            <th>Company &amp; Contact</th>
                            <th>Message</th>
                            <th>Plan</th>
                            <th>Referral</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th style="width:100px">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inquiry in Model)
                        {
                            var badgeClass = inquiry.Inquiry.Status switch
                            {
                                "New"       => "sa-badge-new",
                                "Contacted" => "sa-badge-contacted",
                                "Converted" => "sa-badge-converted",
                                "Rejected"  => "sa-badge-rejected",
                                _           => "sa-badge-new"
                            };

                            <tr>
                                <!-- Company & Contact -->
                                <td>
                                    <div class="cell-primary">@inquiry.Inquiry.CompanyName</div>
                                    <div class="cell-sub">@inquiry.Inquiry.ContactPerson</div>
                                    <div class="cell-email">@inquiry.Inquiry.Email</div>
                                    @if (!string.IsNullOrEmpty(inquiry.Inquiry.Phone))
                                    {
                                        <div class="cell-sub">@inquiry.Inquiry.Phone</div>
                                    }
                                </td>

                                <!-- Message -->
                                <td>
                                    <div class="msg-cell" title="@inquiry.Inquiry.Message">
                                        @(string.IsNullOrEmpty(inquiry.Inquiry.Message) ? "-" : inquiry.Inquiry.Message)
                                    </div>
                                </td>

                                <!-- Plan -->
                                <td>
                                    @if (!string.IsNullOrEmpty(inquiry.Inquiry.SelectedPlan))
                                    {
                                        <span class="sa-badge sa-badge-new" style="background:rgba(107,123,141,0.12);color:#6B7B8D;">@inquiry.Inquiry.SelectedPlan</span>
                                    }
                                    else
                                    {
                                        <span class="cell-sub">-</span>
                                    }
                                </td>

                                <!-- Referral -->
                                <td>
                                    @if (!string.IsNullOrEmpty(inquiry.Inquiry.ReferralCode))
                                    {
                                        <div class="referral-code">@inquiry.Inquiry.ReferralCode</div>
                                        <div class="cell-sub">@(string.IsNullOrEmpty(inquiry.ReferralCompany) ? "-" : inquiry.ReferralCompany)</div>
                                    }
                                    else
                                    {
                                        <span class="cell-sub">Direct</span>
                                    }
                                </td>

                                <!-- Status -->
                                <td>
                                    <span class="sa-badge @badgeClass">@inquiry.Inquiry.Status</span>
                                </td>

                                <!-- Date -->
                                <td>
                                    <div class="cell-sub" style="font-size:0.75rem;">
                                        @inquiry.Inquiry.CreatedOn.ToString("dd MMM yyyy")
                                    </div>
                                </td>

                                <!-- Action -->
                                <td>
                                    <div class="dropdown" id="dd-@inquiry.Inquiry.InquiryId">
                                        <button class="btn-action"
                                                onclick="toggleDropdown(@inquiry.Inquiry.InquiryId, event)"
                                                aria-expanded="false">
                                            Action <i class="fa-solid fa-chevron-down" style="font-size:9px" aria-hidden="true"></i>
                                        </button>
                                        <div class="iq-dropdown-menu" id="menu-@inquiry.Inquiry.InquiryId">
                                            <button class="iq-dropdown-item"
                                                    onclick="updateStatus(@inquiry.Inquiry.InquiryId,'Contacted');closeAllDropdowns()">
                                                <i class="fa-solid fa-phone" aria-hidden="true"></i> Contacted
                                            </button>
                                            <button class="iq-dropdown-item"
                                                    onclick="updateStatus(@inquiry.Inquiry.InquiryId,'Converted');closeAllDropdowns()">
                                                <i class="fa-solid fa-circle-check" aria-hidden="true"></i> Converted
                                            </button>
                                            <button class="iq-dropdown-item danger"
                                                    onclick="updateStatus(@inquiry.Inquiry.InquiryId,'Rejected');closeAllDropdowns()">
                                                <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> Reject
                                            </button>
                                            <div class="iq-divider"></div>
                                            <a class="iq-dropdown-item success"
                                               href="/SuperAdmin/CreateTenant?companyName=@Uri.EscapeDataString(inquiry.Inquiry.CompanyName)&contactPerson=@Uri.EscapeDataString(inquiry.Inquiry.ContactPerson)&email=@Uri.EscapeDataString(inquiry.Inquiry.Email)&phone=@Uri.EscapeDataString(inquiry.Inquiry.Phone ?? "")&referralCode=@Uri.EscapeDataString(inquiry.Inquiry.ReferralCode ?? "")">
                                                <i class="fa-solid fa-plus" aria-hidden="true"></i> Create Tenant
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // -- Custom dropdown --------------------------------------------

    function toggleDropdown(id, e) {
        e.stopPropagation();
        var menu = document.getElementById('menu-' + id);
        var isOpen = menu.classList.contains('show');
        closeAllDropdowns();
        if (!isOpen) menu.classList.add('show');
    }

    function closeAllDropdowns() {
        document.querySelectorAll('.iq-dropdown-menu').forEach(function (m) {
            m.classList.remove('show');
        });
    }

    document.addEventListener('click', closeAllDropdowns);

    // -- Update status ----------------------------------------------

    function updateStatus(inquiryId, status) {

        Swal.fire({
            title: 'Update status to ' + status + '?',
            input: 'text',
            inputLabel: 'Notes (optional)',
            inputPlaceholder: 'Enter remarks...',
            showCancelButton: true,
            confirmButtonText: 'Update',
            confirmButtonColor: '#1A6FA8',
            cancelButtonColor: '#6B7B8D'
        }).then(result => {

            if (!result.isConfirmed) return;

            const notes = result.value || '';

            const btn = document.querySelector(`[onclick*="${inquiryId}"]`);
            if (btn) btn.disabled = true;

            fetch('/SuperAdmin/UpdateInquiryStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({
                    inquiryId: inquiryId,
                    status: status,
                    notes: notes
                })
            })
            .then(async response => {
                const text = await response.text();
                try {
                    return JSON.parse(text);
                } catch (e) {
                    console.error("Invalid JSON response:", text);
                    throw new Error("Server returned invalid response");
                }
            })
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated!',
                        text: data.message || 'Status updated successfully',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => { location.reload(); });
                } else {
                    Swal.fire('Error', data.message || 'Update failed', 'error');
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire('Error', 'Something went wrong', 'error');
            })
            .finally(() => {
                if (btn) btn.disabled = false;
            });
        });
    }
    // -- Inquiry Overview Card --
    function showInquiryCard(inquiryId) {
        var row = document.querySelector('#dd-' + inquiryId).closest('tr');
        var cells = row.querySelectorAll('td');
        if (!cells || cells.length < 7) return;
        // cells: 0=Company&Contact, 1=Message, 2=Plan, 3=Referral, 4=Status, 5=Date, 6=Action
        var company = cells[0].querySelector('.cell-primary')?.textContent || '';
        var contactPerson = cells[0].querySelector('.cell-sub')?.textContent || '';
        var email = cells[0].querySelector('.cell-email')?.textContent || '';
        // Phone is the last .cell-sub in cells[0], or empty if not present
        var phoneCells = cells[0].querySelectorAll('.cell-sub');
        var phone = phoneCells.length > 1 ? phoneCells[phoneCells.length - 1].textContent?.trim() || '' : '';
        var message = cells[1]?.querySelector('.msg-cell')?.getAttribute('title') || cells[1]?.querySelector('.msg-cell')?.textContent || '';
        var referral = cells[3]?.querySelector('.referral-code')?.textContent || 'Direct';
        var status = (cells[4]?.querySelector('.sa-badge')?.textContent || '').trim();
        var date = cells[5]?.querySelector('.cell-sub')?.textContent || '';
        var overlay = document.createElement('div');
        overlay.className = 'inq-overlay';
        overlay.innerHTML = '<div class="inq-card"><div class="inq-card-header"><h3><i class="fa-solid fa-building me-2"></i>' + escapeHtml(company) + '</h3><button onclick="closeInquiryCard()"><i class="fa-solid fa-xmark"></i></button></div><div class="inq-card-body"><div class="row g-3"><div class="col-6"><div class="inq-field"><div class="inq-field-label">Contact Person</div><div class="inq-field-value">' + escapeHtml(contactPerson) + '</div></div></div><div class="col-6"><div class="inq-field"><div class="inq-field-label">Status</div><div class="inq-field-value"><span class="sa-badge ' + getBadgeClass(status) + '">' + status + '</span></div></div></div><div class="col-6"><div class="inq-field"><div class="inq-field-label">Email</div><div class="inq-field-value" style="color:var(--blue)">' + escapeHtml(email) + '</div></div></div><div class="col-6"><div class="inq-field"><div class="inq-field-label">Phone</div><div class="inq-field-value">' + (escapeHtml(phone) || '-') + '</div></div></div><div class="col-6"><div class="inq-field"><div class="inq-field-label">Referral</div><div class="inq-field-value" style="color:var(--gold);font-weight:700">' + escapeHtml(referral) + '</div></div></div><div class="col-6"><div class="inq-field"><div class="inq-field-label">Created</div><div class="inq-field-value">' + escapeHtml(date) + '</div></div></div><div class="col-12"><div class="inq-field"><div class="inq-field-label">Message</div><div class="inq-msg">' + (escapeHtml(message) || 'No message') + '</div></div></div></div><div class="inq-actions"><button class="btn btn-contact" onclick="updateFromCard(' + inquiryId + ',\'Contacted\')"><i class="fa-solid fa-phone"></i> Contacted</button><button class="btn btn-convert" onclick="updateFromCard(' + inquiryId + ',\'Converted\')"><i class="fa-solid fa-circle-check"></i> Converted</button><button class="btn btn-reject" onclick="updateFromCard(' + inquiryId + ',\'Rejected\')"><i class="fa-solid fa-ban"></i> Reject</button><a class="btn btn-tenant" href="/SuperAdmin/CreateTenant?companyName=' + encodeURIComponent(company) + '&contactPerson=' + encodeURIComponent(contactPerson) + '&email=' + encodeURIComponent(email) + '"><i class="fa-solid fa-plus"></i> Create Tenant</a></div></div></div>';
        document.body.appendChild(overlay);
        overlay.addEventListener('click', function(e) { if (e.target === overlay) closeInquiryCard(); });
        document.addEventListener('keydown', escHandler);
    }
    function closeInquiryCard() {
        var overlay = document.getElementById('inqOverlay');
        if (overlay) overlay.remove();
        document.removeEventListener('keydown', escHandler);
    }
    function escHandler(e) { if (e.key === 'Escape') closeInquiryCard(); }
    function updateFromCard(inquiryId, status) { closeInquiryCard(); updateStatus(inquiryId, status); }
    function getBadgeClass(status) {
        switch((status || '').trim()) {
            case 'New': return 'sa-badge-new'; case 'Contacted': return 'sa-badge-contacted';
            case 'Converted': return 'sa-badge-converted'; case 'Rejected': return 'sa-badge-rejected';
            default: return 'sa-badge-new';
        }
    }
    function escapeHtml(str) { if (!str) return ''; var d = document.createElement('div'); d.textContent = str; return d.innerHTML; }
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.iq-table tbody tr').forEach(function(row) {
            row.addEventListener('click', function(e) {
                if (e.target.closest('.dropdown') || e.target.closest('button') || e.target.closest('a')) return;
                var ac = this.querySelector('td:last-child .btn-action');
                if (ac) { var m = ac.getAttribute('onclick').match(/toggleDropdown\((\d+)/); if (m) showInquiryCard(parseInt(m[1])); }
            });
        });
    });
</script>
