@model List<CRM.MasterDb.Models.TenantSubscriptionModel>
@using CRM.MasterDb.Models
@{
    ViewData["Title"] = "Manage Tenant Subscriptions";

    var subscriptions = Model ?? new List<TenantSubscriptionModel>();
    var tenants = ViewBag.Tenants as List<TenantModel> ?? new List<TenantModel>();

    var displayRows = tenants.Any()
        ? tenants.Select(t => new
        {
            Tenant = t,
            Subscription = subscriptions
                .Where(s => s.TenantId == t.TenantId)
                .OrderByDescending(s => s.CreatedOn)
                .FirstOrDefault()
        }).ToList()
        : subscriptions.Select(s => new
        {
            Tenant = s.Tenant,
            Subscription = s
        }).ToList();
}

