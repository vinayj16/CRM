<div class="ts-scope">
<div class="ts-wrapper">
    <!-- Breadcrumb -->
    <nav class="mb-3" aria-label="breadcrumb" style="font-size:.76rem;">
        <ol class="breadcrumb mb-0" style="background:transparent;padding:0;">
            <li class="breadcrumb-item"><a href="/SuperAdmin/Dashboard" style="color:var(--blue);text-decoration:none;">Dashboard</a></li>
            <li class="breadcrumb-item active" style="color:var(--text-muted)">Tenant Subscriptions</li>
        </ol>
    </nav>

    <div class="ts-card">

        <!-- Header -->
        <div class="ts-header">
            <div class="ts-header-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>
            </div>
            <h5>Tenant Subscriptions</h5>
        </div>

        <!-- Filters -->
        <form method="get" class="ts-filters" id="filterForm">
            <div class="fi-search">
                <input type="text" class="form-control" name="search" id="searchInput"
                       value="@ViewBag.Search" placeholder="&#128269; Search tenant…">
            </div>

            <div class="fi-plan">
                <select class="form-select" name="plan" onchange="this.form.submit()">
                    <option value="">All Plans</option>
                    @if (ViewBag.Plans != null)
                    {
                        foreach (var plan in ViewBag.Plans)
                        {
                            <option value="@plan.PlanId"
                                    selected="@(ViewBag.SelectedPlan == plan.PlanId.ToString() ? "selected" : null)">
                                @plan.PlanName
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="fi-bill">
                <select class="form-select" name="billing" onchange="this.form.submit()">
                    <option value="">All Billing</option>
                    <option value="Monthly" selected="@(ViewBag.SelectedBilling == "Monthly" ? "selected" : null)">Monthly</option>
                    <option value="Annual"  selected="@(ViewBag.SelectedBilling == "Annual"  ? "selected" : null)">Annual</option>
                </select>
            </div>

            <div class="fi-date">
                <input type="text" class="form-control" id="fromDate" name="fromDate"
                       value="@ViewBag.FromDate" placeholder="From date" readonly="readonly">
            </div>

            <div class="fi-date">
                <input type="text" class="form-control" id="toDate" name="toDate"
                       value="@ViewBag.ToDate" placeholder="To date" readonly="readonly">
            </div>

            <button type="submit" class="btn-filter">Filter</button>
        </form>

        <!-- Desktop Table -->
        <div class="ts-table-wrap">
            <table class="ts-table">
                <thead>
                    <tr>
                        <th>Tenant</th>
                        <th>Plan</th>
                        <th>Billing</th>
                        <th>Amount</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th style="text-align:right; padding-right:0.85rem;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (displayRows.Any())
                    {
                        foreach (var row in displayRows)
                        {
                            var tenant = row.Tenant;
                            var subscription = row.Subscription;

                            <tr>
                                <td class="td-tenant">@tenant?.CompanyName</td>

                                <td>
                                    @if (subscription?.Plan != null)
                                    {
                                        <span class="badge-plan">@subscription.Plan.PlanName</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--ts-muted)">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(subscription?.BillingCycle) && subscription.BillingCycle != "No Plan")
                                    {
                                        <span class="badge-billing">@subscription.BillingCycle</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--ts-muted)">—</span>
                                    }
                                </td>

                                <td>
                                    @if (subscription != null && subscription.Amount > 0)
                                    {
                                        <span class="td-amount">₹@subscription.Amount.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="td-amount zero">₹0.00</span>
                                    }
                                </td>

                                <td>
                                    @if (subscription != null && subscription.StartDate != DateTime.MinValue)
                                    {
                                        @subscription.StartDate.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span style="color:var(--ts-muted)">—</span>
                                    }
                                </td>

                                <td>
                                    @if (subscription != null && subscription.EndDate != DateTime.MinValue)
                                    {
                                        <div>@subscription.EndDate.ToString("dd/MM/yyyy")</div>
                                        @if (subscription.Status == "Active" && subscription.EndDate <= DateTime.Now)
                                        {
                                            <span class="tag-expired">Expired</span>
                                        }
                                        else if (subscription.Status == "Active" && subscription.EndDate <= DateTime.Now.AddDays(7))
                                        {
                                            <span class="tag-expiring">Expiring Soon</span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color:var(--ts-muted)">—</span>
                                    }
                                </td>

                                <td class="td-actions">
                                    @if (tenant != null)
                                    {
                                        if (subscription != null && subscription.Status == "Active" && subscription.EndDate > DateTime.Now)
                                        {
                                            <button class="btn-upgrade" onclick="openSaasUpgradeModal(@tenant.TenantId)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l7-7 7 7M12 5v14"/></svg>
                                                Upgrade
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-assign" onclick="openSaasUpgradeModal(@tenant.TenantId)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                                Assign Plan
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="ts-empty">
                                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/></svg>
                                    <div>No tenants found</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Cards -->
        <div class="mobile-cards">
            @if (displayRows.Any())
            {
                foreach (var row in displayRows)
                {
                    var tenant = row.Tenant;
                    var subscription = row.Subscription;

                    <div class="sub-card">
                        <div class="sub-card-top">
                            <span class="sub-card-name">@tenant?.CompanyName</span>
                            <span class="sub-card-amount">
                                @if (subscription != null && subscription.Amount > 0)
                                {
                                    <span>₹@subscription.Amount.ToString("N2")</span>
                                }
                                else
                                {
                                    <span style="color:var(--ts-muted);font-weight:400">₹0.00</span>
                                }
                            </span>
                        </div>

                        <div class="sub-card-row">
                            <span>
                                <span class="sub-card-label">Plan</span>
                                @if (subscription?.Plan != null)
                                {
                                    <span class="badge-plan">@subscription.Plan.PlanName</span>
                                }
                                else
                                {
                                    <span style="color:var(--ts-muted)">—</span>
                                }
                            </span>
                            <span>
                                <span class="sub-card-label">Billing</span>
                                @if (!string.IsNullOrEmpty(subscription?.BillingCycle) && subscription.BillingCycle != "No Plan")
                                {
                                    <span class="badge-billing">@subscription.BillingCycle</span>
                                }
                                else
                                {
                                    <span style="color:var(--ts-muted)">—</span>
                                }
                            </span>
                        </div>

                        <div class="sub-card-row">
                            <span>
                                <span class="sub-card-label">Start Date</span>
                                @if (subscription != null && subscription.StartDate != DateTime.MinValue)
                                {
                                    @subscription.StartDate.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span style="color:var(--ts-muted)">—</span>
                                }
                            </span>
                            <span>
                                <span class="sub-card-label">End Date</span>
                                @if (subscription != null && subscription.EndDate != DateTime.MinValue)
                                {
                                    <div>@subscription.EndDate.ToString("dd/MM/yyyy")</div>
                                    @if (subscription.Status == "Active" && subscription.EndDate <= DateTime.Now)
                                    {
                                        <span class="tag-expired">Expired</span>
                                    }
                                    else if (subscription.Status == "Active" && subscription.EndDate <= DateTime.Now.AddDays(7))
                                    {
                                        <span class="tag-expiring">Expiring Soon</span>
                                    }
                                }
                                else
                                {
                                    <span style="color:var(--ts-muted)">—</span>
                                }
                            </span>
                        </div>

                        <div>
                            @if (tenant != null)
                            {
                                if (subscription != null && subscription.Status == "Active" && subscription.EndDate > DateTime.Now)
                                {
                                    <button class="btn-upgrade" style="width:100%;justify-content:center" onclick="openSaasUpgradeModal(@tenant.TenantId)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l7-7 7 7M12 5v14"/></svg>
                                        Upgrade Plan
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-assign" style="width:100%;justify-content:center" onclick="openSaasUpgradeModal(@tenant.TenantId)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                        Assign Plan
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="ts-empty">
                    <div>No tenants found</div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="ts-pagination">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search&plan=@ViewBag.SelectedPlan&billing=@ViewBag.SelectedBilling&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate">‹</a>
                }

                @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="active">@i</span>
                    }
                    else
                    {
                        <a href="?page=@i&search=@ViewBag.Search&plan=@ViewBag.SelectedPlan&billing=@ViewBag.SelectedBilling&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate">@i</a>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search&plan=@ViewBag.SelectedPlan&billing=@ViewBag.SelectedBilling&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate">›</a>
                }
            </div>
        }

    </div>
</div>
</div>

@Html.Partial("_UpgradeModal")
@Html.Partial("_SaaSUpgradeModal")

@* Load flatpickr AFTER DOM is ready - fixes calendar not opening *@
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    // ── Flatpickr - loaded after DOM, no altInput needed, readonly inputs ──
    document.addEventListener('DOMContentLoaded', function () {

        var fromPicker = flatpickr('#fromDate', {
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: 'd/m/Y',
            allowInput: false,
            disableMobile: false,
            onChange: function (selectedDates, dateStr) {
                clearTimeout(window._fpTimer);
                window._fpTimer = setTimeout(function () {
                    document.getElementById('filterForm').submit();
                }, 600);
            }
        });

        var toPicker = flatpickr('#toDate', {
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: 'd/m/Y',
            allowInput: false,
            disableMobile: false,
            onChange: function (selectedDates, dateStr) {
                clearTimeout(window._fpTimer);
                window._fpTimer = setTimeout(function () {
                    document.getElementById('filterForm').submit();
                }, 600);
            }
        });

        // Set existing values if present (from ViewBag)
        var fromVal = '@ViewBag.FromDate';
        var toVal   = '@ViewBag.ToDate';
        if (fromVal) fromPicker.setDate(fromVal, false);
        if (toVal)   toPicker.setDate(toVal, false);

        // ── Search debounce ──
        var _searchTimer;
        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                clearTimeout(_searchTimer);
                _searchTimer = setTimeout(function () {
                    document.getElementById('filterForm').submit();
                }, 500);
            });
        }
    });
</script>
